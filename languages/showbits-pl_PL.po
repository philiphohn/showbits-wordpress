# Polish translation of the ShowBits plugin.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: pl_PL\n"
"Plural-Forms: nplurals=3; plural=(n == 1) ? 0 : ((n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14)) ? 1 : 2);\n"

#. Description of the plugin
#: showbits/showbits.php
msgid "Released clips and quote cards from ShowBits in the media library: pick them in WordPress, or receive what your ShowBits admins send."
msgstr "Zatwierdzone w ShowBits klipy i grafiki z cytatami w bibliotece mediów: wybieraj je w WordPressie lub odbieraj to, co wysyłają administratorzy ShowBits."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer as expected."
msgstr "ShowBits nie odpowiedział zgodnie z oczekiwaniami."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer with a file."
msgstr "ShowBits nie zwrócił pliku."

#: showbits/includes/class-api-client.php showbits/includes/class-importer.php
msgid "ShowBits could not be reached."
msgstr "Brak łączności z ShowBits."

#. translators: 1: ShowBits' reason, 2: the HTTP status
#: showbits/includes/class-api-client.php
msgid "ShowBits refused (%1$s, HTTP %2$d)."
msgstr "ShowBits odrzucił żądanie (%1$s, HTTP %2$d)."

#: showbits/includes/class-connection.php
msgid "You may not connect this site."
msgstr "Nie masz uprawnień do połączenia tej witryny."

#. translators: %s: the clip's title
#: showbits/includes/class-importer.php
msgid "%s (thumbnail)"
msgstr "%s (miniatura)"

#. translators: %s: a quote (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%s”"
msgstr "„%s”"

#. translators: 1: a quote, 2: who said it (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%1$s” – %2$s"
msgstr "„%1$s” – %2$s"

#: showbits/includes/class-importer.php
msgid "This is not a clip or a format ShowBits offers."
msgstr "To nie jest klip ani format oferowany przez ShowBits."

#: showbits/includes/class-importer.php
msgid "The clip is no longer released in ShowBits."
msgstr "Klip nie jest już zatwierdzony w ShowBits."

#: showbits/includes/class-importer.php
msgid "The embargo still holds: the file stays in ShowBits until it ends."
msgstr "Embargo wciąż obowiązuje: do jego końca plik pozostaje w ShowBits."

#: showbits/includes/class-importer.php
msgid "The file is not ready yet in ShowBits."
msgstr "Plik nie jest jeszcze gotowy w ShowBits."

#: showbits/includes/class-importer.php
msgid "The file could not be downloaded."
msgstr "Nie udało się pobrać pliku."

#: showbits/includes/class-importer.php
msgid "WordPress did not take the file into the media library."
msgstr "WordPress nie przyjął pliku do biblioteki mediów."

#: showbits/includes/class-importer.php
msgid "The delivery from ShowBits is no longer valid. Import the clip again."
msgstr "Przesyłka z ShowBits straciła ważność. Zaimportuj klip ponownie."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer accepts this site’s connection: connect it again under Settings → ShowBits."
msgstr "ShowBits nie akceptuje już połączenia tej witryny: połącz ją ponownie w menu Ustawienia → ShowBits."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer delivers to this site: the workspace’s plan has ended."
msgstr "ShowBits nie dostarcza już niczego do tej witryny: plan przestrzeni roboczej wygasł."

#: showbits/includes/class-importer.php
msgid "The site’s imports for today are used up. Try again tomorrow."
msgstr "Dzisiejszy limit importów tej witryny został wyczerpany. Spróbuj ponownie jutro."

#: showbits/includes/class-importer.php
msgid "The import was interrupted."
msgstr "Import został przerwany."

#: showbits/includes/class-importer.php
msgid "The import failed."
msgstr "Import nie powiódł się."

#: showbits/includes/class-library-endpoint.php
msgid "This site is not connected to ShowBits."
msgstr "Ta witryna nie jest połączona z ShowBits."

#: showbits/includes/class-library-page.php
msgid "All"
msgstr "Wszystkie"

#: showbits/includes/class-library-page.php
msgid "Clips"
msgstr "Klipy"

#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Quote cards"
msgstr "Grafiki z cytatami"

#: showbits/includes/class-library-page.php
msgid "Search titles"
msgstr "Szukaj w tytułach"

#: showbits/includes/class-library-page.php
msgid "Search the library"
msgstr "Przeszukaj bibliotekę"

#: showbits/includes/class-library-page.php
msgid "Import selected"
msgstr "Importuj zaznaczone"

#. translators: 1: which one, 2: how many in all
#: showbits/includes/class-library-page.php
msgid "Asking ShowBits for %1$d of %2$d …"
msgstr "Wysyłanie żądania do ShowBits: %1$d z %2$d…"

#. translators: %d: how many clips are still on their way
#: showbits/includes/class-library-page.php
msgid "On the way from ShowBits: %d …"
msgstr "W drodze z ShowBits: %d…"

#. translators: %d: how many clips were imported
#: showbits/includes/class-library-page.php
msgid "Imported: %d"
msgstr "Zaimportowano: %d"

#: showbits/includes/class-library-page.php
msgid "Not everything has arrived yet; it continues in the background. Settings → ShowBits lists the imports."
msgstr "Jeszcze nie wszystko dotarło; import trwa w tle. Listę importów znajdziesz w menu Ustawienia → ShowBits."

#: showbits/includes/class-library-page.php
msgid "On the way"
msgstr "W drodze"

#: showbits/includes/class-library-page.php
msgid "Load more"
msgstr "Wczytaj więcej"

#: showbits/includes/class-library-page.php
msgid "Loading …"
msgstr "Wczytywanie…"

#: showbits/includes/class-library-page.php
msgid "No released clips or quote cards yet."
msgstr "Nie ma jeszcze zatwierdzonych klipów ani grafik z cytatami."

#. translators: %s: date and time the embargo ends
#: showbits/includes/class-library-page.php
msgid "Embargo until %s"
msgstr "Embargo do %s"

#: showbits/includes/class-library-page.php
msgid "Not ready yet"
msgstr "W przygotowaniu"

#: showbits/includes/class-library-page.php
msgid "In the media library"
msgstr "W bibliotece mediów"

#: showbits/includes/class-library-page.php
msgid "An older version is in the media library"
msgstr "W bibliotece mediów jest starsza wersja"

#: showbits/includes/class-library-page.php
msgid "Edit"
msgstr "Edytuj"

#: showbits/includes/class-library-page.php
msgid "Format"
msgstr "Format"

#. translators: %s: a quote card's format, such as 9:16 or "9:16 (stories)" (its animated video with the speaker's voice)
#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Animated %s"
msgstr "Animowana %s"

#: showbits/includes/class-library-page.php
msgid "Video"
msgstr "Wideo"

#: showbits/includes/class-library-page.php
msgid "Quote card"
msgstr "Grafika z cytatem"

#: showbits/includes/class-library-page.php
msgid "Meme"
msgstr "Mem"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "Failed: %s"
msgstr "Niepowodzenie: %s"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "The library could not be loaded: %s"
msgstr "Nie udało się wczytać biblioteki: %s"

#: showbits/includes/class-library-page.php
msgid "This site is not connected to ShowBits yet."
msgstr "Ta witryna nie jest jeszcze połączona z ShowBits."

#: showbits/includes/class-library-page.php
msgid "Connect it in the settings."
msgstr "Połącz ją w ustawieniach."

#: showbits/includes/class-library-page.php
msgid "An administrator of this site connects it in the settings."
msgstr "Administrator tej witryny może ją połączyć w ustawieniach."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-library-page.php
msgid "Released clips and quote cards from the ShowBits workspace “%s”. What you import lands in the media library, ready for posts and pages."
msgstr "Zatwierdzone klipy i grafiki z cytatami z przestrzeni roboczej ShowBits „%s”. To, co zaimportujesz, trafia do biblioteki mediów, gotowe do użycia we wpisach i na stronach."

#: showbits/includes/class-library-page.php
msgid "The library needs JavaScript."
msgstr "Biblioteka wymaga JavaScriptu."

#: showbits/includes/class-settings-page.php
msgid "Settings"
msgstr "Ustawienia"

#: showbits/includes/class-settings-page.php
msgid "You may not change these settings."
msgstr "Nie masz uprawnień do zmiany tych ustawień."

#: showbits/includes/class-settings-page.php
msgid "Connection"
msgstr "Połączenie"

#. translators: 1: the constant SHOWBITS_ENCRYPTION_KEY, 2: the file wp-config.php (both stay as they are)
#: showbits/includes/class-settings-page.php
msgid "Your site’s security keys are not in %2$s, so the key that protects the connection to ShowBits is stored in the database. Add %1$s with a long random value to %2$s; if the site is connected already, connect it again afterwards."
msgstr "Klucze bezpieczeństwa Twojej witryny nie znajdują się w %2$s, dlatego klucz chroniący połączenie z ShowBits jest przechowywany w bazie danych. Dodaj %1$s z długą losową wartością do %2$s; jeśli witryna jest już połączona, połącz ją potem ponownie."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-settings-page.php
msgid "Connected to the workspace “%s”."
msgstr "Połączono z przestrzenią roboczą „%s”."

#. translators: 1: imports today, 2: imports a day the plan allows
#: showbits/includes/class-settings-page.php
msgid "Imports today: %1$d of %2$d."
msgstr "Dzisiejsze importy: %1$d z %2$d."

#. translators: 1: a person, 2: a date, 3: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "Connected by %1$s on %2$s, at %3$s."
msgstr "Połączenie z %3$s utworzone przez %1$s dnia %2$s."

#: showbits/includes/class-settings-page.php
msgid "Connect again"
msgstr "Ponowne połączenie"

#: showbits/includes/class-settings-page.php
msgid "With a new site key the site renews its connection, or moves to another workspace."
msgstr "Nowy klucz witryny pozwala odnowić połączenie lub przenieść witrynę do innej przestrzeni roboczej."

#. translators: %s: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "ShowBits (%s) cannot be reached right now. The connection stays; try again later."
msgstr "W tej chwili brak łączności z ShowBits (%s). Połączenie zostaje zachowane; spróbuj ponownie później."

#: showbits/includes/class-settings-page.php
msgid "ShowBits no longer accepts this site’s connection: it was disconnected in ShowBits, the plan ended, or this site’s keys changed. Connect it again with a new site key."
msgstr "ShowBits nie akceptuje już połączenia tej witryny: rozłączono je w ShowBits, plan wygasł albo zmieniły się klucze tej witryny. Połącz ją ponownie przy użyciu nowego klucza witryny."

#: showbits/includes/class-settings-page.php
msgid "Connect this site to a ShowBits workspace: an admin or owner of the workspace makes a site key for this site in ShowBits (Integrations → WordPress). The site can then take released clips and quote cards into its media library, and receive what your ShowBits admins send."
msgstr "Połącz tę witrynę z przestrzenią roboczą ShowBits: klucz witryny tworzy dla niej w ShowBits (Integrations → WordPress) administrator lub właściciel przestrzeni roboczej. Następnie witryna może pobierać zatwierdzone klipy i grafiki z cytatami do swojej biblioteki mediów oraz odbierać to, co wysyłają administratorzy ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Imports"
msgstr "Importy"

#: showbits/includes/class-settings-page.php
msgid "Format of quote cards"
msgstr "Format grafik z cytatami"

#: showbits/includes/class-settings-page.php
msgid "4:5 (feeds, articles)"
msgstr "4:5 (feedy, artykuły)"

#: showbits/includes/class-settings-page.php
msgid "1:1 (square)"
msgstr "1:1 (kwadrat)"

#: showbits/includes/class-settings-page.php
msgid "9:16 (stories)"
msgstr "9:16 (relacje)"

#: showbits/includes/class-settings-page.php
msgid "The picture pushes bring; in the library you choose for each card."
msgstr "Format grafik wysyłanych do witryny; w bibliotece wybierasz go osobno dla każdej grafiki."

#: showbits/includes/class-settings-page.php
msgid "Videos"
msgstr "Wideo"

#: showbits/includes/class-settings-page.php
msgid "Import the thumbnail as the video’s poster image"
msgstr "Importuj miniaturę jako obrazek plakatu wideo"

#: showbits/includes/class-settings-page.php
msgid "Save"
msgstr "Zapisz"

#: showbits/includes/class-settings-page.php
msgid "Site key"
msgstr "Klucz witryny"

#. translators: %s: this site's address
#: showbits/includes/class-settings-page.php
msgid "Made in ShowBits for %s, valid for 24 hours and only once. ShowBits then checks that it is talking to this site."
msgstr "Tworzony w ShowBits dla %s; jednorazowy, ważny przez 24 godziny. Następnie ShowBits sprawdza, czy komunikuje się właśnie z tą witryną."

#: showbits/includes/class-settings-page.php
msgid "Connect"
msgstr "Połącz"

#: showbits/includes/class-settings-page.php
msgid "Are you an admin or owner of the workspace yourself? Then sign in to ShowBits and agree there, without a site key:"
msgstr "Jesteś administratorem lub właścicielem przestrzeni roboczej? Zaloguj się wtedy do ShowBits i wyraź tam zgodę – bez klucza witryny:"

#: showbits/includes/class-settings-page.php
msgid "Connect through ShowBits"
msgstr "Połącz przez ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits address"
msgstr "Adres ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits Cloud: https://app.showbits.ai. OnPremise: the address of your installation."
msgstr "ShowBits Cloud: https://app.showbits.ai. OnPremise: adres własnej instalacji."

#: showbits/includes/class-settings-page.php
msgid "Disconnect"
msgstr "Rozłącz"

#: showbits/includes/class-settings-page.php
msgid "Disconnect this site from ShowBits? What is in the media library stays."
msgstr "Rozłączyć tę witrynę z ShowBits? To, co jest w bibliotece mediów, pozostanie."

#: showbits/includes/class-settings-page.php
msgid "asked for"
msgstr "Wysłano żądanie"

#: showbits/includes/class-settings-page.php
msgid "waiting"
msgstr "W kolejce"

#: showbits/includes/class-settings-page.php
msgid "importing"
msgstr "Importowanie"

#: showbits/includes/class-settings-page.php
msgid "imported"
msgstr "Zaimportowano"

#: showbits/includes/class-settings-page.php
msgid "failed"
msgstr "Niepowodzenie"

#: showbits/includes/class-settings-page.php
msgid "Recent imports"
msgstr "Ostatnie importy"

#: showbits/includes/class-settings-page.php
msgid "When"
msgstr "Data"

#: showbits/includes/class-settings-page.php
msgid "Clip"
msgstr "Klip"

#: showbits/includes/class-settings-page.php
msgid "How"
msgstr "Sposób"

#: showbits/includes/class-settings-page.php
msgid "State"
msgstr "Status"

#: showbits/includes/class-settings-page.php
msgid "sent from ShowBits"
msgstr "Wysłano z ShowBits"

#: showbits/includes/class-settings-page.php
msgid "picked here"
msgstr "Wybrano tutaj"

#: showbits/includes/class-settings-page.php
msgid "Connected. The library is under Media → ShowBits."
msgstr "Połączono. Biblioteka jest dostępna w menu Media → ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Disconnected. What is in the media library stays."
msgstr "Rozłączono. To, co jest w bibliotece mediów, pozostaje."

#: showbits/includes/class-settings-page.php
msgid "Saved."
msgstr "Zapisano."

#: showbits/includes/class-settings-page.php
msgid "Connecting was cancelled in ShowBits."
msgstr "Łączenie zostało anulowane w ShowBits."

#: showbits/includes/class-settings-page.php
msgid "That way back from ShowBits did not belong to this attempt. Start again."
msgstr "Ten powrót z ShowBits nie należy do bieżącej próby połączenia. Zacznij od nowa."

#: showbits/includes/class-settings-page.php
msgid "The ShowBits address must start with https://."
msgstr "Adres ShowBits musi zaczynać się od https://."

#: showbits/includes/class-settings-page.php
msgid "That is not a site key. Copy it from ShowBits (Integrations → WordPress) again."
msgstr "To nie jest klucz witryny. Skopiuj go ponownie z ShowBits (Integrations → WordPress)."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not take the site key: it is unknown, used, withdrawn or expired (a site key lasts 24 hours, a consent ten minutes). Make a new one."
msgstr "ShowBits nie przyjął klucza witryny: jest nieznany, został już użyty, wycofany lub wygasł (klucz witryny jest ważny 24 godziny, zgoda – dziesięć minut). Utwórz nowy."

#: showbits/includes/class-settings-page.php
msgid "The site key was made for another address. Make one for this site’s address."
msgstr "Klucz witryny został utworzony dla innego adresu. Utwórz klucz dla adresu tej witryny."

#: showbits/includes/class-settings-page.php
msgid "ShowBits could not reach this site at its REST API (/wp-json/showbits/v1/push), or ShowBits itself could not be reached. The site must be public over HTTPS; a firewall or security plugin must let ShowBits in."
msgstr "ShowBits nie dotarł do tej witryny przez jej REST API (/wp-json/showbits/v1/push) albo nie było łączności z samym ShowBits. Witryna musi być publicznie dostępna przez HTTPS; zapora sieciowa lub wtyczka bezpieczeństwa musi przepuszczać ShowBits."

#: showbits/includes/class-settings-page.php
msgid "This site did not answer ShowBits’ check as expected. Try again; if it fails again, a cache or security plugin may answer for WordPress."
msgstr "Ta witryna nie odpowiedziała na weryfikację ShowBits zgodnie z oczekiwaniami. Spróbuj ponownie; jeśli znów się nie uda, być może zamiast WordPressa odpowiada wtyczka pamięci podręcznej lub wtyczka bezpieczeństwa."

#: showbits/includes/class-settings-page.php
msgid "The workspace’s plan has ended, or whoever made the site key may no longer connect sites."
msgstr "Plan przestrzeni roboczej wygasł albo osoba, która utworzyła klucz witryny, nie może już łączyć witryn."

#: showbits/includes/class-settings-page.php
msgid "The workspace has as many sites as its plan allows."
msgstr "Przestrzeń robocza ma już tyle witryn, na ile pozwala jej plan."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not accept this site’s address. It must be served over HTTPS."
msgstr "ShowBits nie zaakceptował adresu tej witryny. Witryna musi być udostępniana przez HTTPS."

#: showbits/includes/class-settings-page.php
msgid "Connecting did not work. Try again, or ask your ShowBits contact."
msgstr "Nie udało się połączyć. Spróbuj ponownie lub zapytaj swoją osobę kontaktową w ShowBits."
