# Nigerian Pidgin translation of the ShowBits plugin.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: pcm\n"
"Plural-Forms: nplurals=2; plural=n != 1;\n"

#. Description of the plugin
#: showbits/showbits.php
msgid "Released clips and quote cards from ShowBits in the media library: pick them in WordPress, or receive what your ShowBits admins send."
msgstr "Clips and quote cards wey dem don approve for ShowBits, inside di media library: pick dem for WordPress, or collect wetin your ShowBits admins send."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer as expected."
msgstr "ShowBits no answer di way e suppose."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer with a file."
msgstr "Wetin ShowBits send back no be file."

#: showbits/includes/class-api-client.php showbits/includes/class-importer.php
msgid "ShowBits could not be reached."
msgstr "Dis site no fit reach ShowBits."

#. translators: 1: ShowBits' reason, 2: the HTTP status
#: showbits/includes/class-api-client.php
msgid "ShowBits refused (%1$s, HTTP %2$d)."
msgstr "ShowBits no gree (%1$s, HTTP %2$d)."

#: showbits/includes/class-connection.php
msgid "You may not connect this site."
msgstr "You no get permission to connect dis site."

#. translators: %s: the clip's title
#: showbits/includes/class-importer.php
msgid "%s (thumbnail)"
msgstr "%s (thumbnail)"

#. translators: %s: a quote (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%s”"
msgstr "“%s”"

#. translators: 1: a quote, 2: who said it (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%1$s” – %2$s"
msgstr "“%1$s” – %2$s"

#: showbits/includes/class-importer.php
msgid "This is not a clip or a format ShowBits offers."
msgstr "Dis one no be clip, or e no be format wey ShowBits dey offer."

#: showbits/includes/class-importer.php
msgid "The clip is no longer released in ShowBits."
msgstr "Di clip no dey approved for ShowBits again."

#: showbits/includes/class-importer.php
msgid "The embargo still holds: the file stays in ShowBits until it ends."
msgstr "Di embargo still dey: di file go stay for ShowBits until e end."

#: showbits/includes/class-importer.php
msgid "The file is not ready yet in ShowBits."
msgstr "Di file never ready for ShowBits."

#: showbits/includes/class-importer.php
msgid "The file could not be downloaded."
msgstr "Di file no fit download."

#: showbits/includes/class-importer.php
msgid "WordPress did not take the file into the media library."
msgstr "WordPress no gree take di file enter di media library."

#: showbits/includes/class-importer.php
msgid "The delivery from ShowBits is no longer valid. Import the clip again."
msgstr "Di delivery from ShowBits don expire. Import di clip again."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer accepts this site’s connection: connect it again under Settings → ShowBits."
msgstr "ShowBits don stop to accept dis site connection: connect am again for Settings → ShowBits."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer delivers to this site: the workspace’s plan has ended."
msgstr "ShowBits don stop to deliver to dis site: di workspace plan don end."

#: showbits/includes/class-importer.php
msgid "The site’s imports for today are used up. Try again tomorrow."
msgstr "Dis site don use all im imports for today finish. Try again tomorrow."

#: showbits/includes/class-importer.php
msgid "The import was interrupted."
msgstr "Di import cut for middle."

#: showbits/includes/class-importer.php
msgid "The import failed."
msgstr "Di import fail."

#: showbits/includes/class-library-endpoint.php
msgid "This site is not connected to ShowBits."
msgstr "Dis site no dey connected to ShowBits."

#: showbits/includes/class-library-page.php
msgid "All"
msgstr "All"

#: showbits/includes/class-library-page.php
msgid "Clips"
msgstr "Clips"

#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Quote cards"
msgstr "Quote cards"

#: showbits/includes/class-library-page.php
msgid "Search titles"
msgstr "Search di titles"

#: showbits/includes/class-library-page.php
msgid "Search the library"
msgstr "Search di library"

#: showbits/includes/class-library-page.php
msgid "Import selected"
msgstr "Import wetin you select"

#. translators: 1: which one, 2: how many in all
#: showbits/includes/class-library-page.php
msgid "Asking ShowBits for %1$d of %2$d …"
msgstr "E dey ask ShowBits for %1$d out of %2$d…"

#. translators: %d: how many clips are still on their way
#: showbits/includes/class-library-page.php
msgid "On the way from ShowBits: %d …"
msgstr "E dey come from ShowBits: %d…"

#. translators: %d: how many clips were imported
#: showbits/includes/class-library-page.php
msgid "Imported: %d"
msgstr "Wetin don import: %d"

#: showbits/includes/class-library-page.php
msgid "Not everything has arrived yet; it continues in the background. Settings → ShowBits lists the imports."
msgstr "No be everything don land yet; e go continue for background. Settings → ShowBits get di list of imports."

#: showbits/includes/class-library-page.php
msgid "On the way"
msgstr "E dey come"

#: showbits/includes/class-library-page.php
msgid "Load more"
msgstr "Load more"

#: showbits/includes/class-library-page.php
msgid "Loading …"
msgstr "E dey load…"

#: showbits/includes/class-library-page.php
msgid "No released clips or quote cards yet."
msgstr "No approved clip or quote card dey yet."

#. translators: %s: date and time the embargo ends
#: showbits/includes/class-library-page.php
msgid "Embargo until %s"
msgstr "Embargo till %s"

#: showbits/includes/class-library-page.php
msgid "Not ready yet"
msgstr "E never ready"

#: showbits/includes/class-library-page.php
msgid "In the media library"
msgstr "E don dey di media library"

#: showbits/includes/class-library-page.php
msgid "An older version is in the media library"
msgstr "One old version dey di media library"

#: showbits/includes/class-library-page.php
msgid "Edit"
msgstr "Edit"

#: showbits/includes/class-library-page.php
msgid "Format"
msgstr "Format"

#. translators: %s: a quote card's format, such as 9:16 or "9:16 (stories)" (its animated video with the speaker's voice)
#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Animated %s"
msgstr "Animated %s"

#: showbits/includes/class-library-page.php
msgid "Video"
msgstr "Video"

#: showbits/includes/class-library-page.php
msgid "Quote card"
msgstr "Quote card"

#: showbits/includes/class-library-page.php
msgid "Meme"
msgstr "Meme"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "Failed: %s"
msgstr "E fail: %s"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "The library could not be loaded: %s"
msgstr "Di library no fit load: %s"

#: showbits/includes/class-library-page.php
msgid "This site is not connected to ShowBits yet."
msgstr "Dis site never connect to ShowBits."

#: showbits/includes/class-library-page.php
msgid "Connect it in the settings."
msgstr "Connect am for di settings."

#: showbits/includes/class-library-page.php
msgid "An administrator of this site connects it in the settings."
msgstr "Na administrator of dis site go connect am for di settings."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-library-page.php
msgid "Released clips and quote cards from the ShowBits workspace “%s”. What you import lands in the media library, ready for posts and pages."
msgstr "Approved clips and quote cards from di ShowBits workspace “%s”. Wetin you import go land for di media library, ready for posts and pages."

#: showbits/includes/class-library-page.php
msgid "The library needs JavaScript."
msgstr "Di library need JavaScript."

#: showbits/includes/class-settings-page.php
msgid "Settings"
msgstr "Settings"

#: showbits/includes/class-settings-page.php
msgid "You may not change these settings."
msgstr "You no get permission to change dis settings."

#: showbits/includes/class-settings-page.php
msgid "Connection"
msgstr "Connection"

#. translators: 1: the constant SHOWBITS_ENCRYPTION_KEY, 2: the file wp-config.php (both stay as they are)
#: showbits/includes/class-settings-page.php
msgid "Your site’s security keys are not in %2$s, so the key that protects the connection to ShowBits is stored in the database. Add %1$s with a long random value to %2$s; if the site is connected already, connect it again afterwards."
msgstr "Your site security keys no dey inside %2$s, so di key wey dey protect di connection to ShowBits dey for database. Add %1$s with long random value to %2$s; if di site don connect already, connect am again after."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-settings-page.php
msgid "Connected to the workspace “%s”."
msgstr "E don connect to di workspace “%s”."

#. translators: 1: imports today, 2: imports a day the plan allows
#: showbits/includes/class-settings-page.php
msgid "Imports today: %1$d of %2$d."
msgstr "Imports for today: %1$d out of %2$d."

#. translators: 1: a person, 2: a date, 3: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "Connected by %1$s on %2$s, at %3$s."
msgstr "Na %1$s connect am on %2$s, to %3$s."

#: showbits/includes/class-settings-page.php
msgid "Connect again"
msgstr "Connect am again"

#: showbits/includes/class-settings-page.php
msgid "With a new site key the site renews its connection, or moves to another workspace."
msgstr "With new site key, di site fit renew im connection, or move go another workspace."

#. translators: %s: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "ShowBits (%s) cannot be reached right now. The connection stays; try again later."
msgstr "Dis site no fit reach ShowBits (%s) right now. Di connection still dey; try again later."

#: showbits/includes/class-settings-page.php
msgid "ShowBits no longer accepts this site’s connection: it was disconnected in ShowBits, the plan ended, or this site’s keys changed. Connect it again with a new site key."
msgstr "ShowBits don stop to accept dis site connection: dem disconnect am for ShowBits, di plan don end, or dis site keys don change. Connect am again with new site key."

#: showbits/includes/class-settings-page.php
msgid "Connect this site to a ShowBits workspace: an admin or owner of the workspace makes a site key for this site in ShowBits (Integrations → WordPress). The site can then take released clips and quote cards into its media library, and receive what your ShowBits admins send."
msgstr "Connect dis site to one ShowBits workspace: one admin or owner of di workspace go make site key for dis site for ShowBits (Integrations → WordPress). After dat, di site fit take approved clips and quote cards enter im media library, and collect wetin your ShowBits admins send."

#: showbits/includes/class-settings-page.php
msgid "Imports"
msgstr "Imports"

#: showbits/includes/class-settings-page.php
msgid "Format of quote cards"
msgstr "Format for quote cards"

#: showbits/includes/class-settings-page.php
msgid "4:5 (feeds, articles)"
msgstr "4:5 (feeds, articles)"

#: showbits/includes/class-settings-page.php
msgid "1:1 (square)"
msgstr "1:1 (square)"

#: showbits/includes/class-settings-page.php
msgid "9:16 (stories)"
msgstr "9:16 (stories)"

#: showbits/includes/class-settings-page.php
msgid "The picture pushes bring; in the library you choose for each card."
msgstr "Na di picture format wey go follow anything wey dem push come here; for di library, you go choose am for each card."

#: showbits/includes/class-settings-page.php
msgid "Videos"
msgstr "Videos"

#: showbits/includes/class-settings-page.php
msgid "Import the thumbnail as the video’s poster image"
msgstr "Import di thumbnail as di video poster image"

#: showbits/includes/class-settings-page.php
msgid "Save"
msgstr "Save"

#: showbits/includes/class-settings-page.php
msgid "Site key"
msgstr "Site key"

#. translators: %s: this site's address
#: showbits/includes/class-settings-page.php
msgid "Made in ShowBits for %s, valid for 24 hours and only once. ShowBits then checks that it is talking to this site."
msgstr "Dem make am for ShowBits for %s; e valid for 24 hours and you fit use am only once. ShowBits go then check say na dis site e dey talk to."

#: showbits/includes/class-settings-page.php
msgid "Connect"
msgstr "Connect"

#: showbits/includes/class-settings-page.php
msgid "Are you an admin or owner of the workspace yourself? Then sign in to ShowBits and agree there, without a site key:"
msgstr "Na you self be admin or owner of di workspace? Den sign in to ShowBits and agree for there, without site key:"

#: showbits/includes/class-settings-page.php
msgid "Connect through ShowBits"
msgstr "Connect am through ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits address"
msgstr "ShowBits address"

#: showbits/includes/class-settings-page.php
msgid "ShowBits Cloud: https://app.showbits.ai. OnPremise: the address of your installation."
msgstr "ShowBits Cloud: https://app.showbits.ai. OnPremise: di address of your installation."

#: showbits/includes/class-settings-page.php
msgid "Disconnect"
msgstr "Disconnect"

#: showbits/includes/class-settings-page.php
msgid "Disconnect this site from ShowBits? What is in the media library stays."
msgstr "You wan disconnect dis site from ShowBits? Wetin dey di media library go still stay."

#: showbits/includes/class-settings-page.php
msgid "asked for"
msgstr "Dem don ask for am"

#: showbits/includes/class-settings-page.php
msgid "waiting"
msgstr "E dey wait"

#: showbits/includes/class-settings-page.php
msgid "importing"
msgstr "E dey import"

#: showbits/includes/class-settings-page.php
msgid "imported"
msgstr "E don import"

#: showbits/includes/class-settings-page.php
msgid "failed"
msgstr "E fail"

#: showbits/includes/class-settings-page.php
msgid "Recent imports"
msgstr "Imports wey just happen"

#: showbits/includes/class-settings-page.php
msgid "When"
msgstr "Wen"

#: showbits/includes/class-settings-page.php
msgid "Clip"
msgstr "Clip"

#: showbits/includes/class-settings-page.php
msgid "How"
msgstr "How e come"

#: showbits/includes/class-settings-page.php
msgid "State"
msgstr "Status"

#: showbits/includes/class-settings-page.php
msgid "sent from ShowBits"
msgstr "ShowBits send am"

#: showbits/includes/class-settings-page.php
msgid "picked here"
msgstr "Dem pick am here"

#: showbits/includes/class-settings-page.php
msgid "Connected. The library is under Media → ShowBits."
msgstr "E don connect. Di library dey under Media → ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Disconnected. What is in the media library stays."
msgstr "E don disconnect. Wetin dey di media library go still stay."

#: showbits/includes/class-settings-page.php
msgid "Saved."
msgstr "E don save."

#: showbits/includes/class-settings-page.php
msgid "Connecting was cancelled in ShowBits."
msgstr "Dem cancel di connection process for ShowBits."

#: showbits/includes/class-settings-page.php
msgid "That way back from ShowBits did not belong to this attempt. Start again."
msgstr "Di way back from ShowBits no belong to di connection attempt wey dis site start. Start again."

#: showbits/includes/class-settings-page.php
msgid "The ShowBits address must start with https://."
msgstr "Di ShowBits address must start with https://."

#: showbits/includes/class-settings-page.php
msgid "That is not a site key. Copy it from ShowBits (Integrations → WordPress) again."
msgstr "Dat one no be site key. Copy am again from ShowBits (Integrations → WordPress)."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not take the site key: it is unknown, used, withdrawn or expired (a site key lasts 24 hours, a consent ten minutes). Make a new one."
msgstr "ShowBits no accept di site key: dem no know am, dem don use am before, dem don withdraw am, or e don expire (site key dey last 24 hours, consent dey last ten minutes). Make new one."

#: showbits/includes/class-settings-page.php
msgid "The site key was made for another address. Make one for this site’s address."
msgstr "Dem make di site key for another address. Make one for dis site address."

#: showbits/includes/class-settings-page.php
msgid "ShowBits could not reach this site at its REST API (/wp-json/showbits/v1/push), or ShowBits itself could not be reached. The site must be public over HTTPS; a firewall or security plugin must let ShowBits in."
msgstr "ShowBits no fit reach dis site through im REST API (/wp-json/showbits/v1/push), or nobody fit reach ShowBits self. Di site must dey public over HTTPS; firewall or security plugin must allow ShowBits enter."

#: showbits/includes/class-settings-page.php
msgid "This site did not answer ShowBits’ check as expected. Try again; if it fails again, a cache or security plugin may answer for WordPress."
msgstr "Dis site no answer ShowBits check di way e suppose. Try again; if e fail again, maybe na cache or security plugin dey answer instead of WordPress."

#: showbits/includes/class-settings-page.php
msgid "The workspace’s plan has ended, or whoever made the site key may no longer connect sites."
msgstr "Di workspace plan don end, or di person wey make di site key no get permission to connect sites again."

#: showbits/includes/class-settings-page.php
msgid "The workspace has as many sites as its plan allows."
msgstr "Di workspace don reach di number of sites wey im plan allow."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not accept this site’s address. It must be served over HTTPS."
msgstr "ShowBits no accept dis site address. Di site must dey run on HTTPS."

#: showbits/includes/class-settings-page.php
msgid "Connecting did not work. Try again, or ask your ShowBits contact."
msgstr "Di connection no work. Try again, or ask your contact for ShowBits."
