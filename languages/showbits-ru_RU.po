# Russian translation of the ShowBits plugin.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: ru_RU\n"
"Plural-Forms: nplurals=3; plural=(n % 10 == 1 && n % 100 != 11) ? 0 : ((n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14)) ? 1 : 2);\n"

#. Description of the plugin
#: showbits/showbits.php
msgid "Released clips and quote cards from ShowBits in the media library: pick them in WordPress, or receive what your ShowBits admins send."
msgstr "Одобренные клипы и карточки с цитатами из ShowBits в библиотеке файлов: выбирайте их в WordPress или получайте то, что отправляют ваши администраторы ShowBits."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer as expected."
msgstr "ShowBits ответил не так, как ожидалось."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer with a file."
msgstr "ShowBits не вернул файл."

#: showbits/includes/class-api-client.php showbits/includes/class-importer.php
msgid "ShowBits could not be reached."
msgstr "Не удалось связаться с ShowBits."

#. translators: 1: ShowBits' reason, 2: the HTTP status
#: showbits/includes/class-api-client.php
msgid "ShowBits refused (%1$s, HTTP %2$d)."
msgstr "ShowBits отклонил запрос (%1$s, HTTP %2$d)."

#: showbits/includes/class-connection.php
msgid "You may not connect this site."
msgstr "У вас нет прав на подключение этого сайта."

#. translators: %s: the clip's title
#: showbits/includes/class-importer.php
msgid "%s (thumbnail)"
msgstr "%s (миниатюра)"

#. translators: %s: a quote (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%s”"
msgstr "«%s»"

#. translators: 1: a quote, 2: who said it (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%1$s” – %2$s"
msgstr "«%1$s» — %2$s"

#: showbits/includes/class-importer.php
msgid "This is not a clip or a format ShowBits offers."
msgstr "Это не клип и не формат, который предлагает ShowBits."

#: showbits/includes/class-importer.php
msgid "The clip is no longer released in ShowBits."
msgstr "Клип больше не одобрен в ShowBits."

#: showbits/includes/class-importer.php
msgid "The embargo still holds: the file stays in ShowBits until it ends."
msgstr "Эмбарго ещё действует: файл остаётся в ShowBits до его окончания."

#: showbits/includes/class-importer.php
msgid "The file is not ready yet in ShowBits."
msgstr "Файл в ShowBits ещё не готов."

#: showbits/includes/class-importer.php
msgid "The file could not be downloaded."
msgstr "Не удалось скачать файл."

#: showbits/includes/class-importer.php
msgid "WordPress did not take the file into the media library."
msgstr "WordPress не принял файл в библиотеку файлов."

#: showbits/includes/class-importer.php
msgid "The delivery from ShowBits is no longer valid. Import the clip again."
msgstr "Доставка из ShowBits больше недействительна. Импортируйте клип ещё раз."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer accepts this site’s connection: connect it again under Settings → ShowBits."
msgstr "ShowBits больше не принимает подключение этого сайта: подключите его заново в разделе Настройки → ShowBits."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer delivers to this site: the workspace’s plan has ended."
msgstr "ShowBits больше ничего не доставляет на этот сайт: срок действия тарифа рабочего пространства истёк."

#: showbits/includes/class-importer.php
msgid "The site’s imports for today are used up. Try again tomorrow."
msgstr "Лимит импорта для этого сайта на сегодня исчерпан. Попробуйте ещё раз завтра."

#: showbits/includes/class-importer.php
msgid "The import was interrupted."
msgstr "Импорт был прерван."

#: showbits/includes/class-importer.php
msgid "The import failed."
msgstr "Импорт не удался."

#: showbits/includes/class-library-endpoint.php
msgid "This site is not connected to ShowBits."
msgstr "Этот сайт не подключён к ShowBits."

#: showbits/includes/class-library-page.php
msgid "All"
msgstr "Все"

#: showbits/includes/class-library-page.php
msgid "Clips"
msgstr "Клипы"

#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Quote cards"
msgstr "Карточки с цитатами"

#: showbits/includes/class-library-page.php
msgid "Search titles"
msgstr "Поиск по заголовкам"

#: showbits/includes/class-library-page.php
msgid "Search the library"
msgstr "Поиск в библиотеке"

#: showbits/includes/class-library-page.php
msgid "Import selected"
msgstr "Импортировать выбранные"

#. translators: 1: which one, 2: how many in all
#: showbits/includes/class-library-page.php
msgid "Asking ShowBits for %1$d of %2$d …"
msgstr "Запрос к ShowBits: %1$d из %2$d…"

#. translators: %d: how many clips are still on their way
#: showbits/includes/class-library-page.php
msgid "On the way from ShowBits: %d …"
msgstr "В пути из ShowBits: %d…"

#. translators: %d: how many clips were imported
#: showbits/includes/class-library-page.php
msgid "Imported: %d"
msgstr "Импортировано: %d"

#: showbits/includes/class-library-page.php
msgid "Not everything has arrived yet; it continues in the background. Settings → ShowBits lists the imports."
msgstr "Ещё не всё пришло; импорт продолжается в фоновом режиме. Список импортов — в разделе Настройки → ShowBits."

#: showbits/includes/class-library-page.php
msgid "On the way"
msgstr "В пути"

#: showbits/includes/class-library-page.php
msgid "Load more"
msgstr "Загрузить ещё"

#: showbits/includes/class-library-page.php
msgid "Loading …"
msgstr "Загрузка…"

#: showbits/includes/class-library-page.php
msgid "No released clips or quote cards yet."
msgstr "Одобренных клипов и карточек с цитатами пока нет."

#. translators: %s: date and time the embargo ends
#: showbits/includes/class-library-page.php
msgid "Embargo until %s"
msgstr "Эмбарго до %s"

#: showbits/includes/class-library-page.php
msgid "Not ready yet"
msgstr "Ещё не готово"

#: showbits/includes/class-library-page.php
msgid "In the media library"
msgstr "В библиотеке файлов"

#: showbits/includes/class-library-page.php
msgid "An older version is in the media library"
msgstr "В библиотеке файлов есть более старая версия"

#: showbits/includes/class-library-page.php
msgid "Edit"
msgstr "Изменить"

#: showbits/includes/class-library-page.php
msgid "Format"
msgstr "Формат"

#: showbits/includes/class-library-page.php
msgid "Video"
msgstr "Видео"

#: showbits/includes/class-library-page.php
msgid "Quote card"
msgstr "Карточка с цитатой"

#: showbits/includes/class-library-page.php
msgid "Meme"
msgstr "Мем"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "Failed: %s"
msgstr "Не удалось: %s"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "The library could not be loaded: %s"
msgstr "Не удалось загрузить библиотеку: %s"

#: showbits/includes/class-library-page.php
msgid "This site is not connected to ShowBits yet."
msgstr "Этот сайт ещё не подключён к ShowBits."

#: showbits/includes/class-library-page.php
msgid "Connect it in the settings."
msgstr "Подключите его в настройках."

#: showbits/includes/class-library-page.php
msgid "An administrator of this site connects it in the settings."
msgstr "Подключить его может администратор этого сайта в настройках."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-library-page.php
msgid "Released clips and quote cards from the ShowBits workspace “%s”. What you import lands in the media library, ready for posts and pages."
msgstr "Одобренные клипы и карточки с цитатами из рабочего пространства ShowBits «%s». Всё, что вы импортируете, попадает в библиотеку файлов и готово для записей и страниц."

#: showbits/includes/class-library-page.php
msgid "The library needs JavaScript."
msgstr "Для работы библиотеки нужен JavaScript."

#: showbits/includes/class-settings-page.php
msgid "Settings"
msgstr "Настройки"

#: showbits/includes/class-settings-page.php
msgid "You may not change these settings."
msgstr "У вас нет прав на изменение этих настроек."

#: showbits/includes/class-settings-page.php
msgid "Connection"
msgstr "Подключение"

#. translators: 1: the constant SHOWBITS_ENCRYPTION_KEY, 2: the file wp-config.php (both stay as they are)
#: showbits/includes/class-settings-page.php
msgid "Your site’s security keys are not in %2$s, so the key that protects the connection to ShowBits is stored in the database. Add %1$s with a long random value to %2$s; if the site is connected already, connect it again afterwards."
msgstr "Ключи безопасности вашего сайта не заданы в %2$s, поэтому ключ, защищающий подключение к ShowBits, хранится в базе данных. Добавьте %1$s с длинным случайным значением в %2$s; если сайт уже подключён, затем подключите его заново."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-settings-page.php
msgid "Connected to the workspace “%s”."
msgstr "Подключено к рабочему пространству «%s»."

#. translators: 1: imports today, 2: imports a day the plan allows
#: showbits/includes/class-settings-page.php
msgid "Imports today: %1$d of %2$d."
msgstr "Импортов сегодня: %1$d из %2$d."

#. translators: 1: a person, 2: a date, 3: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "Connected by %1$s on %2$s, at %3$s."
msgstr "Подключено к %3$s пользователем %1$s, %2$s."

#: showbits/includes/class-settings-page.php
msgid "Connect again"
msgstr "Повторное подключение"

#: showbits/includes/class-settings-page.php
msgid "With a new site key the site renews its connection, or moves to another workspace."
msgstr "Новый ключ сайта позволяет обновить подключение или перенести сайт в другое рабочее пространство."

#. translators: %s: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "ShowBits (%s) cannot be reached right now. The connection stays; try again later."
msgstr "ShowBits (%s) сейчас недоступен. Подключение сохраняется; попробуйте позже."

#: showbits/includes/class-settings-page.php
msgid "ShowBits no longer accepts this site’s connection: it was disconnected in ShowBits, the plan ended, or this site’s keys changed. Connect it again with a new site key."
msgstr "ShowBits больше не принимает подключение этого сайта: его отключили в ShowBits, срок действия тарифа истёк, или ключи этого сайта изменились. Подключите сайт заново с новым ключом сайта."

#: showbits/includes/class-settings-page.php
msgid "Connect this site to a ShowBits workspace: an admin or owner of the workspace makes a site key for this site in ShowBits (Integrations → WordPress). The site can then take released clips and quote cards into its media library, and receive what your ShowBits admins send."
msgstr "Подключите этот сайт к рабочему пространству ShowBits: администратор или владелец рабочего пространства создаёт в ShowBits ключ сайта для этого сайта (Integrations → WordPress). После этого сайт сможет забирать одобренные клипы и карточки с цитатами в свою библиотеку файлов и получать то, что отправляют ваши администраторы ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Imports"
msgstr "Импорт"

#: showbits/includes/class-settings-page.php
msgid "Format of quote cards"
msgstr "Формат карточек с цитатами"

#: showbits/includes/class-settings-page.php
msgid "4:5 (feeds, articles)"
msgstr "4:5 (ленты, статьи)"

#: showbits/includes/class-settings-page.php
msgid "1:1 (square)"
msgstr "1:1 (квадрат)"

#: showbits/includes/class-settings-page.php
msgid "9:16 (stories)"
msgstr "9:16 (истории)"

#: showbits/includes/class-settings-page.php
msgid "The picture pushes bring; in the library you choose for each card."
msgstr "Формат карточек, отправленных на сайт; в библиотеке вы выбираете его для каждой карточки отдельно."

#: showbits/includes/class-settings-page.php
msgid "Videos"
msgstr "Видео"

#: showbits/includes/class-settings-page.php
msgid "Import the thumbnail as the video’s poster image"
msgstr "Импортировать миниатюру как постер видео"

#: showbits/includes/class-settings-page.php
msgid "Save"
msgstr "Сохранить"

#: showbits/includes/class-settings-page.php
msgid "Site key"
msgstr "Ключ сайта"

#. translators: %s: this site's address
#: showbits/includes/class-settings-page.php
msgid "Made in ShowBits for %s, valid for 24 hours and only once. ShowBits then checks that it is talking to this site."
msgstr "Создаётся в ShowBits для %s; одноразовый, действует 24 часа. Затем ShowBits проверяет, что связывается именно с этим сайтом."

#: showbits/includes/class-settings-page.php
msgid "Connect"
msgstr "Подключить"

#: showbits/includes/class-settings-page.php
msgid "Are you an admin or owner of the workspace yourself? Then sign in to ShowBits and agree there, without a site key:"
msgstr "Вы сами администратор или владелец рабочего пространства? Тогда войдите в ShowBits и дайте согласие там, без ключа сайта:"

#: showbits/includes/class-settings-page.php
msgid "Connect through ShowBits"
msgstr "Подключить через ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits address"
msgstr "Адрес ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits Cloud: https://app.showbits.ai. OnPremise: the address of your installation."
msgstr "ShowBits Cloud: https://app.showbits.ai. OnPremise: адрес вашей установки."

#: showbits/includes/class-settings-page.php
msgid "Disconnect"
msgstr "Отключить"

#: showbits/includes/class-settings-page.php
msgid "Disconnect this site from ShowBits? What is in the media library stays."
msgstr "Отключить этот сайт от ShowBits? Всё, что есть в библиотеке файлов, останется."

#: showbits/includes/class-settings-page.php
msgid "asked for"
msgstr "Запрошено"

#: showbits/includes/class-settings-page.php
msgid "waiting"
msgstr "В очереди"

#: showbits/includes/class-settings-page.php
msgid "importing"
msgstr "Импортируется"

#: showbits/includes/class-settings-page.php
msgid "imported"
msgstr "Импортировано"

#: showbits/includes/class-settings-page.php
msgid "failed"
msgstr "Не удалось"

#: showbits/includes/class-settings-page.php
msgid "Recent imports"
msgstr "Последние импорты"

#: showbits/includes/class-settings-page.php
msgid "When"
msgstr "Дата"

#: showbits/includes/class-settings-page.php
msgid "Clip"
msgstr "Клип"

#: showbits/includes/class-settings-page.php
msgid "How"
msgstr "Способ"

#: showbits/includes/class-settings-page.php
msgid "State"
msgstr "Статус"

#: showbits/includes/class-settings-page.php
msgid "sent from ShowBits"
msgstr "Отправлено из ShowBits"

#: showbits/includes/class-settings-page.php
msgid "picked here"
msgstr "Выбрано здесь"

#: showbits/includes/class-settings-page.php
msgid "Connected. The library is under Media → ShowBits."
msgstr "Подключено. Библиотека находится в разделе Медиафайлы → ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Disconnected. What is in the media library stays."
msgstr "Отключено. Всё, что есть в библиотеке файлов, остаётся."

#: showbits/includes/class-settings-page.php
msgid "Saved."
msgstr "Сохранено."

#: showbits/includes/class-settings-page.php
msgid "Connecting was cancelled in ShowBits."
msgstr "Подключение отменено в ShowBits."

#: showbits/includes/class-settings-page.php
msgid "That way back from ShowBits did not belong to this attempt. Start again."
msgstr "Этот возврат из ShowBits не относится к данной попытке подключения. Начните заново."

#: showbits/includes/class-settings-page.php
msgid "The ShowBits address must start with https://."
msgstr "Адрес ShowBits должен начинаться с https://."

#: showbits/includes/class-settings-page.php
msgid "That is not a site key. Copy it from ShowBits (Integrations → WordPress) again."
msgstr "Это не ключ сайта. Скопируйте его ещё раз из ShowBits (Integrations → WordPress)."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not take the site key: it is unknown, used, withdrawn or expired (a site key lasts 24 hours, a consent ten minutes). Make a new one."
msgstr "ShowBits не принял ключ сайта: он неизвестен, уже использован, отозван или истёк (ключ сайта действует 24 часа, согласие — десять минут). Создайте новый."

#: showbits/includes/class-settings-page.php
msgid "The site key was made for another address. Make one for this site’s address."
msgstr "Ключ сайта был создан для другого адреса. Создайте ключ для адреса этого сайта."

#: showbits/includes/class-settings-page.php
msgid "ShowBits could not reach this site at its REST API (/wp-json/showbits/v1/push), or ShowBits itself could not be reached. The site must be public over HTTPS; a firewall or security plugin must let ShowBits in."
msgstr "ShowBits не смог связаться с этим сайтом через его REST API (/wp-json/showbits/v1/push), или недоступен сам ShowBits. Сайт должен быть публично доступен по HTTPS; брандмауэр или плагин безопасности должен пропускать ShowBits."

#: showbits/includes/class-settings-page.php
msgid "This site did not answer ShowBits’ check as expected. Try again; if it fails again, a cache or security plugin may answer for WordPress."
msgstr "Этот сайт ответил на проверку ShowBits не так, как ожидалось. Попробуйте ещё раз; если снова не получится, возможно, вместо WordPress отвечает плагин кеширования или безопасности."

#: showbits/includes/class-settings-page.php
msgid "The workspace’s plan has ended, or whoever made the site key may no longer connect sites."
msgstr "Срок действия тарифа рабочего пространства истёк, или тот, кто создал ключ сайта, больше не может подключать сайты."

#: showbits/includes/class-settings-page.php
msgid "The workspace has as many sites as its plan allows."
msgstr "В рабочем пространстве уже столько сайтов, сколько позволяет его тариф."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not accept this site’s address. It must be served over HTTPS."
msgstr "ShowBits не принял адрес этого сайта. Сайт должен работать по HTTPS."

#: showbits/includes/class-settings-page.php
msgid "Connecting did not work. Try again, or ask your ShowBits contact."
msgstr "Подключиться не удалось. Попробуйте ещё раз или обратитесь к своему контактному лицу в ShowBits."
