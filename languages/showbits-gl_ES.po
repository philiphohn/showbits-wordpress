# Galician translation of the ShowBits plugin.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: gl_ES\n"
"Plural-Forms: nplurals=2; plural=n != 1;\n"

#. Description of the plugin
#: showbits/showbits.php
msgid "Released clips and quote cards from ShowBits in the media library: pick them in WordPress, or receive what your ShowBits admins send."
msgstr "Clips e tarxetas con cita aprobados de ShowBits na biblioteca multimedia: escólleos en WordPress ou recibe o que envían os teus administradores de ShowBits."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer as expected."
msgstr "ShowBits non respondeu como se esperaba."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer with a file."
msgstr "ShowBits non devolveu ningún ficheiro."

#: showbits/includes/class-api-client.php showbits/includes/class-importer.php
msgid "ShowBits could not be reached."
msgstr "Non se puido contactar con ShowBits."

#. translators: 1: ShowBits' reason, 2: the HTTP status
#: showbits/includes/class-api-client.php
msgid "ShowBits refused (%1$s, HTTP %2$d)."
msgstr "ShowBits rexeitou a solicitude (%1$s, HTTP %2$d)."

#: showbits/includes/class-connection.php
msgid "You may not connect this site."
msgstr "Non tes permiso para conectar este sitio."

#. translators: %s: the clip's title
#: showbits/includes/class-importer.php
msgid "%s (thumbnail)"
msgstr "%s (miniatura)"

#. translators: %s: a quote (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%s”"
msgstr "«%s»"

#. translators: 1: a quote, 2: who said it (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%1$s” – %2$s"
msgstr "«%1$s» – %2$s"

#: showbits/includes/class-importer.php
msgid "This is not a clip or a format ShowBits offers."
msgstr "Isto non é un clip nin un formato que ofreza ShowBits."

#: showbits/includes/class-importer.php
msgid "The clip is no longer released in ShowBits."
msgstr "O clip xa non está aprobado en ShowBits."

#: showbits/includes/class-importer.php
msgid "The embargo still holds: the file stays in ShowBits until it ends."
msgstr "O embargo segue vixente: o ficheiro queda en ShowBits ata que remate."

#: showbits/includes/class-importer.php
msgid "The file is not ready yet in ShowBits."
msgstr "O ficheiro aínda non está listo en ShowBits."

#: showbits/includes/class-importer.php
msgid "The file could not be downloaded."
msgstr "Non se puido descargar o ficheiro."

#: showbits/includes/class-importer.php
msgid "WordPress did not take the file into the media library."
msgstr "WordPress non aceptou o ficheiro na biblioteca multimedia."

#: showbits/includes/class-importer.php
msgid "The delivery from ShowBits is no longer valid. Import the clip again."
msgstr "O envío de ShowBits xa non é válido. Importa o clip de novo."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer accepts this site’s connection: connect it again under Settings → ShowBits."
msgstr "ShowBits xa non acepta a conexión deste sitio: conéctao de novo en Axustes → ShowBits."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer delivers to this site: the workspace’s plan has ended."
msgstr "ShowBits xa non envía nada a este sitio: o plan do espazo de traballo rematou."

#: showbits/includes/class-importer.php
msgid "The site’s imports for today are used up. Try again tomorrow."
msgstr "Esgotáronse as importacións de hoxe deste sitio. Téntao de novo mañá."

#: showbits/includes/class-importer.php
msgid "The import was interrupted."
msgstr "A importación interrompeuse."

#: showbits/includes/class-importer.php
msgid "The import failed."
msgstr "A importación fallou."

#: showbits/includes/class-library-endpoint.php
msgid "This site is not connected to ShowBits."
msgstr "Este sitio non está conectado a ShowBits."

#: showbits/includes/class-library-page.php
msgid "All"
msgstr "Todos"

#: showbits/includes/class-library-page.php
msgid "Clips"
msgstr "Clips"

#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Quote cards"
msgstr "Tarxetas con cita"

#: showbits/includes/class-library-page.php
msgid "Search titles"
msgstr "Buscar nos títulos"

#: showbits/includes/class-library-page.php
msgid "Search the library"
msgstr "Buscar na biblioteca"

#: showbits/includes/class-library-page.php
msgid "Import selected"
msgstr "Importar a selección"

#. translators: 1: which one, 2: how many in all
#: showbits/includes/class-library-page.php
msgid "Asking ShowBits for %1$d of %2$d …"
msgstr "Solicitando a ShowBits: %1$d de %2$d…"

#. translators: %d: how many clips are still on their way
#: showbits/includes/class-library-page.php
msgid "On the way from ShowBits: %d …"
msgstr "De camiño desde ShowBits: %d…"

#. translators: %d: how many clips were imported
#: showbits/includes/class-library-page.php
msgid "Imported: %d"
msgstr "Importados: %d"

#: showbits/includes/class-library-page.php
msgid "Not everything has arrived yet; it continues in the background. Settings → ShowBits lists the imports."
msgstr "Aínda non chegou todo; a importación continúa en segundo plano. En Axustes → ShowBits podes ver as importacións."

#: showbits/includes/class-library-page.php
msgid "On the way"
msgstr "De camiño"

#: showbits/includes/class-library-page.php
msgid "Load more"
msgstr "Cargar máis"

#: showbits/includes/class-library-page.php
msgid "Loading …"
msgstr "Cargando…"

#: showbits/includes/class-library-page.php
msgid "No released clips or quote cards yet."
msgstr "Aínda non hai clips nin tarxetas con cita aprobados."

#. translators: %s: date and time the embargo ends
#: showbits/includes/class-library-page.php
msgid "Embargo until %s"
msgstr "Embargo ata o %s"

#: showbits/includes/class-library-page.php
msgid "Not ready yet"
msgstr "Aínda non está listo"

#: showbits/includes/class-library-page.php
msgid "In the media library"
msgstr "Na biblioteca multimedia"

#: showbits/includes/class-library-page.php
msgid "An older version is in the media library"
msgstr "Hai unha versión anterior na biblioteca multimedia"

#: showbits/includes/class-library-page.php
msgid "Edit"
msgstr "Editar"

#: showbits/includes/class-library-page.php
msgid "Format"
msgstr "Formato"

#. translators: %s: a quote card's format, such as 9:16 or "9:16 (stories)" (its animated video with the speaker's voice)
#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Animated %s"
msgstr "Animada %s"

#: showbits/includes/class-library-page.php
msgid "Video"
msgstr "Vídeo"

#: showbits/includes/class-library-page.php
msgid "Quote card"
msgstr "Tarxeta con cita"

#: showbits/includes/class-library-page.php
msgid "Meme"
msgstr "Meme"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "Failed: %s"
msgstr "Fallou: %s"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "The library could not be loaded: %s"
msgstr "Non se puido cargar a biblioteca: %s"

#: showbits/includes/class-library-page.php
msgid "This site is not connected to ShowBits yet."
msgstr "Este sitio aínda non está conectado a ShowBits."

#: showbits/includes/class-library-page.php
msgid "Connect it in the settings."
msgstr "Conéctao nos axustes."

#: showbits/includes/class-library-page.php
msgid "An administrator of this site connects it in the settings."
msgstr "Un administrador deste sitio ten que conectalo nos axustes."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-library-page.php
msgid "Released clips and quote cards from the ShowBits workspace “%s”. What you import lands in the media library, ready for posts and pages."
msgstr "Clips e tarxetas con cita aprobados do espazo de traballo de ShowBits «%s». O que importes vai parar á biblioteca multimedia, listo para entradas e páxinas."

#: showbits/includes/class-library-page.php
msgid "The library needs JavaScript."
msgstr "A biblioteca necesita JavaScript."

#: showbits/includes/class-settings-page.php
msgid "Settings"
msgstr "Axustes"

#: showbits/includes/class-settings-page.php
msgid "You may not change these settings."
msgstr "Non tes permiso para cambiar estes axustes."

#: showbits/includes/class-settings-page.php
msgid "Connection"
msgstr "Conexión"

#. translators: 1: the constant SHOWBITS_ENCRYPTION_KEY, 2: the file wp-config.php (both stay as they are)
#: showbits/includes/class-settings-page.php
msgid "Your site’s security keys are not in %2$s, so the key that protects the connection to ShowBits is stored in the database. Add %1$s with a long random value to %2$s; if the site is connected already, connect it again afterwards."
msgstr "As claves de seguranza do teu sitio non están en %2$s, polo que a clave que protexe a conexión con ShowBits gárdase na base de datos. Engade %1$s cun valor aleatorio longo a %2$s; se o sitio xa está conectado, conéctao de novo despois."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-settings-page.php
msgid "Connected to the workspace “%s”."
msgstr "Conectado ao espazo de traballo «%s»."

#. translators: 1: imports today, 2: imports a day the plan allows
#: showbits/includes/class-settings-page.php
msgid "Imports today: %1$d of %2$d."
msgstr "Importacións de hoxe: %1$d de %2$d."

#. translators: 1: a person, 2: a date, 3: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "Connected by %1$s on %2$s, at %3$s."
msgstr "Conectado por %1$s o %2$s, no enderezo %3$s."

#: showbits/includes/class-settings-page.php
msgid "Connect again"
msgstr "Conectar de novo"

#: showbits/includes/class-settings-page.php
msgid "With a new site key the site renews its connection, or moves to another workspace."
msgstr "Cunha nova clave do sitio, o sitio renova a súa conexión ou pasa a outro espazo de traballo."

#. translators: %s: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "ShowBits (%s) cannot be reached right now. The connection stays; try again later."
msgstr "ShowBits (%s) non está accesible neste momento. A conexión mantense; téntao de novo máis tarde."

#: showbits/includes/class-settings-page.php
msgid "ShowBits no longer accepts this site’s connection: it was disconnected in ShowBits, the plan ended, or this site’s keys changed. Connect it again with a new site key."
msgstr "ShowBits xa non acepta a conexión deste sitio: desconectouse en ShowBits, o plan rematou ou cambiaron as claves deste sitio. Conéctao de novo cunha nova clave do sitio."

#: showbits/includes/class-settings-page.php
msgid "Connect this site to a ShowBits workspace: an admin or owner of the workspace makes a site key for this site in ShowBits (Integrations → WordPress). The site can then take released clips and quote cards into its media library, and receive what your ShowBits admins send."
msgstr "Conecta este sitio a un espazo de traballo de ShowBits: un administrador ou propietario do espazo de traballo crea en ShowBits unha clave do sitio para este sitio (Integrations → WordPress). Despois, o sitio poderá incorporar á súa biblioteca multimedia clips e tarxetas con cita aprobados, e recibir o que envían os teus administradores de ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Imports"
msgstr "Importacións"

#: showbits/includes/class-settings-page.php
msgid "Format of quote cards"
msgstr "Formato das tarxetas con cita"

#: showbits/includes/class-settings-page.php
msgid "4:5 (feeds, articles)"
msgstr "4:5 (publicacións, artigos)"

#: showbits/includes/class-settings-page.php
msgid "1:1 (square)"
msgstr "1:1 (cadrado)"

#: showbits/includes/class-settings-page.php
msgid "9:16 (stories)"
msgstr "9:16 (historias)"

#: showbits/includes/class-settings-page.php
msgid "The picture pushes bring; in the library you choose for each card."
msgstr "O formato das tarxetas enviadas a este sitio; na biblioteca escóllelo para cada tarxeta."

#: showbits/includes/class-settings-page.php
msgid "Videos"
msgstr "Vídeos"

#: showbits/includes/class-settings-page.php
msgid "Import the thumbnail as the video’s poster image"
msgstr "Importar a miniatura como imaxe de póster do vídeo"

#: showbits/includes/class-settings-page.php
msgid "Save"
msgstr "Gardar"

#: showbits/includes/class-settings-page.php
msgid "Site key"
msgstr "Clave do sitio"

#. translators: %s: this site's address
#: showbits/includes/class-settings-page.php
msgid "Made in ShowBits for %s, valid for 24 hours and only once. ShowBits then checks that it is talking to this site."
msgstr "Creada en ShowBits para %s, válida durante 24 horas e unha soa vez. Despois, ShowBits comproba que está a falar con este sitio."

#: showbits/includes/class-settings-page.php
msgid "Connect"
msgstr "Conectar"

#: showbits/includes/class-settings-page.php
msgid "Are you an admin or owner of the workspace yourself? Then sign in to ShowBits and agree there, without a site key:"
msgstr "Es ti administrador ou propietario do espazo de traballo? Entón inicia sesión en ShowBits e dá alí o teu consentimento, sen clave do sitio:"

#: showbits/includes/class-settings-page.php
msgid "Connect through ShowBits"
msgstr "Conectar a través de ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits address"
msgstr "Enderezo de ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits Cloud: https://app.showbits.ai. OnPremise: the address of your installation."
msgstr "ShowBits Cloud: https://app.showbits.ai. OnPremise: o enderezo da túa instalación."

#: showbits/includes/class-settings-page.php
msgid "Disconnect"
msgstr "Desconectar"

#: showbits/includes/class-settings-page.php
msgid "Disconnect this site from ShowBits? What is in the media library stays."
msgstr "Queres desconectar este sitio de ShowBits? O que hai na biblioteca multimedia queda alí."

#: showbits/includes/class-settings-page.php
msgid "asked for"
msgstr "Solicitado"

#: showbits/includes/class-settings-page.php
msgid "waiting"
msgstr "En espera"

#: showbits/includes/class-settings-page.php
msgid "importing"
msgstr "Importando"

#: showbits/includes/class-settings-page.php
msgid "imported"
msgstr "Importado"

#: showbits/includes/class-settings-page.php
msgid "failed"
msgstr "Fallou"

#: showbits/includes/class-settings-page.php
msgid "Recent imports"
msgstr "Importacións recentes"

#: showbits/includes/class-settings-page.php
msgid "When"
msgstr "Data"

#: showbits/includes/class-settings-page.php
msgid "Clip"
msgstr "Clip"

#: showbits/includes/class-settings-page.php
msgid "How"
msgstr "Orixe"

#: showbits/includes/class-settings-page.php
msgid "State"
msgstr "Estado"

#: showbits/includes/class-settings-page.php
msgid "sent from ShowBits"
msgstr "Enviado desde ShowBits"

#: showbits/includes/class-settings-page.php
msgid "picked here"
msgstr "Escollido aquí"

#: showbits/includes/class-settings-page.php
msgid "Connected. The library is under Media → ShowBits."
msgstr "Conectado. A biblioteca está en Multimedia → ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Disconnected. What is in the media library stays."
msgstr "Desconectado. O que hai na biblioteca multimedia queda alí."

#: showbits/includes/class-settings-page.php
msgid "Saved."
msgstr "Gardáronse os axustes."

#: showbits/includes/class-settings-page.php
msgid "Connecting was cancelled in ShowBits."
msgstr "Cancelouse a conexión en ShowBits."

#: showbits/includes/class-settings-page.php
msgid "That way back from ShowBits did not belong to this attempt. Start again."
msgstr "Este regreso desde ShowBits non corresponde ao intento de conexión que iniciou este sitio. Comeza de novo."

#: showbits/includes/class-settings-page.php
msgid "The ShowBits address must start with https://."
msgstr "O enderezo de ShowBits debe comezar por https://."

#: showbits/includes/class-settings-page.php
msgid "That is not a site key. Copy it from ShowBits (Integrations → WordPress) again."
msgstr "Isto non é unha clave do sitio. Cópiaa de novo desde ShowBits (Integrations → WordPress)."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not take the site key: it is unknown, used, withdrawn or expired (a site key lasts 24 hours, a consent ten minutes). Make a new one."
msgstr "ShowBits non aceptou a clave do sitio: é descoñecida, xa se usou, foi retirada ou caducou (unha clave do sitio dura 24 horas; un consentimento, dez minutos). Crea unha nova."

#: showbits/includes/class-settings-page.php
msgid "The site key was made for another address. Make one for this site’s address."
msgstr "A clave do sitio creouse para outro enderezo. Crea unha para o enderezo deste sitio."

#: showbits/includes/class-settings-page.php
msgid "ShowBits could not reach this site at its REST API (/wp-json/showbits/v1/push), or ShowBits itself could not be reached. The site must be public over HTTPS; a firewall or security plugin must let ShowBits in."
msgstr "ShowBits non puido acceder a este sitio a través da súa API REST (/wp-json/showbits/v1/push), ou non se puido contactar co propio ShowBits. O sitio debe ser accesible publicamente a través de HTTPS; unha devasa ou un plugin de seguranza debe deixar pasar ShowBits."

#: showbits/includes/class-settings-page.php
msgid "This site did not answer ShowBits’ check as expected. Try again; if it fails again, a cache or security plugin may answer for WordPress."
msgstr "Este sitio non respondeu como se esperaba á comprobación de ShowBits. Téntao de novo; se volve fallar, quizais un plugin de caché ou de seguranza estea a responder no canto de WordPress."

#: showbits/includes/class-settings-page.php
msgid "The workspace’s plan has ended, or whoever made the site key may no longer connect sites."
msgstr "O plan do espazo de traballo rematou, ou quen creou a clave do sitio xa non pode conectar sitios."

#: showbits/includes/class-settings-page.php
msgid "The workspace has as many sites as its plan allows."
msgstr "O espazo de traballo xa ten tantos sitios como permite o seu plan."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not accept this site’s address. It must be served over HTTPS."
msgstr "ShowBits non aceptou o enderezo deste sitio. O sitio debe servirse a través de HTTPS."

#: showbits/includes/class-settings-page.php
msgid "Connecting did not work. Try again, or ask your ShowBits contact."
msgstr "A conexión non funcionou. Téntao de novo ou pregúntalle á túa persoa de contacto de ShowBits."
