# Vietnamese translation of the ShowBits plugin.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: vi\n"
"Plural-Forms: nplurals=1; plural=0;\n"

#. Description of the plugin
#: showbits/showbits.php
msgid "Released clips and quote cards from ShowBits in the media library: pick them in WordPress, or receive what your ShowBits admins send."
msgstr "Clip và thẻ trích dẫn đã duyệt từ ShowBits ngay trong thư viện Media: chọn chúng trong WordPress, hoặc nhận những gì quản trị viên ShowBits của bạn gửi đến."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer as expected."
msgstr "ShowBits không phản hồi như mong đợi."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer with a file."
msgstr "ShowBits không trả về tập tin."

#: showbits/includes/class-api-client.php showbits/includes/class-importer.php
msgid "ShowBits could not be reached."
msgstr "Không thể truy cập ShowBits."

#. translators: 1: ShowBits' reason, 2: the HTTP status
#: showbits/includes/class-api-client.php
msgid "ShowBits refused (%1$s, HTTP %2$d)."
msgstr "ShowBits đã từ chối (%1$s, HTTP %2$d)."

#: showbits/includes/class-connection.php
msgid "You may not connect this site."
msgstr "Bạn không có quyền kết nối trang web này."

#. translators: %s: the clip's title
#: showbits/includes/class-importer.php
msgid "%s (thumbnail)"
msgstr "%s (ảnh thu nhỏ)"

#. translators: %s: a quote (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%s”"
msgstr "“%s”"

#. translators: 1: a quote, 2: who said it (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%1$s” – %2$s"
msgstr "“%1$s” – %2$s"

#: showbits/includes/class-importer.php
msgid "This is not a clip or a format ShowBits offers."
msgstr "Đây không phải là clip hoặc định dạng mà ShowBits cung cấp."

#: showbits/includes/class-importer.php
msgid "The clip is no longer released in ShowBits."
msgstr "Clip này không còn được duyệt trong ShowBits."

#: showbits/includes/class-importer.php
msgid "The embargo still holds: the file stays in ShowBits until it ends."
msgstr "Lệnh cấm công bố vẫn còn hiệu lực: tập tin sẽ ở lại ShowBits cho đến khi lệnh này kết thúc."

#: showbits/includes/class-importer.php
msgid "The file is not ready yet in ShowBits."
msgstr "Tập tin trong ShowBits chưa sẵn sàng."

#: showbits/includes/class-importer.php
msgid "The file could not be downloaded."
msgstr "Không thể tải tập tin xuống."

#: showbits/includes/class-importer.php
msgid "WordPress did not take the file into the media library."
msgstr "WordPress không nhận tập tin vào thư viện Media."

#: showbits/includes/class-importer.php
msgid "The delivery from ShowBits is no longer valid. Import the clip again."
msgstr "Lượt gửi từ ShowBits không còn hợp lệ. Hãy nhập lại clip."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer accepts this site’s connection: connect it again under Settings → ShowBits."
msgstr "ShowBits không còn chấp nhận kết nối của trang web này: hãy kết nối lại trong Cài đặt → ShowBits."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer delivers to this site: the workspace’s plan has ended."
msgstr "ShowBits không còn gửi gì đến trang web này: gói dịch vụ của không gian làm việc đã kết thúc."

#: showbits/includes/class-importer.php
msgid "The site’s imports for today are used up. Try again tomorrow."
msgstr "Trang web đã dùng hết lượt nhập của hôm nay. Hãy thử lại vào ngày mai."

#: showbits/includes/class-importer.php
msgid "The import was interrupted."
msgstr "Quá trình nhập đã bị gián đoạn."

#: showbits/includes/class-importer.php
msgid "The import failed."
msgstr "Quá trình nhập thất bại."

#: showbits/includes/class-library-endpoint.php
msgid "This site is not connected to ShowBits."
msgstr "Trang web này không có kết nối với ShowBits."

#: showbits/includes/class-library-page.php
msgid "All"
msgstr "Tất cả"

#: showbits/includes/class-library-page.php
msgid "Clips"
msgstr "Clip"

#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Quote cards"
msgstr "Thẻ trích dẫn"

#: showbits/includes/class-library-page.php
msgid "Search titles"
msgstr "Tìm theo tiêu đề"

#: showbits/includes/class-library-page.php
msgid "Search the library"
msgstr "Tìm kiếm trong thư viện"

#: showbits/includes/class-library-page.php
msgid "Import selected"
msgstr "Nhập mục đã chọn"

#. translators: 1: which one, 2: how many in all
#: showbits/includes/class-library-page.php
msgid "Asking ShowBits for %1$d of %2$d …"
msgstr "Đang gửi yêu cầu tới ShowBits: %1$d trên %2$d…"

#. translators: %d: how many clips are still on their way
#: showbits/includes/class-library-page.php
msgid "On the way from ShowBits: %d …"
msgstr "Đang chuyển đến từ ShowBits: %d…"

#. translators: %d: how many clips were imported
#: showbits/includes/class-library-page.php
msgid "Imported: %d"
msgstr "Đã nhập: %d"

#: showbits/includes/class-library-page.php
msgid "Not everything has arrived yet; it continues in the background. Settings → ShowBits lists the imports."
msgstr "Một số mục chưa đến; quá trình nhập vẫn tiếp tục chạy nền. Xem các lượt nhập trong Cài đặt → ShowBits."

#: showbits/includes/class-library-page.php
msgid "On the way"
msgstr "Đang chuyển đến"

#: showbits/includes/class-library-page.php
msgid "Load more"
msgstr "Tải thêm"

#: showbits/includes/class-library-page.php
msgid "Loading …"
msgstr "Đang tải…"

#: showbits/includes/class-library-page.php
msgid "No released clips or quote cards yet."
msgstr "Chưa có clip hay thẻ trích dẫn nào được duyệt."

#. translators: %s: date and time the embargo ends
#: showbits/includes/class-library-page.php
msgid "Embargo until %s"
msgstr "Cấm công bố đến %s"

#: showbits/includes/class-library-page.php
msgid "Not ready yet"
msgstr "Chưa sẵn sàng"

#: showbits/includes/class-library-page.php
msgid "In the media library"
msgstr "Đã có trong thư viện Media"

#: showbits/includes/class-library-page.php
msgid "An older version is in the media library"
msgstr "Thư viện Media đang có phiên bản cũ hơn"

#: showbits/includes/class-library-page.php
msgid "Edit"
msgstr "Chỉnh sửa"

#: showbits/includes/class-library-page.php
msgid "Format"
msgstr "Định dạng"

#: showbits/includes/class-library-page.php
msgid "Video"
msgstr "Video"

#: showbits/includes/class-library-page.php
msgid "Quote card"
msgstr "Thẻ trích dẫn"

#: showbits/includes/class-library-page.php
msgid "Meme"
msgstr "Meme"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "Failed: %s"
msgstr "Thất bại: %s"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "The library could not be loaded: %s"
msgstr "Không thể tải thư viện: %s"

#: showbits/includes/class-library-page.php
msgid "This site is not connected to ShowBits yet."
msgstr "Trang web này chưa được kết nối với ShowBits."

#: showbits/includes/class-library-page.php
msgid "Connect it in the settings."
msgstr "Kết nối trang web trong phần cài đặt."

#: showbits/includes/class-library-page.php
msgid "An administrator of this site connects it in the settings."
msgstr "Quản trị viên của trang web này cần thực hiện kết nối trong phần cài đặt."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-library-page.php
msgid "Released clips and quote cards from the ShowBits workspace “%s”. What you import lands in the media library, ready for posts and pages."
msgstr "Clip và thẻ trích dẫn đã duyệt từ không gian làm việc ShowBits “%s”. Những gì bạn nhập sẽ nằm trong thư viện Media, sẵn sàng để dùng cho bài viết và trang."

#: showbits/includes/class-library-page.php
msgid "The library needs JavaScript."
msgstr "Thư viện cần JavaScript để hoạt động."

#: showbits/includes/class-settings-page.php
msgid "Settings"
msgstr "Cài đặt"

#: showbits/includes/class-settings-page.php
msgid "You may not change these settings."
msgstr "Bạn không có quyền thay đổi các cài đặt này."

#: showbits/includes/class-settings-page.php
msgid "Connection"
msgstr "Kết nối"

#. translators: 1: the constant SHOWBITS_ENCRYPTION_KEY, 2: the file wp-config.php (both stay as they are)
#: showbits/includes/class-settings-page.php
msgid "Your site’s security keys are not in %2$s, so the key that protects the connection to ShowBits is stored in the database. Add %1$s with a long random value to %2$s; if the site is connected already, connect it again afterwards."
msgstr "Các khóa bảo mật của trang web không nằm trong %2$s, vì vậy khóa bảo vệ kết nối với ShowBits được lưu trong cơ sở dữ liệu. Hãy thêm %1$s với một giá trị ngẫu nhiên dài vào %2$s; nếu trang web đã được kết nối, hãy kết nối lại sau đó."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-settings-page.php
msgid "Connected to the workspace “%s”."
msgstr "Đã kết nối với không gian làm việc “%s”."

#. translators: 1: imports today, 2: imports a day the plan allows
#: showbits/includes/class-settings-page.php
msgid "Imports today: %1$d of %2$d."
msgstr "Lượt nhập hôm nay: %1$d trên %2$d."

#. translators: 1: a person, 2: a date, 3: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "Connected by %1$s on %2$s, at %3$s."
msgstr "Do %1$s kết nối vào %2$s, tới %3$s."

#: showbits/includes/class-settings-page.php
msgid "Connect again"
msgstr "Kết nối lại"

#: showbits/includes/class-settings-page.php
msgid "With a new site key the site renews its connection, or moves to another workspace."
msgstr "Với một khóa trang web mới, trang web sẽ làm mới kết nối hoặc chuyển sang không gian làm việc khác."

#. translators: %s: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "ShowBits (%s) cannot be reached right now. The connection stays; try again later."
msgstr "Hiện không thể truy cập ShowBits (%s). Kết nối vẫn được giữ; hãy thử lại sau."

#: showbits/includes/class-settings-page.php
msgid "ShowBits no longer accepts this site’s connection: it was disconnected in ShowBits, the plan ended, or this site’s keys changed. Connect it again with a new site key."
msgstr "ShowBits không còn chấp nhận kết nối của trang web này: kết nối đã bị ngắt trong ShowBits, gói dịch vụ đã kết thúc, hoặc các khóa của trang web này đã thay đổi. Hãy kết nối lại bằng một khóa trang web mới."

#: showbits/includes/class-settings-page.php
msgid "Connect this site to a ShowBits workspace: an admin or owner of the workspace makes a site key for this site in ShowBits (Integrations → WordPress). The site can then take released clips and quote cards into its media library, and receive what your ShowBits admins send."
msgstr "Kết nối trang web này với một không gian làm việc ShowBits: quản trị viên hoặc chủ sở hữu của không gian làm việc tạo một khóa trang web dành cho trang web này trong ShowBits (Integrations → WordPress). Sau đó, trang web có thể đưa clip và thẻ trích dẫn đã duyệt vào thư viện Media của mình, và nhận những gì quản trị viên ShowBits của bạn gửi đến."

#: showbits/includes/class-settings-page.php
msgid "Imports"
msgstr "Nhập"

#: showbits/includes/class-settings-page.php
msgid "Format of quote cards"
msgstr "Định dạng thẻ trích dẫn"

#: showbits/includes/class-settings-page.php
msgid "4:5 (feeds, articles)"
msgstr "4:5 (feed, bài viết)"

#: showbits/includes/class-settings-page.php
msgid "1:1 (square)"
msgstr "1:1 (vuông)"

#: showbits/includes/class-settings-page.php
msgid "9:16 (stories)"
msgstr "9:16 (story)"

#: showbits/includes/class-settings-page.php
msgid "The picture pushes bring; in the library you choose for each card."
msgstr "Định dạng ảnh mà các mục được gửi đến sẽ mang theo; trong thư viện, bạn chọn riêng cho từng thẻ."

#: showbits/includes/class-settings-page.php
msgid "Videos"
msgstr "Video"

#: showbits/includes/class-settings-page.php
msgid "Import the thumbnail as the video’s poster image"
msgstr "Nhập ảnh thu nhỏ làm ảnh poster của video"

#: showbits/includes/class-settings-page.php
msgid "Save"
msgstr "Lưu"

#: showbits/includes/class-settings-page.php
msgid "Site key"
msgstr "Khóa trang web"

#. translators: %s: this site's address
#: showbits/includes/class-settings-page.php
msgid "Made in ShowBits for %s, valid for 24 hours and only once. ShowBits then checks that it is talking to this site."
msgstr "Được tạo trong ShowBits cho %s, có hiệu lực trong 24 giờ và chỉ dùng được một lần. Sau đó, ShowBits sẽ kiểm tra để chắc chắn đang giao tiếp đúng với trang web này."

#: showbits/includes/class-settings-page.php
msgid "Connect"
msgstr "Kết nối"

#: showbits/includes/class-settings-page.php
msgid "Are you an admin or owner of the workspace yourself? Then sign in to ShowBits and agree there, without a site key:"
msgstr "Bạn có phải là quản trị viên hoặc chủ sở hữu của không gian làm việc không? Nếu đúng vậy, hãy đăng nhập vào ShowBits và đồng ý tại đó, không cần khóa trang web:"

#: showbits/includes/class-settings-page.php
msgid "Connect through ShowBits"
msgstr "Kết nối qua ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits address"
msgstr "Địa chỉ ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits Cloud: https://app.showbits.ai. OnPremise: the address of your installation."
msgstr "ShowBits Cloud: https://app.showbits.ai. OnPremise: địa chỉ bản cài đặt của bạn."

#: showbits/includes/class-settings-page.php
msgid "Disconnect"
msgstr "Ngắt kết nối"

#: showbits/includes/class-settings-page.php
msgid "Disconnect this site from ShowBits? What is in the media library stays."
msgstr "Bạn có muốn ngắt kết nối trang web này khỏi ShowBits không? Những gì đã có trong thư viện Media vẫn được giữ nguyên."

#: showbits/includes/class-settings-page.php
msgid "asked for"
msgstr "Đã yêu cầu"

#: showbits/includes/class-settings-page.php
msgid "waiting"
msgstr "Đang chờ"

#: showbits/includes/class-settings-page.php
msgid "importing"
msgstr "Đang nhập"

#: showbits/includes/class-settings-page.php
msgid "imported"
msgstr "Đã nhập"

#: showbits/includes/class-settings-page.php
msgid "failed"
msgstr "Thất bại"

#: showbits/includes/class-settings-page.php
msgid "Recent imports"
msgstr "Lượt nhập gần đây"

#: showbits/includes/class-settings-page.php
msgid "When"
msgstr "Thời gian"

#: showbits/includes/class-settings-page.php
msgid "Clip"
msgstr "Clip"

#: showbits/includes/class-settings-page.php
msgid "How"
msgstr "Cách nhận"

#: showbits/includes/class-settings-page.php
msgid "State"
msgstr "Trạng thái"

#: showbits/includes/class-settings-page.php
msgid "sent from ShowBits"
msgstr "Gửi từ ShowBits"

#: showbits/includes/class-settings-page.php
msgid "picked here"
msgstr "Chọn tại đây"

#: showbits/includes/class-settings-page.php
msgid "Connected. The library is under Media → ShowBits."
msgstr "Đã kết nối. Thư viện nằm trong Media → ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Disconnected. What is in the media library stays."
msgstr "Đã ngắt kết nối. Những gì đã có trong thư viện Media vẫn được giữ nguyên."

#: showbits/includes/class-settings-page.php
msgid "Saved."
msgstr "Đã lưu."

#: showbits/includes/class-settings-page.php
msgid "Connecting was cancelled in ShowBits."
msgstr "Việc kết nối đã bị hủy trong ShowBits."

#: showbits/includes/class-settings-page.php
msgid "That way back from ShowBits did not belong to this attempt. Start again."
msgstr "Lượt quay lại từ ShowBits không thuộc về lần kết nối mà trang web này đã khởi tạo. Hãy bắt đầu lại."

#: showbits/includes/class-settings-page.php
msgid "The ShowBits address must start with https://."
msgstr "Địa chỉ ShowBits phải bắt đầu bằng https://."

#: showbits/includes/class-settings-page.php
msgid "That is not a site key. Copy it from ShowBits (Integrations → WordPress) again."
msgstr "Đây không phải là khóa trang web. Hãy sao chép lại từ ShowBits (Integrations → WordPress)."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not take the site key: it is unknown, used, withdrawn or expired (a site key lasts 24 hours, a consent ten minutes). Make a new one."
msgstr "ShowBits không chấp nhận khóa trang web: khóa không xác định, đã được dùng, đã bị thu hồi hoặc đã hết hạn (khóa trang web có hiệu lực 24 giờ, sự đồng ý có hiệu lực mười phút). Hãy tạo khóa mới."

#: showbits/includes/class-settings-page.php
msgid "The site key was made for another address. Make one for this site’s address."
msgstr "Khóa trang web này được tạo cho một địa chỉ khác. Hãy tạo khóa cho địa chỉ của trang web này."

#: showbits/includes/class-settings-page.php
msgid "ShowBits could not reach this site at its REST API (/wp-json/showbits/v1/push), or ShowBits itself could not be reached. The site must be public over HTTPS; a firewall or security plugin must let ShowBits in."
msgstr "ShowBits không thể truy cập REST API của trang web này (/wp-json/showbits/v1/push), hoặc chính ShowBits không thể truy cập được. Trang web phải công khai qua HTTPS; tường lửa hoặc plugin bảo mật phải cho phép ShowBits truy cập."

#: showbits/includes/class-settings-page.php
msgid "This site did not answer ShowBits’ check as expected. Try again; if it fails again, a cache or security plugin may answer for WordPress."
msgstr "Trang web này không trả lời bước kiểm tra của ShowBits như mong đợi. Hãy thử lại; nếu vẫn thất bại, có thể một plugin bộ nhớ đệm hoặc plugin bảo mật đang trả lời thay cho WordPress."

#: showbits/includes/class-settings-page.php
msgid "The workspace’s plan has ended, or whoever made the site key may no longer connect sites."
msgstr "Gói dịch vụ của không gian làm việc đã kết thúc, hoặc người đã tạo khóa trang web không còn quyền kết nối trang web nữa."

#: showbits/includes/class-settings-page.php
msgid "The workspace has as many sites as its plan allows."
msgstr "Không gian làm việc đã có số trang web tối đa mà gói dịch vụ cho phép."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not accept this site’s address. It must be served over HTTPS."
msgstr "ShowBits không chấp nhận địa chỉ của trang web này. Trang web phải dùng HTTPS."

#: showbits/includes/class-settings-page.php
msgid "Connecting did not work. Try again, or ask your ShowBits contact."
msgstr "Kết nối không thành công. Hãy thử lại hoặc hỏi người liên hệ của bạn tại ShowBits."
