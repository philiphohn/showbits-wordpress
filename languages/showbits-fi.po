# Finnish translation of the ShowBits plugin.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: fi\n"
"Plural-Forms: nplurals=2; plural=n != 1;\n"

#. Description of the plugin
#: showbits/showbits.php
msgid "Released clips and quote cards from ShowBits in the media library: pick them in WordPress, or receive what your ShowBits admins send."
msgstr "ShowBitsissä julkaisuun hyväksytyt klipit ja lainauskortit mediakirjastoon: valitse ne WordPressissä tai ota vastaan, mitä ShowBits-ylläpitäjäsi lähettävät."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer as expected."
msgstr "ShowBits ei vastannut odotetulla tavalla."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer with a file."
msgstr "ShowBits ei toimittanut tiedostoa."

#: showbits/includes/class-api-client.php showbits/includes/class-importer.php
msgid "ShowBits could not be reached."
msgstr "ShowBitsiin ei saatu yhteyttä."

#. translators: 1: ShowBits' reason, 2: the HTTP status
#: showbits/includes/class-api-client.php
msgid "ShowBits refused (%1$s, HTTP %2$d)."
msgstr "ShowBits hylkäsi pyynnön (%1$s, HTTP %2$d)."

#: showbits/includes/class-connection.php
msgid "You may not connect this site."
msgstr "Sinulla ei ole oikeutta yhdistää tätä sivustoa."

#. translators: %s: the clip's title
#: showbits/includes/class-importer.php
msgid "%s (thumbnail)"
msgstr "%s (pienoiskuva)"

#. translators: %s: a quote (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%s”"
msgstr "”%s”"

#. translators: 1: a quote, 2: who said it (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%1$s” – %2$s"
msgstr "”%1$s” – %2$s"

#: showbits/includes/class-importer.php
msgid "This is not a clip or a format ShowBits offers."
msgstr "Tämä ei ole ShowBitsin tarjoama klippi tai muoto."

#: showbits/includes/class-importer.php
msgid "The clip is no longer released in ShowBits."
msgstr "Klippi ei ole enää julkaisuun hyväksytty ShowBitsissä."

#: showbits/includes/class-importer.php
msgid "The embargo still holds: the file stays in ShowBits until it ends."
msgstr "Embargo on yhä voimassa: tiedosto pysyy ShowBitsissä, kunnes embargo päättyy."

#: showbits/includes/class-importer.php
msgid "The file is not ready yet in ShowBits."
msgstr "Tiedosto ei ole vielä valmis ShowBitsissä."

#: showbits/includes/class-importer.php
msgid "The file could not be downloaded."
msgstr "Tiedostoa ei voitu ladata."

#: showbits/includes/class-importer.php
msgid "WordPress did not take the file into the media library."
msgstr "WordPress ei lisännyt tiedostoa mediakirjastoon."

#: showbits/includes/class-importer.php
msgid "The delivery from ShowBits is no longer valid. Import the clip again."
msgstr "ShowBitsin toimitus ei ole enää voimassa. Tuo klippi uudelleen."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer accepts this site’s connection: connect it again under Settings → ShowBits."
msgstr "ShowBits ei enää hyväksy tämän sivuston yhteyttä: yhdistä sivusto uudelleen kohdassa Asetukset → ShowBits."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer delivers to this site: the workspace’s plan has ended."
msgstr "ShowBits ei enää toimita tälle sivustolle: työtilan tilaus on päättynyt."

#: showbits/includes/class-importer.php
msgid "The site’s imports for today are used up. Try again tomorrow."
msgstr "Sivuston tämän päivän tuontikiintiö on käytetty loppuun. Yritä uudelleen huomenna."

#: showbits/includes/class-importer.php
msgid "The import was interrupted."
msgstr "Tuonti keskeytyi."

#: showbits/includes/class-importer.php
msgid "The import failed."
msgstr "Tuonti epäonnistui."

#: showbits/includes/class-library-endpoint.php
msgid "This site is not connected to ShowBits."
msgstr "Tätä sivustoa ei ole yhdistetty ShowBitsiin."

#: showbits/includes/class-library-page.php
msgid "All"
msgstr "Kaikki"

#: showbits/includes/class-library-page.php
msgid "Clips"
msgstr "Klipit"

#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Quote cards"
msgstr "Lainauskortit"

#: showbits/includes/class-library-page.php
msgid "Search titles"
msgstr "Hae otsikoista"

#: showbits/includes/class-library-page.php
msgid "Search the library"
msgstr "Hae kirjastosta"

#: showbits/includes/class-library-page.php
msgid "Import selected"
msgstr "Tuo valitut"

#. translators: 1: which one, 2: how many in all
#: showbits/includes/class-library-page.php
msgid "Asking ShowBits for %1$d of %2$d …"
msgstr "Pyydetään ShowBitsiltä kohdetta %1$d/%2$d…"

#. translators: %d: how many clips are still on their way
#: showbits/includes/class-library-page.php
msgid "On the way from ShowBits: %d …"
msgstr "Tulossa ShowBitsistä: %d…"

#. translators: %d: how many clips were imported
#: showbits/includes/class-library-page.php
msgid "Imported: %d"
msgstr "Tuotu: %d"

#: showbits/includes/class-library-page.php
msgid "Not everything has arrived yet; it continues in the background. Settings → ShowBits lists the imports."
msgstr "Kaikki ei ole vielä saapunut; tuonti jatkuu taustalla. Tuonnit näkyvät kohdassa Asetukset → ShowBits."

#: showbits/includes/class-library-page.php
msgid "On the way"
msgstr "Tulossa"

#: showbits/includes/class-library-page.php
msgid "Load more"
msgstr "Lataa lisää"

#: showbits/includes/class-library-page.php
msgid "Loading …"
msgstr "Ladataan…"

#: showbits/includes/class-library-page.php
msgid "No released clips or quote cards yet."
msgstr "Ei vielä julkaisuun hyväksyttyjä klippejä tai lainauskortteja."

#. translators: %s: date and time the embargo ends
#: showbits/includes/class-library-page.php
msgid "Embargo until %s"
msgstr "Embargo %s asti"

#: showbits/includes/class-library-page.php
msgid "Not ready yet"
msgstr "Ei vielä valmis"

#: showbits/includes/class-library-page.php
msgid "In the media library"
msgstr "Mediakirjastossa"

#: showbits/includes/class-library-page.php
msgid "An older version is in the media library"
msgstr "Vanhempi versio on mediakirjastossa"

#: showbits/includes/class-library-page.php
msgid "Edit"
msgstr "Muokkaa"

#: showbits/includes/class-library-page.php
msgid "Format"
msgstr "Muoto"

#: showbits/includes/class-library-page.php
msgid "Video"
msgstr "Video"

#: showbits/includes/class-library-page.php
msgid "Quote card"
msgstr "Lainauskortti"

#: showbits/includes/class-library-page.php
msgid "Meme"
msgstr "Meemi"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "Failed: %s"
msgstr "Epäonnistui: %s"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "The library could not be loaded: %s"
msgstr "Kirjastoa ei voitu ladata: %s"

#: showbits/includes/class-library-page.php
msgid "This site is not connected to ShowBits yet."
msgstr "Tätä sivustoa ei ole vielä yhdistetty ShowBitsiin."

#: showbits/includes/class-library-page.php
msgid "Connect it in the settings."
msgstr "Yhdistä se asetuksissa."

#: showbits/includes/class-library-page.php
msgid "An administrator of this site connects it in the settings."
msgstr "Sivuston pääkäyttäjä yhdistää sen asetuksissa."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-library-page.php
msgid "Released clips and quote cards from the ShowBits workspace “%s”. What you import lands in the media library, ready for posts and pages."
msgstr "Julkaisuun hyväksytyt klipit ja lainauskortit ShowBits-työtilasta ”%s”. Tuomasi kohteet päätyvät mediakirjastoon valmiina artikkeleihin ja sivuihin."

#: showbits/includes/class-library-page.php
msgid "The library needs JavaScript."
msgstr "Kirjasto vaatii JavaScriptin."

#: showbits/includes/class-settings-page.php
msgid "Settings"
msgstr "Asetukset"

#: showbits/includes/class-settings-page.php
msgid "You may not change these settings."
msgstr "Sinulla ei ole oikeutta muuttaa näitä asetuksia."

#: showbits/includes/class-settings-page.php
msgid "Connection"
msgstr "Yhteys"

#. translators: 1: the constant SHOWBITS_ENCRYPTION_KEY, 2: the file wp-config.php (both stay as they are)
#: showbits/includes/class-settings-page.php
msgid "Your site’s security keys are not in %2$s, so the key that protects the connection to ShowBits is stored in the database. Add %1$s with a long random value to %2$s; if the site is connected already, connect it again afterwards."
msgstr "Sivustosi suojausavaimet eivät ole tiedostossa %2$s, joten ShowBitsin yhteyttä suojaava avain on tallennettu tietokantaan. Lisää tiedostoon %2$s %1$s pitkällä satunnaisella arvolla; jos sivusto on jo yhdistetty, yhdistä se sen jälkeen uudelleen."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-settings-page.php
msgid "Connected to the workspace “%s”."
msgstr "Yhdistetty työtilaan ”%s”."

#. translators: 1: imports today, 2: imports a day the plan allows
#: showbits/includes/class-settings-page.php
msgid "Imports today: %1$d of %2$d."
msgstr "Tuonnit tänään: %1$d/%2$d."

#. translators: 1: a person, 2: a date, 3: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "Connected by %1$s on %2$s, at %3$s."
msgstr "%1$s yhdisti sivuston %2$s osoitteeseen %3$s."

#: showbits/includes/class-settings-page.php
msgid "Connect again"
msgstr "Yhdistä uudelleen"

#: showbits/includes/class-settings-page.php
msgid "With a new site key the site renews its connection, or moves to another workspace."
msgstr "Uudella sivustoavaimella sivusto uusii yhteytensä tai siirtyy toiseen työtilaan."

#. translators: %s: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "ShowBits (%s) cannot be reached right now. The connection stays; try again later."
msgstr "ShowBitsiin (%s) ei saada juuri nyt yhteyttä. Sivusto pysyy yhdistettynä; yritä myöhemmin uudelleen."

#: showbits/includes/class-settings-page.php
msgid "ShowBits no longer accepts this site’s connection: it was disconnected in ShowBits, the plan ended, or this site’s keys changed. Connect it again with a new site key."
msgstr "ShowBits ei enää hyväksy tämän sivuston yhteyttä: yhteys katkaistiin ShowBitsissä, tilaus päättyi tai tämän sivuston avaimet muuttuivat. Yhdistä sivusto uudelleen uudella sivustoavaimella."

#: showbits/includes/class-settings-page.php
msgid "Connect this site to a ShowBits workspace: an admin or owner of the workspace makes a site key for this site in ShowBits (Integrations → WordPress). The site can then take released clips and quote cards into its media library, and receive what your ShowBits admins send."
msgstr "Yhdistä tämä sivusto ShowBits-työtilaan: työtilan ylläpitäjä tai omistaja luo ShowBitsissä sivustoavaimen tälle sivustolle (Integrations → WordPress). Sen jälkeen sivusto voi tuoda julkaisuun hyväksyttyjä klippejä ja lainauskortteja mediakirjastoonsa ja ottaa vastaan, mitä ShowBits-ylläpitäjäsi lähettävät."

#: showbits/includes/class-settings-page.php
msgid "Imports"
msgstr "Tuonnit"

#: showbits/includes/class-settings-page.php
msgid "Format of quote cards"
msgstr "Lainauskorttien muoto"

#: showbits/includes/class-settings-page.php
msgid "4:5 (feeds, articles)"
msgstr "4:5 (syötteet, artikkelit)"

#: showbits/includes/class-settings-page.php
msgid "1:1 (square)"
msgstr "1:1 (neliö)"

#: showbits/includes/class-settings-page.php
msgid "9:16 (stories)"
msgstr "9:16 (tarinat)"

#: showbits/includes/class-settings-page.php
msgid "The picture pushes bring; in the library you choose for each card."
msgstr "Muoto, jossa lähetetyt kortit saapuvat; kirjastossa valitset muodon jokaiselle kortille erikseen."

#: showbits/includes/class-settings-page.php
msgid "Videos"
msgstr "Videot"

#: showbits/includes/class-settings-page.php
msgid "Import the thumbnail as the video’s poster image"
msgstr "Tuo pienoiskuva videon ruutukaappaukseksi"

#: showbits/includes/class-settings-page.php
msgid "Save"
msgstr "Tallenna"

#: showbits/includes/class-settings-page.php
msgid "Site key"
msgstr "Sivustoavain"

#. translators: %s: this site's address
#: showbits/includes/class-settings-page.php
msgid "Made in ShowBits for %s, valid for 24 hours and only once. ShowBits then checks that it is talking to this site."
msgstr "Luodaan ShowBitsissä osoitteelle %s, voimassa 24 tuntia ja käytettävissä vain kerran. ShowBits tarkistaa sitten, että se on yhteydessä juuri tähän sivustoon."

#: showbits/includes/class-settings-page.php
msgid "Connect"
msgstr "Yhdistä"

#: showbits/includes/class-settings-page.php
msgid "Are you an admin or owner of the workspace yourself? Then sign in to ShowBits and agree there, without a site key:"
msgstr "Oletko itse työtilan ylläpitäjä tai omistaja? Kirjaudu silloin ShowBitsiin ja anna suostumuksesi siellä ilman sivustoavainta:"

#: showbits/includes/class-settings-page.php
msgid "Connect through ShowBits"
msgstr "Yhdistä ShowBitsin kautta"

#: showbits/includes/class-settings-page.php
msgid "ShowBits address"
msgstr "ShowBitsin osoite"

#: showbits/includes/class-settings-page.php
msgid "ShowBits Cloud: https://app.showbits.ai. OnPremise: the address of your installation."
msgstr "ShowBits Cloud: https://app.showbits.ai. OnPremise: oman asennuksesi osoite."

#: showbits/includes/class-settings-page.php
msgid "Disconnect"
msgstr "Katkaise yhteys"

#: showbits/includes/class-settings-page.php
msgid "Disconnect this site from ShowBits? What is in the media library stays."
msgstr "Katkaistaanko tämän sivuston yhteys ShowBitsiin? Mediakirjaston sisältö säilyy."

#: showbits/includes/class-settings-page.php
msgid "asked for"
msgstr "pyydetty"

#: showbits/includes/class-settings-page.php
msgid "waiting"
msgstr "odottaa"

#: showbits/includes/class-settings-page.php
msgid "importing"
msgstr "tuodaan"

#: showbits/includes/class-settings-page.php
msgid "imported"
msgstr "tuotu"

#: showbits/includes/class-settings-page.php
msgid "failed"
msgstr "epäonnistui"

#: showbits/includes/class-settings-page.php
msgid "Recent imports"
msgstr "Viimeisimmät tuonnit"

#: showbits/includes/class-settings-page.php
msgid "When"
msgstr "Milloin"

#: showbits/includes/class-settings-page.php
msgid "Clip"
msgstr "Klippi"

#: showbits/includes/class-settings-page.php
msgid "How"
msgstr "Tapa"

#: showbits/includes/class-settings-page.php
msgid "State"
msgstr "Tila"

#: showbits/includes/class-settings-page.php
msgid "sent from ShowBits"
msgstr "lähetetty ShowBitsistä"

#: showbits/includes/class-settings-page.php
msgid "picked here"
msgstr "valittu täällä"

#: showbits/includes/class-settings-page.php
msgid "Connected. The library is under Media → ShowBits."
msgstr "Yhdistetty. Kirjasto löytyy kohdasta Media → ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Disconnected. What is in the media library stays."
msgstr "Yhteys katkaistu. Mediakirjaston sisältö säilyy."

#: showbits/includes/class-settings-page.php
msgid "Saved."
msgstr "Tallennettu."

#: showbits/includes/class-settings-page.php
msgid "Connecting was cancelled in ShowBits."
msgstr "Yhdistäminen peruttiin ShowBitsissä."

#: showbits/includes/class-settings-page.php
msgid "That way back from ShowBits did not belong to this attempt. Start again."
msgstr "Paluu ShowBitsistä ei kuulunut tähän yhdistämisyritykseen. Aloita alusta."

#: showbits/includes/class-settings-page.php
msgid "The ShowBits address must start with https://."
msgstr "ShowBitsin osoitteen on alettava merkeillä https://."

#: showbits/includes/class-settings-page.php
msgid "That is not a site key. Copy it from ShowBits (Integrations → WordPress) again."
msgstr "Tämä ei ole sivustoavain. Kopioi se uudelleen ShowBitsistä (Integrations → WordPress)."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not take the site key: it is unknown, used, withdrawn or expired (a site key lasts 24 hours, a consent ten minutes). Make a new one."
msgstr "ShowBits ei hyväksynyt sivustoavainta: se on tuntematon, jo käytetty, peruttu tai vanhentunut (sivustoavain on voimassa 24 tuntia, suostumus kymmenen minuuttia). Luo uusi sivustoavain."

#: showbits/includes/class-settings-page.php
msgid "The site key was made for another address. Make one for this site’s address."
msgstr "Sivustoavain on luotu toiselle osoitteelle. Luo sivustoavain tämän sivuston osoitteelle."

#: showbits/includes/class-settings-page.php
msgid "ShowBits could not reach this site at its REST API (/wp-json/showbits/v1/push), or ShowBits itself could not be reached. The site must be public over HTTPS; a firewall or security plugin must let ShowBits in."
msgstr "ShowBits ei tavoittanut tämän sivuston REST API -rajapintaa (/wp-json/showbits/v1/push) tai ShowBitsiin itseensä ei saatu yhteyttä. Sivuston on oltava julkisesti saatavilla HTTPS:n kautta; palomuurin tai tietoturvalisäosan on päästettävä ShowBits läpi."

#: showbits/includes/class-settings-page.php
msgid "This site did not answer ShowBits’ check as expected. Try again; if it fails again, a cache or security plugin may answer for WordPress."
msgstr "Tämä sivusto ei vastannut ShowBitsin tarkistukseen odotetulla tavalla. Yritä uudelleen; jos se epäonnistuu taas, välimuisti- tai tietoturvalisäosa saattaa vastata WordPressin sijasta."

#: showbits/includes/class-settings-page.php
msgid "The workspace’s plan has ended, or whoever made the site key may no longer connect sites."
msgstr "Työtilan tilaus on päättynyt tai sivustoavaimen luoneella henkilöllä ei ole enää oikeutta yhdistää sivustoja."

#: showbits/includes/class-settings-page.php
msgid "The workspace has as many sites as its plan allows."
msgstr "Työtilassa on jo niin monta sivustoa kuin sen tilaus sallii."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not accept this site’s address. It must be served over HTTPS."
msgstr "ShowBits ei hyväksynyt tämän sivuston osoitetta. Sivuston on oltava käytettävissä HTTPS:n kautta."

#: showbits/includes/class-settings-page.php
msgid "Connecting did not work. Try again, or ask your ShowBits contact."
msgstr "Yhdistäminen ei onnistunut. Yritä uudelleen tai kysy ShowBits-yhteyshenkilöltäsi."
