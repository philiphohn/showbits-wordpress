# Catalan translation of the ShowBits plugin.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: ca\n"
"Plural-Forms: nplurals=2; plural=n != 1;\n"

#. Description of the plugin
#: showbits/showbits.php
msgid "Released clips and quote cards from ShowBits in the media library: pick them in WordPress, or receive what your ShowBits admins send."
msgstr "Clips i targetes de citació aprovats de ShowBits a la mediateca: trieu-los al WordPress o rebeu el que us envien els vostres administradors de ShowBits."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer as expected."
msgstr "ShowBits no ha respost com s'esperava."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer with a file."
msgstr "ShowBits no ha retornat cap fitxer."

#: showbits/includes/class-api-client.php showbits/includes/class-importer.php
msgid "ShowBits could not be reached."
msgstr "No s'ha pogut contactar amb ShowBits."

#. translators: 1: ShowBits' reason, 2: the HTTP status
#: showbits/includes/class-api-client.php
msgid "ShowBits refused (%1$s, HTTP %2$d)."
msgstr "ShowBits ha rebutjat la sol·licitud (%1$s, HTTP %2$d)."

#: showbits/includes/class-connection.php
msgid "You may not connect this site."
msgstr "No teniu permís per a connectar aquest lloc web."

#. translators: %s: the clip's title
#: showbits/includes/class-importer.php
msgid "%s (thumbnail)"
msgstr "%s (miniatura)"

#. translators: %s: a quote (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%s”"
msgstr "«%s»"

#. translators: 1: a quote, 2: who said it (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%1$s” – %2$s"
msgstr "«%1$s» – %2$s"

#: showbits/includes/class-importer.php
msgid "This is not a clip or a format ShowBits offers."
msgstr "No és un clip ni un format que ofereixi ShowBits."

#: showbits/includes/class-importer.php
msgid "The clip is no longer released in ShowBits."
msgstr "El clip ja no està aprovat a ShowBits."

#: showbits/includes/class-importer.php
msgid "The embargo still holds: the file stays in ShowBits until it ends."
msgstr "L'embargament encara és vigent: el fitxer es queda a ShowBits fins que s'acabi."

#: showbits/includes/class-importer.php
msgid "The file is not ready yet in ShowBits."
msgstr "El fitxer encara no està a punt a ShowBits."

#: showbits/includes/class-importer.php
msgid "The file could not be downloaded."
msgstr "No s'ha pogut baixar el fitxer."

#: showbits/includes/class-importer.php
msgid "WordPress did not take the file into the media library."
msgstr "El WordPress no ha acceptat el fitxer a la mediateca."

#: showbits/includes/class-importer.php
msgid "The delivery from ShowBits is no longer valid. Import the clip again."
msgstr "L'enviament de ShowBits ja no és vàlid. Torneu a importar el clip."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer accepts this site’s connection: connect it again under Settings → ShowBits."
msgstr "ShowBits ja no accepta la connexió d'aquest lloc web: torneu-lo a connectar a Paràmetres → ShowBits."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer delivers to this site: the workspace’s plan has ended."
msgstr "ShowBits ja no envia res a aquest lloc web: el pla de l'espai de treball ha finalitzat."

#: showbits/includes/class-importer.php
msgid "The site’s imports for today are used up. Try again tomorrow."
msgstr "S'han esgotat les importacions d'avui d'aquest lloc web. Torneu-ho a provar demà."

#: showbits/includes/class-importer.php
msgid "The import was interrupted."
msgstr "La importació s'ha interromput."

#: showbits/includes/class-importer.php
msgid "The import failed."
msgstr "La importació ha fallat."

#: showbits/includes/class-library-endpoint.php
msgid "This site is not connected to ShowBits."
msgstr "Aquest lloc web no està connectat a ShowBits."

#: showbits/includes/class-library-page.php
msgid "All"
msgstr "Tot"

#: showbits/includes/class-library-page.php
msgid "Clips"
msgstr "Clips"

#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Quote cards"
msgstr "Targetes de citació"

#: showbits/includes/class-library-page.php
msgid "Search titles"
msgstr "Cerca als títols"

#: showbits/includes/class-library-page.php
msgid "Search the library"
msgstr "Cerca a la biblioteca"

#: showbits/includes/class-library-page.php
msgid "Import selected"
msgstr "Importa la selecció"

#. translators: 1: which one, 2: how many in all
#: showbits/includes/class-library-page.php
msgid "Asking ShowBits for %1$d of %2$d …"
msgstr "S'està demanant a ShowBits: %1$d de %2$d…"

#. translators: %d: how many clips are still on their way
#: showbits/includes/class-library-page.php
msgid "On the way from ShowBits: %d …"
msgstr "En camí des de ShowBits: %d…"

#. translators: %d: how many clips were imported
#: showbits/includes/class-library-page.php
msgid "Imported: %d"
msgstr "Importats: %d"

#: showbits/includes/class-library-page.php
msgid "Not everything has arrived yet; it continues in the background. Settings → ShowBits lists the imports."
msgstr "Encara no ha arribat tot; la importació continua en segon pla. Trobareu les importacions a Paràmetres → ShowBits."

#: showbits/includes/class-library-page.php
msgid "On the way"
msgstr "En camí"

#: showbits/includes/class-library-page.php
msgid "Load more"
msgstr "Carrega'n més"

#: showbits/includes/class-library-page.php
msgid "Loading …"
msgstr "S'està carregant…"

#: showbits/includes/class-library-page.php
msgid "No released clips or quote cards yet."
msgstr "Encara no hi ha clips ni targetes de citació aprovats."

#. translators: %s: date and time the embargo ends
#: showbits/includes/class-library-page.php
msgid "Embargo until %s"
msgstr "Embargament fins al %s"

#: showbits/includes/class-library-page.php
msgid "Not ready yet"
msgstr "Encara no està a punt"

#: showbits/includes/class-library-page.php
msgid "In the media library"
msgstr "A la mediateca"

#: showbits/includes/class-library-page.php
msgid "An older version is in the media library"
msgstr "Hi ha una versió anterior a la mediateca"

#: showbits/includes/class-library-page.php
msgid "Edit"
msgstr "Edita"

#: showbits/includes/class-library-page.php
msgid "Format"
msgstr "Format"

#: showbits/includes/class-library-page.php
msgid "Video"
msgstr "Vídeo"

#: showbits/includes/class-library-page.php
msgid "Quote card"
msgstr "Targeta de citació"

#: showbits/includes/class-library-page.php
msgid "Meme"
msgstr "Mem"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "Failed: %s"
msgstr "Ha fallat: %s"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "The library could not be loaded: %s"
msgstr "No s'ha pogut carregar la biblioteca: %s"

#: showbits/includes/class-library-page.php
msgid "This site is not connected to ShowBits yet."
msgstr "Aquest lloc web encara no està connectat a ShowBits."

#: showbits/includes/class-library-page.php
msgid "Connect it in the settings."
msgstr "Connecteu-lo als paràmetres."

#: showbits/includes/class-library-page.php
msgid "An administrator of this site connects it in the settings."
msgstr "Un administrador d'aquest lloc web l'ha de connectar als paràmetres."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-library-page.php
msgid "Released clips and quote cards from the ShowBits workspace “%s”. What you import lands in the media library, ready for posts and pages."
msgstr "Clips i targetes de citació aprovats de l'espai de treball de ShowBits «%s». El que importeu va a parar a la mediateca, a punt per a entrades i pàgines."

#: showbits/includes/class-library-page.php
msgid "The library needs JavaScript."
msgstr "La biblioteca necessita JavaScript."

#: showbits/includes/class-settings-page.php
msgid "Settings"
msgstr "Paràmetres"

#: showbits/includes/class-settings-page.php
msgid "You may not change these settings."
msgstr "No teniu permís per a canviar aquests paràmetres."

#: showbits/includes/class-settings-page.php
msgid "Connection"
msgstr "Connexió"

#. translators: 1: the constant SHOWBITS_ENCRYPTION_KEY, 2: the file wp-config.php (both stay as they are)
#: showbits/includes/class-settings-page.php
msgid "Your site’s security keys are not in %2$s, so the key that protects the connection to ShowBits is stored in the database. Add %1$s with a long random value to %2$s; if the site is connected already, connect it again afterwards."
msgstr "Les claus de seguretat del vostre lloc web no són a %2$s, de manera que la clau que protegeix la connexió amb ShowBits es desa a la base de dades. Afegiu %1$s amb un valor aleatori llarg a %2$s; si el lloc web ja està connectat, torneu-lo a connectar després."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-settings-page.php
msgid "Connected to the workspace “%s”."
msgstr "Connectat a l'espai de treball «%s»."

#. translators: 1: imports today, 2: imports a day the plan allows
#: showbits/includes/class-settings-page.php
msgid "Imports today: %1$d of %2$d."
msgstr "Importacions d'avui: %1$d de %2$d."

#. translators: 1: a person, 2: a date, 3: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "Connected by %1$s on %2$s, at %3$s."
msgstr "Connectat per %1$s el %2$s, a l'adreça %3$s."

#: showbits/includes/class-settings-page.php
msgid "Connect again"
msgstr "Torna a connectar"

#: showbits/includes/class-settings-page.php
msgid "With a new site key the site renews its connection, or moves to another workspace."
msgstr "Amb una clau del lloc web nova, el lloc web renova la connexió o passa a un altre espai de treball."

#. translators: %s: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "ShowBits (%s) cannot be reached right now. The connection stays; try again later."
msgstr "ShowBits (%s) no està disponible ara mateix. La connexió es manté; torneu-ho a provar més tard."

#: showbits/includes/class-settings-page.php
msgid "ShowBits no longer accepts this site’s connection: it was disconnected in ShowBits, the plan ended, or this site’s keys changed. Connect it again with a new site key."
msgstr "ShowBits ja no accepta la connexió d'aquest lloc web: s'ha desconnectat a ShowBits, el pla ha finalitzat o les claus d'aquest lloc web han canviat. Torneu-lo a connectar amb una clau del lloc web nova."

#: showbits/includes/class-settings-page.php
msgid "Connect this site to a ShowBits workspace: an admin or owner of the workspace makes a site key for this site in ShowBits (Integrations → WordPress). The site can then take released clips and quote cards into its media library, and receive what your ShowBits admins send."
msgstr "Connecteu aquest lloc web a un espai de treball de ShowBits: un administrador o propietari de l'espai de treball crea a ShowBits una clau del lloc web per a aquest lloc (Integrations → WordPress). Després, el lloc web podrà incorporar a la mediateca clips i targetes de citació aprovats, i rebre el que us envien els vostres administradors de ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Imports"
msgstr "Importacions"

#: showbits/includes/class-settings-page.php
msgid "Format of quote cards"
msgstr "Format de les targetes de citació"

#: showbits/includes/class-settings-page.php
msgid "4:5 (feeds, articles)"
msgstr "4:5 (publicacions, articles)"

#: showbits/includes/class-settings-page.php
msgid "1:1 (square)"
msgstr "1:1 (quadrat)"

#: showbits/includes/class-settings-page.php
msgid "9:16 (stories)"
msgstr "9:16 (històries)"

#: showbits/includes/class-settings-page.php
msgid "The picture pushes bring; in the library you choose for each card."
msgstr "El format de les targetes que s'envien a aquest lloc web; a la biblioteca el trieu per a cada targeta."

#: showbits/includes/class-settings-page.php
msgid "Videos"
msgstr "Vídeos"

#: showbits/includes/class-settings-page.php
msgid "Import the thumbnail as the video’s poster image"
msgstr "Importa la miniatura com a imatge de pòster del vídeo"

#: showbits/includes/class-settings-page.php
msgid "Save"
msgstr "Desa"

#: showbits/includes/class-settings-page.php
msgid "Site key"
msgstr "Clau del lloc web"

#. translators: %s: this site's address
#: showbits/includes/class-settings-page.php
msgid "Made in ShowBits for %s, valid for 24 hours and only once. ShowBits then checks that it is talking to this site."
msgstr "Creada a ShowBits per a %s, vàlida durant 24 hores i d'un sol ús. Després ShowBits comprova que parla amb aquest lloc web."

#: showbits/includes/class-settings-page.php
msgid "Connect"
msgstr "Connecta"

#: showbits/includes/class-settings-page.php
msgid "Are you an admin or owner of the workspace yourself? Then sign in to ShowBits and agree there, without a site key:"
msgstr "Sou administrador o propietari de l'espai de treball? Llavors inicieu la sessió a ShowBits i doneu-hi el vostre consentiment, sense clau del lloc web:"

#: showbits/includes/class-settings-page.php
msgid "Connect through ShowBits"
msgstr "Connecta mitjançant ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits address"
msgstr "Adreça de ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits Cloud: https://app.showbits.ai. OnPremise: the address of your installation."
msgstr "ShowBits Cloud: https://app.showbits.ai. OnPremise: l'adreça de la vostra instal·lació."

#: showbits/includes/class-settings-page.php
msgid "Disconnect"
msgstr "Desconnecta"

#: showbits/includes/class-settings-page.php
msgid "Disconnect this site from ShowBits? What is in the media library stays."
msgstr "Voleu desconnectar aquest lloc web de ShowBits? El que hi ha a la mediateca s'hi queda."

#: showbits/includes/class-settings-page.php
msgid "asked for"
msgstr "Sol·licitat"

#: showbits/includes/class-settings-page.php
msgid "waiting"
msgstr "En espera"

#: showbits/includes/class-settings-page.php
msgid "importing"
msgstr "S'està important"

#: showbits/includes/class-settings-page.php
msgid "imported"
msgstr "Importat"

#: showbits/includes/class-settings-page.php
msgid "failed"
msgstr "Ha fallat"

#: showbits/includes/class-settings-page.php
msgid "Recent imports"
msgstr "Importacions recents"

#: showbits/includes/class-settings-page.php
msgid "When"
msgstr "Data"

#: showbits/includes/class-settings-page.php
msgid "Clip"
msgstr "Clip"

#: showbits/includes/class-settings-page.php
msgid "How"
msgstr "Origen"

#: showbits/includes/class-settings-page.php
msgid "State"
msgstr "Estat"

#: showbits/includes/class-settings-page.php
msgid "sent from ShowBits"
msgstr "Enviat des de ShowBits"

#: showbits/includes/class-settings-page.php
msgid "picked here"
msgstr "Triat aquí"

#: showbits/includes/class-settings-page.php
msgid "Connected. The library is under Media → ShowBits."
msgstr "Connectat. La biblioteca és a Mèdia → ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Disconnected. What is in the media library stays."
msgstr "Desconnectat. El que hi ha a la mediateca s'hi queda."

#: showbits/includes/class-settings-page.php
msgid "Saved."
msgstr "S'han desat els paràmetres."

#: showbits/includes/class-settings-page.php
msgid "Connecting was cancelled in ShowBits."
msgstr "S'ha cancel·lat la connexió a ShowBits."

#: showbits/includes/class-settings-page.php
msgid "That way back from ShowBits did not belong to this attempt. Start again."
msgstr "Aquest retorn des de ShowBits no correspon a l'intent de connexió que ha iniciat aquest lloc web. Torneu a començar."

#: showbits/includes/class-settings-page.php
msgid "The ShowBits address must start with https://."
msgstr "L'adreça de ShowBits ha de començar per https://."

#: showbits/includes/class-settings-page.php
msgid "That is not a site key. Copy it from ShowBits (Integrations → WordPress) again."
msgstr "Això no és una clau del lloc web. Torneu-la a copiar de ShowBits (Integrations → WordPress)."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not take the site key: it is unknown, used, withdrawn or expired (a site key lasts 24 hours, a consent ten minutes). Make a new one."
msgstr "ShowBits no ha acceptat la clau del lloc web: és desconeguda, ja s'ha utilitzat, s'ha revocat o ha caducat (una clau del lloc web dura 24 hores; un consentiment, deu minuts). Creeu-ne una de nova."

#: showbits/includes/class-settings-page.php
msgid "The site key was made for another address. Make one for this site’s address."
msgstr "La clau del lloc web es va crear per a una altra adreça. Creeu-ne una per a l'adreça d'aquest lloc web."

#: showbits/includes/class-settings-page.php
msgid "ShowBits could not reach this site at its REST API (/wp-json/showbits/v1/push), or ShowBits itself could not be reached. The site must be public over HTTPS; a firewall or security plugin must let ShowBits in."
msgstr "ShowBits no ha pogut accedir a aquest lloc web a través de la seva API REST (/wp-json/showbits/v1/push), o bé no s'ha pogut contactar amb ShowBits. El lloc web ha de ser accessible públicament per HTTPS; un tallafoc o una extensió de seguretat ha de deixar passar ShowBits."

#: showbits/includes/class-settings-page.php
msgid "This site did not answer ShowBits’ check as expected. Try again; if it fails again, a cache or security plugin may answer for WordPress."
msgstr "Aquest lloc web no ha respost com s'esperava a la comprovació de ShowBits. Torneu-ho a provar; si torna a fallar, potser una extensió de memòria cau o de seguretat respon en lloc del WordPress."

#: showbits/includes/class-settings-page.php
msgid "The workspace’s plan has ended, or whoever made the site key may no longer connect sites."
msgstr "El pla de l'espai de treball ha finalitzat, o la persona que va crear la clau del lloc web ja no pot connectar llocs web."

#: showbits/includes/class-settings-page.php
msgid "The workspace has as many sites as its plan allows."
msgstr "L'espai de treball ja té tants llocs web com permet el seu pla."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not accept this site’s address. It must be served over HTTPS."
msgstr "ShowBits no ha acceptat l'adreça d'aquest lloc web. El lloc web s'ha de servir per HTTPS."

#: showbits/includes/class-settings-page.php
msgid "Connecting did not work. Try again, or ask your ShowBits contact."
msgstr "La connexió no ha funcionat. Torneu-ho a provar o adreceu-vos a la vostra persona de contacte de ShowBits."
