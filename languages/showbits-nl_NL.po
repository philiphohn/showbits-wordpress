# Dutch translation of the ShowBits plugin.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: nl_NL\n"
"Plural-Forms: nplurals=2; plural=n != 1;\n"

#. Description of the plugin
#: showbits/showbits.php
msgid "Released clips and quote cards from ShowBits in the media library: pick them in WordPress, or receive what your ShowBits admins send."
msgstr "Vrijgegeven clips en citaatkaarten uit ShowBits in de mediabibliotheek: kies ze in WordPress of ontvang wat je ShowBits-admins sturen."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer as expected."
msgstr "ShowBits gaf niet het verwachte antwoord."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer with a file."
msgstr "ShowBits leverde geen bestand."

#: showbits/includes/class-api-client.php showbits/includes/class-importer.php
msgid "ShowBits could not be reached."
msgstr "ShowBits was niet bereikbaar."

#. translators: 1: ShowBits' reason, 2: the HTTP status
#: showbits/includes/class-api-client.php
msgid "ShowBits refused (%1$s, HTTP %2$d)."
msgstr "ShowBits weigerde (%1$s, HTTP %2$d)."

#: showbits/includes/class-connection.php
msgid "You may not connect this site."
msgstr "Je hebt geen toestemming om deze site te verbinden."

#. translators: %s: the clip's title
#: showbits/includes/class-importer.php
msgid "%s (thumbnail)"
msgstr "%s (thumbnail)"

#. translators: %s: a quote (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%s”"
msgstr "“%s”"

#. translators: 1: a quote, 2: who said it (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%1$s” – %2$s"
msgstr "“%1$s” – %2$s"

#: showbits/includes/class-importer.php
msgid "This is not a clip or a format ShowBits offers."
msgstr "Dit is geen clip of formaat dat ShowBits aanbiedt."

#: showbits/includes/class-importer.php
msgid "The clip is no longer released in ShowBits."
msgstr "De clip is in ShowBits niet meer vrijgegeven."

#: showbits/includes/class-importer.php
msgid "The embargo still holds: the file stays in ShowBits until it ends."
msgstr "Het embargo geldt nog: het bestand blijft in ShowBits tot het embargo voorbij is."

#: showbits/includes/class-importer.php
msgid "The file is not ready yet in ShowBits."
msgstr "Het bestand is in ShowBits nog niet klaar."

#: showbits/includes/class-importer.php
msgid "The file could not be downloaded."
msgstr "Het bestand kon niet worden gedownload."

#: showbits/includes/class-importer.php
msgid "WordPress did not take the file into the media library."
msgstr "WordPress heeft het bestand niet in de mediabibliotheek opgenomen."

#: showbits/includes/class-importer.php
msgid "The delivery from ShowBits is no longer valid. Import the clip again."
msgstr "De levering van ShowBits is niet meer geldig. Importeer de clip opnieuw."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer accepts this site’s connection: connect it again under Settings → ShowBits."
msgstr "ShowBits accepteert de verbinding van deze site niet meer: verbind de site opnieuw via Instellingen → ShowBits."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer delivers to this site: the workspace’s plan has ended."
msgstr "ShowBits levert niet meer aan deze site: het abonnement van de werkruimte is afgelopen."

#: showbits/includes/class-importer.php
msgid "The site’s imports for today are used up. Try again tomorrow."
msgstr "Deze site heeft voor vandaag geen imports meer over. Probeer het morgen opnieuw."

#: showbits/includes/class-importer.php
msgid "The import was interrupted."
msgstr "De import is onderbroken."

#: showbits/includes/class-importer.php
msgid "The import failed."
msgstr "De import is mislukt."

#: showbits/includes/class-library-endpoint.php
msgid "This site is not connected to ShowBits."
msgstr "Deze site is niet met ShowBits verbonden."

#: showbits/includes/class-library-page.php
msgid "All"
msgstr "Alle"

#: showbits/includes/class-library-page.php
msgid "Clips"
msgstr "Clips"

#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Quote cards"
msgstr "Citaatkaarten"

#: showbits/includes/class-library-page.php
msgid "Search titles"
msgstr "Titels zoeken"

#: showbits/includes/class-library-page.php
msgid "Search the library"
msgstr "Bibliotheek doorzoeken"

#: showbits/includes/class-library-page.php
msgid "Import selected"
msgstr "Selectie importeren"

#. translators: 1: which one, 2: how many in all
#: showbits/includes/class-library-page.php
msgid "Asking ShowBits for %1$d of %2$d …"
msgstr "Opvragen bij ShowBits: %1$d van %2$d…"

#. translators: %d: how many clips are still on their way
#: showbits/includes/class-library-page.php
msgid "On the way from ShowBits: %d …"
msgstr "Onderweg vanuit ShowBits: %d…"

#. translators: %d: how many clips were imported
#: showbits/includes/class-library-page.php
msgid "Imported: %d"
msgstr "Geïmporteerd: %d"

#: showbits/includes/class-library-page.php
msgid "Not everything has arrived yet; it continues in the background. Settings → ShowBits lists the imports."
msgstr "Nog niet alles is aangekomen; het importeren gaat op de achtergrond verder. Onder Instellingen → ShowBits staan de imports."

#: showbits/includes/class-library-page.php
msgid "On the way"
msgstr "Onderweg"

#: showbits/includes/class-library-page.php
msgid "Load more"
msgstr "Meer laden"

#: showbits/includes/class-library-page.php
msgid "Loading …"
msgstr "Laden…"

#: showbits/includes/class-library-page.php
msgid "No released clips or quote cards yet."
msgstr "Nog geen vrijgegeven clips of citaatkaarten."

#. translators: %s: date and time the embargo ends
#: showbits/includes/class-library-page.php
msgid "Embargo until %s"
msgstr "Embargo tot %s"

#: showbits/includes/class-library-page.php
msgid "Not ready yet"
msgstr "Nog niet klaar"

#: showbits/includes/class-library-page.php
msgid "In the media library"
msgstr "In de mediabibliotheek"

#: showbits/includes/class-library-page.php
msgid "An older version is in the media library"
msgstr "Een oudere versie staat in de mediabibliotheek"

#: showbits/includes/class-library-page.php
msgid "Edit"
msgstr "Bewerken"

#: showbits/includes/class-library-page.php
msgid "Format"
msgstr "Formaat"

#. translators: %s: a quote card's format, such as 9:16 or "9:16 (stories)" (its animated video with the speaker's voice)
#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Animated %s"
msgstr "Geanimeerd %s"

#: showbits/includes/class-library-page.php
msgid "Video"
msgstr "Video"

#: showbits/includes/class-library-page.php
msgid "Quote card"
msgstr "Citaatkaart"

#: showbits/includes/class-library-page.php
msgid "Meme"
msgstr "Meme"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "Failed: %s"
msgstr "Mislukt: %s"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "The library could not be loaded: %s"
msgstr "De bibliotheek kon niet worden geladen: %s"

#: showbits/includes/class-library-page.php
msgid "This site is not connected to ShowBits yet."
msgstr "Deze site is nog niet met ShowBits verbonden."

#: showbits/includes/class-library-page.php
msgid "Connect it in the settings."
msgstr "Verbind de site in de instellingen."

#: showbits/includes/class-library-page.php
msgid "An administrator of this site connects it in the settings."
msgstr "Een beheerder van deze site moet de site in de instellingen verbinden."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-library-page.php
msgid "Released clips and quote cards from the ShowBits workspace “%s”. What you import lands in the media library, ready for posts and pages."
msgstr "Vrijgegeven clips en citaatkaarten uit de ShowBits-werkruimte “%s”. Wat je importeert, komt in de mediabibliotheek terecht, klaar voor berichten en pagina’s."

#: showbits/includes/class-library-page.php
msgid "The library needs JavaScript."
msgstr "De bibliotheek heeft JavaScript nodig."

#: showbits/includes/class-settings-page.php
msgid "Settings"
msgstr "Instellingen"

#: showbits/includes/class-settings-page.php
msgid "You may not change these settings."
msgstr "Je hebt geen toestemming om deze instellingen te wijzigen."

#: showbits/includes/class-settings-page.php
msgid "Connection"
msgstr "Verbinding"

#. translators: 1: the constant SHOWBITS_ENCRYPTION_KEY, 2: the file wp-config.php (both stay as they are)
#: showbits/includes/class-settings-page.php
msgid "Your site’s security keys are not in %2$s, so the key that protects the connection to ShowBits is stored in the database. Add %1$s with a long random value to %2$s; if the site is connected already, connect it again afterwards."
msgstr "De beveiligingssleutels van je site staan niet in %2$s, daarom wordt de sleutel die de verbinding met ShowBits beschermt in de database bewaard. Voeg %1$s met een lange willekeurige waarde toe aan %2$s; is de site al verbonden, verbind hem daarna dan opnieuw."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-settings-page.php
msgid "Connected to the workspace “%s”."
msgstr "Verbonden met de werkruimte “%s”."

#. translators: 1: imports today, 2: imports a day the plan allows
#: showbits/includes/class-settings-page.php
msgid "Imports today: %1$d of %2$d."
msgstr "Imports vandaag: %1$d van %2$d."

#. translators: 1: a person, 2: a date, 3: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "Connected by %1$s on %2$s, at %3$s."
msgstr "Verbonden met %3$s door %1$s op %2$s."

#: showbits/includes/class-settings-page.php
msgid "Connect again"
msgstr "Opnieuw verbinden"

#: showbits/includes/class-settings-page.php
msgid "With a new site key the site renews its connection, or moves to another workspace."
msgstr "Met een nieuwe sitesleutel wordt de verbinding van de site vernieuwd, of gaat de site over naar een andere werkruimte."

#. translators: %s: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "ShowBits (%s) cannot be reached right now. The connection stays; try again later."
msgstr "ShowBits (%s) is op dit moment niet bereikbaar. De verbinding blijft bestaan; probeer het later opnieuw."

#: showbits/includes/class-settings-page.php
msgid "ShowBits no longer accepts this site’s connection: it was disconnected in ShowBits, the plan ended, or this site’s keys changed. Connect it again with a new site key."
msgstr "ShowBits accepteert de verbinding van deze site niet meer: de verbinding is in ShowBits verbroken, het abonnement is afgelopen of de sleutels van deze site zijn gewijzigd. Verbind de site opnieuw met een nieuwe sitesleutel."

#: showbits/includes/class-settings-page.php
msgid "Connect this site to a ShowBits workspace: an admin or owner of the workspace makes a site key for this site in ShowBits (Integrations → WordPress). The site can then take released clips and quote cards into its media library, and receive what your ShowBits admins send."
msgstr "Verbind deze site met een ShowBits-werkruimte: een admin of eigenaar van de werkruimte maakt een sitesleutel voor deze site aan in ShowBits (Integrations → WordPress). Daarna kan de site vrijgegeven clips en citaatkaarten in de mediabibliotheek opnemen en ontvangen wat je ShowBits-admins sturen."

#: showbits/includes/class-settings-page.php
msgid "Imports"
msgstr "Imports"

#: showbits/includes/class-settings-page.php
msgid "Format of quote cards"
msgstr "Formaat van citaatkaarten"

#: showbits/includes/class-settings-page.php
msgid "4:5 (feeds, articles)"
msgstr "4:5 (feeds, artikelen)"

#: showbits/includes/class-settings-page.php
msgid "1:1 (square)"
msgstr "1:1 (vierkant)"

#: showbits/includes/class-settings-page.php
msgid "9:16 (stories)"
msgstr "9:16 (stories)"

#: showbits/includes/class-settings-page.php
msgid "The picture pushes bring; in the library you choose for each card."
msgstr "Het formaat van toegestuurde kaarten; in de bibliotheek kies je het per kaart."

#: showbits/includes/class-settings-page.php
msgid "Videos"
msgstr "Video’s"

#: showbits/includes/class-settings-page.php
msgid "Import the thumbnail as the video’s poster image"
msgstr "De thumbnail importeren als posterafbeelding van de video"

#: showbits/includes/class-settings-page.php
msgid "Save"
msgstr "Opslaan"

#: showbits/includes/class-settings-page.php
msgid "Site key"
msgstr "Sitesleutel"

#. translators: %s: this site's address
#: showbits/includes/class-settings-page.php
msgid "Made in ShowBits for %s, valid for 24 hours and only once. ShowBits then checks that it is talking to this site."
msgstr "In ShowBits aangemaakt voor %s, 24 uur geldig en maar één keer te gebruiken. ShowBits controleert daarna of het echt met deze site communiceert."

#: showbits/includes/class-settings-page.php
msgid "Connect"
msgstr "Verbinden"

#: showbits/includes/class-settings-page.php
msgid "Are you an admin or owner of the workspace yourself? Then sign in to ShowBits and agree there, without a site key:"
msgstr "Ben je zelf admin of eigenaar van de werkruimte? Log dan in bij ShowBits en geef daar toestemming, zonder sitesleutel:"

#: showbits/includes/class-settings-page.php
msgid "Connect through ShowBits"
msgstr "Verbinden via ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits address"
msgstr "ShowBits-adres"

#: showbits/includes/class-settings-page.php
msgid "ShowBits Cloud: https://app.showbits.ai. OnPremise: the address of your installation."
msgstr "ShowBits Cloud: https://app.showbits.ai. OnPremise: het adres van je installatie."

#: showbits/includes/class-settings-page.php
msgid "Disconnect"
msgstr "Verbinding verbreken"

#: showbits/includes/class-settings-page.php
msgid "Disconnect this site from ShowBits? What is in the media library stays."
msgstr "De verbinding tussen deze site en ShowBits verbreken? Wat in de mediabibliotheek staat, blijft daar."

#: showbits/includes/class-settings-page.php
msgid "asked for"
msgstr "Aangevraagd"

#: showbits/includes/class-settings-page.php
msgid "waiting"
msgstr "In de wachtrij"

#: showbits/includes/class-settings-page.php
msgid "importing"
msgstr "Wordt geïmporteerd"

#: showbits/includes/class-settings-page.php
msgid "imported"
msgstr "Geïmporteerd"

#: showbits/includes/class-settings-page.php
msgid "failed"
msgstr "Mislukt"

#: showbits/includes/class-settings-page.php
msgid "Recent imports"
msgstr "Recente imports"

#: showbits/includes/class-settings-page.php
msgid "When"
msgstr "Wanneer"

#: showbits/includes/class-settings-page.php
msgid "Clip"
msgstr "Clip"

#: showbits/includes/class-settings-page.php
msgid "How"
msgstr "Herkomst"

#: showbits/includes/class-settings-page.php
msgid "State"
msgstr "Status"

#: showbits/includes/class-settings-page.php
msgid "sent from ShowBits"
msgstr "Vanuit ShowBits verzonden"

#: showbits/includes/class-settings-page.php
msgid "picked here"
msgstr "Hier gekozen"

#: showbits/includes/class-settings-page.php
msgid "Connected. The library is under Media → ShowBits."
msgstr "Verbonden. De bibliotheek staat onder Media → ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Disconnected. What is in the media library stays."
msgstr "Verbinding verbroken. Wat in de mediabibliotheek staat, blijft daar."

#: showbits/includes/class-settings-page.php
msgid "Saved."
msgstr "Opgeslagen."

#: showbits/includes/class-settings-page.php
msgid "Connecting was cancelled in ShowBits."
msgstr "Het verbinden is in ShowBits geannuleerd."

#: showbits/includes/class-settings-page.php
msgid "That way back from ShowBits did not belong to this attempt. Start again."
msgstr "De doorverwijzing terug vanuit ShowBits hoort niet bij de verbindingspoging van deze site. Begin opnieuw."

#: showbits/includes/class-settings-page.php
msgid "The ShowBits address must start with https://."
msgstr "Het ShowBits-adres moet met https:// beginnen."

#: showbits/includes/class-settings-page.php
msgid "That is not a site key. Copy it from ShowBits (Integrations → WordPress) again."
msgstr "Dat is geen sitesleutel. Kopieer hem opnieuw uit ShowBits (Integrations → WordPress)."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not take the site key: it is unknown, used, withdrawn or expired (a site key lasts 24 hours, a consent ten minutes). Make a new one."
msgstr "ShowBits heeft de sitesleutel niet geaccepteerd: hij is onbekend, al gebruikt, ingetrokken of verlopen (een sitesleutel is 24 uur geldig, een toestemming tien minuten). Maak een nieuwe aan."

#: showbits/includes/class-settings-page.php
msgid "The site key was made for another address. Make one for this site’s address."
msgstr "De sitesleutel is voor een ander adres aangemaakt. Maak er een aan voor het adres van deze site."

#: showbits/includes/class-settings-page.php
msgid "ShowBits could not reach this site at its REST API (/wp-json/showbits/v1/push), or ShowBits itself could not be reached. The site must be public over HTTPS; a firewall or security plugin must let ShowBits in."
msgstr "ShowBits kon deze site niet bereiken via de REST API (/wp-json/showbits/v1/push), of ShowBits zelf was niet bereikbaar. De site moet openbaar bereikbaar zijn via HTTPS; een firewall of beveiligingsplugin moet ShowBits doorlaten."

#: showbits/includes/class-settings-page.php
msgid "This site did not answer ShowBits’ check as expected. Try again; if it fails again, a cache or security plugin may answer for WordPress."
msgstr "Deze site heeft de controle van ShowBits niet beantwoord zoals verwacht. Probeer het opnieuw; als het weer mislukt, antwoordt er misschien een cache- of beveiligingsplugin in plaats van WordPress."

#: showbits/includes/class-settings-page.php
msgid "The workspace’s plan has ended, or whoever made the site key may no longer connect sites."
msgstr "Het abonnement van de werkruimte is afgelopen, of wie de sitesleutel heeft aangemaakt, mag geen sites meer verbinden."

#: showbits/includes/class-settings-page.php
msgid "The workspace has as many sites as its plan allows."
msgstr "De werkruimte heeft al zoveel sites als het abonnement toestaat."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not accept this site’s address. It must be served over HTTPS."
msgstr "ShowBits heeft het adres van deze site niet geaccepteerd. De site moet via HTTPS worden aangeboden."

#: showbits/includes/class-settings-page.php
msgid "Connecting did not work. Try again, or ask your ShowBits contact."
msgstr "Verbinden is niet gelukt. Probeer het opnieuw of vraag je contactpersoon bij ShowBits om hulp."
