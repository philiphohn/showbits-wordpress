# Hungarian translation of the ShowBits plugin.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: hu_HU\n"
"Plural-Forms: nplurals=2; plural=n != 1;\n"

#. Description of the plugin
#: showbits/showbits.php
msgid "Released clips and quote cards from ShowBits in the media library: pick them in WordPress, or receive what your ShowBits admins send."
msgstr "A ShowBitsben közzétételre jóváhagyott klipek és idézetkártyák a médiatárban: a WordPressben kiválaszthatók, vagy fogadhatók, amikor a ShowBits-adminisztrátorok elküldik őket."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer as expected."
msgstr "A ShowBits nem a várt módon válaszolt."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer with a file."
msgstr "A ShowBits nem küldött fájlt."

#: showbits/includes/class-api-client.php showbits/includes/class-importer.php
msgid "ShowBits could not be reached."
msgstr "A ShowBits nem érhető el."

#. translators: 1: ShowBits' reason, 2: the HTTP status
#: showbits/includes/class-api-client.php
msgid "ShowBits refused (%1$s, HTTP %2$d)."
msgstr "A ShowBits elutasította a kérést (%1$s, HTTP %2$d)."

#: showbits/includes/class-connection.php
msgid "You may not connect this site."
msgstr "Nincs jogosultság a honlap csatlakoztatásához."

#. translators: %s: the clip's title
#: showbits/includes/class-importer.php
msgid "%s (thumbnail)"
msgstr "%s (bélyegkép)"

#. translators: %s: a quote (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%s”"
msgstr "„%s”"

#. translators: 1: a quote, 2: who said it (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%1$s” – %2$s"
msgstr "„%1$s” – %2$s"

#: showbits/includes/class-importer.php
msgid "This is not a clip or a format ShowBits offers."
msgstr "Ez nem a ShowBits által kínált klip vagy formátum."

#: showbits/includes/class-importer.php
msgid "The clip is no longer released in ShowBits."
msgstr "A klip már nincs közzétételre jóváhagyva a ShowBitsben."

#: showbits/includes/class-importer.php
msgid "The embargo still holds: the file stays in ShowBits until it ends."
msgstr "Az embargó még érvényben van: a fájl a ShowBitsben marad, amíg le nem jár."

#: showbits/includes/class-importer.php
msgid "The file is not ready yet in ShowBits."
msgstr "A fájl még nem készült el a ShowBitsben."

#: showbits/includes/class-importer.php
msgid "The file could not be downloaded."
msgstr "A fájlt nem sikerült letölteni."

#: showbits/includes/class-importer.php
msgid "WordPress did not take the file into the media library."
msgstr "A WordPress nem vette fel a fájlt a médiatárba."

#: showbits/includes/class-importer.php
msgid "The delivery from ShowBits is no longer valid. Import the clip again."
msgstr "A ShowBitsből érkezett küldemény már nem érvényes. A klipet újra kell importálni."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer accepts this site’s connection: connect it again under Settings → ShowBits."
msgstr "A ShowBits már nem fogadja el a honlap kapcsolatát: újra kell csatlakoztatni a Beállítások → ShowBits menüpontban."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer delivers to this site: the workspace’s plan has ended."
msgstr "A ShowBits már nem szállít erre a honlapra: a munkaterület előfizetése lejárt."

#: showbits/includes/class-importer.php
msgid "The site’s imports for today are used up. Try again tomorrow."
msgstr "A honlap mai importálási kerete elfogyott. Holnap újra lehet próbálkozni."

#: showbits/includes/class-importer.php
msgid "The import was interrupted."
msgstr "Az importálás megszakadt."

#: showbits/includes/class-importer.php
msgid "The import failed."
msgstr "Az importálás nem sikerült."

#: showbits/includes/class-library-endpoint.php
msgid "This site is not connected to ShowBits."
msgstr "Ez a honlap nincs csatlakoztatva a ShowBitshez."

#: showbits/includes/class-library-page.php
msgid "All"
msgstr "Összes"

#: showbits/includes/class-library-page.php
msgid "Clips"
msgstr "Klipek"

#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Quote cards"
msgstr "Idézetkártyák"

#: showbits/includes/class-library-page.php
msgid "Search titles"
msgstr "Keresés a címekben"

#: showbits/includes/class-library-page.php
msgid "Search the library"
msgstr "Keresés a könyvtárban"

#: showbits/includes/class-library-page.php
msgid "Import selected"
msgstr "Kijelöltek importálása"

#. translators: 1: which one, 2: how many in all
#: showbits/includes/class-library-page.php
msgid "Asking ShowBits for %1$d of %2$d …"
msgstr "Lekérés a ShowBitstől: %1$d/%2$d…"

#. translators: %d: how many clips are still on their way
#: showbits/includes/class-library-page.php
msgid "On the way from ShowBits: %d …"
msgstr "Úton a ShowBitstől: %d…"

#. translators: %d: how many clips were imported
#: showbits/includes/class-library-page.php
msgid "Imported: %d"
msgstr "Importálva: %d"

#: showbits/includes/class-library-page.php
msgid "Not everything has arrived yet; it continues in the background. Settings → ShowBits lists the imports."
msgstr "Még nem érkezett meg minden; a folyamat a háttérben folytatódik. Az importálások a Beállítások → ShowBits oldalon láthatók."

#: showbits/includes/class-library-page.php
msgid "On the way"
msgstr "Úton"

#: showbits/includes/class-library-page.php
msgid "Load more"
msgstr "Továbbiak betöltése"

#: showbits/includes/class-library-page.php
msgid "Loading …"
msgstr "Betöltés…"

#: showbits/includes/class-library-page.php
msgid "No released clips or quote cards yet."
msgstr "Még nincsenek közzétételre jóváhagyott klipek vagy idézetkártyák."

#. translators: %s: date and time the embargo ends
#: showbits/includes/class-library-page.php
msgid "Embargo until %s"
msgstr "Embargó eddig: %s"

#: showbits/includes/class-library-page.php
msgid "Not ready yet"
msgstr "Még nem kész"

#: showbits/includes/class-library-page.php
msgid "In the media library"
msgstr "A médiatárban"

#: showbits/includes/class-library-page.php
msgid "An older version is in the media library"
msgstr "Egy régebbi változat van a médiatárban"

#: showbits/includes/class-library-page.php
msgid "Edit"
msgstr "Szerkesztés"

#: showbits/includes/class-library-page.php
msgid "Format"
msgstr "Formátum"

#: showbits/includes/class-library-page.php
msgid "Video"
msgstr "Videó"

#: showbits/includes/class-library-page.php
msgid "Quote card"
msgstr "Idézetkártya"

#: showbits/includes/class-library-page.php
msgid "Meme"
msgstr "Mém"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "Failed: %s"
msgstr "Sikertelen: %s"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "The library could not be loaded: %s"
msgstr "A könyvtárat nem sikerült betölteni: %s"

#: showbits/includes/class-library-page.php
msgid "This site is not connected to ShowBits yet."
msgstr "Ez a honlap még nincs csatlakoztatva a ShowBitshez."

#: showbits/includes/class-library-page.php
msgid "Connect it in the settings."
msgstr "Csatlakoztatás a beállításokban."

#: showbits/includes/class-library-page.php
msgid "An administrator of this site connects it in the settings."
msgstr "A honlap egy adminisztrátora csatlakoztathatja a beállításokban."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-library-page.php
msgid "Released clips and quote cards from the ShowBits workspace “%s”. What you import lands in the media library, ready for posts and pages."
msgstr "Közzétételre jóváhagyott klipek és idézetkártyák a ShowBits „%s” munkaterületéről. Az importált elemek a médiatárba kerülnek, készen a bejegyzésekhez és oldalakhoz."

#: showbits/includes/class-library-page.php
msgid "The library needs JavaScript."
msgstr "A könyvtár működéséhez JavaScript szükséges."

#: showbits/includes/class-settings-page.php
msgid "Settings"
msgstr "Beállítások"

#: showbits/includes/class-settings-page.php
msgid "You may not change these settings."
msgstr "Nincs jogosultság ezeknek a beállításoknak a módosításához."

#: showbits/includes/class-settings-page.php
msgid "Connection"
msgstr "Kapcsolat"

#. translators: 1: the constant SHOWBITS_ENCRYPTION_KEY, 2: the file wp-config.php (both stay as they are)
#: showbits/includes/class-settings-page.php
msgid "Your site’s security keys are not in %2$s, so the key that protects the connection to ShowBits is stored in the database. Add %1$s with a long random value to %2$s; if the site is connected already, connect it again afterwards."
msgstr "A honlap biztonsági kulcsai nincsenek a %2$s fájlban, ezért a ShowBitshez fűződő kapcsolatot védő kulcs az adatbázisban van tárolva. A %2$s fájlhoz hozzá kell adni a %1$s állandót egy hosszú, véletlenszerű értékkel; ha a honlap már csatlakoztatva van, utána újra kell csatlakoztatni."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-settings-page.php
msgid "Connected to the workspace “%s”."
msgstr "Csatlakoztatva ehhez a munkaterülethez: „%s”."

#. translators: 1: imports today, 2: imports a day the plan allows
#: showbits/includes/class-settings-page.php
msgid "Imports today: %1$d of %2$d."
msgstr "Mai importálások: %1$d/%2$d."

#. translators: 1: a person, 2: a date, 3: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "Connected by %1$s on %2$s, at %3$s."
msgstr "Csatlakoztatta: %1$s (%2$s), cím: %3$s."

#: showbits/includes/class-settings-page.php
msgid "Connect again"
msgstr "Újracsatlakoztatás"

#: showbits/includes/class-settings-page.php
msgid "With a new site key the site renews its connection, or moves to another workspace."
msgstr "Új honlapkulccsal a honlap megújítja a kapcsolatát, vagy átkerül egy másik munkaterületre."

#. translators: %s: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "ShowBits (%s) cannot be reached right now. The connection stays; try again later."
msgstr "A ShowBits (%s) jelenleg nem érhető el. A kapcsolat megmarad; később újra lehet próbálkozni."

#: showbits/includes/class-settings-page.php
msgid "ShowBits no longer accepts this site’s connection: it was disconnected in ShowBits, the plan ended, or this site’s keys changed. Connect it again with a new site key."
msgstr "A ShowBits már nem fogadja el a honlap kapcsolatát: leválasztották a ShowBitsben, lejárt az előfizetés, vagy megváltoztak a honlap kulcsai. Új honlapkulccsal újra kell csatlakoztatni."

#: showbits/includes/class-settings-page.php
msgid "Connect this site to a ShowBits workspace: an admin or owner of the workspace makes a site key for this site in ShowBits (Integrations → WordPress). The site can then take released clips and quote cards into its media library, and receive what your ShowBits admins send."
msgstr "Ezt a honlapot egy ShowBits-munkaterülethez lehet csatlakoztatni: a munkaterület egy adminisztrátora vagy tulajdonosa honlapkulcsot készít ehhez a honlaphoz a ShowBitsben (Integrations → WordPress). Ezután a honlap átveheti a médiatárába a közzétételre jóváhagyott klipeket és idézetkártyákat, és fogadhatja, amit a ShowBits-adminisztrátorok küldenek."

#: showbits/includes/class-settings-page.php
msgid "Imports"
msgstr "Importálások"

#: showbits/includes/class-settings-page.php
msgid "Format of quote cards"
msgstr "Idézetkártyák formátuma"

#: showbits/includes/class-settings-page.php
msgid "4:5 (feeds, articles)"
msgstr "4:5 (hírfolyamok, cikkek)"

#: showbits/includes/class-settings-page.php
msgid "1:1 (square)"
msgstr "1:1 (négyzet)"

#: showbits/includes/class-settings-page.php
msgid "9:16 (stories)"
msgstr "9:16 (történetek)"

#: showbits/includes/class-settings-page.php
msgid "The picture pushes bring; in the library you choose for each card."
msgstr "Ilyen formátumban érkeznek a küldött kártyák; a könyvtárban kártyánként lehet választani."

#: showbits/includes/class-settings-page.php
msgid "Videos"
msgstr "Videók"

#: showbits/includes/class-settings-page.php
msgid "Import the thumbnail as the video’s poster image"
msgstr "A bélyegkép importálása a videó poszterképeként"

#: showbits/includes/class-settings-page.php
msgid "Save"
msgstr "Mentés"

#: showbits/includes/class-settings-page.php
msgid "Site key"
msgstr "Honlapkulcs"

#. translators: %s: this site's address
#: showbits/includes/class-settings-page.php
msgid "Made in ShowBits for %s, valid for 24 hours and only once. ShowBits then checks that it is talking to this site."
msgstr "A ShowBitsben készül ehhez a címhez: %s. Egyszer használható, és 24 óráig érvényes. Ezután a ShowBits ellenőrzi, hogy valóban ezzel a honlappal kommunikál."

#: showbits/includes/class-settings-page.php
msgid "Connect"
msgstr "Csatlakoztatás"

#: showbits/includes/class-settings-page.php
msgid "Are you an admin or owner of the workspace yourself? Then sign in to ShowBits and agree there, without a site key:"
msgstr "Munkaterület-adminisztrátorként vagy -tulajdonosként honlapkulcs nélkül is lehet csatlakoztatni: be kell jelentkezni a ShowBitsbe, és ott hozzá kell járulni:"

#: showbits/includes/class-settings-page.php
msgid "Connect through ShowBits"
msgstr "Csatlakoztatás a ShowBitsen keresztül"

#: showbits/includes/class-settings-page.php
msgid "ShowBits address"
msgstr "ShowBits címe"

#: showbits/includes/class-settings-page.php
msgid "ShowBits Cloud: https://app.showbits.ai. OnPremise: the address of your installation."
msgstr "ShowBits Cloud: https://app.showbits.ai. OnPremise: a saját telepítés címe."

#: showbits/includes/class-settings-page.php
msgid "Disconnect"
msgstr "Leválasztás"

#: showbits/includes/class-settings-page.php
msgid "Disconnect this site from ShowBits? What is in the media library stays."
msgstr "Leválasztjuk a honlapot a ShowBitsről? Ami a médiatárban van, megmarad."

#: showbits/includes/class-settings-page.php
msgid "asked for"
msgstr "lekérve"

#: showbits/includes/class-settings-page.php
msgid "waiting"
msgstr "várakozik"

#: showbits/includes/class-settings-page.php
msgid "importing"
msgstr "importálás alatt"

#: showbits/includes/class-settings-page.php
msgid "imported"
msgstr "importálva"

#: showbits/includes/class-settings-page.php
msgid "failed"
msgstr "sikertelen"

#: showbits/includes/class-settings-page.php
msgid "Recent imports"
msgstr "Legutóbbi importálások"

#: showbits/includes/class-settings-page.php
msgid "When"
msgstr "Mikor"

#: showbits/includes/class-settings-page.php
msgid "Clip"
msgstr "Klip"

#: showbits/includes/class-settings-page.php
msgid "How"
msgstr "Mód"

#: showbits/includes/class-settings-page.php
msgid "State"
msgstr "Állapot"

#: showbits/includes/class-settings-page.php
msgid "sent from ShowBits"
msgstr "a ShowBitsből küldve"

#: showbits/includes/class-settings-page.php
msgid "picked here"
msgstr "itt kiválasztva"

#: showbits/includes/class-settings-page.php
msgid "Connected. The library is under Media → ShowBits."
msgstr "Csatlakoztatva. A könyvtár a Média → ShowBits menüpontban található."

#: showbits/includes/class-settings-page.php
msgid "Disconnected. What is in the media library stays."
msgstr "Leválasztva. Ami a médiatárban van, megmarad."

#: showbits/includes/class-settings-page.php
msgid "Saved."
msgstr "Mentve."

#: showbits/includes/class-settings-page.php
msgid "Connecting was cancelled in ShowBits."
msgstr "A csatlakoztatást megszakították a ShowBitsben."

#: showbits/includes/class-settings-page.php
msgid "That way back from ShowBits did not belong to this attempt. Start again."
msgstr "Ez a visszairányítás a ShowBitsből nem ehhez a csatlakozási kísérlethez tartozott. Elölről kell kezdeni."

#: showbits/includes/class-settings-page.php
msgid "The ShowBits address must start with https://."
msgstr "A ShowBits címének https:// előtaggal kell kezdődnie."

#: showbits/includes/class-settings-page.php
msgid "That is not a site key. Copy it from ShowBits (Integrations → WordPress) again."
msgstr "Ez nem honlapkulcs. Újra ki kell másolni a ShowBitsből (Integrations → WordPress)."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not take the site key: it is unknown, used, withdrawn or expired (a site key lasts 24 hours, a consent ten minutes). Make a new one."
msgstr "A ShowBits nem fogadta el a honlapkulcsot: ismeretlen, már felhasznált, visszavont vagy lejárt (a honlapkulcs 24 óráig érvényes, a hozzájárulás tíz percig). Újat kell készíteni."

#: showbits/includes/class-settings-page.php
msgid "The site key was made for another address. Make one for this site’s address."
msgstr "A honlapkulcs egy másik címhez készült. Ennek a honlapnak a címéhez kell egyet készíteni."

#: showbits/includes/class-settings-page.php
msgid "ShowBits could not reach this site at its REST API (/wp-json/showbits/v1/push), or ShowBits itself could not be reached. The site must be public over HTTPS; a firewall or security plugin must let ShowBits in."
msgstr "A ShowBits nem érte el ezt a honlapot a REST API-ján keresztül (/wp-json/showbits/v1/push), vagy maga a ShowBits nem volt elérhető. A honlapnak nyilvánosan elérhetőnek kell lennie HTTPS-en; a tűzfalnak vagy a biztonsági bővítménynek át kell engednie a ShowBits kéréseit."

#: showbits/includes/class-settings-page.php
msgid "This site did not answer ShowBits’ check as expected. Try again; if it fails again, a cache or security plugin may answer for WordPress."
msgstr "Ez a honlap nem a várt módon válaszolt a ShowBits ellenőrzésére. Próbáljuk meg újra; ha ismét nem sikerül, lehet, hogy egy gyorstár- vagy biztonsági bővítmény válaszol a WordPress helyett."

#: showbits/includes/class-settings-page.php
msgid "The workspace’s plan has ended, or whoever made the site key may no longer connect sites."
msgstr "A munkaterület előfizetése lejárt, vagy aki a honlapkulcsot készítette, már nem csatlakoztathat honlapokat."

#: showbits/includes/class-settings-page.php
msgid "The workspace has as many sites as its plan allows."
msgstr "A munkaterületen már annyi honlap van, amennyit az előfizetése enged."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not accept this site’s address. It must be served over HTTPS."
msgstr "A ShowBits nem fogadta el a honlap címét. A honlapot HTTPS-en keresztül kell kiszolgálni."

#: showbits/includes/class-settings-page.php
msgid "Connecting did not work. Try again, or ask your ShowBits contact."
msgstr "A csatlakoztatás nem sikerült. Próbáljuk meg újra, vagy kérdezzük meg a ShowBits-kapcsolattartót."
