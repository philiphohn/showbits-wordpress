# Danish translation of the ShowBits plugin.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: da_DK\n"
"Plural-Forms: nplurals=2; plural=n != 1;\n"

#. Description of the plugin
#: showbits/showbits.php
msgid "Released clips and quote cards from ShowBits in the media library: pick them in WordPress, or receive what your ShowBits admins send."
msgstr "Frigivne klip og citatkort fra ShowBits i mediebiblioteket: Vælg dem i WordPress, eller modtag det, dine administratorer i ShowBits sender."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer as expected."
msgstr "ShowBits svarede ikke som forventet."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer with a file."
msgstr "ShowBits leverede ingen fil."

#: showbits/includes/class-api-client.php showbits/includes/class-importer.php
msgid "ShowBits could not be reached."
msgstr "ShowBits kunne ikke nås."

#. translators: 1: ShowBits' reason, 2: the HTTP status
#: showbits/includes/class-api-client.php
msgid "ShowBits refused (%1$s, HTTP %2$d)."
msgstr "ShowBits afviste (%1$s, HTTP %2$d)."

#: showbits/includes/class-connection.php
msgid "You may not connect this site."
msgstr "Du har ikke tilladelse til at forbinde dette websted."

#. translators: %s: the clip's title
#: showbits/includes/class-importer.php
msgid "%s (thumbnail)"
msgstr "%s (miniaturebillede)"

#. translators: %s: a quote (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%s”"
msgstr "»%s«"

#. translators: 1: a quote, 2: who said it (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%1$s” – %2$s"
msgstr "»%1$s« – %2$s"

#: showbits/includes/class-importer.php
msgid "This is not a clip or a format ShowBits offers."
msgstr "Dette er ikke et klip eller et format, som ShowBits tilbyder."

#: showbits/includes/class-importer.php
msgid "The clip is no longer released in ShowBits."
msgstr "Klippet er ikke længere frigivet i ShowBits."

#: showbits/includes/class-importer.php
msgid "The embargo still holds: the file stays in ShowBits until it ends."
msgstr "Embargoen gælder stadig: Filen bliver i ShowBits, indtil embargoen udløber."

#: showbits/includes/class-importer.php
msgid "The file is not ready yet in ShowBits."
msgstr "Filen er endnu ikke klar i ShowBits."

#: showbits/includes/class-importer.php
msgid "The file could not be downloaded."
msgstr "Filen kunne ikke downloades."

#: showbits/includes/class-importer.php
msgid "WordPress did not take the file into the media library."
msgstr "WordPress tilføjede ikke filen til mediebiblioteket."

#: showbits/includes/class-importer.php
msgid "The delivery from ShowBits is no longer valid. Import the clip again."
msgstr "Leveringen fra ShowBits er ikke længere gyldig. Importér klippet igen."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer accepts this site’s connection: connect it again under Settings → ShowBits."
msgstr "ShowBits accepterer ikke længere forbindelsen til dette websted: Forbind det igen under Indstillinger → ShowBits."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer delivers to this site: the workspace’s plan has ended."
msgstr "ShowBits leverer ikke længere til dette websted: Arbejdsområdets abonnement er udløbet."

#: showbits/includes/class-importer.php
msgid "The site’s imports for today are used up. Try again tomorrow."
msgstr "Dagens importer for dette websted er brugt op. Prøv igen i morgen."

#: showbits/includes/class-importer.php
msgid "The import was interrupted."
msgstr "Importen blev afbrudt."

#: showbits/includes/class-importer.php
msgid "The import failed."
msgstr "Importen mislykkedes."

#: showbits/includes/class-library-endpoint.php
msgid "This site is not connected to ShowBits."
msgstr "Dette websted er ikke forbundet med ShowBits."

#: showbits/includes/class-library-page.php
msgid "All"
msgstr "Alle"

#: showbits/includes/class-library-page.php
msgid "Clips"
msgstr "Klip"

#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Quote cards"
msgstr "Citatkort"

#: showbits/includes/class-library-page.php
msgid "Search titles"
msgstr "Søg i titler"

#: showbits/includes/class-library-page.php
msgid "Search the library"
msgstr "Søg i biblioteket"

#: showbits/includes/class-library-page.php
msgid "Import selected"
msgstr "Importér valgte"

#. translators: 1: which one, 2: how many in all
#: showbits/includes/class-library-page.php
msgid "Asking ShowBits for %1$d of %2$d …"
msgstr "Beder ShowBits om %1$d af %2$d…"

#. translators: %d: how many clips are still on their way
#: showbits/includes/class-library-page.php
msgid "On the way from ShowBits: %d …"
msgstr "På vej fra ShowBits: %d…"

#. translators: %d: how many clips were imported
#: showbits/includes/class-library-page.php
msgid "Imported: %d"
msgstr "Importeret: %d"

#: showbits/includes/class-library-page.php
msgid "Not everything has arrived yet; it continues in the background. Settings → ShowBits lists the imports."
msgstr "Ikke alt er kommet frem endnu; det fortsætter i baggrunden. Indstillinger → ShowBits viser importerne."

#: showbits/includes/class-library-page.php
msgid "On the way"
msgstr "På vej"

#: showbits/includes/class-library-page.php
msgid "Load more"
msgstr "Indlæs flere"

#: showbits/includes/class-library-page.php
msgid "Loading …"
msgstr "Indlæser…"

#: showbits/includes/class-library-page.php
msgid "No released clips or quote cards yet."
msgstr "Ingen frigivne klip eller citatkort endnu."

#. translators: %s: date and time the embargo ends
#: showbits/includes/class-library-page.php
msgid "Embargo until %s"
msgstr "Embargo indtil %s"

#: showbits/includes/class-library-page.php
msgid "Not ready yet"
msgstr "Ikke klar endnu"

#: showbits/includes/class-library-page.php
msgid "In the media library"
msgstr "I mediebiblioteket"

#: showbits/includes/class-library-page.php
msgid "An older version is in the media library"
msgstr "En ældre version ligger i mediebiblioteket"

#: showbits/includes/class-library-page.php
msgid "Edit"
msgstr "Rediger"

#: showbits/includes/class-library-page.php
msgid "Format"
msgstr "Format"

#. translators: %s: a quote card's format, such as 9:16 or "9:16 (stories)" (its animated video with the speaker's voice)
#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Animated %s"
msgstr "Animeret %s"

#: showbits/includes/class-library-page.php
msgid "Video"
msgstr "Video"

#: showbits/includes/class-library-page.php
msgid "Quote card"
msgstr "Citatkort"

#: showbits/includes/class-library-page.php
msgid "Meme"
msgstr "Meme"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "Failed: %s"
msgstr "Mislykkedes: %s"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "The library could not be loaded: %s"
msgstr "Biblioteket kunne ikke indlæses: %s"

#: showbits/includes/class-library-page.php
msgid "This site is not connected to ShowBits yet."
msgstr "Dette websted er endnu ikke forbundet med ShowBits."

#: showbits/includes/class-library-page.php
msgid "Connect it in the settings."
msgstr "Forbind det i indstillingerne."

#: showbits/includes/class-library-page.php
msgid "An administrator of this site connects it in the settings."
msgstr "En administrator for dette websted skal forbinde det i indstillingerne."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-library-page.php
msgid "Released clips and quote cards from the ShowBits workspace “%s”. What you import lands in the media library, ready for posts and pages."
msgstr "Frigivne klip og citatkort fra ShowBits-arbejdsområdet »%s«. Det, du importerer, havner i mediebiblioteket, klart til indlæg og sider."

#: showbits/includes/class-library-page.php
msgid "The library needs JavaScript."
msgstr "Biblioteket kræver JavaScript."

#: showbits/includes/class-settings-page.php
msgid "Settings"
msgstr "Indstillinger"

#: showbits/includes/class-settings-page.php
msgid "You may not change these settings."
msgstr "Du har ikke tilladelse til at ændre disse indstillinger."

#: showbits/includes/class-settings-page.php
msgid "Connection"
msgstr "Forbindelse"

#. translators: 1: the constant SHOWBITS_ENCRYPTION_KEY, 2: the file wp-config.php (both stay as they are)
#: showbits/includes/class-settings-page.php
msgid "Your site’s security keys are not in %2$s, so the key that protects the connection to ShowBits is stored in the database. Add %1$s with a long random value to %2$s; if the site is connected already, connect it again afterwards."
msgstr "Dit websteds sikkerhedsnøgler er ikke i %2$s, så nøglen, der beskytter forbindelsen til ShowBits, gemmes i databasen. Tilføj %1$s med en lang tilfældig værdi i %2$s; hvis webstedet allerede er forbundet, skal du forbinde det igen bagefter."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-settings-page.php
msgid "Connected to the workspace “%s”."
msgstr "Forbundet med arbejdsområdet »%s«."

#. translators: 1: imports today, 2: imports a day the plan allows
#: showbits/includes/class-settings-page.php
msgid "Imports today: %1$d of %2$d."
msgstr "Importer i dag: %1$d af %2$d."

#. translators: 1: a person, 2: a date, 3: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "Connected by %1$s on %2$s, at %3$s."
msgstr "Forbundet med %3$s af %1$s den %2$s."

#: showbits/includes/class-settings-page.php
msgid "Connect again"
msgstr "Forbind igen"

#: showbits/includes/class-settings-page.php
msgid "With a new site key the site renews its connection, or moves to another workspace."
msgstr "Med en ny webstedsnøgle fornyer webstedet sin forbindelse eller flytter til et andet arbejdsområde."

#. translators: %s: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "ShowBits (%s) cannot be reached right now. The connection stays; try again later."
msgstr "ShowBits (%s) kan ikke nås lige nu. Forbindelsen bevares; prøv igen senere."

#: showbits/includes/class-settings-page.php
msgid "ShowBits no longer accepts this site’s connection: it was disconnected in ShowBits, the plan ended, or this site’s keys changed. Connect it again with a new site key."
msgstr "ShowBits accepterer ikke længere forbindelsen til dette websted: Den er blevet afbrudt i ShowBits, abonnementet er udløbet, eller webstedets nøgler er blevet ændret. Forbind det igen med en ny webstedsnøgle."

#: showbits/includes/class-settings-page.php
msgid "Connect this site to a ShowBits workspace: an admin or owner of the workspace makes a site key for this site in ShowBits (Integrations → WordPress). The site can then take released clips and quote cards into its media library, and receive what your ShowBits admins send."
msgstr "Forbind dette websted med et ShowBits-arbejdsområde: En administrator eller ejer af arbejdsområdet opretter en webstedsnøgle til dette websted i ShowBits (Integrations → WordPress). Derefter kan webstedet hente frigivne klip og citatkort ind i sit mediebibliotek og modtage det, dine administratorer i ShowBits sender."

#: showbits/includes/class-settings-page.php
msgid "Imports"
msgstr "Import"

#: showbits/includes/class-settings-page.php
msgid "Format of quote cards"
msgstr "Format for citatkort"

#: showbits/includes/class-settings-page.php
msgid "4:5 (feeds, articles)"
msgstr "4:5 (feeds, artikler)"

#: showbits/includes/class-settings-page.php
msgid "1:1 (square)"
msgstr "1:1 (kvadratisk)"

#: showbits/includes/class-settings-page.php
msgid "9:16 (stories)"
msgstr "9:16 (stories)"

#: showbits/includes/class-settings-page.php
msgid "The picture pushes bring; in the library you choose for each card."
msgstr "Formatet for kort, der sendes hertil; i biblioteket vælger du det for hvert kort."

#: showbits/includes/class-settings-page.php
msgid "Videos"
msgstr "Videoer"

#: showbits/includes/class-settings-page.php
msgid "Import the thumbnail as the video’s poster image"
msgstr "Importér miniaturebilledet som videoens plakatbillede"

#: showbits/includes/class-settings-page.php
msgid "Save"
msgstr "Gem"

#: showbits/includes/class-settings-page.php
msgid "Site key"
msgstr "Webstedsnøgle"

#. translators: %s: this site's address
#: showbits/includes/class-settings-page.php
msgid "Made in ShowBits for %s, valid for 24 hours and only once. ShowBits then checks that it is talking to this site."
msgstr "Oprettet i ShowBits til %s, gyldig i 24 timer og kun til én brug. ShowBits kontrollerer derefter, at det taler med netop dette websted."

#: showbits/includes/class-settings-page.php
msgid "Connect"
msgstr "Forbind"

#: showbits/includes/class-settings-page.php
msgid "Are you an admin or owner of the workspace yourself? Then sign in to ShowBits and agree there, without a site key:"
msgstr "Er du selv administrator eller ejer af arbejdsområdet? Så log ind på ShowBits, og giv samtykke der, uden webstedsnøgle:"

#: showbits/includes/class-settings-page.php
msgid "Connect through ShowBits"
msgstr "Forbind via ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits address"
msgstr "ShowBits-adresse"

#: showbits/includes/class-settings-page.php
msgid "ShowBits Cloud: https://app.showbits.ai. OnPremise: the address of your installation."
msgstr "ShowBits Cloud: https://app.showbits.ai. OnPremise: adressen på din installation."

#: showbits/includes/class-settings-page.php
msgid "Disconnect"
msgstr "Afbryd forbindelsen"

#: showbits/includes/class-settings-page.php
msgid "Disconnect this site from ShowBits? What is in the media library stays."
msgstr "Afbryd forbindelsen mellem dette websted og ShowBits? Det, der ligger i mediebiblioteket, bliver liggende."

#: showbits/includes/class-settings-page.php
msgid "asked for"
msgstr "Anmodet"

#: showbits/includes/class-settings-page.php
msgid "waiting"
msgstr "I kø"

#: showbits/includes/class-settings-page.php
msgid "importing"
msgstr "Importeres"

#: showbits/includes/class-settings-page.php
msgid "imported"
msgstr "Importeret"

#: showbits/includes/class-settings-page.php
msgid "failed"
msgstr "Mislykkedes"

#: showbits/includes/class-settings-page.php
msgid "Recent imports"
msgstr "Seneste importer"

#: showbits/includes/class-settings-page.php
msgid "When"
msgstr "Hvornår"

#: showbits/includes/class-settings-page.php
msgid "Clip"
msgstr "Klip"

#: showbits/includes/class-settings-page.php
msgid "How"
msgstr "Kilde"

#: showbits/includes/class-settings-page.php
msgid "State"
msgstr "Status"

#: showbits/includes/class-settings-page.php
msgid "sent from ShowBits"
msgstr "Sendt fra ShowBits"

#: showbits/includes/class-settings-page.php
msgid "picked here"
msgstr "Valgt her"

#: showbits/includes/class-settings-page.php
msgid "Connected. The library is under Media → ShowBits."
msgstr "Forbundet. Biblioteket finder du under Medier → ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Disconnected. What is in the media library stays."
msgstr "Forbindelsen er afbrudt. Det, der ligger i mediebiblioteket, bliver liggende."

#: showbits/includes/class-settings-page.php
msgid "Saved."
msgstr "Gemt."

#: showbits/includes/class-settings-page.php
msgid "Connecting was cancelled in ShowBits."
msgstr "Oprettelsen af forbindelsen blev annulleret i ShowBits."

#: showbits/includes/class-settings-page.php
msgid "That way back from ShowBits did not belong to this attempt. Start again."
msgstr "Omdirigeringen tilbage fra ShowBits hører ikke til dette websteds forbindelsesforsøg. Start forfra."

#: showbits/includes/class-settings-page.php
msgid "The ShowBits address must start with https://."
msgstr "ShowBits-adressen skal begynde med https://."

#: showbits/includes/class-settings-page.php
msgid "That is not a site key. Copy it from ShowBits (Integrations → WordPress) again."
msgstr "Det er ikke en webstedsnøgle. Kopiér den igen fra ShowBits (Integrations → WordPress)."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not take the site key: it is unknown, used, withdrawn or expired (a site key lasts 24 hours, a consent ten minutes). Make a new one."
msgstr "ShowBits accepterede ikke webstedsnøglen: Den er ukendt, brugt, trukket tilbage eller udløbet (en webstedsnøgle gælder i 24 timer, et samtykke i ti minutter). Opret en ny."

#: showbits/includes/class-settings-page.php
msgid "The site key was made for another address. Make one for this site’s address."
msgstr "Webstedsnøglen blev oprettet til en anden adresse. Opret en til dette websteds adresse."

#: showbits/includes/class-settings-page.php
msgid "ShowBits could not reach this site at its REST API (/wp-json/showbits/v1/push), or ShowBits itself could not be reached. The site must be public over HTTPS; a firewall or security plugin must let ShowBits in."
msgstr "ShowBits kunne ikke nå dette websted via dets REST-API (/wp-json/showbits/v1/push), eller ShowBits selv kunne ikke nås. Webstedet skal være offentligt tilgængeligt via HTTPS; en firewall eller et sikkerhedsplugin skal lukke ShowBits ind."

#: showbits/includes/class-settings-page.php
msgid "This site did not answer ShowBits’ check as expected. Try again; if it fails again, a cache or security plugin may answer for WordPress."
msgstr "Dette websted besvarede ikke kontrollen fra ShowBits som forventet. Prøv igen; hvis det mislykkes igen, svarer et cache- eller sikkerhedsplugin måske i stedet for WordPress."

#: showbits/includes/class-settings-page.php
msgid "The workspace’s plan has ended, or whoever made the site key may no longer connect sites."
msgstr "Arbejdsområdets abonnement er udløbet, eller den, der oprettede webstedsnøglen, må ikke længere forbinde websteder."

#: showbits/includes/class-settings-page.php
msgid "The workspace has as many sites as its plan allows."
msgstr "Arbejdsområdet har allerede så mange websteder, som abonnementet tillader."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not accept this site’s address. It must be served over HTTPS."
msgstr "ShowBits accepterede ikke dette websteds adresse. Webstedet skal leveres via HTTPS."

#: showbits/includes/class-settings-page.php
msgid "Connecting did not work. Try again, or ask your ShowBits contact."
msgstr "Forbindelsen kunne ikke oprettes. Prøv igen, eller spørg din kontaktperson hos ShowBits."
