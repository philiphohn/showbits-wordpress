# Korean translation of the ShowBits plugin.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: ko_KR\n"
"Plural-Forms: nplurals=1; plural=0;\n"

#. Description of the plugin
#: showbits/showbits.php
msgid "Released clips and quote cards from ShowBits in the media library: pick them in WordPress, or receive what your ShowBits admins send."
msgstr "ShowBits에서 게시 승인된 클립과 인용 카드를 미디어 라이브러리로 가져옵니다. WordPress에서 직접 고르거나, ShowBits 관리자가 보내는 항목을 받을 수 있습니다."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer as expected."
msgstr "ShowBits가 예상대로 응답하지 않았습니다."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer with a file."
msgstr "ShowBits가 파일을 반환하지 않았습니다."

#: showbits/includes/class-api-client.php showbits/includes/class-importer.php
msgid "ShowBits could not be reached."
msgstr "ShowBits에 접속할 수 없습니다."

#. translators: 1: ShowBits' reason, 2: the HTTP status
#: showbits/includes/class-api-client.php
msgid "ShowBits refused (%1$s, HTTP %2$d)."
msgstr "ShowBits가 요청을 거부했습니다(%1$s, HTTP %2$d)."

#: showbits/includes/class-connection.php
msgid "You may not connect this site."
msgstr "이 사이트를 연결할 권한이 없습니다."

#. translators: %s: the clip's title
#: showbits/includes/class-importer.php
msgid "%s (thumbnail)"
msgstr "%s (썸네일)"

#. translators: %s: a quote (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%s”"
msgstr "“%s”"

#. translators: 1: a quote, 2: who said it (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%1$s” – %2$s"
msgstr "“%1$s” – %2$s"

#: showbits/includes/class-importer.php
msgid "This is not a clip or a format ShowBits offers."
msgstr "클립이 아니거나 ShowBits에서 제공하지 않는 이미지 비율입니다."

#: showbits/includes/class-importer.php
msgid "The clip is no longer released in ShowBits."
msgstr "이 클립은 ShowBits에서 게시 승인이 취소되었습니다."

#: showbits/includes/class-importer.php
msgid "The embargo still holds: the file stays in ShowBits until it ends."
msgstr "엠바고가 아직 유효합니다. 엠바고가 끝날 때까지 파일은 ShowBits에 남아 있습니다."

#: showbits/includes/class-importer.php
msgid "The file is not ready yet in ShowBits."
msgstr "ShowBits에서 파일이 아직 준비되지 않았습니다."

#: showbits/includes/class-importer.php
msgid "The file could not be downloaded."
msgstr "파일을 다운로드할 수 없습니다."

#: showbits/includes/class-importer.php
msgid "WordPress did not take the file into the media library."
msgstr "WordPress가 파일을 미디어 라이브러리에 추가하지 않았습니다."

#: showbits/includes/class-importer.php
msgid "The delivery from ShowBits is no longer valid. Import the clip again."
msgstr "ShowBits에서 보낸 전송 정보가 더 이상 유효하지 않습니다. 클립을 다시 가져오세요."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer accepts this site’s connection: connect it again under Settings → ShowBits."
msgstr "ShowBits가 더 이상 이 사이트의 연결을 받아들이지 않습니다. 설정 → ShowBits에서 다시 연결하세요."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer delivers to this site: the workspace’s plan has ended."
msgstr "워크스페이스의 요금제가 종료되어 ShowBits가 더 이상 이 사이트로 전송하지 않습니다."

#: showbits/includes/class-importer.php
msgid "The site’s imports for today are used up. Try again tomorrow."
msgstr "이 사이트의 오늘 가져오기 횟수를 모두 사용했습니다. 내일 다시 시도하세요."

#: showbits/includes/class-importer.php
msgid "The import was interrupted."
msgstr "가져오기가 중단되었습니다."

#: showbits/includes/class-importer.php
msgid "The import failed."
msgstr "가져오기에 실패했습니다."

#: showbits/includes/class-library-endpoint.php
msgid "This site is not connected to ShowBits."
msgstr "이 사이트는 ShowBits에 연결되어 있지 않습니다."

#: showbits/includes/class-library-page.php
msgid "All"
msgstr "모두"

#: showbits/includes/class-library-page.php
msgid "Clips"
msgstr "클립"

#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Quote cards"
msgstr "인용 카드"

#: showbits/includes/class-library-page.php
msgid "Search titles"
msgstr "제목 검색"

#: showbits/includes/class-library-page.php
msgid "Search the library"
msgstr "라이브러리 검색"

#: showbits/includes/class-library-page.php
msgid "Import selected"
msgstr "선택 항목 가져오기"

#. translators: 1: which one, 2: how many in all
#: showbits/includes/class-library-page.php
msgid "Asking ShowBits for %1$d of %2$d …"
msgstr "ShowBits에 요청 중: %2$d개 중 %1$d번째…"

#. translators: %d: how many clips are still on their way
#: showbits/includes/class-library-page.php
msgid "On the way from ShowBits: %d …"
msgstr "ShowBits에서 전송 중: %d개…"

#. translators: %d: how many clips were imported
#: showbits/includes/class-library-page.php
msgid "Imported: %d"
msgstr "가져오기 완료: %d개"

#: showbits/includes/class-library-page.php
msgid "Not everything has arrived yet; it continues in the background. Settings → ShowBits lists the imports."
msgstr "아직 모두 도착하지 않았습니다. 백그라운드에서 계속 진행됩니다. 가져오기 목록은 설정 → ShowBits에서 볼 수 있습니다."

#: showbits/includes/class-library-page.php
msgid "On the way"
msgstr "전송 중"

#: showbits/includes/class-library-page.php
msgid "Load more"
msgstr "더 불러오기"

#: showbits/includes/class-library-page.php
msgid "Loading …"
msgstr "불러오는 중…"

#: showbits/includes/class-library-page.php
msgid "No released clips or quote cards yet."
msgstr "아직 게시 승인된 클립이나 인용 카드가 없습니다."

#. translators: %s: date and time the embargo ends
#: showbits/includes/class-library-page.php
msgid "Embargo until %s"
msgstr "%s까지 엠바고"

#: showbits/includes/class-library-page.php
msgid "Not ready yet"
msgstr "아직 준비되지 않음"

#: showbits/includes/class-library-page.php
msgid "In the media library"
msgstr "미디어 라이브러리에 있음"

#: showbits/includes/class-library-page.php
msgid "An older version is in the media library"
msgstr "미디어 라이브러리에 이전 버전이 있음"

#: showbits/includes/class-library-page.php
msgid "Edit"
msgstr "편집"

#: showbits/includes/class-library-page.php
msgid "Format"
msgstr "비율"

#. translators: %s: a quote card's format, such as 9:16 or "9:16 (stories)" (its animated video with the speaker's voice)
#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Animated %s"
msgstr "애니메이션 %s"

#: showbits/includes/class-library-page.php
msgid "Video"
msgstr "비디오"

#: showbits/includes/class-library-page.php
msgid "Quote card"
msgstr "인용 카드"

#: showbits/includes/class-library-page.php
msgid "Meme"
msgstr "밈"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "Failed: %s"
msgstr "실패: %s"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "The library could not be loaded: %s"
msgstr "라이브러리를 불러올 수 없습니다: %s"

#: showbits/includes/class-library-page.php
msgid "This site is not connected to ShowBits yet."
msgstr "이 사이트는 아직 ShowBits에 연결되지 않았습니다."

#: showbits/includes/class-library-page.php
msgid "Connect it in the settings."
msgstr "설정에서 연결하세요."

#: showbits/includes/class-library-page.php
msgid "An administrator of this site connects it in the settings."
msgstr "이 사이트의 관리자가 설정에서 연결해야 합니다."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-library-page.php
msgid "Released clips and quote cards from the ShowBits workspace “%s”. What you import lands in the media library, ready for posts and pages."
msgstr "ShowBits 워크스페이스 “%s”의 게시 승인된 클립과 인용 카드입니다. 가져온 항목은 미디어 라이브러리에 저장되어 글과 페이지에 바로 사용할 수 있습니다."

#: showbits/includes/class-library-page.php
msgid "The library needs JavaScript."
msgstr "라이브러리를 사용하려면 JavaScript가 필요합니다."

#: showbits/includes/class-settings-page.php
msgid "Settings"
msgstr "설정"

#: showbits/includes/class-settings-page.php
msgid "You may not change these settings."
msgstr "이 설정을 변경할 권한이 없습니다."

#: showbits/includes/class-settings-page.php
msgid "Connection"
msgstr "연결"

#. translators: 1: the constant SHOWBITS_ENCRYPTION_KEY, 2: the file wp-config.php (both stay as they are)
#: showbits/includes/class-settings-page.php
msgid "Your site’s security keys are not in %2$s, so the key that protects the connection to ShowBits is stored in the database. Add %1$s with a long random value to %2$s; if the site is connected already, connect it again afterwards."
msgstr "사이트의 보안 키가 %2$s에 없으므로 ShowBits 연결을 보호하는 키가 데이터베이스에 저장되어 있습니다. %2$s에 긴 임의의 값으로 %1$s을(를) 추가하세요. 사이트가 이미 연결되어 있다면 그 후에 다시 연결하세요."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-settings-page.php
msgid "Connected to the workspace “%s”."
msgstr "워크스페이스 “%s”에 연결되었습니다."

#. translators: 1: imports today, 2: imports a day the plan allows
#: showbits/includes/class-settings-page.php
msgid "Imports today: %1$d of %2$d."
msgstr "오늘 가져오기 횟수: %1$d/%2$d."

#. translators: 1: a person, 2: a date, 3: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "Connected by %1$s on %2$s, at %3$s."
msgstr "%1$s 님이 %2$s에 %3$s 주소로 연결했습니다."

#: showbits/includes/class-settings-page.php
msgid "Connect again"
msgstr "다시 연결"

#: showbits/includes/class-settings-page.php
msgid "With a new site key the site renews its connection, or moves to another workspace."
msgstr "새 사이트 키를 사용하면 사이트의 연결을 갱신하거나 다른 워크스페이스로 옮길 수 있습니다."

#. translators: %s: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "ShowBits (%s) cannot be reached right now. The connection stays; try again later."
msgstr "지금은 ShowBits(%s)에 접속할 수 없습니다. 연결은 유지됩니다. 나중에 다시 시도하세요."

#: showbits/includes/class-settings-page.php
msgid "ShowBits no longer accepts this site’s connection: it was disconnected in ShowBits, the plan ended, or this site’s keys changed. Connect it again with a new site key."
msgstr "ShowBits가 더 이상 이 사이트의 연결을 받아들이지 않습니다. ShowBits에서 연결이 해제되었거나, 요금제가 종료되었거나, 이 사이트의 키가 변경되었습니다. 새 사이트 키로 다시 연결하세요."

#: showbits/includes/class-settings-page.php
msgid "Connect this site to a ShowBits workspace: an admin or owner of the workspace makes a site key for this site in ShowBits (Integrations → WordPress). The site can then take released clips and quote cards into its media library, and receive what your ShowBits admins send."
msgstr "이 사이트를 ShowBits 워크스페이스에 연결하세요. 워크스페이스의 관리자나 소유자가 ShowBits(Integrations → WordPress)에서 이 사이트용 사이트 키를 만듭니다. 그러면 이 사이트가 게시 승인된 클립과 인용 카드를 미디어 라이브러리로 가져올 수 있고, ShowBits 관리자가 보내는 항목도 받을 수 있습니다."

#: showbits/includes/class-settings-page.php
msgid "Imports"
msgstr "가져오기"

#: showbits/includes/class-settings-page.php
msgid "Format of quote cards"
msgstr "인용 카드 비율"

#: showbits/includes/class-settings-page.php
msgid "4:5 (feeds, articles)"
msgstr "4:5 (피드, 기사)"

#: showbits/includes/class-settings-page.php
msgid "1:1 (square)"
msgstr "1:1 (정사각형)"

#: showbits/includes/class-settings-page.php
msgid "9:16 (stories)"
msgstr "9:16 (스토리)"

#: showbits/includes/class-settings-page.php
msgid "The picture pushes bring; in the library you choose for each card."
msgstr "전송받는 카드에 적용되는 이미지 비율입니다. 라이브러리에서는 카드마다 선택합니다."

#: showbits/includes/class-settings-page.php
msgid "Videos"
msgstr "비디오"

#: showbits/includes/class-settings-page.php
msgid "Import the thumbnail as the video’s poster image"
msgstr "썸네일을 비디오의 포스터 이미지로 가져오기"

#: showbits/includes/class-settings-page.php
msgid "Save"
msgstr "저장"

#: showbits/includes/class-settings-page.php
msgid "Site key"
msgstr "사이트 키"

#. translators: %s: this site's address
#: showbits/includes/class-settings-page.php
msgid "Made in ShowBits for %s, valid for 24 hours and only once. ShowBits then checks that it is talking to this site."
msgstr "ShowBits에서 %s용으로 만든 키이며, 24시간 동안 한 번만 사용할 수 있습니다. 그런 다음 ShowBits가 이 사이트와 통신하고 있는지 확인합니다."

#: showbits/includes/class-settings-page.php
msgid "Connect"
msgstr "연결"

#: showbits/includes/class-settings-page.php
msgid "Are you an admin or owner of the workspace yourself? Then sign in to ShowBits and agree there, without a site key:"
msgstr "본인이 워크스페이스의 관리자 또는 소유자이십니까? 그렇다면 ShowBits에 로그인하여 사이트 키 없이 그곳에서 동의하세요:"

#: showbits/includes/class-settings-page.php
msgid "Connect through ShowBits"
msgstr "ShowBits를 통해 연결"

#: showbits/includes/class-settings-page.php
msgid "ShowBits address"
msgstr "ShowBits 주소"

#: showbits/includes/class-settings-page.php
msgid "ShowBits Cloud: https://app.showbits.ai. OnPremise: the address of your installation."
msgstr "ShowBits Cloud: https://app.showbits.ai. OnPremise: 직접 설치한 인스턴스의 주소."

#: showbits/includes/class-settings-page.php
msgid "Disconnect"
msgstr "연결 해제"

#: showbits/includes/class-settings-page.php
msgid "Disconnect this site from ShowBits? What is in the media library stays."
msgstr "이 사이트와 ShowBits의 연결을 해제하시겠습니까? 미디어 라이브러리에 있는 항목은 그대로 남습니다."

#: showbits/includes/class-settings-page.php
msgid "asked for"
msgstr "요청됨"

#: showbits/includes/class-settings-page.php
msgid "waiting"
msgstr "대기 중"

#: showbits/includes/class-settings-page.php
msgid "importing"
msgstr "가져오는 중"

#: showbits/includes/class-settings-page.php
msgid "imported"
msgstr "가져오기 완료"

#: showbits/includes/class-settings-page.php
msgid "failed"
msgstr "실패"

#: showbits/includes/class-settings-page.php
msgid "Recent imports"
msgstr "최근 가져오기"

#: showbits/includes/class-settings-page.php
msgid "When"
msgstr "일시"

#: showbits/includes/class-settings-page.php
msgid "Clip"
msgstr "클립"

#: showbits/includes/class-settings-page.php
msgid "How"
msgstr "방식"

#: showbits/includes/class-settings-page.php
msgid "State"
msgstr "상태"

#: showbits/includes/class-settings-page.php
msgid "sent from ShowBits"
msgstr "ShowBits에서 보냄"

#: showbits/includes/class-settings-page.php
msgid "picked here"
msgstr "여기서 선택함"

#: showbits/includes/class-settings-page.php
msgid "Connected. The library is under Media → ShowBits."
msgstr "연결되었습니다. 라이브러리는 미디어 → ShowBits에 있습니다."

#: showbits/includes/class-settings-page.php
msgid "Disconnected. What is in the media library stays."
msgstr "연결이 해제되었습니다. 미디어 라이브러리에 있는 항목은 그대로 남습니다."

#: showbits/includes/class-settings-page.php
msgid "Saved."
msgstr "저장되었습니다."

#: showbits/includes/class-settings-page.php
msgid "Connecting was cancelled in ShowBits."
msgstr "ShowBits에서 연결이 취소되었습니다."

#: showbits/includes/class-settings-page.php
msgid "That way back from ShowBits did not belong to this attempt. Start again."
msgstr "ShowBits에서 돌아온 요청이 이번 연결 시도와 일치하지 않습니다. 처음부터 다시 시작하세요."

#: showbits/includes/class-settings-page.php
msgid "The ShowBits address must start with https://."
msgstr "ShowBits 주소는 https://로 시작해야 합니다."

#: showbits/includes/class-settings-page.php
msgid "That is not a site key. Copy it from ShowBits (Integrations → WordPress) again."
msgstr "사이트 키가 아닙니다. ShowBits(Integrations → WordPress)에서 다시 복사하세요."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not take the site key: it is unknown, used, withdrawn or expired (a site key lasts 24 hours, a consent ten minutes). Make a new one."
msgstr "ShowBits가 사이트 키를 받아들이지 않았습니다. 알 수 없거나, 이미 사용되었거나, 철회되었거나, 만료된 키입니다(사이트 키는 24시간, 동의는 10분 동안 유효합니다). 새 키를 만드세요."

#: showbits/includes/class-settings-page.php
msgid "The site key was made for another address. Make one for this site’s address."
msgstr "이 사이트 키는 다른 주소용으로 만들어졌습니다. 이 사이트의 주소용 키를 만드세요."

#: showbits/includes/class-settings-page.php
msgid "ShowBits could not reach this site at its REST API (/wp-json/showbits/v1/push), or ShowBits itself could not be reached. The site must be public over HTTPS; a firewall or security plugin must let ShowBits in."
msgstr "ShowBits가 이 사이트의 REST API(/wp-json/showbits/v1/push)에 접속하지 못했거나, ShowBits 자체에 접속할 수 없습니다. 사이트는 HTTPS로 공개되어 있어야 하며, 방화벽이나 보안 플러그인이 ShowBits의 접속을 허용해야 합니다."

#: showbits/includes/class-settings-page.php
msgid "This site did not answer ShowBits’ check as expected. Try again; if it fails again, a cache or security plugin may answer for WordPress."
msgstr "이 사이트가 ShowBits의 확인 요청에 예상대로 응답하지 않았습니다. 다시 시도하세요. 다시 실패하면 캐시 플러그인이나 보안 플러그인이 WordPress 대신 응답하고 있을 수 있습니다."

#: showbits/includes/class-settings-page.php
msgid "The workspace’s plan has ended, or whoever made the site key may no longer connect sites."
msgstr "워크스페이스의 요금제가 종료되었거나, 사이트 키를 만든 사람이 더 이상 사이트를 연결할 수 없습니다."

#: showbits/includes/class-settings-page.php
msgid "The workspace has as many sites as its plan allows."
msgstr "워크스페이스의 사이트 수가 이미 요금제 한도에 도달했습니다."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not accept this site’s address. It must be served over HTTPS."
msgstr "ShowBits가 이 사이트의 주소를 받아들이지 않았습니다. 사이트는 HTTPS로 제공되어야 합니다."

#: showbits/includes/class-settings-page.php
msgid "Connecting did not work. Try again, or ask your ShowBits contact."
msgstr "연결하지 못했습니다. 다시 시도하거나 ShowBits 담당자에게 문의하세요."
