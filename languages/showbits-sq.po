# Albanian translation of the ShowBits plugin.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: sq\n"
"Plural-Forms: nplurals=2; plural=n != 1;\n"

#. Description of the plugin
#: showbits/showbits.php
msgid "Released clips and quote cards from ShowBits in the media library: pick them in WordPress, or receive what your ShowBits admins send."
msgstr "Klipe dhe karta citimi të miratuara për botim në ShowBits, te mediateka juaj: zgjidhini në WordPress, ose merrni ç’ju dërgojnë përgjegjësit tuaj në ShowBits."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer as expected."
msgstr "ShowBits-i nuk u përgjigj siç pritej."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer with a file."
msgstr "ShowBits-i nuk dërgoi kartelë."

#: showbits/includes/class-api-client.php showbits/includes/class-importer.php
msgid "ShowBits could not be reached."
msgstr "S’u lidh dot me ShowBits-in."

#. translators: 1: ShowBits' reason, 2: the HTTP status
#: showbits/includes/class-api-client.php
msgid "ShowBits refused (%1$s, HTTP %2$d)."
msgstr "ShowBits-i e hodhi poshtë kërkesën (%1$s, HTTP %2$d)."

#: showbits/includes/class-connection.php
msgid "You may not connect this site."
msgstr "S’keni leje ta lidhni këtë sajt."

#. translators: %s: the clip's title
#: showbits/includes/class-importer.php
msgid "%s (thumbnail)"
msgstr "%s (miniaturë)"

#. translators: %s: a quote (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%s”"
msgstr "“%s”"

#. translators: 1: a quote, 2: who said it (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%1$s” – %2$s"
msgstr "“%1$s” – %2$s"

#: showbits/includes/class-importer.php
msgid "This is not a clip or a format ShowBits offers."
msgstr "Ky s’është klip apo format që ofron ShowBits-i."

#: showbits/includes/class-importer.php
msgid "The clip is no longer released in ShowBits."
msgstr "Klipi s’është më i miratuar për botim në ShowBits."

#: showbits/includes/class-importer.php
msgid "The embargo still holds: the file stays in ShowBits until it ends."
msgstr "Embargoja është ende në fuqi: kartela mbetet në ShowBits derisa të mbarojë embargoja."

#: showbits/includes/class-importer.php
msgid "The file is not ready yet in ShowBits."
msgstr "Kartela s’është ende gati në ShowBits."

#: showbits/includes/class-importer.php
msgid "The file could not be downloaded."
msgstr "Kartela s’u shkarkua dot."

#: showbits/includes/class-importer.php
msgid "WordPress did not take the file into the media library."
msgstr "WordPress-i s’e pranoi kartelën në mediatekë."

#: showbits/includes/class-importer.php
msgid "The delivery from ShowBits is no longer valid. Import the clip again."
msgstr "Dërgesa nga ShowBits-i s’është më e vlefshme. Importojeni sërish klipin."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer accepts this site’s connection: connect it again under Settings → ShowBits."
msgstr "ShowBits-i s’e pranon më lidhjen e këtij sajti: lidheni sërish te Rregullime → ShowBits."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer delivers to this site: the workspace’s plan has ended."
msgstr "ShowBits-i s’i dërgon më gjë këtij sajti: plani i hapësirës së punës ka mbaruar."

#: showbits/includes/class-importer.php
msgid "The site’s imports for today are used up. Try again tomorrow."
msgstr "Importimet e sajtit për sot janë shteruar. Riprovoni nesër."

#: showbits/includes/class-importer.php
msgid "The import was interrupted."
msgstr "Importimi u ndërpre."

#: showbits/includes/class-importer.php
msgid "The import failed."
msgstr "Importimi dështoi."

#: showbits/includes/class-library-endpoint.php
msgid "This site is not connected to ShowBits."
msgstr "Ky sajt s’është i lidhur me ShowBits-in."

#: showbits/includes/class-library-page.php
msgid "All"
msgstr "Krejt"

#: showbits/includes/class-library-page.php
msgid "Clips"
msgstr "Klipe"

#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Quote cards"
msgstr "Karta citimi"

#: showbits/includes/class-library-page.php
msgid "Search titles"
msgstr "Kërkoni te titujt"

#: showbits/includes/class-library-page.php
msgid "Search the library"
msgstr "Kërkoni në bibliotekë"

#: showbits/includes/class-library-page.php
msgid "Import selected"
msgstr "Importoji të përzgjedhurat"

#. translators: 1: which one, 2: how many in all
#: showbits/includes/class-library-page.php
msgid "Asking ShowBits for %1$d of %2$d …"
msgstr "Po i kërkohet ShowBits-it %1$d nga %2$d…"

#. translators: %d: how many clips are still on their way
#: showbits/includes/class-library-page.php
msgid "On the way from ShowBits: %d …"
msgstr "Po vijnë nga ShowBits-i: %d…"

#. translators: %d: how many clips were imported
#: showbits/includes/class-library-page.php
msgid "Imported: %d"
msgstr "U importuan: %d"

#: showbits/includes/class-library-page.php
msgid "Not everything has arrived yet; it continues in the background. Settings → ShowBits lists the imports."
msgstr "S’ka mbërritur ende gjithçka; importimi vazhdon në prapaskenë. Importimet i shihni te Rregullime → ShowBits."

#: showbits/includes/class-library-page.php
msgid "On the way"
msgstr "Në rrugë"

#: showbits/includes/class-library-page.php
msgid "Load more"
msgstr "Ngarko më tepër"

#: showbits/includes/class-library-page.php
msgid "Loading …"
msgstr "Po ngarkohet…"

#: showbits/includes/class-library-page.php
msgid "No released clips or quote cards yet."
msgstr "Ende s’ka klipe apo karta citimi të miratuara për botim."

#. translators: %s: date and time the embargo ends
#: showbits/includes/class-library-page.php
msgid "Embargo until %s"
msgstr "Embargo deri më %s"

#: showbits/includes/class-library-page.php
msgid "Not ready yet"
msgstr "Ende jo gati"

#: showbits/includes/class-library-page.php
msgid "In the media library"
msgstr "Në mediatekë"

#: showbits/includes/class-library-page.php
msgid "An older version is in the media library"
msgstr "Një version më i vjetër gjendet në mediatekë"

#: showbits/includes/class-library-page.php
msgid "Edit"
msgstr "Përpunoni"

#: showbits/includes/class-library-page.php
msgid "Format"
msgstr "Format"

#. translators: %s: a quote card's format, such as 9:16 or "9:16 (stories)" (its animated video with the speaker's voice)
#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Animated %s"
msgstr "E animuar %s"

#: showbits/includes/class-library-page.php
msgid "Video"
msgstr "Video"

#: showbits/includes/class-library-page.php
msgid "Quote card"
msgstr "Kartë citimi"

#: showbits/includes/class-library-page.php
msgid "Meme"
msgstr "Meme"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "Failed: %s"
msgstr "Dështoi: %s"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "The library could not be loaded: %s"
msgstr "Biblioteka s’u ngarkua dot: %s"

#: showbits/includes/class-library-page.php
msgid "This site is not connected to ShowBits yet."
msgstr "Ky sajt s’është lidhur ende me ShowBits-in."

#: showbits/includes/class-library-page.php
msgid "Connect it in the settings."
msgstr "Lidheni te rregullimet."

#: showbits/includes/class-library-page.php
msgid "An administrator of this site connects it in the settings."
msgstr "Këtë sajt e lidh te rregullimet një përgjegjës i tij."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-library-page.php
msgid "Released clips and quote cards from the ShowBits workspace “%s”. What you import lands in the media library, ready for posts and pages."
msgstr "Klipe dhe karta citimi të miratuara për botim nga hapësira e punës ShowBits “%s”. Ç’importoni përfundon në mediatekë, gati për postime dhe faqe."

#: showbits/includes/class-library-page.php
msgid "The library needs JavaScript."
msgstr "Biblioteka lyp JavaScript."

#: showbits/includes/class-settings-page.php
msgid "Settings"
msgstr "Rregullime"

#: showbits/includes/class-settings-page.php
msgid "You may not change these settings."
msgstr "S’keni leje t’i ndryshoni këto rregullime."

#: showbits/includes/class-settings-page.php
msgid "Connection"
msgstr "Lidhje"

#. translators: 1: the constant SHOWBITS_ENCRYPTION_KEY, 2: the file wp-config.php (both stay as they are)
#: showbits/includes/class-settings-page.php
msgid "Your site’s security keys are not in %2$s, so the key that protects the connection to ShowBits is stored in the database. Add %1$s with a long random value to %2$s; if the site is connected already, connect it again afterwards."
msgstr "Kyçet e sigurisë së sajtit tuaj nuk janë te %2$s, ndaj kyçi që mbron lidhjen me ShowBits-in ruhet në bazën e të dhënave. Shtoni %1$s me një vlerë të gjatë të rastësishme te %2$s; nëse sajti është tashmë i lidhur, lidheni sërish më pas."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-settings-page.php
msgid "Connected to the workspace “%s”."
msgstr "Lidhur me hapësirën e punës “%s”."

#. translators: 1: imports today, 2: imports a day the plan allows
#: showbits/includes/class-settings-page.php
msgid "Imports today: %1$d of %2$d."
msgstr "Importime sot: %1$d nga %2$d."

#. translators: 1: a person, 2: a date, 3: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "Connected by %1$s on %2$s, at %3$s."
msgstr "Lidhur nga %1$s më %2$s, te %3$s."

#: showbits/includes/class-settings-page.php
msgid "Connect again"
msgstr "Rilidhje"

#: showbits/includes/class-settings-page.php
msgid "With a new site key the site renews its connection, or moves to another workspace."
msgstr "Me një kyç të ri sajti, sajti rinovon lidhjen e vet, ose kalon në një tjetër hapësirë pune."

#. translators: %s: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "ShowBits (%s) cannot be reached right now. The connection stays; try again later."
msgstr "ShowBits-i (%s) s’mund të kapet tani. Lidhja mbetet; riprovoni më vonë."

#: showbits/includes/class-settings-page.php
msgid "ShowBits no longer accepts this site’s connection: it was disconnected in ShowBits, the plan ended, or this site’s keys changed. Connect it again with a new site key."
msgstr "ShowBits-i s’e pranon më lidhjen e këtij sajti: u shkëput në ShowBits, plani mbaroi, ose ndryshuan kyçet e këtij sajti. Lidheni sërish me një kyç të ri sajti."

#: showbits/includes/class-settings-page.php
msgid "Connect this site to a ShowBits workspace: an admin or owner of the workspace makes a site key for this site in ShowBits (Integrations → WordPress). The site can then take released clips and quote cards into its media library, and receive what your ShowBits admins send."
msgstr "Lidheni këtë sajt me një hapësirë pune ShowBits: një përgjegjës ose i zoti i hapësirës së punës krijon në ShowBits një kyç sajti për këtë sajt (Integrations → WordPress). Më pas sajti mund të marrë në mediatekën e vet klipe dhe karta citimi të miratuara për botim, si dhe të pranojë ç’dërgojnë përgjegjësit tuaj në ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Imports"
msgstr "Importime"

#: showbits/includes/class-settings-page.php
msgid "Format of quote cards"
msgstr "Format kartash citimi"

#: showbits/includes/class-settings-page.php
msgid "4:5 (feeds, articles)"
msgstr "4:5 (prurje, artikuj)"

#: showbits/includes/class-settings-page.php
msgid "1:1 (square)"
msgstr "1:1 (katror)"

#: showbits/includes/class-settings-page.php
msgid "9:16 (stories)"
msgstr "9:16 (histori)"

#: showbits/includes/class-settings-page.php
msgid "The picture pushes bring; in the library you choose for each card."
msgstr "Formati me të cilin vijnë kartat e dërguara; te biblioteka e zgjidhni për çdo kartë veç e veç."

#: showbits/includes/class-settings-page.php
msgid "Videos"
msgstr "Video"

#: showbits/includes/class-settings-page.php
msgid "Import the thumbnail as the video’s poster image"
msgstr "Importo miniaturën si figurë afishe të videos"

#: showbits/includes/class-settings-page.php
msgid "Save"
msgstr "Ruaje"

#: showbits/includes/class-settings-page.php
msgid "Site key"
msgstr "Kyç sajti"

#. translators: %s: this site's address
#: showbits/includes/class-settings-page.php
msgid "Made in ShowBits for %s, valid for 24 hours and only once. ShowBits then checks that it is talking to this site."
msgstr "Krijuar në ShowBits për %s, i vlefshëm për 24 orë dhe vetëm një herë. Më pas ShowBits-i kontrollon se po flet me këtë sajt."

#: showbits/includes/class-settings-page.php
msgid "Connect"
msgstr "Lidhe"

#: showbits/includes/class-settings-page.php
msgid "Are you an admin or owner of the workspace yourself? Then sign in to ShowBits and agree there, without a site key:"
msgstr "Jeni vetë përgjegjës ose i zoti i hapësirës së punës? Atëherë hyni në ShowBits dhe jepni pëlqimin atje, pa kyç sajti:"

#: showbits/includes/class-settings-page.php
msgid "Connect through ShowBits"
msgstr "Lidhe përmes ShowBits-it"

#: showbits/includes/class-settings-page.php
msgid "ShowBits address"
msgstr "Adresë ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits Cloud: https://app.showbits.ai. OnPremise: the address of your installation."
msgstr "ShowBits Cloud: https://app.showbits.ai. OnPremise: adresa e instalimit tuaj."

#: showbits/includes/class-settings-page.php
msgid "Disconnect"
msgstr "Shkëpute"

#: showbits/includes/class-settings-page.php
msgid "Disconnect this site from ShowBits? What is in the media library stays."
msgstr "Të shkëputet ky sajt nga ShowBits-i? Ç’gjendet në mediatekë mbetet."

#: showbits/includes/class-settings-page.php
msgid "asked for"
msgstr "i kërkuar"

#: showbits/includes/class-settings-page.php
msgid "waiting"
msgstr "në pritje"

#: showbits/includes/class-settings-page.php
msgid "importing"
msgstr "po importohet"

#: showbits/includes/class-settings-page.php
msgid "imported"
msgstr "i importuar"

#: showbits/includes/class-settings-page.php
msgid "failed"
msgstr "dështoi"

#: showbits/includes/class-settings-page.php
msgid "Recent imports"
msgstr "Importime së fundi"

#: showbits/includes/class-settings-page.php
msgid "When"
msgstr "Kur"

#: showbits/includes/class-settings-page.php
msgid "Clip"
msgstr "Klip"

#: showbits/includes/class-settings-page.php
msgid "How"
msgstr "Mënyrë"

#: showbits/includes/class-settings-page.php
msgid "State"
msgstr "Gjendje"

#: showbits/includes/class-settings-page.php
msgid "sent from ShowBits"
msgstr "dërguar nga ShowBits-i"

#: showbits/includes/class-settings-page.php
msgid "picked here"
msgstr "zgjedhur këtu"

#: showbits/includes/class-settings-page.php
msgid "Connected. The library is under Media → ShowBits."
msgstr "U lidh. Biblioteka gjendet te Media → ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Disconnected. What is in the media library stays."
msgstr "U shkëput. Ç’gjendet në mediatekë mbetet."

#: showbits/includes/class-settings-page.php
msgid "Saved."
msgstr "U ruajt."

#: showbits/includes/class-settings-page.php
msgid "Connecting was cancelled in ShowBits."
msgstr "Lidhja u anulua në ShowBits."

#: showbits/includes/class-settings-page.php
msgid "That way back from ShowBits did not belong to this attempt. Start again."
msgstr "Ky kthim nga ShowBits-i s’i përkiste kësaj përpjekjeje për lidhje. Filloni nga e para."

#: showbits/includes/class-settings-page.php
msgid "The ShowBits address must start with https://."
msgstr "Adresa e ShowBits-it duhet të fillojë me https://."

#: showbits/includes/class-settings-page.php
msgid "That is not a site key. Copy it from ShowBits (Integrations → WordPress) again."
msgstr "Ky s’është kyç sajti. Kopjojeni sërish nga ShowBits-i (Integrations → WordPress)."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not take the site key: it is unknown, used, withdrawn or expired (a site key lasts 24 hours, a consent ten minutes). Make a new one."
msgstr "ShowBits-i s’e pranoi kyçin e sajtit: është i panjohur, i përdorur, i tërhequr ose i skaduar (një kyç sajti vlen 24 orë, një pëlqim dhjetë minuta). Krijoni një të ri."

#: showbits/includes/class-settings-page.php
msgid "The site key was made for another address. Make one for this site’s address."
msgstr "Kyçi i sajtit qe krijuar për një tjetër adresë. Krijoni një për adresën e këtij sajti."

#: showbits/includes/class-settings-page.php
msgid "ShowBits could not reach this site at its REST API (/wp-json/showbits/v1/push), or ShowBits itself could not be reached. The site must be public over HTTPS; a firewall or security plugin must let ShowBits in."
msgstr "ShowBits-i s’e kapi dot këtë sajt përmes REST API-t të tij (/wp-json/showbits/v1/push), ose s’u kap dot vetë ShowBits-i. Sajti duhet të jetë publik përmes HTTPS; një firewall ose shtojcë sigurie duhet ta lërë ShowBits-in të hyjë."

#: showbits/includes/class-settings-page.php
msgid "This site did not answer ShowBits’ check as expected. Try again; if it fails again, a cache or security plugin may answer for WordPress."
msgstr "Ky sajt s’iu përgjigj kontrollit të ShowBits-it siç pritej. Riprovoni; nëse dështon sërish, mund të jetë një shtojcë fshehtine ose sigurie që përgjigjet në vend të WordPress-it."

#: showbits/includes/class-settings-page.php
msgid "The workspace’s plan has ended, or whoever made the site key may no longer connect sites."
msgstr "Plani i hapësirës së punës ka mbaruar, ose kushdo që krijoi kyçin e sajtit s’mund të lidhë më sajte."

#: showbits/includes/class-settings-page.php
msgid "The workspace has as many sites as its plan allows."
msgstr "Hapësira e punës ka aq sajte sa lejon plani i saj."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not accept this site’s address. It must be served over HTTPS."
msgstr "ShowBits-i s’e pranoi adresën e këtij sajti. Duhet të shërbehet përmes HTTPS."

#: showbits/includes/class-settings-page.php
msgid "Connecting did not work. Try again, or ask your ShowBits contact."
msgstr "Lidhja s’u bë dot. Riprovoni, ose pyetni personin tuaj të kontaktit në ShowBits."
