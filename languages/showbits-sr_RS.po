# Serbian translation of the ShowBits plugin.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: sr_RS\n"
"Plural-Forms: nplurals=3; plural=(n % 10 == 1 && n % 100 != 11) ? 0 : ((n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14)) ? 1 : 2);\n"

#. Description of the plugin
#: showbits/showbits.php
msgid "Released clips and quote cards from ShowBits in the media library: pick them in WordPress, or receive what your ShowBits admins send."
msgstr "Одобрени клипови и слике са цитатима из ShowBits-а у библиотеци садржаја: бирајте их у WordPress-у или примајте оно што шаљу ваши администратори у ShowBits-у."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer as expected."
msgstr "ShowBits није одговорио онако како се очекивало."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer with a file."
msgstr "ShowBits није вратио датотеку."

#: showbits/includes/class-api-client.php showbits/includes/class-importer.php
msgid "ShowBits could not be reached."
msgstr "ShowBits није доступан."

#. translators: 1: ShowBits' reason, 2: the HTTP status
#: showbits/includes/class-api-client.php
msgid "ShowBits refused (%1$s, HTTP %2$d)."
msgstr "ShowBits је одбио захтев (%1$s, HTTP %2$d)."

#: showbits/includes/class-connection.php
msgid "You may not connect this site."
msgstr "Није вам дозвољено да повежете ово веб место."

#. translators: %s: the clip's title
#: showbits/includes/class-importer.php
msgid "%s (thumbnail)"
msgstr "%s (умањена слика)"

#. translators: %s: a quote (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%s”"
msgstr "„%s“"

#. translators: 1: a quote, 2: who said it (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%1$s” – %2$s"
msgstr "„%1$s“ – %2$s"

#: showbits/includes/class-importer.php
msgid "This is not a clip or a format ShowBits offers."
msgstr "Ово није клип нити формат који ShowBits нуди."

#: showbits/includes/class-importer.php
msgid "The clip is no longer released in ShowBits."
msgstr "Клип више није одобрен у ShowBits-у."

#: showbits/includes/class-importer.php
msgid "The embargo still holds: the file stays in ShowBits until it ends."
msgstr "Ембарго још важи: датотека остаје у ShowBits-у док он не истекне."

#: showbits/includes/class-importer.php
msgid "The file is not ready yet in ShowBits."
msgstr "Датотека у ShowBits-у још није спремна."

#: showbits/includes/class-importer.php
msgid "The file could not be downloaded."
msgstr "Преузимање датотеке није успело."

#: showbits/includes/class-importer.php
msgid "WordPress did not take the file into the media library."
msgstr "WordPress није примио датотеку у библиотеку садржаја."

#: showbits/includes/class-importer.php
msgid "The delivery from ShowBits is no longer valid. Import the clip again."
msgstr "Достава из ShowBits-а више не важи. Поново увезите клип."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer accepts this site’s connection: connect it again under Settings → ShowBits."
msgstr "ShowBits више не прихвата везу овог веб места: поново га повежите у одељку Подешавања → ShowBits."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer delivers to this site: the workspace’s plan has ended."
msgstr "ShowBits више ништа не доставља овом веб месту: пакет радног простора је истекао."

#: showbits/includes/class-importer.php
msgid "The site’s imports for today are used up. Try again tomorrow."
msgstr "Дневно ограничење увоза за ово веб место је достигнуто. Покушајте поново сутра."

#: showbits/includes/class-importer.php
msgid "The import was interrupted."
msgstr "Увоз је прекинут."

#: showbits/includes/class-importer.php
msgid "The import failed."
msgstr "Увоз није успео."

#: showbits/includes/class-library-endpoint.php
msgid "This site is not connected to ShowBits."
msgstr "Ово веб место није повезано са ShowBits-ом."

#: showbits/includes/class-library-page.php
msgid "All"
msgstr "Све"

#: showbits/includes/class-library-page.php
msgid "Clips"
msgstr "Клипови"

#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Quote cards"
msgstr "Слике са цитатима"

#: showbits/includes/class-library-page.php
msgid "Search titles"
msgstr "Претражи наслове"

#: showbits/includes/class-library-page.php
msgid "Search the library"
msgstr "Претражи библиотеку"

#: showbits/includes/class-library-page.php
msgid "Import selected"
msgstr "Увези изабрано"

#. translators: 1: which one, 2: how many in all
#: showbits/includes/class-library-page.php
msgid "Asking ShowBits for %1$d of %2$d …"
msgstr "Слање захтева ShowBits-у: %1$d од %2$d…"

#. translators: %d: how many clips are still on their way
#: showbits/includes/class-library-page.php
msgid "On the way from ShowBits: %d …"
msgstr "На путу из ShowBits-а: %d…"

#. translators: %d: how many clips were imported
#: showbits/includes/class-library-page.php
msgid "Imported: %d"
msgstr "Увезено: %d"

#: showbits/includes/class-library-page.php
msgid "Not everything has arrived yet; it continues in the background. Settings → ShowBits lists the imports."
msgstr "Још није све стигло; увоз се наставља у позадини. Списак увоза је у одељку Подешавања → ShowBits."

#: showbits/includes/class-library-page.php
msgid "On the way"
msgstr "На путу"

#: showbits/includes/class-library-page.php
msgid "Load more"
msgstr "Учитај још"

#: showbits/includes/class-library-page.php
msgid "Loading …"
msgstr "Учитавање…"

#: showbits/includes/class-library-page.php
msgid "No released clips or quote cards yet."
msgstr "Још нема одобрених клипова ни слика са цитатима."

#. translators: %s: date and time the embargo ends
#: showbits/includes/class-library-page.php
msgid "Embargo until %s"
msgstr "Ембарго до %s"

#: showbits/includes/class-library-page.php
msgid "Not ready yet"
msgstr "Још није спремно"

#: showbits/includes/class-library-page.php
msgid "In the media library"
msgstr "У библиотеци садржаја"

#: showbits/includes/class-library-page.php
msgid "An older version is in the media library"
msgstr "Старије издање је у библиотеци садржаја"

#: showbits/includes/class-library-page.php
msgid "Edit"
msgstr "Уреди"

#: showbits/includes/class-library-page.php
msgid "Format"
msgstr "Формат"

#. translators: %s: a quote card's format, such as 9:16 or "9:16 (stories)" (its animated video with the speaker's voice)
#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Animated %s"
msgstr "Анимирана %s"

#: showbits/includes/class-library-page.php
msgid "Video"
msgstr "Видео"

#: showbits/includes/class-library-page.php
msgid "Quote card"
msgstr "Слика са цитатом"

#: showbits/includes/class-library-page.php
msgid "Meme"
msgstr "Мим"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "Failed: %s"
msgstr "Није успело: %s"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "The library could not be loaded: %s"
msgstr "Библиотека није могла да се учита: %s"

#: showbits/includes/class-library-page.php
msgid "This site is not connected to ShowBits yet."
msgstr "Ово веб место још није повезано са ShowBits-ом."

#: showbits/includes/class-library-page.php
msgid "Connect it in the settings."
msgstr "Повежите га у подешавањима."

#: showbits/includes/class-library-page.php
msgid "An administrator of this site connects it in the settings."
msgstr "Управник овог веб места може да га повеже у подешавањима."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-library-page.php
msgid "Released clips and quote cards from the ShowBits workspace “%s”. What you import lands in the media library, ready for posts and pages."
msgstr "Одобрени клипови и слике са цитатима из радног простора „%s“ у ShowBits-у. Оно што увезете стиже у библиотеку садржаја, спремно за чланке и стране."

#: showbits/includes/class-library-page.php
msgid "The library needs JavaScript."
msgstr "Библиотеци је потребан JavaScript."

#: showbits/includes/class-settings-page.php
msgid "Settings"
msgstr "Подешавања"

#: showbits/includes/class-settings-page.php
msgid "You may not change these settings."
msgstr "Није вам дозвољено да мењате ова подешавања."

#: showbits/includes/class-settings-page.php
msgid "Connection"
msgstr "Веза"

#. translators: 1: the constant SHOWBITS_ENCRYPTION_KEY, 2: the file wp-config.php (both stay as they are)
#: showbits/includes/class-settings-page.php
msgid "Your site’s security keys are not in %2$s, so the key that protects the connection to ShowBits is stored in the database. Add %1$s with a long random value to %2$s; if the site is connected already, connect it again afterwards."
msgstr "Безбедносни кључеви вашег веб места нису у %2$s, па је кључ који штити везу са ShowBits-ом сачуван у бази података. Додајте %1$s са дугом насумичном вредношћу у %2$s; ако је веб место већ повезано, након тога га поново повежите."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-settings-page.php
msgid "Connected to the workspace “%s”."
msgstr "Повезано са радним простором „%s“."

#. translators: 1: imports today, 2: imports a day the plan allows
#: showbits/includes/class-settings-page.php
msgid "Imports today: %1$d of %2$d."
msgstr "Данашњи увози: %1$d од %2$d."

#. translators: 1: a person, 2: a date, 3: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "Connected by %1$s on %2$s, at %3$s."
msgstr "Везу са %3$s успоставио је корисник %1$s, %2$s."

#: showbits/includes/class-settings-page.php
msgid "Connect again"
msgstr "Поновно повезивање"

#: showbits/includes/class-settings-page.php
msgid "With a new site key the site renews its connection, or moves to another workspace."
msgstr "Нови кључ веб места обнавља везу или премешта веб место у други радни простор."

#. translators: %s: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "ShowBits (%s) cannot be reached right now. The connection stays; try again later."
msgstr "ShowBits (%s) тренутно није доступан. Веза остаје; покушајте поново касније."

#: showbits/includes/class-settings-page.php
msgid "ShowBits no longer accepts this site’s connection: it was disconnected in ShowBits, the plan ended, or this site’s keys changed. Connect it again with a new site key."
msgstr "ShowBits више не прихвата везу овог веб места: веза је прекинута у ShowBits-у, пакет је истекао или су се кључеви овог веб места променили. Поново га повежите новим кључем веб места."

#: showbits/includes/class-settings-page.php
msgid "Connect this site to a ShowBits workspace: an admin or owner of the workspace makes a site key for this site in ShowBits (Integrations → WordPress). The site can then take released clips and quote cards into its media library, and receive what your ShowBits admins send."
msgstr "Повежите ово веб место са радним простором у ShowBits-у: администратор или власник радног простора прави у ShowBits-у кључ веб места за ово веб место (Integrations → WordPress). Веб место затим може да преузима одобрене клипове и слике са цитатима у своју библиотеку садржаја и да прима оно што шаљу ваши администратори у ShowBits-у."

#: showbits/includes/class-settings-page.php
msgid "Imports"
msgstr "Увози"

#: showbits/includes/class-settings-page.php
msgid "Format of quote cards"
msgstr "Формат слика са цитатима"

#: showbits/includes/class-settings-page.php
msgid "4:5 (feeds, articles)"
msgstr "4:5 (фидови, чланци)"

#: showbits/includes/class-settings-page.php
msgid "1:1 (square)"
msgstr "1:1 (квадрат)"

#: showbits/includes/class-settings-page.php
msgid "9:16 (stories)"
msgstr "9:16 (приче)"

#: showbits/includes/class-settings-page.php
msgid "The picture pushes bring; in the library you choose for each card."
msgstr "Формат који имају послате слике; у библиотеци га бирате за сваку слику посебно."

#: showbits/includes/class-settings-page.php
msgid "Videos"
msgstr "Видео записи"

#: showbits/includes/class-settings-page.php
msgid "Import the thumbnail as the video’s poster image"
msgstr "Увези умањену слику као слику плаката видео записа"

#: showbits/includes/class-settings-page.php
msgid "Save"
msgstr "Сачувај"

#: showbits/includes/class-settings-page.php
msgid "Site key"
msgstr "Кључ веб места"

#. translators: %s: this site's address
#: showbits/includes/class-settings-page.php
msgid "Made in ShowBits for %s, valid for 24 hours and only once. ShowBits then checks that it is talking to this site."
msgstr "Прави се у ShowBits-у за %s; важи 24 сата и може да се употреби само једном. ShowBits затим проверава да ли комуницира баш са овим веб местом."

#: showbits/includes/class-settings-page.php
msgid "Connect"
msgstr "Повежи"

#: showbits/includes/class-settings-page.php
msgid "Are you an admin or owner of the workspace yourself? Then sign in to ShowBits and agree there, without a site key:"
msgstr "Да ли сте и сами администратор или власник радног простора? Онда се пријавите у ShowBits и тамо дајте сагласност, без кључа веб места:"

#: showbits/includes/class-settings-page.php
msgid "Connect through ShowBits"
msgstr "Повежи преко ShowBits-а"

#: showbits/includes/class-settings-page.php
msgid "ShowBits address"
msgstr "Адреса ShowBits-а"

#: showbits/includes/class-settings-page.php
msgid "ShowBits Cloud: https://app.showbits.ai. OnPremise: the address of your installation."
msgstr "ShowBits Cloud: https://app.showbits.ai. OnPremise: адреса ваше инсталације."

#: showbits/includes/class-settings-page.php
msgid "Disconnect"
msgstr "Прекини везу"

#: showbits/includes/class-settings-page.php
msgid "Disconnect this site from ShowBits? What is in the media library stays."
msgstr "Да ли желите да прекинете везу овог веб места са ShowBits-ом? Оно што је у библиотеци садржаја остаје."

#: showbits/includes/class-settings-page.php
msgid "asked for"
msgstr "Затражено"

#: showbits/includes/class-settings-page.php
msgid "waiting"
msgstr "Чека"

#: showbits/includes/class-settings-page.php
msgid "importing"
msgstr "Увози се"

#: showbits/includes/class-settings-page.php
msgid "imported"
msgstr "Увезено"

#: showbits/includes/class-settings-page.php
msgid "failed"
msgstr "Није успело"

#: showbits/includes/class-settings-page.php
msgid "Recent imports"
msgstr "Недавни увози"

#: showbits/includes/class-settings-page.php
msgid "When"
msgstr "Датум"

#: showbits/includes/class-settings-page.php
msgid "Clip"
msgstr "Клип"

#: showbits/includes/class-settings-page.php
msgid "How"
msgstr "Начин"

#: showbits/includes/class-settings-page.php
msgid "State"
msgstr "Стање"

#: showbits/includes/class-settings-page.php
msgid "sent from ShowBits"
msgstr "Послато из ShowBits-а"

#: showbits/includes/class-settings-page.php
msgid "picked here"
msgstr "Изабрано овде"

#: showbits/includes/class-settings-page.php
msgid "Connected. The library is under Media → ShowBits."
msgstr "Повезано. Библиотека је у одељку Садржај → ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Disconnected. What is in the media library stays."
msgstr "Веза је прекинута. Оно што је у библиотеци садржаја остаје."

#: showbits/includes/class-settings-page.php
msgid "Saved."
msgstr "Сачувано."

#: showbits/includes/class-settings-page.php
msgid "Connecting was cancelled in ShowBits."
msgstr "Повезивање је отказано у ShowBits-у."

#: showbits/includes/class-settings-page.php
msgid "That way back from ShowBits did not belong to this attempt. Start again."
msgstr "Тај повратак из ShowBits-а не припада овом покушају повезивања. Почните поново."

#: showbits/includes/class-settings-page.php
msgid "The ShowBits address must start with https://."
msgstr "Адреса ShowBits-а мора да почиње са https://."

#: showbits/includes/class-settings-page.php
msgid "That is not a site key. Copy it from ShowBits (Integrations → WordPress) again."
msgstr "То није кључ веб места. Поново га копирајте из ShowBits-а (Integrations → WordPress)."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not take the site key: it is unknown, used, withdrawn or expired (a site key lasts 24 hours, a consent ten minutes). Make a new one."
msgstr "ShowBits није прихватио кључ веб места: непознат је, искоришћен, повучен или је истекао (кључ веб места важи 24 сата, сагласност десет минута). Направите нови."

#: showbits/includes/class-settings-page.php
msgid "The site key was made for another address. Make one for this site’s address."
msgstr "Кључ веб места је направљен за другу адресу. Направите кључ за адресу овог веб места."

#: showbits/includes/class-settings-page.php
msgid "ShowBits could not reach this site at its REST API (/wp-json/showbits/v1/push), or ShowBits itself could not be reached. The site must be public over HTTPS; a firewall or security plugin must let ShowBits in."
msgstr "ShowBits није могао да приступи овом веб месту преко његовог REST API-ја (/wp-json/showbits/v1/push) или сам ShowBits није био доступан. Веб место мора бити јавно доступно преко HTTPS-а; заштитни зид или безбедносни додатак мора да пропусти ShowBits."

#: showbits/includes/class-settings-page.php
msgid "This site did not answer ShowBits’ check as expected. Try again; if it fails again, a cache or security plugin may answer for WordPress."
msgstr "Ово веб место није одговорило на проверу ShowBits-а онако како се очекивало. Покушајте поново; ако опет не успе, можда уместо WordPress-а одговара додатак за кеширање или безбедносни додатак."

#: showbits/includes/class-settings-page.php
msgid "The workspace’s plan has ended, or whoever made the site key may no longer connect sites."
msgstr "Пакет радног простора је истекао или онај ко је направио кључ веб места више не сме да повезује веб места."

#: showbits/includes/class-settings-page.php
msgid "The workspace has as many sites as its plan allows."
msgstr "Радни простор већ има онолико веб места колико његов пакет дозвољава."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not accept this site’s address. It must be served over HTTPS."
msgstr "ShowBits није прихватио адресу овог веб места. Оно мора бити доступно преко HTTPS-а."

#: showbits/includes/class-settings-page.php
msgid "Connecting did not work. Try again, or ask your ShowBits contact."
msgstr "Повезивање није успело. Покушајте поново или се обратите својој особи за контакт у ShowBits-у."
