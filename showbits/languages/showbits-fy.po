# Frisian translation of the ShowBits plugin.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: fy\n"
"Plural-Forms: nplurals=2; plural=n != 1;\n"

#. Description of the plugin
#: showbits/showbits.php
msgid "Released clips and quote cards from ShowBits in the media library: pick them in WordPress, or receive what your ShowBits admins send."
msgstr "Frijjûne klips en sitaatkaarten út ShowBits yn de mediabibleteek: kies se yn WordPress, of ûntfang wat jo ShowBits-admins stjoere."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer as expected."
msgstr "ShowBits joech net it ferwachte antwurd."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer with a file."
msgstr "ShowBits levere gjin triem."

#: showbits/includes/class-api-client.php showbits/includes/class-importer.php
msgid "ShowBits could not be reached."
msgstr "ShowBits wie net te berikken."

#. translators: 1: ShowBits' reason, 2: the HTTP status
#: showbits/includes/class-api-client.php
msgid "ShowBits refused (%1$s, HTTP %2$d)."
msgstr "ShowBits wegere (%1$s, HTTP %2$d)."

#: showbits/includes/class-connection.php
msgid "You may not connect this site."
msgstr "Jo hawwe gjin tastimming om dizze webside te ferbinen."

#. translators: %s: the clip's title
#: showbits/includes/class-importer.php
msgid "%s (thumbnail)"
msgstr "%s (miniatuer)"

#. translators: %s: a quote (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%s”"
msgstr "“%s”"

#. translators: 1: a quote, 2: who said it (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%1$s” – %2$s"
msgstr "“%1$s” – %2$s"

#: showbits/includes/class-importer.php
msgid "This is not a clip or a format ShowBits offers."
msgstr "Dit is gjin klip of formaat dat ShowBits oanbiedt."

#: showbits/includes/class-importer.php
msgid "The clip is no longer released in ShowBits."
msgstr "De klip is yn ShowBits net mear frijjûn."

#: showbits/includes/class-importer.php
msgid "The embargo still holds: the file stays in ShowBits until it ends."
msgstr "It embargo jildt noch: de triem bliuwt yn ShowBits oant it embargo foarby is."

#: showbits/includes/class-importer.php
msgid "The file is not ready yet in ShowBits."
msgstr "De triem is yn ShowBits noch net klear."

#: showbits/includes/class-importer.php
msgid "The file could not be downloaded."
msgstr "It downloaden fan de triem is mislearre."

#: showbits/includes/class-importer.php
msgid "WordPress did not take the file into the media library."
msgstr "WordPress hat de triem net yn de mediabibleteek opnommen."

#: showbits/includes/class-importer.php
msgid "The delivery from ShowBits is no longer valid. Import the clip again."
msgstr "De levering fan ShowBits is net mear jildich. Ymportearje de klip opnij."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer accepts this site’s connection: connect it again under Settings → ShowBits."
msgstr "ShowBits akseptearret de ferbining fan dizze webside net mear: ferbyn de webside opnij ûnder Ynstellingen → ShowBits."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer delivers to this site: the workspace’s plan has ended."
msgstr "ShowBits leveret net mear oan dizze webside: it abonnemint fan de wurkromte is ôfrûn."

#: showbits/includes/class-importer.php
msgid "The site’s imports for today are used up. Try again tomorrow."
msgstr "De ymporten fan dizze webside foar hjoed binne op. Besykje it moarn nochris."

#: showbits/includes/class-importer.php
msgid "The import was interrupted."
msgstr "De ymport is ûnderbrutsen."

#: showbits/includes/class-importer.php
msgid "The import failed."
msgstr "De ymport is mislearre."

#: showbits/includes/class-library-endpoint.php
msgid "This site is not connected to ShowBits."
msgstr "Dizze webside is net mei ShowBits ferbûn."

#: showbits/includes/class-library-page.php
msgid "All"
msgstr "Alle"

#: showbits/includes/class-library-page.php
msgid "Clips"
msgstr "Klips"

#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Quote cards"
msgstr "Sitaatkaarten"

#: showbits/includes/class-library-page.php
msgid "Search titles"
msgstr "Titels sykje"

#: showbits/includes/class-library-page.php
msgid "Search the library"
msgstr "Bibleteek trochsykje"

#: showbits/includes/class-library-page.php
msgid "Import selected"
msgstr "Seleksje ymportearje"

#. translators: 1: which one, 2: how many in all
#: showbits/includes/class-library-page.php
msgid "Asking ShowBits for %1$d of %2$d …"
msgstr "Oanfreegje by ShowBits: %1$d fan %2$d…"

#. translators: %d: how many clips are still on their way
#: showbits/includes/class-library-page.php
msgid "On the way from ShowBits: %d …"
msgstr "Ûnderweis fan ShowBits: %d…"

#. translators: %d: how many clips were imported
#: showbits/includes/class-library-page.php
msgid "Imported: %d"
msgstr "Ymportearre: %d"

#: showbits/includes/class-library-page.php
msgid "Not everything has arrived yet; it continues in the background. Settings → ShowBits lists the imports."
msgstr "Noch net alles is oankommen; it ymportearjen giet op de eftergrûn fierder. Ûnder Ynstellingen → ShowBits steane de ymporten."

#: showbits/includes/class-library-page.php
msgid "On the way"
msgstr "Ûnderweis"

#: showbits/includes/class-library-page.php
msgid "Load more"
msgstr "Mear lade"

#: showbits/includes/class-library-page.php
msgid "Loading …"
msgstr "Lade…"

#: showbits/includes/class-library-page.php
msgid "No released clips or quote cards yet."
msgstr "Noch gjin frijjûne klips of sitaatkaarten."

#. translators: %s: date and time the embargo ends
#: showbits/includes/class-library-page.php
msgid "Embargo until %s"
msgstr "Embargo oant %s"

#: showbits/includes/class-library-page.php
msgid "Not ready yet"
msgstr "Noch net klear"

#: showbits/includes/class-library-page.php
msgid "In the media library"
msgstr "Yn de mediabibleteek"

#: showbits/includes/class-library-page.php
msgid "An older version is in the media library"
msgstr "In âldere ferzje stiet yn de mediabibleteek"

#: showbits/includes/class-library-page.php
msgid "Edit"
msgstr "Bewurkje"

#: showbits/includes/class-library-page.php
msgid "Format"
msgstr "Formaat"

#: showbits/includes/class-library-page.php
msgid "Video"
msgstr "Fideo"

#: showbits/includes/class-library-page.php
msgid "Quote card"
msgstr "Sitaatkaart"

#: showbits/includes/class-library-page.php
msgid "Meme"
msgstr "Meme"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "Failed: %s"
msgstr "Mislearre: %s"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "The library could not be loaded: %s"
msgstr "It laden fan de bibleteek is mislearre: %s"

#: showbits/includes/class-library-page.php
msgid "This site is not connected to ShowBits yet."
msgstr "Dizze webside is noch net mei ShowBits ferbûn."

#: showbits/includes/class-library-page.php
msgid "Connect it in the settings."
msgstr "Ferbyn de webside yn de ynstellingen."

#: showbits/includes/class-library-page.php
msgid "An administrator of this site connects it in the settings."
msgstr "In behearder fan dizze webside moat de webside yn de ynstellingen ferbine."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-library-page.php
msgid "Released clips and quote cards from the ShowBits workspace “%s”. What you import lands in the media library, ready for posts and pages."
msgstr "Frijjûne klips en sitaatkaarten út de ShowBits-wurkromte “%s”. Wat jo ymportearje, komt yn de mediabibleteek telâne, klear foar berjochten en siden."

#: showbits/includes/class-library-page.php
msgid "The library needs JavaScript."
msgstr "De bibleteek hat JavaScript nedich."

#: showbits/includes/class-settings-page.php
msgid "Settings"
msgstr "Ynstellingen"

#: showbits/includes/class-settings-page.php
msgid "You may not change these settings."
msgstr "Jo hawwe gjin tastimming om dizze ynstellingen te wizigjen."

#: showbits/includes/class-settings-page.php
msgid "Connection"
msgstr "Ferbining"

#. translators: 1: the constant SHOWBITS_ENCRYPTION_KEY, 2: the file wp-config.php (both stay as they are)
#: showbits/includes/class-settings-page.php
msgid "Your site’s security keys are not in %2$s, so the key that protects the connection to ShowBits is stored in the database. Add %1$s with a long random value to %2$s; if the site is connected already, connect it again afterwards."
msgstr "De befeiligingskaaien fan jo webside steane net yn %2$s, dêrom wurdt de kaai dy't de ferbining mei ShowBits beskermet yn de databank bewarre. Foegje %1$s mei in lange willekeurige wearde ta oan %2$s; as de webside al ferbûn is, ferbyn him dêrnei opnij."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-settings-page.php
msgid "Connected to the workspace “%s”."
msgstr "Ferbûn mei de wurkromte “%s”."

#. translators: 1: imports today, 2: imports a day the plan allows
#: showbits/includes/class-settings-page.php
msgid "Imports today: %1$d of %2$d."
msgstr "Ymporten hjoed: %1$d fan %2$d."

#. translators: 1: a person, 2: a date, 3: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "Connected by %1$s on %2$s, at %3$s."
msgstr "Ferbûn mei %3$s troch %1$s op %2$s."

#: showbits/includes/class-settings-page.php
msgid "Connect again"
msgstr "Opnij ferbine"

#: showbits/includes/class-settings-page.php
msgid "With a new site key the site renews its connection, or moves to another workspace."
msgstr "Mei in nije websidekaai wurdt de ferbining fan de webside fernijd, of giet de webside oer nei in oare wurkromte."

#. translators: %s: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "ShowBits (%s) cannot be reached right now. The connection stays; try again later."
msgstr "ShowBits (%s) is op dit stuit net te berikken. De ferbining bliuwt bestean; besykje it letter nochris."

#: showbits/includes/class-settings-page.php
msgid "ShowBits no longer accepts this site’s connection: it was disconnected in ShowBits, the plan ended, or this site’s keys changed. Connect it again with a new site key."
msgstr "ShowBits akseptearret de ferbining fan dizze webside net mear: de ferbining is yn ShowBits ferbrutsen, it abonnemint is ôfrûn of de kaaien fan dizze webside binne feroare. Ferbyn de webside opnij mei in nije websidekaai."

#: showbits/includes/class-settings-page.php
msgid "Connect this site to a ShowBits workspace: an admin or owner of the workspace makes a site key for this site in ShowBits (Integrations → WordPress). The site can then take released clips and quote cards into its media library, and receive what your ShowBits admins send."
msgstr "Ferbyn dizze webside mei in ShowBits-wurkromte: in admin of eigner fan de wurkromte makket in websidekaai foar dizze webside yn ShowBits (Integrations → WordPress). Dêrnei kin de webside frijjûne klips en sitaatkaarten yn de mediabibleteek opnimme en ûntfange wat jo ShowBits-admins stjoere."

#: showbits/includes/class-settings-page.php
msgid "Imports"
msgstr "Ymporten"

#: showbits/includes/class-settings-page.php
msgid "Format of quote cards"
msgstr "Formaat fan sitaatkaarten"

#: showbits/includes/class-settings-page.php
msgid "4:5 (feeds, articles)"
msgstr "4:5 (feeds, artikels)"

#: showbits/includes/class-settings-page.php
msgid "1:1 (square)"
msgstr "1:1 (fjouwerkant)"

#: showbits/includes/class-settings-page.php
msgid "9:16 (stories)"
msgstr "9:16 (stories)"

#: showbits/includes/class-settings-page.php
msgid "The picture pushes bring; in the library you choose for each card."
msgstr "It formaat fan kaarten dy’t hjirhinne stjoerd wurde; yn de bibleteek kieze jo it per kaart."

#: showbits/includes/class-settings-page.php
msgid "Videos"
msgstr "Fideo’s"

#: showbits/includes/class-settings-page.php
msgid "Import the thumbnail as the video’s poster image"
msgstr "De miniatuer ymportearje as posterôfbylding fan de fideo"

#: showbits/includes/class-settings-page.php
msgid "Save"
msgstr "Bewarje"

#: showbits/includes/class-settings-page.php
msgid "Site key"
msgstr "Websidekaai"

#. translators: %s: this site's address
#: showbits/includes/class-settings-page.php
msgid "Made in ShowBits for %s, valid for 24 hours and only once. ShowBits then checks that it is talking to this site."
msgstr "Makke yn ShowBits foar %s, 24 oeren jildich en mar ien kear te brûken. ShowBits kontrolearret dêrnei oft it echt mei dizze webside praat."

#: showbits/includes/class-settings-page.php
msgid "Connect"
msgstr "Ferbine"

#: showbits/includes/class-settings-page.php
msgid "Are you an admin or owner of the workspace yourself? Then sign in to ShowBits and agree there, without a site key:"
msgstr "Binne jo sels admin of eigner fan de wurkromte? Meld jo dan oan by ShowBits en jou dêr tastimming, sûnder websidekaai:"

#: showbits/includes/class-settings-page.php
msgid "Connect through ShowBits"
msgstr "Ferbine fia ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits address"
msgstr "ShowBits-adres"

#: showbits/includes/class-settings-page.php
msgid "ShowBits Cloud: https://app.showbits.ai. OnPremise: the address of your installation."
msgstr "ShowBits Cloud: https://app.showbits.ai. OnPremise: it adres fan jo ynstallaasje."

#: showbits/includes/class-settings-page.php
msgid "Disconnect"
msgstr "Ferbining ferbrekke"

#: showbits/includes/class-settings-page.php
msgid "Disconnect this site from ShowBits? What is in the media library stays."
msgstr "De ferbining fan dizze webside mei ShowBits ferbrekke? Wat yn de mediabibleteek stiet, bliuwt dêr."

#: showbits/includes/class-settings-page.php
msgid "asked for"
msgstr "Oanfrege"

#: showbits/includes/class-settings-page.php
msgid "waiting"
msgstr "Yn de wachtrige"

#: showbits/includes/class-settings-page.php
msgid "importing"
msgstr "Wurdt ymportearre"

#: showbits/includes/class-settings-page.php
msgid "imported"
msgstr "Ymportearre"

#: showbits/includes/class-settings-page.php
msgid "failed"
msgstr "Mislearre"

#: showbits/includes/class-settings-page.php
msgid "Recent imports"
msgstr "Lêste ymporten"

#: showbits/includes/class-settings-page.php
msgid "When"
msgstr "Wannear"

#: showbits/includes/class-settings-page.php
msgid "Clip"
msgstr "Klip"

#: showbits/includes/class-settings-page.php
msgid "How"
msgstr "Boarne"

#: showbits/includes/class-settings-page.php
msgid "State"
msgstr "Status"

#: showbits/includes/class-settings-page.php
msgid "sent from ShowBits"
msgstr "Fan ShowBits stjoerd"

#: showbits/includes/class-settings-page.php
msgid "picked here"
msgstr "Hjir keazen"

#: showbits/includes/class-settings-page.php
msgid "Connected. The library is under Media → ShowBits."
msgstr "Ferbûn. De bibleteek stiet ûnder Media → ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Disconnected. What is in the media library stays."
msgstr "Ferbining ferbrutsen. Wat yn de mediabibleteek stiet, bliuwt dêr."

#: showbits/includes/class-settings-page.php
msgid "Saved."
msgstr "Bewarre."

#: showbits/includes/class-settings-page.php
msgid "Connecting was cancelled in ShowBits."
msgstr "It ferbinen is yn ShowBits annulearre."

#: showbits/includes/class-settings-page.php
msgid "That way back from ShowBits did not belong to this attempt. Start again."
msgstr "De weromkear fan ShowBits heart net by it ferbiningsbesykjen fan dizze webside. Begjin opnij."

#: showbits/includes/class-settings-page.php
msgid "The ShowBits address must start with https://."
msgstr "It ShowBits-adres moat begjinne mei https://."

#: showbits/includes/class-settings-page.php
msgid "That is not a site key. Copy it from ShowBits (Integrations → WordPress) again."
msgstr "Dat is gjin websidekaai. Kopiearje him opnij út ShowBits (Integrations → WordPress)."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not take the site key: it is unknown, used, withdrawn or expired (a site key lasts 24 hours, a consent ten minutes). Make a new one."
msgstr "ShowBits hat de websidekaai net oannommen: hy is ûnbekend, al brûkt, ynlutsen of ferrûn (in websidekaai is 24 oeren jildich, in tastimming tsien minuten). Meitsje in nije."

#: showbits/includes/class-settings-page.php
msgid "The site key was made for another address. Make one for this site’s address."
msgstr "De websidekaai is foar in oar adres makke. Meitsje ien foar it adres fan dizze webside."

#: showbits/includes/class-settings-page.php
msgid "ShowBits could not reach this site at its REST API (/wp-json/showbits/v1/push), or ShowBits itself could not be reached. The site must be public over HTTPS; a firewall or security plugin must let ShowBits in."
msgstr "ShowBits koe dizze webside net berikke fia de REST API (/wp-json/showbits/v1/push), of ShowBits sels wie net te berikken. De webside moat iepenbier te berikken wêze fia HTTPS; in firewall of befeiligingsplugin moat ShowBits trochlitte."

#: showbits/includes/class-settings-page.php
msgid "This site did not answer ShowBits’ check as expected. Try again; if it fails again, a cache or security plugin may answer for WordPress."
msgstr "Dizze webside hat de kontrôle fan ShowBits net lykas ferwachte beäntwurde. Besykje it nochris; as it wer mislearret, antwurdet miskien in cache- of befeiligingsplugin yn it plak fan WordPress."

#: showbits/includes/class-settings-page.php
msgid "The workspace’s plan has ended, or whoever made the site key may no longer connect sites."
msgstr "It abonnemint fan de wurkromte is ôfrûn, of wa’t de websidekaai makke hat, mei gjin websiden mear ferbine."

#: showbits/includes/class-settings-page.php
msgid "The workspace has as many sites as its plan allows."
msgstr "De wurkromte hat al safolle websiden as it abonnemint tastiet."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not accept this site’s address. It must be served over HTTPS."
msgstr "ShowBits hat it adres fan dizze webside net akseptearre. De webside moat fia HTTPS oanbean wurde."

#: showbits/includes/class-settings-page.php
msgid "Connecting did not work. Try again, or ask your ShowBits contact."
msgstr "It ferbinen is net slagge. Besykje it nochris, of freegje jo kontaktpersoan by ShowBits om help."
