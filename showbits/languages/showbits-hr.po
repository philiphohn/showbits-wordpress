# Croatian translation of the ShowBits plugin.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: hr\n"
"Plural-Forms: nplurals=3; plural=(n % 10 == 1 && n % 100 != 11) ? 0 : ((n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14)) ? 1 : 2);\n"

#. Description of the plugin
#: showbits/showbits.php
msgid "Released clips and quote cards from ShowBits in the media library: pick them in WordPress, or receive what your ShowBits admins send."
msgstr "Odobreni isječci i slike s citatima iz ShowBitsa u zbirci medija: odaberite ih u WordPressu ili primajte ono što šalju vaši administratori u ShowBitsu."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer as expected."
msgstr "ShowBits nije odgovorio kako se očekivalo."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer with a file."
msgstr "ShowBits nije vratio datoteku."

#: showbits/includes/class-api-client.php showbits/includes/class-importer.php
msgid "ShowBits could not be reached."
msgstr "ShowBits nije dostupan."

#. translators: 1: ShowBits' reason, 2: the HTTP status
#: showbits/includes/class-api-client.php
msgid "ShowBits refused (%1$s, HTTP %2$d)."
msgstr "ShowBits je odbio zahtjev (%1$s, HTTP %2$d)."

#: showbits/includes/class-connection.php
msgid "You may not connect this site."
msgstr "Nemate dopuštenje za povezivanje ove web stranice."

#. translators: %s: the clip's title
#: showbits/includes/class-importer.php
msgid "%s (thumbnail)"
msgstr "%s (minijatura)"

#. translators: %s: a quote (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%s”"
msgstr "„%s“"

#. translators: 1: a quote, 2: who said it (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%1$s” – %2$s"
msgstr "„%1$s“ – %2$s"

#: showbits/includes/class-importer.php
msgid "This is not a clip or a format ShowBits offers."
msgstr "Ovo nije isječak ni format koji ShowBits nudi."

#: showbits/includes/class-importer.php
msgid "The clip is no longer released in ShowBits."
msgstr "Isječak više nije odobren u ShowBitsu."

#: showbits/includes/class-importer.php
msgid "The embargo still holds: the file stays in ShowBits until it ends."
msgstr "Embargo još vrijedi: do njegova isteka datoteka ostaje u ShowBitsu."

#: showbits/includes/class-importer.php
msgid "The file is not ready yet in ShowBits."
msgstr "Datoteka u ShowBitsu još nije spremna."

#: showbits/includes/class-importer.php
msgid "The file could not be downloaded."
msgstr "Datoteku nije bilo moguće preuzeti."

#: showbits/includes/class-importer.php
msgid "WordPress did not take the file into the media library."
msgstr "WordPress nije primio datoteku u zbirku medija."

#: showbits/includes/class-importer.php
msgid "The delivery from ShowBits is no longer valid. Import the clip again."
msgstr "Isporuka iz ShowBitsa više nije važeća. Ponovno uvezite isječak."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer accepts this site’s connection: connect it again under Settings → ShowBits."
msgstr "ShowBits više ne prihvaća vezu ove web stranice: ponovno je povežite u izborniku Postavke → ShowBits."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer delivers to this site: the workspace’s plan has ended."
msgstr "ShowBits više ništa ne isporučuje ovoj web stranici: paket radnog prostora je istekao."

#: showbits/includes/class-importer.php
msgid "The site’s imports for today are used up. Try again tomorrow."
msgstr "Dosegnuto je dnevno ograničenje uvoza za ovu web stranicu. Pokušajte ponovno sutra."

#: showbits/includes/class-importer.php
msgid "The import was interrupted."
msgstr "Uvoz je prekinut."

#: showbits/includes/class-importer.php
msgid "The import failed."
msgstr "Uvoz nije uspio."

#: showbits/includes/class-library-endpoint.php
msgid "This site is not connected to ShowBits."
msgstr "Ova web stranica nije povezana sa ShowBitsom."

#: showbits/includes/class-library-page.php
msgid "All"
msgstr "Sve"

#: showbits/includes/class-library-page.php
msgid "Clips"
msgstr "Isječci"

#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Quote cards"
msgstr "Slike s citatima"

#: showbits/includes/class-library-page.php
msgid "Search titles"
msgstr "Pretraži naslove"

#: showbits/includes/class-library-page.php
msgid "Search the library"
msgstr "Pretraži biblioteku"

#: showbits/includes/class-library-page.php
msgid "Import selected"
msgstr "Uvezi odabrano"

#. translators: 1: which one, 2: how many in all
#: showbits/includes/class-library-page.php
msgid "Asking ShowBits for %1$d of %2$d …"
msgstr "Slanje zahtjeva ShowBitsu: %1$d od %2$d…"

#. translators: %d: how many clips are still on their way
#: showbits/includes/class-library-page.php
msgid "On the way from ShowBits: %d …"
msgstr "Na putu iz ShowBitsa: %d…"

#. translators: %d: how many clips were imported
#: showbits/includes/class-library-page.php
msgid "Imported: %d"
msgstr "Uvezeno: %d"

#: showbits/includes/class-library-page.php
msgid "Not everything has arrived yet; it continues in the background. Settings → ShowBits lists the imports."
msgstr "Još nije sve stiglo; uvoz se nastavlja u pozadini. Popis uvoza nalazi se u izborniku Postavke → ShowBits."

#: showbits/includes/class-library-page.php
msgid "On the way"
msgstr "Na putu"

#: showbits/includes/class-library-page.php
msgid "Load more"
msgstr "Učitaj više"

#: showbits/includes/class-library-page.php
msgid "Loading …"
msgstr "Učitavanje…"

#: showbits/includes/class-library-page.php
msgid "No released clips or quote cards yet."
msgstr "Još nema odobrenih isječaka ni slika s citatima."

#. translators: %s: date and time the embargo ends
#: showbits/includes/class-library-page.php
msgid "Embargo until %s"
msgstr "Embargo do %s"

#: showbits/includes/class-library-page.php
msgid "Not ready yet"
msgstr "Još nije spremno"

#: showbits/includes/class-library-page.php
msgid "In the media library"
msgstr "U zbirci medija"

#: showbits/includes/class-library-page.php
msgid "An older version is in the media library"
msgstr "U zbirci medija nalazi se starija inačica"

#: showbits/includes/class-library-page.php
msgid "Edit"
msgstr "Uredi"

#: showbits/includes/class-library-page.php
msgid "Format"
msgstr "Format"

#: showbits/includes/class-library-page.php
msgid "Video"
msgstr "Video"

#: showbits/includes/class-library-page.php
msgid "Quote card"
msgstr "Slika s citatom"

#: showbits/includes/class-library-page.php
msgid "Meme"
msgstr "Mem"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "Failed: %s"
msgstr "Nije uspjelo: %s"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "The library could not be loaded: %s"
msgstr "Biblioteku nije bilo moguće učitati: %s"

#: showbits/includes/class-library-page.php
msgid "This site is not connected to ShowBits yet."
msgstr "Ova web stranica još nije povezana sa ShowBitsom."

#: showbits/includes/class-library-page.php
msgid "Connect it in the settings."
msgstr "Povežite je u postavkama."

#: showbits/includes/class-library-page.php
msgid "An administrator of this site connects it in the settings."
msgstr "Administrator ove web stranice može je povezati u postavkama."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-library-page.php
msgid "Released clips and quote cards from the ShowBits workspace “%s”. What you import lands in the media library, ready for posts and pages."
msgstr "Odobreni isječci i slike s citatima iz radnog prostora „%s“ u ShowBitsu. Ono što uvezete stiže u zbirku medija, spremno za objave i stranice."

#: showbits/includes/class-library-page.php
msgid "The library needs JavaScript."
msgstr "Biblioteci je potreban JavaScript."

#: showbits/includes/class-settings-page.php
msgid "Settings"
msgstr "Postavke"

#: showbits/includes/class-settings-page.php
msgid "You may not change these settings."
msgstr "Nemate dopuštenje za promjenu ovih postavki."

#: showbits/includes/class-settings-page.php
msgid "Connection"
msgstr "Veza"

#. translators: 1: the constant SHOWBITS_ENCRYPTION_KEY, 2: the file wp-config.php (both stay as they are)
#: showbits/includes/class-settings-page.php
msgid "Your site’s security keys are not in %2$s, so the key that protects the connection to ShowBits is stored in the database. Add %1$s with a long random value to %2$s; if the site is connected already, connect it again afterwards."
msgstr "Sigurnosni ključevi vaše web stranice nisu u %2$s, pa je ključ koji štiti vezu sa ShowBitsom spremljen u bazi podataka. Dodajte %1$s s dugom nasumičnom vrijednošću u %2$s; ako je web stranica već povezana, nakon toga je ponovno povežite."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-settings-page.php
msgid "Connected to the workspace “%s”."
msgstr "Povezano s radnim prostorom „%s“."

#. translators: 1: imports today, 2: imports a day the plan allows
#: showbits/includes/class-settings-page.php
msgid "Imports today: %1$d of %2$d."
msgstr "Današnji uvozi: %1$d od %2$d."

#. translators: 1: a person, 2: a date, 3: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "Connected by %1$s on %2$s, at %3$s."
msgstr "Vezu s %3$s uspostavio je korisnik %1$s, %2$s."

#: showbits/includes/class-settings-page.php
msgid "Connect again"
msgstr "Ponovno povezivanje"

#: showbits/includes/class-settings-page.php
msgid "With a new site key the site renews its connection, or moves to another workspace."
msgstr "Novi ključ web stranice obnavlja vezu ili premješta web stranicu u drugi radni prostor."

#. translators: %s: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "ShowBits (%s) cannot be reached right now. The connection stays; try again later."
msgstr "ShowBits (%s) trenutačno nije dostupan. Veza ostaje; pokušajte ponovno kasnije."

#: showbits/includes/class-settings-page.php
msgid "ShowBits no longer accepts this site’s connection: it was disconnected in ShowBits, the plan ended, or this site’s keys changed. Connect it again with a new site key."
msgstr "ShowBits više ne prihvaća vezu ove web stranice: veza je prekinuta u ShowBitsu, paket je istekao ili su se ključevi ove web stranice promijenili. Ponovno je povežite novim ključem web stranice."

#: showbits/includes/class-settings-page.php
msgid "Connect this site to a ShowBits workspace: an admin or owner of the workspace makes a site key for this site in ShowBits (Integrations → WordPress). The site can then take released clips and quote cards into its media library, and receive what your ShowBits admins send."
msgstr "Povežite ovu web stranicu s radnim prostorom u ShowBitsu: administrator ili vlasnik radnog prostora izrađuje u ShowBitsu ključ web stranice za ovu web stranicu (Integrations → WordPress). Web stranica tada može preuzimati odobrene isječke i slike s citatima u svoju zbirku medija te primati ono što šalju vaši administratori u ShowBitsu."

#: showbits/includes/class-settings-page.php
msgid "Imports"
msgstr "Uvozi"

#: showbits/includes/class-settings-page.php
msgid "Format of quote cards"
msgstr "Format slika s citatima"

#: showbits/includes/class-settings-page.php
msgid "4:5 (feeds, articles)"
msgstr "4:5 (feedovi, članci)"

#: showbits/includes/class-settings-page.php
msgid "1:1 (square)"
msgstr "1:1 (kvadrat)"

#: showbits/includes/class-settings-page.php
msgid "9:16 (stories)"
msgstr "9:16 (priče)"

#: showbits/includes/class-settings-page.php
msgid "The picture pushes bring; in the library you choose for each card."
msgstr "Format koji imaju poslane slike; u biblioteci ga birate za svaku sliku zasebno."

#: showbits/includes/class-settings-page.php
msgid "Videos"
msgstr "Videi"

#: showbits/includes/class-settings-page.php
msgid "Import the thumbnail as the video’s poster image"
msgstr "Uvezi minijaturu kao poster sliku videa"

#: showbits/includes/class-settings-page.php
msgid "Save"
msgstr "Snimi"

#: showbits/includes/class-settings-page.php
msgid "Site key"
msgstr "Ključ web stranice"

#. translators: %s: this site's address
#: showbits/includes/class-settings-page.php
msgid "Made in ShowBits for %s, valid for 24 hours and only once. ShowBits then checks that it is talking to this site."
msgstr "Izrađuje se u ShowBitsu za %s; vrijedi 24 sata i može se upotrijebiti samo jednom. ShowBits zatim provjerava komunicira li baš s ovom web stranicom."

#: showbits/includes/class-settings-page.php
msgid "Connect"
msgstr "Poveži"

#: showbits/includes/class-settings-page.php
msgid "Are you an admin or owner of the workspace yourself? Then sign in to ShowBits and agree there, without a site key:"
msgstr "Jeste li i sami administrator ili vlasnik radnog prostora? Tada se prijavite u ShowBits i ondje dajte suglasnost, bez ključa web stranice:"

#: showbits/includes/class-settings-page.php
msgid "Connect through ShowBits"
msgstr "Poveži putem ShowBitsa"

#: showbits/includes/class-settings-page.php
msgid "ShowBits address"
msgstr "Adresa ShowBitsa"

#: showbits/includes/class-settings-page.php
msgid "ShowBits Cloud: https://app.showbits.ai. OnPremise: the address of your installation."
msgstr "ShowBits Cloud: https://app.showbits.ai. OnPremise: adresa vaše instalacije."

#: showbits/includes/class-settings-page.php
msgid "Disconnect"
msgstr "Prekini vezu"

#: showbits/includes/class-settings-page.php
msgid "Disconnect this site from ShowBits? What is in the media library stays."
msgstr "Želite li prekinuti vezu ove web stranice sa ShowBitsom? Ono što je u zbirci medija ostaje."

#: showbits/includes/class-settings-page.php
msgid "asked for"
msgstr "Zatraženo"

#: showbits/includes/class-settings-page.php
msgid "waiting"
msgstr "Na čekanju"

#: showbits/includes/class-settings-page.php
msgid "importing"
msgstr "Uvozi se"

#: showbits/includes/class-settings-page.php
msgid "imported"
msgstr "Uvezeno"

#: showbits/includes/class-settings-page.php
msgid "failed"
msgstr "Nije uspjelo"

#: showbits/includes/class-settings-page.php
msgid "Recent imports"
msgstr "Nedavni uvozi"

#: showbits/includes/class-settings-page.php
msgid "When"
msgstr "Datum"

#: showbits/includes/class-settings-page.php
msgid "Clip"
msgstr "Isječak"

#: showbits/includes/class-settings-page.php
msgid "How"
msgstr "Način"

#: showbits/includes/class-settings-page.php
msgid "State"
msgstr "Status"

#: showbits/includes/class-settings-page.php
msgid "sent from ShowBits"
msgstr "Poslano iz ShowBitsa"

#: showbits/includes/class-settings-page.php
msgid "picked here"
msgstr "Odabrano ovdje"

#: showbits/includes/class-settings-page.php
msgid "Connected. The library is under Media → ShowBits."
msgstr "Povezano. Biblioteka se nalazi u izborniku Medijski zapisi → ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Disconnected. What is in the media library stays."
msgstr "Veza je prekinuta. Ono što je u zbirci medija ostaje."

#: showbits/includes/class-settings-page.php
msgid "Saved."
msgstr "Snimljeno."

#: showbits/includes/class-settings-page.php
msgid "Connecting was cancelled in ShowBits."
msgstr "Povezivanje je otkazano u ShowBitsu."

#: showbits/includes/class-settings-page.php
msgid "That way back from ShowBits did not belong to this attempt. Start again."
msgstr "Taj povratak iz ShowBitsa ne pripada ovom pokušaju povezivanja. Počnite ispočetka."

#: showbits/includes/class-settings-page.php
msgid "The ShowBits address must start with https://."
msgstr "Adresa ShowBitsa mora počinjati s https://."

#: showbits/includes/class-settings-page.php
msgid "That is not a site key. Copy it from ShowBits (Integrations → WordPress) again."
msgstr "To nije ključ web stranice. Ponovno ga kopirajte iz ShowBitsa (Integrations → WordPress)."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not take the site key: it is unknown, used, withdrawn or expired (a site key lasts 24 hours, a consent ten minutes). Make a new one."
msgstr "ShowBits nije prihvatio ključ web stranice: nepoznat je, već iskorišten, povučen ili je istekao (ključ web stranice vrijedi 24 sata, suglasnost deset minuta). Izradite novi."

#: showbits/includes/class-settings-page.php
msgid "The site key was made for another address. Make one for this site’s address."
msgstr "Ključ web stranice izrađen je za drugu adresu. Izradite ključ za adresu ove web stranice."

#: showbits/includes/class-settings-page.php
msgid "ShowBits could not reach this site at its REST API (/wp-json/showbits/v1/push), or ShowBits itself could not be reached. The site must be public over HTTPS; a firewall or security plugin must let ShowBits in."
msgstr "ShowBits nije mogao pristupiti ovoj web stranici putem njezina REST API-ja (/wp-json/showbits/v1/push) ili sam ShowBits nije bio dostupan. Web stranica mora biti javno dostupna putem HTTPS-a; vatrozid ili sigurnosni dodatak mora propustiti ShowBits."

#: showbits/includes/class-settings-page.php
msgid "This site did not answer ShowBits’ check as expected. Try again; if it fails again, a cache or security plugin may answer for WordPress."
msgstr "Ova web stranica nije odgovorila na provjeru ShowBitsa kako se očekivalo. Pokušajte ponovno; ako opet ne uspije, možda umjesto WordPressa odgovara dodatak za predmemoriju ili sigurnosni dodatak."

#: showbits/includes/class-settings-page.php
msgid "The workspace’s plan has ended, or whoever made the site key may no longer connect sites."
msgstr "Paket radnog prostora je istekao ili onaj tko je izradio ključ web stranice više ne smije povezivati web stranice."

#: showbits/includes/class-settings-page.php
msgid "The workspace has as many sites as its plan allows."
msgstr "Radni prostor već ima onoliko web stranica koliko mu paket dopušta."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not accept this site’s address. It must be served over HTTPS."
msgstr "ShowBits nije prihvatio adresu ove web stranice. Web stranica mora se posluživati putem HTTPS-a."

#: showbits/includes/class-settings-page.php
msgid "Connecting did not work. Try again, or ask your ShowBits contact."
msgstr "Povezivanje nije uspjelo. Pokušajte ponovno ili se obratite svojoj kontaktnoj osobi u ShowBitsu."
