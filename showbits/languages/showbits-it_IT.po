# Italian translation of the ShowBits plugin.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: it_IT\n"
"Plural-Forms: nplurals=2; plural=n != 1;\n"

#. Description of the plugin
#: showbits/showbits.php
msgid "Released clips and quote cards from ShowBits in the media library: pick them in WordPress, or receive what your ShowBits admins send."
msgstr "Clip e card con citazione approvate in ShowBits, nella libreria media: sceglile in WordPress o ricevi ciò che inviano i tuoi admin di ShowBits."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer as expected."
msgstr "ShowBits non ha risposto come previsto."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer with a file."
msgstr "ShowBits non ha restituito alcun file."

#: showbits/includes/class-api-client.php showbits/includes/class-importer.php
msgid "ShowBits could not be reached."
msgstr "Impossibile raggiungere ShowBits."

#. translators: 1: ShowBits' reason, 2: the HTTP status
#: showbits/includes/class-api-client.php
msgid "ShowBits refused (%1$s, HTTP %2$d)."
msgstr "ShowBits ha rifiutato la richiesta (%1$s, HTTP %2$d)."

#: showbits/includes/class-connection.php
msgid "You may not connect this site."
msgstr "Non hai i permessi per connettere questo sito."

#. translators: %s: the clip's title
#: showbits/includes/class-importer.php
msgid "%s (thumbnail)"
msgstr "%s (miniatura)"

#. translators: %s: a quote (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%s”"
msgstr "“%s”"

#. translators: 1: a quote, 2: who said it (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%1$s” – %2$s"
msgstr "“%1$s” – %2$s"

#: showbits/includes/class-importer.php
msgid "This is not a clip or a format ShowBits offers."
msgstr "Non è una clip né un formato offerto da ShowBits."

#: showbits/includes/class-importer.php
msgid "The clip is no longer released in ShowBits."
msgstr "La clip non è più approvata in ShowBits."

#: showbits/includes/class-importer.php
msgid "The embargo still holds: the file stays in ShowBits until it ends."
msgstr "L'embargo è ancora in vigore: il file resta in ShowBits fino alla sua scadenza."

#: showbits/includes/class-importer.php
msgid "The file is not ready yet in ShowBits."
msgstr "Il file non è ancora pronto in ShowBits."

#: showbits/includes/class-importer.php
msgid "The file could not be downloaded."
msgstr "Impossibile scaricare il file."

#: showbits/includes/class-importer.php
msgid "WordPress did not take the file into the media library."
msgstr "WordPress non ha accettato il file nella libreria media."

#: showbits/includes/class-importer.php
msgid "The delivery from ShowBits is no longer valid. Import the clip again."
msgstr "La consegna da ShowBits non è più valida. Importa di nuovo la clip."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer accepts this site’s connection: connect it again under Settings → ShowBits."
msgstr "ShowBits non accetta più la connessione di questo sito: connettilo di nuovo in Impostazioni → ShowBits."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer delivers to this site: the workspace’s plan has ended."
msgstr "ShowBits non invia più nulla a questo sito: il piano dello spazio di lavoro è terminato."

#: showbits/includes/class-importer.php
msgid "The site’s imports for today are used up. Try again tomorrow."
msgstr "Le importazioni di oggi per questo sito sono esaurite. Riprova domani."

#: showbits/includes/class-importer.php
msgid "The import was interrupted."
msgstr "L'importazione è stata interrotta."

#: showbits/includes/class-importer.php
msgid "The import failed."
msgstr "L'importazione non è riuscita."

#: showbits/includes/class-library-endpoint.php
msgid "This site is not connected to ShowBits."
msgstr "Questo sito non è connesso a ShowBits."

#: showbits/includes/class-library-page.php
msgid "All"
msgstr "Tutti"

#: showbits/includes/class-library-page.php
msgid "Clips"
msgstr "Clip"

#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Quote cards"
msgstr "Card con citazione"

#: showbits/includes/class-library-page.php
msgid "Search titles"
msgstr "Cerca nei titoli"

#: showbits/includes/class-library-page.php
msgid "Search the library"
msgstr "Cerca nella libreria"

#: showbits/includes/class-library-page.php
msgid "Import selected"
msgstr "Importa la selezione"

#. translators: 1: which one, 2: how many in all
#: showbits/includes/class-library-page.php
msgid "Asking ShowBits for %1$d of %2$d …"
msgstr "Richiesta a ShowBits: %1$d di %2$d…"

#. translators: %d: how many clips are still on their way
#: showbits/includes/class-library-page.php
msgid "On the way from ShowBits: %d …"
msgstr "In arrivo da ShowBits: %d…"

#. translators: %d: how many clips were imported
#: showbits/includes/class-library-page.php
msgid "Imported: %d"
msgstr "Elementi importati: %d"

#: showbits/includes/class-library-page.php
msgid "Not everything has arrived yet; it continues in the background. Settings → ShowBits lists the imports."
msgstr "Non è ancora arrivato tutto; l'importazione prosegue in background. L'elenco delle importazioni è in Impostazioni → ShowBits."

#: showbits/includes/class-library-page.php
msgid "On the way"
msgstr "In arrivo"

#: showbits/includes/class-library-page.php
msgid "Load more"
msgstr "Carica altri"

#: showbits/includes/class-library-page.php
msgid "Loading …"
msgstr "Caricamento…"

#: showbits/includes/class-library-page.php
msgid "No released clips or quote cards yet."
msgstr "Non ci sono ancora clip o card con citazione approvate."

#. translators: %s: date and time the embargo ends
#: showbits/includes/class-library-page.php
msgid "Embargo until %s"
msgstr "Embargo fino al %s"

#: showbits/includes/class-library-page.php
msgid "Not ready yet"
msgstr "File non ancora pronto"

#: showbits/includes/class-library-page.php
msgid "In the media library"
msgstr "Nella libreria media"

#: showbits/includes/class-library-page.php
msgid "An older version is in the media library"
msgstr "Una versione precedente è nella libreria media"

#: showbits/includes/class-library-page.php
msgid "Edit"
msgstr "Modifica"

#: showbits/includes/class-library-page.php
msgid "Format"
msgstr "Formato"

#: showbits/includes/class-library-page.php
msgid "Video"
msgstr "Video"

#: showbits/includes/class-library-page.php
msgid "Quote card"
msgstr "Card con citazione"

#: showbits/includes/class-library-page.php
msgid "Meme"
msgstr "Meme"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "Failed: %s"
msgstr "Importazione non riuscita: %s"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "The library could not be loaded: %s"
msgstr "Impossibile caricare la libreria: %s"

#: showbits/includes/class-library-page.php
msgid "This site is not connected to ShowBits yet."
msgstr "Questo sito non è ancora connesso a ShowBits."

#: showbits/includes/class-library-page.php
msgid "Connect it in the settings."
msgstr "Connettilo nelle impostazioni."

#: showbits/includes/class-library-page.php
msgid "An administrator of this site connects it in the settings."
msgstr "Spetta a un amministratore di questo sito connetterlo nelle impostazioni."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-library-page.php
msgid "Released clips and quote cards from the ShowBits workspace “%s”. What you import lands in the media library, ready for posts and pages."
msgstr "Clip e card con citazione approvate dallo spazio di lavoro ShowBits “%s”. Ciò che importi finisce nella libreria media, pronto per articoli e pagine."

#: showbits/includes/class-library-page.php
msgid "The library needs JavaScript."
msgstr "La libreria richiede JavaScript."

#: showbits/includes/class-settings-page.php
msgid "Settings"
msgstr "Impostazioni"

#: showbits/includes/class-settings-page.php
msgid "You may not change these settings."
msgstr "Non hai i permessi per modificare queste impostazioni."

#: showbits/includes/class-settings-page.php
msgid "Connection"
msgstr "Connessione"

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-settings-page.php
msgid "Connected to the workspace “%s”."
msgstr "Connesso allo spazio di lavoro “%s”."

#. translators: 1: imports today, 2: imports a day the plan allows
#: showbits/includes/class-settings-page.php
msgid "Imports today: %1$d of %2$d."
msgstr "Importazioni di oggi: %1$d su %2$d."

#. translators: 1: a person, 2: a date, 3: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "Connected by %1$s on %2$s, at %3$s."
msgstr "Connesso da %1$s il %2$s, all'indirizzo %3$s."

#: showbits/includes/class-settings-page.php
msgid "Connect again"
msgstr "Riconnetti"

#: showbits/includes/class-settings-page.php
msgid "With a new site key the site renews its connection, or moves to another workspace."
msgstr "Con una nuova chiave del sito, il sito rinnova la connessione o passa a un altro spazio di lavoro."

#. translators: %s: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "ShowBits (%s) cannot be reached right now. The connection stays; try again later."
msgstr "ShowBits (%s) non è raggiungibile in questo momento. La connessione resta attiva; riprova più tardi."

#: showbits/includes/class-settings-page.php
msgid "ShowBits no longer accepts this site’s connection: it was disconnected in ShowBits, the plan ended, or this site’s keys changed. Connect it again with a new site key."
msgstr "ShowBits non accetta più la connessione di questo sito: è stato disconnesso in ShowBits, il piano è terminato oppure le chiavi di questo sito sono cambiate. Connettilo di nuovo con una nuova chiave del sito."

#: showbits/includes/class-settings-page.php
msgid "Connect this site to a ShowBits workspace: an admin or owner of the workspace makes a site key for this site in ShowBits (Integrations → WordPress). The site can then take released clips and quote cards into its media library, and receive what your ShowBits admins send."
msgstr "Connetti questo sito a uno spazio di lavoro ShowBits: un admin o un proprietario dello spazio di lavoro crea in ShowBits una chiave del sito per questo sito (Integrations → WordPress). Il sito potrà poi accogliere nella sua libreria media clip e card con citazione approvate e ricevere ciò che inviano i tuoi admin di ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Imports"
msgstr "Importazioni"

#: showbits/includes/class-settings-page.php
msgid "Format of quote cards"
msgstr "Formato delle card con citazione"

#: showbits/includes/class-settings-page.php
msgid "4:5 (feeds, articles)"
msgstr "4:5 (feed, articoli)"

#: showbits/includes/class-settings-page.php
msgid "1:1 (square)"
msgstr "1:1 (quadrato)"

#: showbits/includes/class-settings-page.php
msgid "9:16 (stories)"
msgstr "9:16 (storie)"

#: showbits/includes/class-settings-page.php
msgid "The picture pushes bring; in the library you choose for each card."
msgstr "Il formato delle card inviate a questo sito; nella libreria lo scegli per ogni card."

#: showbits/includes/class-settings-page.php
msgid "Videos"
msgstr "Video"

#: showbits/includes/class-settings-page.php
msgid "Import the thumbnail as the video’s poster image"
msgstr "Importa la miniatura come immagine poster del video"

#: showbits/includes/class-settings-page.php
msgid "Save"
msgstr "Salva"

#: showbits/includes/class-settings-page.php
msgid "Site key"
msgstr "Chiave del sito"

#. translators: %s: this site's address
#: showbits/includes/class-settings-page.php
msgid "Made in ShowBits for %s, valid for 24 hours and only once. ShowBits then checks that it is talking to this site."
msgstr "Creata in ShowBits per %s, valida per 24 ore e una sola volta. ShowBits verifica poi di comunicare proprio con questo sito."

#: showbits/includes/class-settings-page.php
msgid "Connect"
msgstr "Connetti"

#: showbits/includes/class-settings-page.php
msgid "Are you an admin or owner of the workspace yourself? Then sign in to ShowBits and agree there, without a site key:"
msgstr "Sei admin o proprietario dello spazio di lavoro? Allora accedi a ShowBits e dai lì il tuo consenso, senza chiave del sito:"

#: showbits/includes/class-settings-page.php
msgid "Connect through ShowBits"
msgstr "Connetti tramite ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits address"
msgstr "Indirizzo di ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits Cloud: https://app.showbits.ai. OnPremise: the address of your installation."
msgstr "ShowBits Cloud: https://app.showbits.ai. OnPremise: l'indirizzo della tua installazione."

#: showbits/includes/class-settings-page.php
msgid "Disconnect"
msgstr "Disconnetti"

#: showbits/includes/class-settings-page.php
msgid "Disconnect this site from ShowBits? What is in the media library stays."
msgstr "Vuoi disconnettere questo sito da ShowBits? I contenuti nella libreria media restano."

#: showbits/includes/class-settings-page.php
msgid "asked for"
msgstr "Richiesto"

#: showbits/includes/class-settings-page.php
msgid "waiting"
msgstr "In attesa"

#: showbits/includes/class-settings-page.php
msgid "importing"
msgstr "Importazione in corso"

#: showbits/includes/class-settings-page.php
msgid "imported"
msgstr "Importato"

#: showbits/includes/class-settings-page.php
msgid "failed"
msgstr "Non riuscito"

#: showbits/includes/class-settings-page.php
msgid "Recent imports"
msgstr "Importazioni recenti"

#: showbits/includes/class-settings-page.php
msgid "When"
msgstr "Data"

#: showbits/includes/class-settings-page.php
msgid "Clip"
msgstr "Clip"

#: showbits/includes/class-settings-page.php
msgid "How"
msgstr "Provenienza"

#: showbits/includes/class-settings-page.php
msgid "State"
msgstr "Stato"

#: showbits/includes/class-settings-page.php
msgid "sent from ShowBits"
msgstr "Inviato da ShowBits"

#: showbits/includes/class-settings-page.php
msgid "picked here"
msgstr "Scelto qui"

#: showbits/includes/class-settings-page.php
msgid "Connected. The library is under Media → ShowBits."
msgstr "Connesso. La libreria si trova in Media → ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Disconnected. What is in the media library stays."
msgstr "Disconnesso. I contenuti nella libreria media restano."

#: showbits/includes/class-settings-page.php
msgid "Saved."
msgstr "Impostazioni salvate."

#: showbits/includes/class-settings-page.php
msgid "Connecting was cancelled in ShowBits."
msgstr "La connessione è stata annullata in ShowBits."

#: showbits/includes/class-settings-page.php
msgid "That way back from ShowBits did not belong to this attempt. Start again."
msgstr "Questo ritorno da ShowBits non corrisponde al tentativo di connessione avviato da questo sito. Ricomincia."

#: showbits/includes/class-settings-page.php
msgid "The ShowBits address must start with https://."
msgstr "L'indirizzo di ShowBits deve iniziare con https://."

#: showbits/includes/class-settings-page.php
msgid "That is not a site key. Copy it from ShowBits (Integrations → WordPress) again."
msgstr "Questa non è una chiave del sito. Copiala di nuovo da ShowBits (Integrations → WordPress)."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not take the site key: it is unknown, used, withdrawn or expired (a site key lasts 24 hours, a consent ten minutes). Make a new one."
msgstr "ShowBits non ha accettato la chiave del sito: è sconosciuta, già usata, revocata o scaduta (una chiave del sito vale 24 ore, un consenso dieci minuti). Creane una nuova."

#: showbits/includes/class-settings-page.php
msgid "The site key was made for another address. Make one for this site’s address."
msgstr "La chiave del sito è stata creata per un altro indirizzo. Creane una per l'indirizzo di questo sito."

#: showbits/includes/class-settings-page.php
msgid "ShowBits could not reach this site at its REST API (/wp-json/showbits/v1/push), or ShowBits itself could not be reached. The site must be public over HTTPS; a firewall or security plugin must let ShowBits in."
msgstr "ShowBits non è riuscito a raggiungere questo sito tramite la sua API REST (/wp-json/showbits/v1/push), oppure ShowBits stesso non era raggiungibile. Il sito deve essere raggiungibile pubblicamente tramite HTTPS; un firewall o un plugin di sicurezza deve lasciar passare ShowBits."

#: showbits/includes/class-settings-page.php
msgid "This site did not answer ShowBits’ check as expected. Try again; if it fails again, a cache or security plugin may answer for WordPress."
msgstr "Questo sito non ha risposto come previsto alla verifica di ShowBits. Riprova; se l'errore si ripete, forse un plugin di cache o di sicurezza risponde al posto di WordPress."

#: showbits/includes/class-settings-page.php
msgid "The workspace’s plan has ended, or whoever made the site key may no longer connect sites."
msgstr "Il piano dello spazio di lavoro è terminato, oppure chi ha creato la chiave del sito non può più connettere siti."

#: showbits/includes/class-settings-page.php
msgid "The workspace has as many sites as its plan allows."
msgstr "Lo spazio di lavoro ha già tanti siti quanti ne consente il suo piano."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not accept this site’s address. It must be served over HTTPS."
msgstr "ShowBits non ha accettato l'indirizzo di questo sito. Il sito deve essere servito tramite HTTPS."

#: showbits/includes/class-settings-page.php
msgid "Connecting did not work. Try again, or ask your ShowBits contact."
msgstr "La connessione non è riuscita. Riprova o chiedi al tuo referente ShowBits."
