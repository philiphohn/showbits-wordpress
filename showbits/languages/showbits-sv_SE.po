# Swedish translation of the ShowBits plugin.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: sv_SE\n"
"Plural-Forms: nplurals=2; plural=n != 1;\n"

#. Description of the plugin
#: showbits/showbits.php
msgid "Released clips and quote cards from ShowBits in the media library: pick them in WordPress, or receive what your ShowBits admins send."
msgstr "Frigivna klipp och citatkort från ShowBits i mediabiblioteket: välj dem i WordPress eller ta emot det som dina administratörer i ShowBits skickar."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer as expected."
msgstr "ShowBits svarade inte som förväntat."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer with a file."
msgstr "ShowBits levererade ingen fil."

#: showbits/includes/class-api-client.php showbits/includes/class-importer.php
msgid "ShowBits could not be reached."
msgstr "ShowBits kunde inte nås."

#. translators: 1: ShowBits' reason, 2: the HTTP status
#: showbits/includes/class-api-client.php
msgid "ShowBits refused (%1$s, HTTP %2$d)."
msgstr "ShowBits nekade (%1$s, HTTP %2$d)."

#: showbits/includes/class-connection.php
msgid "You may not connect this site."
msgstr "Du har inte behörighet att ansluta den här webbplatsen."

#. translators: %s: the clip's title
#: showbits/includes/class-importer.php
msgid "%s (thumbnail)"
msgstr "%s (miniatyrbild)"

#. translators: %s: a quote (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%s”"
msgstr "”%s”"

#. translators: 1: a quote, 2: who said it (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%1$s” – %2$s"
msgstr "”%1$s” – %2$s"

#: showbits/includes/class-importer.php
msgid "This is not a clip or a format ShowBits offers."
msgstr "Det här är inte ett klipp eller ett format som ShowBits erbjuder."

#: showbits/includes/class-importer.php
msgid "The clip is no longer released in ShowBits."
msgstr "Klippet är inte längre frigivet i ShowBits."

#: showbits/includes/class-importer.php
msgid "The embargo still holds: the file stays in ShowBits until it ends."
msgstr "Embargot gäller fortfarande: filen stannar i ShowBits tills embargot upphör."

#: showbits/includes/class-importer.php
msgid "The file is not ready yet in ShowBits."
msgstr "Filen är inte klar än i ShowBits."

#: showbits/includes/class-importer.php
msgid "The file could not be downloaded."
msgstr "Filen kunde inte laddas ner."

#: showbits/includes/class-importer.php
msgid "WordPress did not take the file into the media library."
msgstr "WordPress lade inte till filen i mediabiblioteket."

#: showbits/includes/class-importer.php
msgid "The delivery from ShowBits is no longer valid. Import the clip again."
msgstr "Leveransen från ShowBits är inte längre giltig. Importera klippet igen."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer accepts this site’s connection: connect it again under Settings → ShowBits."
msgstr "ShowBits godtar inte längre den här webbplatsens anslutning: anslut webbplatsen igen under Inställningar → ShowBits."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer delivers to this site: the workspace’s plan has ended."
msgstr "ShowBits levererar inte längre till den här webbplatsen: arbetsytans abonnemang har upphört."

#: showbits/includes/class-importer.php
msgid "The site’s imports for today are used up. Try again tomorrow."
msgstr "Webbplatsens importer för i dag är förbrukade. Försök igen i morgon."

#: showbits/includes/class-importer.php
msgid "The import was interrupted."
msgstr "Importen avbröts."

#: showbits/includes/class-importer.php
msgid "The import failed."
msgstr "Importen misslyckades."

#: showbits/includes/class-library-endpoint.php
msgid "This site is not connected to ShowBits."
msgstr "Den här webbplatsen är inte ansluten till ShowBits."

#: showbits/includes/class-library-page.php
msgid "All"
msgstr "Alla"

#: showbits/includes/class-library-page.php
msgid "Clips"
msgstr "Klipp"

#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Quote cards"
msgstr "Citatkort"

#: showbits/includes/class-library-page.php
msgid "Search titles"
msgstr "Sök bland titlar"

#: showbits/includes/class-library-page.php
msgid "Search the library"
msgstr "Sök i biblioteket"

#: showbits/includes/class-library-page.php
msgid "Import selected"
msgstr "Importera valda"

#. translators: 1: which one, 2: how many in all
#: showbits/includes/class-library-page.php
msgid "Asking ShowBits for %1$d of %2$d …"
msgstr "Begär %1$d av %2$d från ShowBits…"

#. translators: %d: how many clips are still on their way
#: showbits/includes/class-library-page.php
msgid "On the way from ShowBits: %d …"
msgstr "På väg från ShowBits: %d…"

#. translators: %d: how many clips were imported
#: showbits/includes/class-library-page.php
msgid "Imported: %d"
msgstr "Importerade: %d"

#: showbits/includes/class-library-page.php
msgid "Not everything has arrived yet; it continues in the background. Settings → ShowBits lists the imports."
msgstr "Allt har inte kommit fram än; det fortsätter i bakgrunden. Inställningar → ShowBits visar importerna."

#: showbits/includes/class-library-page.php
msgid "On the way"
msgstr "På väg"

#: showbits/includes/class-library-page.php
msgid "Load more"
msgstr "Ladda fler"

#: showbits/includes/class-library-page.php
msgid "Loading …"
msgstr "Laddar…"

#: showbits/includes/class-library-page.php
msgid "No released clips or quote cards yet."
msgstr "Inga frigivna klipp eller citatkort än."

#. translators: %s: date and time the embargo ends
#: showbits/includes/class-library-page.php
msgid "Embargo until %s"
msgstr "Embargo till %s"

#: showbits/includes/class-library-page.php
msgid "Not ready yet"
msgstr "Inte klar än"

#: showbits/includes/class-library-page.php
msgid "In the media library"
msgstr "I mediabiblioteket"

#: showbits/includes/class-library-page.php
msgid "An older version is in the media library"
msgstr "En äldre version finns i mediabiblioteket"

#: showbits/includes/class-library-page.php
msgid "Edit"
msgstr "Redigera"

#: showbits/includes/class-library-page.php
msgid "Format"
msgstr "Format"

#: showbits/includes/class-library-page.php
msgid "Video"
msgstr "Video"

#: showbits/includes/class-library-page.php
msgid "Quote card"
msgstr "Citatkort"

#: showbits/includes/class-library-page.php
msgid "Meme"
msgstr "Meme"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "Failed: %s"
msgstr "Misslyckades: %s"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "The library could not be loaded: %s"
msgstr "Biblioteket kunde inte laddas: %s"

#: showbits/includes/class-library-page.php
msgid "This site is not connected to ShowBits yet."
msgstr "Den här webbplatsen är inte ansluten till ShowBits än."

#: showbits/includes/class-library-page.php
msgid "Connect it in the settings."
msgstr "Anslut den i inställningarna."

#: showbits/includes/class-library-page.php
msgid "An administrator of this site connects it in the settings."
msgstr "En administratör för den här webbplatsen behöver ansluta den i inställningarna."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-library-page.php
msgid "Released clips and quote cards from the ShowBits workspace “%s”. What you import lands in the media library, ready for posts and pages."
msgstr "Frigivna klipp och citatkort från ShowBits-arbetsytan ”%s”. Det du importerar hamnar i mediabiblioteket, redo för inlägg och sidor."

#: showbits/includes/class-library-page.php
msgid "The library needs JavaScript."
msgstr "Biblioteket kräver JavaScript."

#: showbits/includes/class-settings-page.php
msgid "Settings"
msgstr "Inställningar"

#: showbits/includes/class-settings-page.php
msgid "You may not change these settings."
msgstr "Du har inte behörighet att ändra de här inställningarna."

#: showbits/includes/class-settings-page.php
msgid "Connection"
msgstr "Anslutning"

#. translators: 1: the constant SHOWBITS_ENCRYPTION_KEY, 2: the file wp-config.php (both stay as they are)
#: showbits/includes/class-settings-page.php
msgid "Your site’s security keys are not in %2$s, so the key that protects the connection to ShowBits is stored in the database. Add %1$s with a long random value to %2$s; if the site is connected already, connect it again afterwards."
msgstr "Webbplatsens säkerhetsnycklar finns inte i %2$s, så nyckeln som skyddar anslutningen till ShowBits lagras i databasen. Lägg till %1$s med ett långt slumpmässigt värde i %2$s; om webbplatsen redan är ansluten ansluter du den igen efteråt."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-settings-page.php
msgid "Connected to the workspace “%s”."
msgstr "Ansluten till arbetsytan ”%s”."

#. translators: 1: imports today, 2: imports a day the plan allows
#: showbits/includes/class-settings-page.php
msgid "Imports today: %1$d of %2$d."
msgstr "Importer i dag: %1$d av %2$d."

#. translators: 1: a person, 2: a date, 3: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "Connected by %1$s on %2$s, at %3$s."
msgstr "Ansluten till %3$s av %1$s den %2$s."

#: showbits/includes/class-settings-page.php
msgid "Connect again"
msgstr "Anslut igen"

#: showbits/includes/class-settings-page.php
msgid "With a new site key the site renews its connection, or moves to another workspace."
msgstr "Med en ny webbplatsnyckel förnyar webbplatsen sin anslutning eller flyttar till en annan arbetsyta."

#. translators: %s: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "ShowBits (%s) cannot be reached right now. The connection stays; try again later."
msgstr "ShowBits (%s) kan inte nås just nu. Anslutningen finns kvar; försök igen senare."

#: showbits/includes/class-settings-page.php
msgid "ShowBits no longer accepts this site’s connection: it was disconnected in ShowBits, the plan ended, or this site’s keys changed. Connect it again with a new site key."
msgstr "ShowBits godtar inte längre den här webbplatsens anslutning: den kopplades bort i ShowBits, abonnemanget har upphört eller webbplatsens nycklar har ändrats. Anslut webbplatsen igen med en ny webbplatsnyckel."

#: showbits/includes/class-settings-page.php
msgid "Connect this site to a ShowBits workspace: an admin or owner of the workspace makes a site key for this site in ShowBits (Integrations → WordPress). The site can then take released clips and quote cards into its media library, and receive what your ShowBits admins send."
msgstr "Anslut den här webbplatsen till en ShowBits-arbetsyta: en administratör eller ägare av arbetsytan skapar en webbplatsnyckel för den här webbplatsen i ShowBits (Integrations → WordPress). Därefter kan webbplatsen hämta frigivna klipp och citatkort till sitt mediabibliotek och ta emot det som dina administratörer i ShowBits skickar."

#: showbits/includes/class-settings-page.php
msgid "Imports"
msgstr "Import"

#: showbits/includes/class-settings-page.php
msgid "Format of quote cards"
msgstr "Format för citatkort"

#: showbits/includes/class-settings-page.php
msgid "4:5 (feeds, articles)"
msgstr "4:5 (flöden, artiklar)"

#: showbits/includes/class-settings-page.php
msgid "1:1 (square)"
msgstr "1:1 (kvadratisk)"

#: showbits/includes/class-settings-page.php
msgid "9:16 (stories)"
msgstr "9:16 (stories)"

#: showbits/includes/class-settings-page.php
msgid "The picture pushes bring; in the library you choose for each card."
msgstr "Formatet för kort som skickas hit; i biblioteket väljer du det för varje kort."

#: showbits/includes/class-settings-page.php
msgid "Videos"
msgstr "Videor"

#: showbits/includes/class-settings-page.php
msgid "Import the thumbnail as the video’s poster image"
msgstr "Importera miniatyrbilden som videons affischbild"

#: showbits/includes/class-settings-page.php
msgid "Save"
msgstr "Spara"

#: showbits/includes/class-settings-page.php
msgid "Site key"
msgstr "Webbplatsnyckel"

#. translators: %s: this site's address
#: showbits/includes/class-settings-page.php
msgid "Made in ShowBits for %s, valid for 24 hours and only once. ShowBits then checks that it is talking to this site."
msgstr "Skapad i ShowBits för %s, giltig i 24 timmar och för en enda användning. ShowBits kontrollerar sedan att det verkligen kommunicerar med den här webbplatsen."

#: showbits/includes/class-settings-page.php
msgid "Connect"
msgstr "Anslut"

#: showbits/includes/class-settings-page.php
msgid "Are you an admin or owner of the workspace yourself? Then sign in to ShowBits and agree there, without a site key:"
msgstr "Är du själv administratör eller ägare av arbetsytan? Logga då in på ShowBits och ge ditt samtycke där, utan webbplatsnyckel:"

#: showbits/includes/class-settings-page.php
msgid "Connect through ShowBits"
msgstr "Anslut via ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits address"
msgstr "ShowBits-adress"

#: showbits/includes/class-settings-page.php
msgid "ShowBits Cloud: https://app.showbits.ai. OnPremise: the address of your installation."
msgstr "ShowBits Cloud: https://app.showbits.ai. OnPremise: adressen till din installation."

#: showbits/includes/class-settings-page.php
msgid "Disconnect"
msgstr "Koppla bort"

#: showbits/includes/class-settings-page.php
msgid "Disconnect this site from ShowBits? What is in the media library stays."
msgstr "Koppla bort den här webbplatsen från ShowBits? Det som finns i mediabiblioteket blir kvar."

#: showbits/includes/class-settings-page.php
msgid "asked for"
msgstr "Begärt"

#: showbits/includes/class-settings-page.php
msgid "waiting"
msgstr "I kö"

#: showbits/includes/class-settings-page.php
msgid "importing"
msgstr "Importeras"

#: showbits/includes/class-settings-page.php
msgid "imported"
msgstr "Importerat"

#: showbits/includes/class-settings-page.php
msgid "failed"
msgstr "Misslyckades"

#: showbits/includes/class-settings-page.php
msgid "Recent imports"
msgstr "Senaste importer"

#: showbits/includes/class-settings-page.php
msgid "When"
msgstr "När"

#: showbits/includes/class-settings-page.php
msgid "Clip"
msgstr "Klipp"

#: showbits/includes/class-settings-page.php
msgid "How"
msgstr "Källa"

#: showbits/includes/class-settings-page.php
msgid "State"
msgstr "Status"

#: showbits/includes/class-settings-page.php
msgid "sent from ShowBits"
msgstr "Skickat från ShowBits"

#: showbits/includes/class-settings-page.php
msgid "picked here"
msgstr "Valt här"

#: showbits/includes/class-settings-page.php
msgid "Connected. The library is under Media → ShowBits."
msgstr "Ansluten. Biblioteket finns under Media → ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Disconnected. What is in the media library stays."
msgstr "Bortkopplad. Det som finns i mediabiblioteket blir kvar."

#: showbits/includes/class-settings-page.php
msgid "Saved."
msgstr "Sparat."

#: showbits/includes/class-settings-page.php
msgid "Connecting was cancelled in ShowBits."
msgstr "Anslutningen avbröts i ShowBits."

#: showbits/includes/class-settings-page.php
msgid "That way back from ShowBits did not belong to this attempt. Start again."
msgstr "Omdirigeringen tillbaka från ShowBits hör inte till webbplatsens anslutningsförsök. Börja om."

#: showbits/includes/class-settings-page.php
msgid "The ShowBits address must start with https://."
msgstr "ShowBits-adressen måste börja med https://."

#: showbits/includes/class-settings-page.php
msgid "That is not a site key. Copy it from ShowBits (Integrations → WordPress) again."
msgstr "Det är ingen webbplatsnyckel. Kopiera den igen från ShowBits (Integrations → WordPress)."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not take the site key: it is unknown, used, withdrawn or expired (a site key lasts 24 hours, a consent ten minutes). Make a new one."
msgstr "ShowBits godtog inte webbplatsnyckeln: den är okänd, redan använd, återkallad eller har gått ut (en webbplatsnyckel gäller i 24 timmar, ett samtycke i tio minuter). Skapa en ny."

#: showbits/includes/class-settings-page.php
msgid "The site key was made for another address. Make one for this site’s address."
msgstr "Webbplatsnyckeln skapades för en annan adress. Skapa en för den här webbplatsens adress."

#: showbits/includes/class-settings-page.php
msgid "ShowBits could not reach this site at its REST API (/wp-json/showbits/v1/push), or ShowBits itself could not be reached. The site must be public over HTTPS; a firewall or security plugin must let ShowBits in."
msgstr "ShowBits kunde inte nå den här webbplatsen via dess REST-API (/wp-json/showbits/v1/push), eller så gick ShowBits inte att nå. Webbplatsen måste vara offentligt tillgänglig via HTTPS; en brandvägg eller ett säkerhetstillägg måste släppa in ShowBits."

#: showbits/includes/class-settings-page.php
msgid "This site did not answer ShowBits’ check as expected. Try again; if it fails again, a cache or security plugin may answer for WordPress."
msgstr "Den här webbplatsen besvarade inte kontrollen från ShowBits som förväntat. Försök igen; om det misslyckas igen, svarar kanske ett cache- eller säkerhetstillägg i stället för WordPress."

#: showbits/includes/class-settings-page.php
msgid "The workspace’s plan has ended, or whoever made the site key may no longer connect sites."
msgstr "Arbetsytans abonnemang har upphört, eller så får den som skapade webbplatsnyckeln inte längre ansluta webbplatser."

#: showbits/includes/class-settings-page.php
msgid "The workspace has as many sites as its plan allows."
msgstr "Arbetsytan har redan så många webbplatser som abonnemanget tillåter."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not accept this site’s address. It must be served over HTTPS."
msgstr "ShowBits godtog inte den här webbplatsens adress. Webbplatsen måste levereras via HTTPS."

#: showbits/includes/class-settings-page.php
msgid "Connecting did not work. Try again, or ask your ShowBits contact."
msgstr "Anslutningen misslyckades. Försök igen eller fråga din kontaktperson på ShowBits."
