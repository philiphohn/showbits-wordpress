# Faroese translation of the ShowBits plugin.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: fo\n"
"Plural-Forms: nplurals=2; plural=n != 1;\n"

#. Description of the plugin
#: showbits/showbits.php
msgid "Released clips and quote cards from ShowBits in the media library: pick them in WordPress, or receive what your ShowBits admins send."
msgstr "Frígivin klipp og sitatkort úr ShowBits í miðlasavninum: vel tey í WordPress, ella tak ímóti tí, sum tínir umsitarar í ShowBits senda."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer as expected."
msgstr "ShowBits svaraði ikki sum væntað."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer with a file."
msgstr "ShowBits sendi onga fílu."

#: showbits/includes/class-api-client.php showbits/includes/class-importer.php
msgid "ShowBits could not be reached."
msgstr "Ikki bar til at fáa samband við ShowBits."

#. translators: 1: ShowBits' reason, 2: the HTTP status
#: showbits/includes/class-api-client.php
msgid "ShowBits refused (%1$s, HTTP %2$d)."
msgstr "ShowBits noktaði (%1$s, HTTP %2$d)."

#: showbits/includes/class-connection.php
msgid "You may not connect this site."
msgstr "Tú hevur ikki loyvi til at knýta samband fyri hesa heimasíðuna."

#. translators: %s: the clip's title
#: showbits/includes/class-importer.php
msgid "%s (thumbnail)"
msgstr "%s (smámynd)"

#. translators: %s: a quote (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%s”"
msgstr "„%s“"

#. translators: 1: a quote, 2: who said it (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%1$s” – %2$s"
msgstr "„%1$s“ – %2$s"

#: showbits/includes/class-importer.php
msgid "This is not a clip or a format ShowBits offers."
msgstr "Hetta er ikki eitt klipp ella eitt snið, sum ShowBits bjóðar."

#: showbits/includes/class-importer.php
msgid "The clip is no longer released in ShowBits."
msgstr "Klippið er ikki longur frígivið í ShowBits."

#: showbits/includes/class-importer.php
msgid "The embargo still holds: the file stays in ShowBits until it ends."
msgstr "Embargo er enn galdandi: fílan verður verandi í ShowBits, so leingi tað varir."

#: showbits/includes/class-importer.php
msgid "The file is not ready yet in ShowBits."
msgstr "Fílan er enn ikki klár í ShowBits."

#: showbits/includes/class-importer.php
msgid "The file could not be downloaded."
msgstr "Ikki bar til at taka fíluna niður."

#: showbits/includes/class-importer.php
msgid "WordPress did not take the file into the media library."
msgstr "WordPress tók ikki fíluna inn í miðlasavnið."

#: showbits/includes/class-importer.php
msgid "The delivery from ShowBits is no longer valid. Import the clip again."
msgstr "Sendingin frá ShowBits er ikki longur galdandi. Innflyt klippið av nýggjum."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer accepts this site’s connection: connect it again under Settings → ShowBits."
msgstr "ShowBits tekur ikki longur við sambandinum hjá hesi heimasíðuni: knýt samband av nýggjum undir Stillingar → ShowBits."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer delivers to this site: the workspace’s plan has ended."
msgstr "ShowBits sendir ikki longur nakað higar: haldið hjá arbeiðsøkinum er útgingið."

#: showbits/includes/class-importer.php
msgid "The site’s imports for today are used up. Try again tomorrow."
msgstr "Innflutningarnir hjá heimasíðuni fyri í dag eru uppbrúktir. Royn aftur í morgin."

#: showbits/includes/class-importer.php
msgid "The import was interrupted."
msgstr "Innflutningurin varð avbrotin."

#: showbits/includes/class-importer.php
msgid "The import failed."
msgstr "Innflutningurin miseydnaðist."

#: showbits/includes/class-library-endpoint.php
msgid "This site is not connected to ShowBits."
msgstr "Henda heimasíðan hevur ikki samband við ShowBits."

#: showbits/includes/class-library-page.php
msgid "All"
msgstr "Øll"

#: showbits/includes/class-library-page.php
msgid "Clips"
msgstr "Klipp"

#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Quote cards"
msgstr "Sitatkort"

#: showbits/includes/class-library-page.php
msgid "Search titles"
msgstr "Leita í heitum"

#: showbits/includes/class-library-page.php
msgid "Search the library"
msgstr "Leita í savninum"

#: showbits/includes/class-library-page.php
msgid "Import selected"
msgstr "Innflyt tey valdu"

#. translators: 1: which one, 2: how many in all
#: showbits/includes/class-library-page.php
msgid "Asking ShowBits for %1$d of %2$d …"
msgstr "Biður ShowBits um %1$d av %2$d…"

#. translators: %d: how many clips are still on their way
#: showbits/includes/class-library-page.php
msgid "On the way from ShowBits: %d …"
msgstr "Á veg frá ShowBits: %d…"

#. translators: %d: how many clips were imported
#: showbits/includes/class-library-page.php
msgid "Imported: %d"
msgstr "Innflutt: %d"

#: showbits/includes/class-library-page.php
msgid "Not everything has arrived yet; it continues in the background. Settings → ShowBits lists the imports."
msgstr "Enn er ikki alt komið; tað heldur fram í bakgrundini. Stillingar → ShowBits vísir innflutningarnar."

#: showbits/includes/class-library-page.php
msgid "On the way"
msgstr "Á veg"

#: showbits/includes/class-library-page.php
msgid "Load more"
msgstr "Heinta fleiri"

#: showbits/includes/class-library-page.php
msgid "Loading …"
msgstr "Heintar…"

#: showbits/includes/class-library-page.php
msgid "No released clips or quote cards yet."
msgstr "Enn eingi frígivin klipp ella sitatkort."

#. translators: %s: date and time the embargo ends
#: showbits/includes/class-library-page.php
msgid "Embargo until %s"
msgstr "Embargo til %s"

#: showbits/includes/class-library-page.php
msgid "Not ready yet"
msgstr "Ikki klárt enn"

#: showbits/includes/class-library-page.php
msgid "In the media library"
msgstr "Í miðlasavninum"

#: showbits/includes/class-library-page.php
msgid "An older version is in the media library"
msgstr "Ein eldri útgáva er í miðlasavninum"

#: showbits/includes/class-library-page.php
msgid "Edit"
msgstr "Rætta"

#: showbits/includes/class-library-page.php
msgid "Format"
msgstr "Snið"

#: showbits/includes/class-library-page.php
msgid "Video"
msgstr "Video"

#: showbits/includes/class-library-page.php
msgid "Quote card"
msgstr "Sitatkort"

#: showbits/includes/class-library-page.php
msgid "Meme"
msgstr "Meme"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "Failed: %s"
msgstr "Miseydnaðist: %s"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "The library could not be loaded: %s"
msgstr "Ikki bar til at heinta savnið: %s"

#: showbits/includes/class-library-page.php
msgid "This site is not connected to ShowBits yet."
msgstr "Henda heimasíðan hevur enn ikki samband við ShowBits."

#: showbits/includes/class-library-page.php
msgid "Connect it in the settings."
msgstr "Knýt samband í stillingunum."

#: showbits/includes/class-library-page.php
msgid "An administrator of this site connects it in the settings."
msgstr "Ein umsitari fyri hesa heimasíðuna má knýta samband í stillingunum."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-library-page.php
msgid "Released clips and quote cards from the ShowBits workspace “%s”. What you import lands in the media library, ready for posts and pages."
msgstr "Frígivin klipp og sitatkort úr ShowBits-arbeiðsøkinum „%s“. Tað, sum tú innflytur, endar í miðlasavninum, klárt at brúka í greinum og síðum."

#: showbits/includes/class-library-page.php
msgid "The library needs JavaScript."
msgstr "Savnið krevur JavaScript."

#: showbits/includes/class-settings-page.php
msgid "Settings"
msgstr "Stillingar"

#: showbits/includes/class-settings-page.php
msgid "You may not change these settings."
msgstr "Tú hevur ikki loyvi til at broyta hesar stillingar."

#: showbits/includes/class-settings-page.php
msgid "Connection"
msgstr "Samband"

#. translators: 1: the constant SHOWBITS_ENCRYPTION_KEY, 2: the file wp-config.php (both stay as they are)
#: showbits/includes/class-settings-page.php
msgid "Your site’s security keys are not in %2$s, so the key that protects the connection to ShowBits is stored in the database. Add %1$s with a long random value to %2$s; if the site is connected already, connect it again afterwards."
msgstr "Trygdarlyklarnir hjá heimasíðu tíni eru ikki í %2$s, so lykilin, ið verjir sambandið við ShowBits, verður goymdur í dátugrunninum. Legg %1$s við einum longum tilvildarligum virði afturat %2$s; um heimasíðan longu er knýtt í samband, so knýt samband aftur eftir hetta."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-settings-page.php
msgid "Connected to the workspace “%s”."
msgstr "Samband er knýtt við arbeiðsøkið „%s“."

#. translators: 1: imports today, 2: imports a day the plan allows
#: showbits/includes/class-settings-page.php
msgid "Imports today: %1$d of %2$d."
msgstr "Innflutningar í dag: %1$d av %2$d."

#. translators: 1: a person, 2: a date, 3: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "Connected by %1$s on %2$s, at %3$s."
msgstr "Samband knýtt við %3$s av %1$s tann %2$s."

#: showbits/includes/class-settings-page.php
msgid "Connect again"
msgstr "Knýt samband av nýggjum"

#: showbits/includes/class-settings-page.php
msgid "With a new site key the site renews its connection, or moves to another workspace."
msgstr "Við einum nýggjum heimasíðulykli endurnýggjar heimasíðan sambandið ella flytur yvir í eitt annað arbeiðsøki."

#. translators: %s: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "ShowBits (%s) cannot be reached right now. The connection stays; try again later."
msgstr "Ikki ber til at fáa samband við ShowBits (%s) beint nú. Sambandið verður verandi; royn aftur seinni."

#: showbits/includes/class-settings-page.php
msgid "ShowBits no longer accepts this site’s connection: it was disconnected in ShowBits, the plan ended, or this site’s keys changed. Connect it again with a new site key."
msgstr "ShowBits tekur ikki longur við sambandinum hjá hesi heimasíðuni: sambandið varð slitið í ShowBits, haldið er útgingið, ella lyklarnir hjá hesi heimasíðuni eru broyttir. Knýt samband aftur við einum nýggjum heimasíðulykli."

#: showbits/includes/class-settings-page.php
msgid "Connect this site to a ShowBits workspace: an admin or owner of the workspace makes a site key for this site in ShowBits (Integrations → WordPress). The site can then take released clips and quote cards into its media library, and receive what your ShowBits admins send."
msgstr "Knýt samband millum hesa heimasíðuna og eitt ShowBits-arbeiðsøki: ein umsitari ella eigari av arbeiðsøkinum ger ein heimasíðulykil fyri hesa heimasíðuna í ShowBits (Integrations → WordPress). Síðan kann heimasíðan taka frígivin klipp og sitatkort inn í miðlasavnið og taka ímóti tí, sum tínir umsitarar í ShowBits senda."

#: showbits/includes/class-settings-page.php
msgid "Imports"
msgstr "Innflutningur"

#: showbits/includes/class-settings-page.php
msgid "Format of quote cards"
msgstr "Snið á sitatkortum"

#: showbits/includes/class-settings-page.php
msgid "4:5 (feeds, articles)"
msgstr "4:5 (feeds, greinir)"

#: showbits/includes/class-settings-page.php
msgid "1:1 (square)"
msgstr "1:1 (ferkantað)"

#: showbits/includes/class-settings-page.php
msgid "9:16 (stories)"
msgstr "9:16 (stories)"

#: showbits/includes/class-settings-page.php
msgid "The picture pushes bring; in the library you choose for each card."
msgstr "Sniðið á kortum, sum verða send higar; í savninum velur tú fyri hvørt kort."

#: showbits/includes/class-settings-page.php
msgid "Videos"
msgstr "Videoklipp"

#: showbits/includes/class-settings-page.php
msgid "Import the thumbnail as the video’s poster image"
msgstr "Innflyt smámyndina sum plakatmynd hjá videoklippinum"

#: showbits/includes/class-settings-page.php
msgid "Save"
msgstr "Goym"

#: showbits/includes/class-settings-page.php
msgid "Site key"
msgstr "Heimasíðulykil"

#. translators: %s: this site's address
#: showbits/includes/class-settings-page.php
msgid "Made in ShowBits for %s, valid for 24 hours and only once. ShowBits then checks that it is talking to this site."
msgstr "Gjørdur í ShowBits fyri %s, galdandi í 24 tímar og bert eina ferð. ShowBits kannar síðan, at tað tosar við júst hesa heimasíðuna."

#: showbits/includes/class-settings-page.php
msgid "Connect"
msgstr "Knýt samband"

#: showbits/includes/class-settings-page.php
msgid "Are you an admin or owner of the workspace yourself? Then sign in to ShowBits and agree there, without a site key:"
msgstr "Ert tú umsitari ella eigari av arbeiðsøkinum? Tá kanst tú rita inn á ShowBits og geva samtykki har, uttan heimasíðulykil:"

#: showbits/includes/class-settings-page.php
msgid "Connect through ShowBits"
msgstr "Knýt samband gjøgnum ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits address"
msgstr "ShowBits-adressa"

#: showbits/includes/class-settings-page.php
msgid "ShowBits Cloud: https://app.showbits.ai. OnPremise: the address of your installation."
msgstr "ShowBits Cloud: https://app.showbits.ai. OnPremise: adressan á tínari innlegging."

#: showbits/includes/class-settings-page.php
msgid "Disconnect"
msgstr "Slít sambandið"

#: showbits/includes/class-settings-page.php
msgid "Disconnect this site from ShowBits? What is in the media library stays."
msgstr "Slíta sambandið millum hesa heimasíðuna og ShowBits? Tað, sum er í miðlasavninum, verður verandi."

#: showbits/includes/class-settings-page.php
msgid "asked for"
msgstr "Umbiðið"

#: showbits/includes/class-settings-page.php
msgid "waiting"
msgstr "Bíðar"

#: showbits/includes/class-settings-page.php
msgid "importing"
msgstr "Verður innflutt"

#: showbits/includes/class-settings-page.php
msgid "imported"
msgstr "Innflutt"

#: showbits/includes/class-settings-page.php
msgid "failed"
msgstr "Miseydnaðist"

#: showbits/includes/class-settings-page.php
msgid "Recent imports"
msgstr "Seinastu innflutningar"

#: showbits/includes/class-settings-page.php
msgid "When"
msgstr "Nær"

#: showbits/includes/class-settings-page.php
msgid "Clip"
msgstr "Klipp"

#: showbits/includes/class-settings-page.php
msgid "How"
msgstr "Kelda"

#: showbits/includes/class-settings-page.php
msgid "State"
msgstr "Støða"

#: showbits/includes/class-settings-page.php
msgid "sent from ShowBits"
msgstr "Sent úr ShowBits"

#: showbits/includes/class-settings-page.php
msgid "picked here"
msgstr "Valt her"

#: showbits/includes/class-settings-page.php
msgid "Connected. The library is under Media → ShowBits."
msgstr "Samband knýtt. Savnið er undir Miðlar → ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Disconnected. What is in the media library stays."
msgstr "Sambandið er slitið. Tað, sum er í miðlasavninum, verður verandi."

#: showbits/includes/class-settings-page.php
msgid "Saved."
msgstr "Goymt."

#: showbits/includes/class-settings-page.php
msgid "Connecting was cancelled in ShowBits."
msgstr "Sambandið varð ikki knýtt: tað varð avlýst í ShowBits."

#: showbits/includes/class-settings-page.php
msgid "That way back from ShowBits did not belong to this attempt. Start again."
msgstr "Vegurin aftur frá ShowBits var ikki partur av royndini, sum henda heimasíðan byrjaði. Byrja av nýggjum."

#: showbits/includes/class-settings-page.php
msgid "The ShowBits address must start with https://."
msgstr "ShowBits-adressan má byrja við https://."

#: showbits/includes/class-settings-page.php
msgid "That is not a site key. Copy it from ShowBits (Integrations → WordPress) again."
msgstr "Hetta er ikki ein heimasíðulykil. Kopiera hann aftur úr ShowBits (Integrations → WordPress)."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not take the site key: it is unknown, used, withdrawn or expired (a site key lasts 24 hours, a consent ten minutes). Make a new one."
msgstr "ShowBits tók ikki við heimasíðulyklinum: hann er ókendur, brúktur, tikin aftur ella útgingin (ein heimasíðulykil er galdandi í 24 tímar, eitt samtykki í tíggju minuttir). Ger ein nýggjan."

#: showbits/includes/class-settings-page.php
msgid "The site key was made for another address. Make one for this site’s address."
msgstr "Heimasíðulykilin varð gjørdur fyri eina aðra adressu. Ger ein fyri adressuna hjá hesi heimasíðuni."

#: showbits/includes/class-settings-page.php
msgid "ShowBits could not reach this site at its REST API (/wp-json/showbits/v1/push), or ShowBits itself could not be reached. The site must be public over HTTPS; a firewall or security plugin must let ShowBits in."
msgstr "ShowBits fekk ikki samband við hesa heimasíðuna gjøgnum REST API (/wp-json/showbits/v1/push), ella bar ikki til at fáa samband við ShowBits. Heimasíðan má vera almant tøk yvir HTTPS; ein eldveggur ella eitt trygdarplugin má sleppa ShowBits inn."

#: showbits/includes/class-settings-page.php
msgid "This site did not answer ShowBits’ check as expected. Try again; if it fails again, a cache or security plugin may answer for WordPress."
msgstr "Henda heimasíðan svaraði ikki kanningini frá ShowBits sum væntað. Royn aftur; miseydnast tað aftur, svarar møguliga eitt cache- ella trygdarplugin í staðin fyri WordPress."

#: showbits/includes/class-settings-page.php
msgid "The workspace’s plan has ended, or whoever made the site key may no longer connect sites."
msgstr "Haldið hjá arbeiðsøkinum er útgingið, ella hevur tann, sum gjørdi heimasíðulykilin, ikki longur loyvi til at knýta samband fyri heimasíður."

#: showbits/includes/class-settings-page.php
msgid "The workspace has as many sites as its plan allows."
msgstr "Arbeiðsøkið hevur longu so nógvar heimasíður, sum haldið loyvir."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not accept this site’s address. It must be served over HTTPS."
msgstr "ShowBits góðtók ikki adressuna hjá hesi heimasíðuni. Heimasíðan má vera tøk yvir HTTPS."

#: showbits/includes/class-settings-page.php
msgid "Connecting did not work. Try again, or ask your ShowBits contact."
msgstr "Ikki bar til at knýta samband. Royn aftur, ella spyr tín kontaktpersón hjá ShowBits."
