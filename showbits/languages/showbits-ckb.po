#. Description of the plugin
#: showbits/showbits.php
msgid "Released clips and quote cards from ShowBits in the media library: pick them in WordPress, or receive what your ShowBits admins send."
msgstr "کلیپ و کارتی وتەی پەسەندکراوی ShowBits لە کتێبخانەی میدیادا: لە WordPress هەڵیانبژێرە، یان ئەوەی بەڕێوەبەرانت لە ShowBits دەینێرن وەریبگرە."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer as expected."
msgstr "ShowBits وەک پێشبینی دەکرا وەڵامی نەدایەوە."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer with a file."
msgstr "ShowBits هیچ پەڕگەیەکی لە وەڵامدا نەنارد."

#: showbits/includes/class-api-client.php showbits/includes/class-importer.php
msgid "ShowBits could not be reached."
msgstr "دەستگەیشتن بە ShowBits سەرکەوتوو نەبوو."

#. translators: 1: ShowBits' reason, 2: the HTTP status
#: showbits/includes/class-api-client.php
msgid "ShowBits refused (%1$s, HTTP %2$d)."
msgstr "ShowBits ڕەتی کردەوە (%1$s، HTTP %2$d)."

#: showbits/includes/class-connection.php
msgid "You may not connect this site."
msgstr "تۆ مۆڵەتی پەیوەستکردنی ئەم ماڵپەڕەت نییە."

#. translators: %s: the clip's title
#: showbits/includes/class-importer.php
msgid "%s (thumbnail)"
msgstr "%s (وێنۆچکە)"

#. translators: %s: a quote (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%s”"
msgstr "«%s»"

#. translators: 1: a quote, 2: who said it (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%1$s” – %2$s"
msgstr "«%1$s» – %2$s"

#: showbits/includes/class-importer.php
msgid "This is not a clip or a format ShowBits offers."
msgstr "ئەمە کلیپ نییە، یان فۆرماتێک نییە کە ShowBits پێشکەشی بکات."

#: showbits/includes/class-importer.php
msgid "The clip is no longer released in ShowBits."
msgstr "ئەم کلیپە چیتر لە ShowBits پەسەندکراو نییە."

#: showbits/includes/class-importer.php
msgid "The embargo still holds: the file stays in ShowBits until it ends."
msgstr "قەدەغەی بڵاوکردنەوە هێشتا بەردەوامە: پەڕگەکە تا کۆتایی قەدەغەکە لە ShowBits دەمێنێتەوە."

#: showbits/includes/class-importer.php
msgid "The file is not ready yet in ShowBits."
msgstr "پەڕگەکە هێشتا لە ShowBits ئامادە نییە."

#: showbits/includes/class-importer.php
msgid "The file could not be downloaded."
msgstr "نەتوانرا پەڕگەکە دابەزێنرێت."

#: showbits/includes/class-importer.php
msgid "WordPress did not take the file into the media library."
msgstr "WordPress پەڕگەکەی وەرنەگرت بۆ ناو کتێبخانەی میدیا."

#: showbits/includes/class-importer.php
msgid "The delivery from ShowBits is no longer valid. Import the clip again."
msgstr "گەیاندنەکە لە ShowBits چیتر دروست نییە. دووبارە کلیپەکە هاوردە بکەرەوە."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer accepts this site’s connection: connect it again under Settings → ShowBits."
msgstr "ShowBits چیتر پەیوەندیی ئەم ماڵپەڕە قبووڵ ناکات: لە ڕێکخستنەکان ← ShowBits دووبارە پەیوەستی بکەرەوە."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer delivers to this site: the workspace’s plan has ended."
msgstr "ShowBits چیتر هیچ شتێک ناگەیەنێتە ئەم ماڵپەڕە: پلانی شوێنی کارەکە کۆتایی هاتووە."

#: showbits/includes/class-importer.php
msgid "The site’s imports for today are used up. Try again tomorrow."
msgstr "هاوردەکردنەکانی ئەمڕۆی ئەم ماڵپەڕە تەواو بوون. سبەی دووبارە هەوڵ بدەرەوە."

#: showbits/includes/class-importer.php
msgid "The import was interrupted."
msgstr "هاوردەکردنەکە لە نیوەڕێدا ڕاوەستا."

#: showbits/includes/class-importer.php
msgid "The import failed."
msgstr "هاوردەکردنەکە سەرکەوتوو نەبوو."

#: showbits/includes/class-library-endpoint.php
msgid "This site is not connected to ShowBits."
msgstr "ئەم ماڵپەڕە بە ShowBits پەیوەست نییە."

#: showbits/includes/class-library-page.php
msgid "All"
msgstr "هەموو"

#: showbits/includes/class-library-page.php
msgid "Clips"
msgstr "کلیپەکان"

#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Quote cards"
msgstr "کارتەکانی وتە"

#: showbits/includes/class-library-page.php
msgid "Search titles"
msgstr "گەڕان لە ناونیشانەکاندا"

#: showbits/includes/class-library-page.php
msgid "Search the library"
msgstr "گەڕان لە کتێبخانەدا"

#: showbits/includes/class-library-page.php
msgid "Import selected"
msgstr "هاوردەکردنی دیاریکراوەکان"

#. translators: 1: which one, 2: how many in all
#: showbits/includes/class-library-page.php
msgid "Asking ShowBits for %1$d of %2$d …"
msgstr "داواکردن لە ShowBits: %1$d لە %2$d…"

#. translators: %d: how many clips are still on their way
#: showbits/includes/class-library-page.php
msgid "On the way from ShowBits: %d …"
msgstr "هێشتا لە ShowBits دێن: %d…"

#. translators: %d: how many clips were imported
#: showbits/includes/class-library-page.php
msgid "Imported: %d"
msgstr "هاوردەکرا: %d"

#: showbits/includes/class-library-page.php
msgid "Not everything has arrived yet; it continues in the background. Settings → ShowBits lists the imports."
msgstr "هێشتا هەموو شت نەگەیشتووە؛ لە پاشبنەمادا بەردەوام دەبێت. ڕێکخستنەکان ← ShowBits لیستی هاوردەکردنەکان پیشان دەدات."

#: showbits/includes/class-library-page.php
msgid "On the way"
msgstr "لە ڕێگادایە"

#: showbits/includes/class-library-page.php
msgid "Load more"
msgstr "بارکردنی زیاتر"

#: showbits/includes/class-library-page.php
msgid "Loading …"
msgstr "بار دەکرێت…"

#: showbits/includes/class-library-page.php
msgid "No released clips or quote cards yet."
msgstr "هێشتا هیچ کلیپ یان کارتی وتەی پەسەندکراو نییە."

#. translators: %s: date and time the embargo ends
#: showbits/includes/class-library-page.php
msgid "Embargo until %s"
msgstr "قەدەغەی بڵاوکردنەوە تا %s"

#: showbits/includes/class-library-page.php
msgid "Not ready yet"
msgstr "هێشتا ئامادە نییە"

#: showbits/includes/class-library-page.php
msgid "In the media library"
msgstr "لە کتێبخانەی میدیادایە"

#: showbits/includes/class-library-page.php
msgid "An older version is in the media library"
msgstr "وەشانێکی کۆنتر لە کتێبخانەی میدیادایە"

#: showbits/includes/class-library-page.php
msgid "Edit"
msgstr "دەستکاری"

#: showbits/includes/class-library-page.php
msgid "Format"
msgstr "فۆرمات"

#: showbits/includes/class-library-page.php
msgid "Video"
msgstr "ڤیدیۆ"

#: showbits/includes/class-library-page.php
msgid "Quote card"
msgstr "کارتی وتە"

#: showbits/includes/class-library-page.php
msgid "Meme"
msgstr "میم"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "Failed: %s"
msgstr "سەرکەوتوو نەبوو: %s"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "The library could not be loaded: %s"
msgstr "نەتوانرا کتێبخانەکە بار بکرێت: %s"

#: showbits/includes/class-library-page.php
msgid "This site is not connected to ShowBits yet."
msgstr "ئەم ماڵپەڕە هێشتا بە ShowBits پەیوەست نییە."

#: showbits/includes/class-library-page.php
msgid "Connect it in the settings."
msgstr "لە ڕێکخستنەکاندا پەیوەستی بکە."

#: showbits/includes/class-library-page.php
msgid "An administrator of this site connects it in the settings."
msgstr "بەڕێوەبەرێکی ئەم ماڵپەڕە لە ڕێکخستنەکاندا پەیوەستی دەکات."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-library-page.php
msgid "Released clips and quote cards from the ShowBits workspace “%s”. What you import lands in the media library, ready for posts and pages."
msgstr "کلیپ و کارتی وتەی پەسەندکراو لە شوێنی کاری ShowBits «%s». ئەوەی هاوردەی دەکەیت دەچێتە کتێبخانەی میدیا و ئامادەیە بۆ بابەت و پەڕەکان."

#: showbits/includes/class-library-page.php
msgid "The library needs JavaScript."
msgstr "کتێبخانەکە پێویستی بە JavaScript هەیە."

#: showbits/includes/class-settings-page.php
msgid "Settings"
msgstr "ڕێکخستنەکان"

#: showbits/includes/class-settings-page.php
msgid "You may not change these settings."
msgstr "تۆ مۆڵەتی گۆڕینی ئەم ڕێکخستنانەت نییە."

#: showbits/includes/class-settings-page.php
msgid "Connection"
msgstr "پەیوەندی"

#. translators: 1: the constant SHOWBITS_ENCRYPTION_KEY, 2: the file wp-config.php (both stay as they are)
#: showbits/includes/class-settings-page.php
msgid "Your site’s security keys are not in %2$s, so the key that protects the connection to ShowBits is stored in the database. Add %1$s with a long random value to %2$s; if the site is connected already, connect it again afterwards."
msgstr "کلیلە ئاسایشییەکانی ماڵپەڕەکەت لە %2$s دا نین، بۆیە ئەو کلیلەی پەیوەندی لەگەڵ ShowBits دەپارێزێت لە بنکەدراوەدا هەڵدەگیرێت. %1$s بە بەهایەکی هەڕەمەکیی درێژ بۆ %2$s زیاد بکە؛ ئەگەر ماڵپەڕەکە پێشتر پەیوەست کرابێت، دواتر دووبارە پەیوەستی بکەرەوە."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-settings-page.php
msgid "Connected to the workspace “%s”."
msgstr "پەیوەستە بە شوێنی کاری «%s»."

#. translators: 1: imports today, 2: imports a day the plan allows
#: showbits/includes/class-settings-page.php
msgid "Imports today: %1$d of %2$d."
msgstr "هاوردەکردنەکانی ئەمڕۆ: %1$d لە %2$d."

#. translators: 1: a person, 2: a date, 3: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "Connected by %1$s on %2$s, at %3$s."
msgstr "لەلایەن %1$s لە %2$s پەیوەستکرا بە %3$s."

#: showbits/includes/class-settings-page.php
msgid "Connect again"
msgstr "دووبارە پەیوەستکردنەوە"

#: showbits/includes/class-settings-page.php
msgid "With a new site key the site renews its connection, or moves to another workspace."
msgstr "بە کلیلێکی نوێی ماڵپەڕ، ماڵپەڕەکە پەیوەندییەکەی نوێ دەکاتەوە یان دەچێتە شوێنێکی کاری تر."

#. translators: %s: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "ShowBits (%s) cannot be reached right now. The connection stays; try again later."
msgstr "ئێستا دەستگەیشتن بە ShowBits (%s) ناکرێت. پەیوەندییەکە دەمێنێتەوە؛ دواتر دووبارە هەوڵ بدەرەوە."

#: showbits/includes/class-settings-page.php
msgid "ShowBits no longer accepts this site’s connection: it was disconnected in ShowBits, the plan ended, or this site’s keys changed. Connect it again with a new site key."
msgstr "ShowBits چیتر پەیوەندیی ئەم ماڵپەڕە قبووڵ ناکات: پەیوەندییەکە لە ShowBits پچڕێنرا، پلانەکە کۆتایی هات، یان کلیلەکانی ئەم ماڵپەڕە گۆڕدران. بە کلیلێکی نوێی ماڵپەڕ دووبارە پەیوەستی بکەرەوە."

#: showbits/includes/class-settings-page.php
msgid "Connect this site to a ShowBits workspace: an admin or owner of the workspace makes a site key for this site in ShowBits (Integrations → WordPress). The site can then take released clips and quote cards into its media library, and receive what your ShowBits admins send."
msgstr "ئەم ماڵپەڕە بە شوێنێکی کاری ShowBits پەیوەست بکە: بەڕێوەبەر یان خاوەنێکی شوێنی کارەکە لە ShowBits (Integrations → WordPress) کلیلێکی ماڵپەڕ بۆ ئەم ماڵپەڕە دروست دەکات. دواتر ماڵپەڕەکە دەتوانێت کلیپ و کارتی وتەی پەسەندکراو بهێنێتە کتێبخانەی میدیاکەی، و ئەوەی بەڕێوەبەرانت لە ShowBits دەینێرن وەربگرێت."

#: showbits/includes/class-settings-page.php
msgid "Imports"
msgstr "هاوردەکردنەکان"

#: showbits/includes/class-settings-page.php
msgid "Format of quote cards"
msgstr "فۆرماتی کارتەکانی وتە"

#: showbits/includes/class-settings-page.php
msgid "4:5 (feeds, articles)"
msgstr "4:5 (فیدەکان، وتارەکان)"

#: showbits/includes/class-settings-page.php
msgid "1:1 (square)"
msgstr "1:1 (چوارگۆشە)"

#: showbits/includes/class-settings-page.php
msgid "9:16 (stories)"
msgstr "9:16 (ستۆرییەکان)"

#: showbits/includes/class-settings-page.php
msgid "The picture pushes bring; in the library you choose for each card."
msgstr "ئەو فۆرماتەی وێنە کە ناردراوەکان لەگەڵ خۆیان دەیهێنن؛ لە کتێبخانەدا بۆ هەر کارتێک خۆت فۆرمات هەڵدەبژێریت."

#: showbits/includes/class-settings-page.php
msgid "Videos"
msgstr "ڤیدیۆکان"

#: showbits/includes/class-settings-page.php
msgid "Import the thumbnail as the video’s poster image"
msgstr "وێنۆچکە وەک وێنەی پۆستەری ڤیدیۆکە هاوردە بکە"

#: showbits/includes/class-settings-page.php
msgid "Save"
msgstr "پاشەکەوتکردن"

#: showbits/includes/class-settings-page.php
msgid "Site key"
msgstr "کلیلی ماڵپەڕ"

#. translators: %s: this site's address
#: showbits/includes/class-settings-page.php
msgid "Made in ShowBits for %s, valid for 24 hours and only once. ShowBits then checks that it is talking to this site."
msgstr "لە ShowBits بۆ %s دروست دەکرێت، بۆ 24 کاتژمێر و تەنها یەک جار دروستە. پاشان ShowBits پشکنین دەکات کە بەڕاستی لەگەڵ ئەم ماڵپەڕە قسە دەکات."

#: showbits/includes/class-settings-page.php
msgid "Connect"
msgstr "پەیوەستکردن"

#: showbits/includes/class-settings-page.php
msgid "Are you an admin or owner of the workspace yourself? Then sign in to ShowBits and agree there, without a site key:"
msgstr "خۆت بەڕێوەبەر یان خاوەنی شوێنی کارەکەیت؟ کەواتە بچۆ ژوورەوەی ShowBits و لەوێ ڕەزامەندی بدە، بەبێ کلیلی ماڵپەڕ:"

#: showbits/includes/class-settings-page.php
msgid "Connect through ShowBits"
msgstr "پەیوەستکردن لە ڕێگەی ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits address"
msgstr "ناونیشانی ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits Cloud: https://app.showbits.ai. OnPremise: the address of your installation."
msgstr "ShowBits Cloud: https://app.showbits.ai. OnPremise: ناونیشانی دامەزراندنەکەی خۆت."

#: showbits/includes/class-settings-page.php
msgid "Disconnect"
msgstr "پچڕاندنی پەیوەندی"

#: showbits/includes/class-settings-page.php
msgid "Disconnect this site from ShowBits? What is in the media library stays."
msgstr "پەیوەندیی ئەم ماڵپەڕە لەگەڵ ShowBits بپچڕێنرێت؟ ئەوەی لە کتێبخانەی میدیادایە دەمێنێتەوە."

#: showbits/includes/class-settings-page.php
msgid "asked for"
msgstr "داواکراوە"

#: showbits/includes/class-settings-page.php
msgid "waiting"
msgstr "چاوەڕێیە"

#: showbits/includes/class-settings-page.php
msgid "importing"
msgstr "هاوردە دەکرێت"

#: showbits/includes/class-settings-page.php
msgid "imported"
msgstr "هاوردەکرا"

#: showbits/includes/class-settings-page.php
msgid "failed"
msgstr "سەرکەوتوو نەبوو"

#: showbits/includes/class-settings-page.php
msgid "Recent imports"
msgstr "دوایین هاوردەکردنەکان"

#: showbits/includes/class-settings-page.php
msgid "When"
msgstr "کات"

#: showbits/includes/class-settings-page.php
msgid "Clip"
msgstr "کلیپ"

#: showbits/includes/class-settings-page.php
msgid "How"
msgstr "شێواز"

#: showbits/includes/class-settings-page.php
msgid "State"
msgstr "دۆخ"

#: showbits/includes/class-settings-page.php
msgid "sent from ShowBits"
msgstr "ناردراوە لەلایەن ShowBits"

#: showbits/includes/class-settings-page.php
msgid "picked here"
msgstr "لێرە هەڵبژێردرا"

#: showbits/includes/class-settings-page.php
msgid "Connected. The library is under Media → ShowBits."
msgstr "پەیوەستکرا. کتێبخانەکە لە میدیا ← ShowBits دەدۆزیتەوە."

#: showbits/includes/class-settings-page.php
msgid "Disconnected. What is in the media library stays."
msgstr "پەیوەندی پچڕێنرا. ئەوەی لە کتێبخانەی میدیادایە دەمێنێتەوە."

#: showbits/includes/class-settings-page.php
msgid "Saved."
msgstr "پاشەکەوت کرا."

#: showbits/includes/class-settings-page.php
msgid "Connecting was cancelled in ShowBits."
msgstr "پەیوەستکردنەکە لە ShowBits هەڵوەشێنرایەوە."

#: showbits/includes/class-settings-page.php
msgid "That way back from ShowBits did not belong to this attempt. Start again."
msgstr "ئەم گەڕانەوەیە لە ShowBits سەر بەو هەوڵەی پەیوەستکردن نییە کە ئەم ماڵپەڕە دەستی پێکرد. دووبارە دەست پێ بکەرەوە."

#: showbits/includes/class-settings-page.php
msgid "The ShowBits address must start with https://."
msgstr "ناونیشانی ShowBits دەبێت بە https:// دەست پێ بکات."

#: showbits/includes/class-settings-page.php
msgid "That is not a site key. Copy it from ShowBits (Integrations → WordPress) again."
msgstr "ئەمە کلیلی ماڵپەڕ نییە. دووبارە لە ShowBits (Integrations → WordPress) لەبەری بگرەوە."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not take the site key: it is unknown, used, withdrawn or expired (a site key lasts 24 hours, a consent ten minutes). Make a new one."
msgstr "ShowBits کلیلی ماڵپەڕەکەی وەرنەگرت: نەناسراوە، بەکارهاتووە، کشێنراوەتەوە یان بەسەرچووە (کلیلی ماڵپەڕ 24 کاتژمێر و ڕەزامەندی دە خولەک دروستە). دانەیەکی نوێ دروست بکە."

#: showbits/includes/class-settings-page.php
msgid "The site key was made for another address. Make one for this site’s address."
msgstr "کلیلی ماڵپەڕەکە بۆ ناونیشانێکی تر دروستکراوە. دانەیەک بۆ ناونیشانی ئەم ماڵپەڕە دروست بکە."

#: showbits/includes/class-settings-page.php
msgid "ShowBits could not reach this site at its REST API (/wp-json/showbits/v1/push), or ShowBits itself could not be reached. The site must be public over HTTPS; a firewall or security plugin must let ShowBits in."
msgstr "ShowBits نەیتوانی لە ڕێگەی REST API ی ئەم ماڵپەڕەوە (/wp-json/showbits/v1/push) بگاتە ماڵپەڕەکە، یان دەستگەیشتن بە خودی ShowBits نەکرا. ماڵپەڕەکە دەبێت بە HTTPS گشتی بێت؛ دیوارێکی ئاگرین یان پێوەکراوێکی ئاسایش دەبێت ڕێگە بە ShowBits بدات."

#: showbits/includes/class-settings-page.php
msgid "This site did not answer ShowBits’ check as expected. Try again; if it fails again, a cache or security plugin may answer for WordPress."
msgstr "ئەم ماڵپەڕە وەک پێشبینی دەکرا وەڵامی پشکنینەکەی ShowBits ی نەدایەوە. دووبارە هەوڵ بدەرەوە؛ ئەگەر دیسان سەرکەوتوو نەبوو، لەوانەیە پێوەکراوێکی کاش یان ئاسایش لە جیاتی WordPress وەڵام بداتەوە."

#: showbits/includes/class-settings-page.php
msgid "The workspace’s plan has ended, or whoever made the site key may no longer connect sites."
msgstr "پلانی شوێنی کارەکە کۆتایی هاتووە، یان ئەو کەسەی کلیلی ماڵپەڕەکەی دروست کرد چیتر ناتوانێت ماڵپەڕ پەیوەست بکات."

#: showbits/includes/class-settings-page.php
msgid "The workspace has as many sites as its plan allows."
msgstr "شوێنی کارەکە هێندەی ئەوەی پلانەکەی ڕێگە دەدات ماڵپەڕی هەیە."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not accept this site’s address. It must be served over HTTPS."
msgstr "ShowBits ناونیشانی ئەم ماڵپەڕەی وەرنەگرت. دەبێت بە HTTPS پێشکەش بکرێت."

#: showbits/includes/class-settings-page.php
msgid "Connecting did not work. Try again, or ask your ShowBits contact."
msgstr "پەیوەستکردن سەرکەوتوو نەبوو. دووبارە هەوڵ بدەرەوە، یان پرسیار لە کەسی پەیوەندیدارت لە ShowBits بکە."
