# Estonian translation of the ShowBits plugin.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: et\n"
"Plural-Forms: nplurals=2; plural=n != 1;\n"

#. Description of the plugin
#: showbits/showbits.php
msgid "Released clips and quote cards from ShowBits in the media library: pick them in WordPress, or receive what your ShowBits admins send."
msgstr "ShowBitsis avaldamiseks kinnitatud klipid ja tsitaadikaardid meediateeki: vali need WordPressis või võta vastu, mida sinu ShowBitsi haldurid saadavad."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer as expected."
msgstr "ShowBits ei vastanud ootuspäraselt."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer with a file."
msgstr "ShowBits ei saatnud faili."

#: showbits/includes/class-api-client.php showbits/includes/class-importer.php
msgid "ShowBits could not be reached."
msgstr "ShowBitsiga ei õnnestunud ühendust saada."

#. translators: 1: ShowBits' reason, 2: the HTTP status
#: showbits/includes/class-api-client.php
msgid "ShowBits refused (%1$s, HTTP %2$d)."
msgstr "ShowBits lükkas päringu tagasi (%1$s, HTTP %2$d)."

#: showbits/includes/class-connection.php
msgid "You may not connect this site."
msgstr "Sul pole õigust seda veebilehte ühendada."

#. translators: %s: the clip's title
#: showbits/includes/class-importer.php
msgid "%s (thumbnail)"
msgstr "%s (pisipilt)"

#. translators: %s: a quote (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%s”"
msgstr "„%s“"

#. translators: 1: a quote, 2: who said it (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%1$s” – %2$s"
msgstr "„%1$s“ – %2$s"

#: showbits/includes/class-importer.php
msgid "This is not a clip or a format ShowBits offers."
msgstr "See ei ole klipp ega formaat, mida ShowBits pakub."

#: showbits/includes/class-importer.php
msgid "The clip is no longer released in ShowBits."
msgstr "Klipp ei ole ShowBitsis enam avaldamiseks kinnitatud."

#: showbits/includes/class-importer.php
msgid "The embargo still holds: the file stays in ShowBits until it ends."
msgstr "Embargo kehtib veel: fail jääb ShowBitsi, kuni embargo lõpeb."

#: showbits/includes/class-importer.php
msgid "The file is not ready yet in ShowBits."
msgstr "Fail ei ole ShowBitsis veel valmis."

#: showbits/includes/class-importer.php
msgid "The file could not be downloaded."
msgstr "Faili ei õnnestunud alla laadida."

#: showbits/includes/class-importer.php
msgid "WordPress did not take the file into the media library."
msgstr "WordPress ei lisanud faili meediateeki."

#: showbits/includes/class-importer.php
msgid "The delivery from ShowBits is no longer valid. Import the clip again."
msgstr "ShowBitsi saadetis ei kehti enam. Impordi klipp uuesti."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer accepts this site’s connection: connect it again under Settings → ShowBits."
msgstr "ShowBits ei aktsepteeri enam selle veebilehe ühendust: ühenda veebileht uuesti menüüs Sätted → ShowBits."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer delivers to this site: the workspace’s plan has ended."
msgstr "ShowBits ei saada sellele veebilehele enam midagi: tööruumi tellimus on lõppenud."

#: showbits/includes/class-importer.php
msgid "The site’s imports for today are used up. Try again tomorrow."
msgstr "Veebilehe tänane impordilimiit on täis. Proovi homme uuesti."

#: showbits/includes/class-importer.php
msgid "The import was interrupted."
msgstr "Import katkes."

#: showbits/includes/class-importer.php
msgid "The import failed."
msgstr "Import ebaõnnestus."

#: showbits/includes/class-library-endpoint.php
msgid "This site is not connected to ShowBits."
msgstr "See veebileht ei ole ShowBitsiga ühendatud."

#: showbits/includes/class-library-page.php
msgid "All"
msgstr "Kõik"

#: showbits/includes/class-library-page.php
msgid "Clips"
msgstr "Klipid"

#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Quote cards"
msgstr "Tsitaadikaardid"

#: showbits/includes/class-library-page.php
msgid "Search titles"
msgstr "Otsi pealkirjadest"

#: showbits/includes/class-library-page.php
msgid "Search the library"
msgstr "Otsi teegist"

#: showbits/includes/class-library-page.php
msgid "Import selected"
msgstr "Impordi valitud"

#. translators: 1: which one, 2: how many in all
#: showbits/includes/class-library-page.php
msgid "Asking ShowBits for %1$d of %2$d …"
msgstr "Päring ShowBitsile: %1$d/%2$d…"

#. translators: %d: how many clips are still on their way
#: showbits/includes/class-library-page.php
msgid "On the way from ShowBits: %d …"
msgstr "Teel ShowBitsist: %d…"

#. translators: %d: how many clips were imported
#: showbits/includes/class-library-page.php
msgid "Imported: %d"
msgstr "Imporditud: %d"

#: showbits/includes/class-library-page.php
msgid "Not everything has arrived yet; it continues in the background. Settings → ShowBits lists the imports."
msgstr "Kõik pole veel kohale jõudnud; import jätkub taustal. Impordid on näha menüüs Sätted → ShowBits."

#: showbits/includes/class-library-page.php
msgid "On the way"
msgstr "Teel"

#: showbits/includes/class-library-page.php
msgid "Load more"
msgstr "Laadi rohkem"

#: showbits/includes/class-library-page.php
msgid "Loading …"
msgstr "Laadimine…"

#: showbits/includes/class-library-page.php
msgid "No released clips or quote cards yet."
msgstr "Avaldamiseks kinnitatud klippe ega tsitaadikaarte veel pole."

#. translators: %s: date and time the embargo ends
#: showbits/includes/class-library-page.php
msgid "Embargo until %s"
msgstr "Embargo kuni %s"

#: showbits/includes/class-library-page.php
msgid "Not ready yet"
msgstr "Pole veel valmis"

#: showbits/includes/class-library-page.php
msgid "In the media library"
msgstr "Meediateegis"

#: showbits/includes/class-library-page.php
msgid "An older version is in the media library"
msgstr "Vanem versioon on meediateegis"

#: showbits/includes/class-library-page.php
msgid "Edit"
msgstr "Muuda"

#: showbits/includes/class-library-page.php
msgid "Format"
msgstr "Formaat"

#: showbits/includes/class-library-page.php
msgid "Video"
msgstr "Video"

#: showbits/includes/class-library-page.php
msgid "Quote card"
msgstr "Tsitaadikaart"

#: showbits/includes/class-library-page.php
msgid "Meme"
msgstr "Meem"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "Failed: %s"
msgstr "Ebaõnnestus: %s"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "The library could not be loaded: %s"
msgstr "Teeki ei õnnestunud laadida: %s"

#: showbits/includes/class-library-page.php
msgid "This site is not connected to ShowBits yet."
msgstr "See veebileht pole veel ShowBitsiga ühendatud."

#: showbits/includes/class-library-page.php
msgid "Connect it in the settings."
msgstr "Ühenda see seadetes."

#: showbits/includes/class-library-page.php
msgid "An administrator of this site connects it in the settings."
msgstr "Veebilehe saab seadetes ühendada selle haldur."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-library-page.php
msgid "Released clips and quote cards from the ShowBits workspace “%s”. What you import lands in the media library, ready for posts and pages."
msgstr "Avaldamiseks kinnitatud klipid ja tsitaadikaardid ShowBitsi tööruumist „%s“. Mida impordid, see jõuab meediateeki, valmis kasutamiseks postitustes ja lehtedel."

#: showbits/includes/class-library-page.php
msgid "The library needs JavaScript."
msgstr "Teek vajab JavaScripti."

#: showbits/includes/class-settings-page.php
msgid "Settings"
msgstr "Sätted"

#: showbits/includes/class-settings-page.php
msgid "You may not change these settings."
msgstr "Sul pole õigust neid seadeid muuta."

#: showbits/includes/class-settings-page.php
msgid "Connection"
msgstr "Ühendus"

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-settings-page.php
msgid "Connected to the workspace “%s”."
msgstr "Ühendatud tööruumiga „%s“."

#. translators: 1: imports today, 2: imports a day the plan allows
#: showbits/includes/class-settings-page.php
msgid "Imports today: %1$d of %2$d."
msgstr "Impordid täna: %1$d/%2$d."

#. translators: 1: a person, 2: a date, 3: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "Connected by %1$s on %2$s, at %3$s."
msgstr "%1$s ühendas veebilehe %2$s aadressiga %3$s."

#: showbits/includes/class-settings-page.php
msgid "Connect again"
msgstr "Ühenda uuesti"

#: showbits/includes/class-settings-page.php
msgid "With a new site key the site renews its connection, or moves to another workspace."
msgstr "Uue veebilehevõtmega uuendab veebileht oma ühendust või kolib teise tööruumi."

#. translators: %s: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "ShowBits (%s) cannot be reached right now. The connection stays; try again later."
msgstr "ShowBits (%s) ei ole praegu kättesaadav. Ühendus jääb alles; proovi hiljem uuesti."

#: showbits/includes/class-settings-page.php
msgid "ShowBits no longer accepts this site’s connection: it was disconnected in ShowBits, the plan ended, or this site’s keys changed. Connect it again with a new site key."
msgstr "ShowBits ei aktsepteeri enam selle veebilehe ühendust: see katkestati ShowBitsis, tellimus lõppes või selle veebilehe võtmed muutusid. Ühenda veebileht uuesti uue veebilehevõtmega."

#: showbits/includes/class-settings-page.php
msgid "Connect this site to a ShowBits workspace: an admin or owner of the workspace makes a site key for this site in ShowBits (Integrations → WordPress). The site can then take released clips and quote cards into its media library, and receive what your ShowBits admins send."
msgstr "Ühenda see veebileht ShowBitsi tööruumiga: tööruumi haldur või omanik loob ShowBitsis selle veebilehe jaoks veebilehevõtme (Integrations → WordPress). Seejärel saab veebileht võtta avaldamiseks kinnitatud klippe ja tsitaadikaarte oma meediateeki ning võtta vastu, mida sinu ShowBitsi haldurid saadavad."

#: showbits/includes/class-settings-page.php
msgid "Imports"
msgstr "Impordid"

#: showbits/includes/class-settings-page.php
msgid "Format of quote cards"
msgstr "Tsitaadikaartide formaat"

#: showbits/includes/class-settings-page.php
msgid "4:5 (feeds, articles)"
msgstr "4:5 (vood, artiklid)"

#: showbits/includes/class-settings-page.php
msgid "1:1 (square)"
msgstr "1:1 (ruut)"

#: showbits/includes/class-settings-page.php
msgid "9:16 (stories)"
msgstr "9:16 (lood)"

#: showbits/includes/class-settings-page.php
msgid "The picture pushes bring; in the library you choose for each card."
msgstr "Formaat, milles saadetud kaardid saabuvad; teegis valid formaadi iga kaardi jaoks eraldi."

#: showbits/includes/class-settings-page.php
msgid "Videos"
msgstr "Videod"

#: showbits/includes/class-settings-page.php
msgid "Import the thumbnail as the video’s poster image"
msgstr "Impordi pisipilt video posteripildiks"

#: showbits/includes/class-settings-page.php
msgid "Save"
msgstr "Salvesta"

#: showbits/includes/class-settings-page.php
msgid "Site key"
msgstr "Veebilehevõti"

#. translators: %s: this site's address
#: showbits/includes/class-settings-page.php
msgid "Made in ShowBits for %s, valid for 24 hours and only once. ShowBits then checks that it is talking to this site."
msgstr "Luuakse ShowBitsis aadressi %s jaoks, kehtib 24 tundi ja ainult ühe korra. Seejärel kontrollib ShowBits, et suhtleb just selle veebilehega."

#: showbits/includes/class-settings-page.php
msgid "Connect"
msgstr "Ühenda"

#: showbits/includes/class-settings-page.php
msgid "Are you an admin or owner of the workspace yourself? Then sign in to ShowBits and agree there, without a site key:"
msgstr "Oled ise tööruumi haldur või omanik? Siis logi ShowBitsi sisse ja anna seal nõusolek, ilma veebilehevõtmeta:"

#: showbits/includes/class-settings-page.php
msgid "Connect through ShowBits"
msgstr "Ühenda ShowBitsi kaudu"

#: showbits/includes/class-settings-page.php
msgid "ShowBits address"
msgstr "ShowBitsi aadress"

#: showbits/includes/class-settings-page.php
msgid "ShowBits Cloud: https://app.showbits.ai. OnPremise: the address of your installation."
msgstr "ShowBits Cloud: https://app.showbits.ai. OnPremise: sinu paigalduse aadress."

#: showbits/includes/class-settings-page.php
msgid "Disconnect"
msgstr "Katkesta ühendus"

#: showbits/includes/class-settings-page.php
msgid "Disconnect this site from ShowBits? What is in the media library stays."
msgstr "Kas katkestada selle veebilehe ühendus ShowBitsiga? Meediateegi sisu jääb alles."

#: showbits/includes/class-settings-page.php
msgid "asked for"
msgstr "küsitud"

#: showbits/includes/class-settings-page.php
msgid "waiting"
msgstr "ootel"

#: showbits/includes/class-settings-page.php
msgid "importing"
msgstr "imporditakse"

#: showbits/includes/class-settings-page.php
msgid "imported"
msgstr "imporditud"

#: showbits/includes/class-settings-page.php
msgid "failed"
msgstr "ebaõnnestus"

#: showbits/includes/class-settings-page.php
msgid "Recent imports"
msgstr "Viimased impordid"

#: showbits/includes/class-settings-page.php
msgid "When"
msgstr "Millal"

#: showbits/includes/class-settings-page.php
msgid "Clip"
msgstr "Klipp"

#: showbits/includes/class-settings-page.php
msgid "How"
msgstr "Allikas"

#: showbits/includes/class-settings-page.php
msgid "State"
msgstr "Olek"

#: showbits/includes/class-settings-page.php
msgid "sent from ShowBits"
msgstr "saadetud ShowBitsist"

#: showbits/includes/class-settings-page.php
msgid "picked here"
msgstr "valitud siin"

#: showbits/includes/class-settings-page.php
msgid "Connected. The library is under Media → ShowBits."
msgstr "Ühendatud. Teek asub menüüs Meedia → ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Disconnected. What is in the media library stays."
msgstr "Ühendus katkestatud. Meediateegi sisu jääb alles."

#: showbits/includes/class-settings-page.php
msgid "Saved."
msgstr "Salvestatud."

#: showbits/includes/class-settings-page.php
msgid "Connecting was cancelled in ShowBits."
msgstr "Ühendamine tühistati ShowBitsis."

#: showbits/includes/class-settings-page.php
msgid "That way back from ShowBits did not belong to this attempt. Start again."
msgstr "See tagasisuunamine ShowBitsist ei kuulunud selle ühendamiskatse juurde. Alusta uuesti."

#: showbits/includes/class-settings-page.php
msgid "The ShowBits address must start with https://."
msgstr "ShowBitsi aadress peab algama https://."

#: showbits/includes/class-settings-page.php
msgid "That is not a site key. Copy it from ShowBits (Integrations → WordPress) again."
msgstr "See ei ole veebilehevõti. Kopeeri see uuesti ShowBitsist (Integrations → WordPress)."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not take the site key: it is unknown, used, withdrawn or expired (a site key lasts 24 hours, a consent ten minutes). Make a new one."
msgstr "ShowBits ei võtnud veebilehevõtit vastu: see on tundmatu, juba kasutatud, tühistatud või aegunud (veebilehevõti kehtib 24 tundi, nõusolek kümme minutit). Loo uus veebilehevõti."

#: showbits/includes/class-settings-page.php
msgid "The site key was made for another address. Make one for this site’s address."
msgstr "Veebilehevõti loodi teise aadressi jaoks. Loo veebilehevõti selle veebilehe aadressi jaoks."

#: showbits/includes/class-settings-page.php
msgid "ShowBits could not reach this site at its REST API (/wp-json/showbits/v1/push), or ShowBits itself could not be reached. The site must be public over HTTPS; a firewall or security plugin must let ShowBits in."
msgstr "ShowBits ei jõudnud selle veebilehe REST API-ni (/wp-json/showbits/v1/push) või ei saanud ShowBitsiga endaga ühendust. Veebileht peab olema avalikult kättesaadav HTTPS-i kaudu; tulemüür või turvaplugin peab ShowBitsi läbi laskma."

#: showbits/includes/class-settings-page.php
msgid "This site did not answer ShowBits’ check as expected. Try again; if it fails again, a cache or security plugin may answer for WordPress."
msgstr "See veebileht ei vastanud ShowBitsi kontrollile ootuspäraselt. Proovi uuesti; kui see jälle ebaõnnestub, võib WordPressi asemel vastata vahemälu- või turvaplugin."

#: showbits/includes/class-settings-page.php
msgid "The workspace’s plan has ended, or whoever made the site key may no longer connect sites."
msgstr "Tööruumi tellimus on lõppenud või veebilehevõtme loojal pole enam õigust veebilehti ühendada."

#: showbits/includes/class-settings-page.php
msgid "The workspace has as many sites as its plan allows."
msgstr "Tööruumis on juba nii palju veebilehti, kui selle tellimus lubab."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not accept this site’s address. It must be served over HTTPS."
msgstr "ShowBits ei aktsepteerinud selle veebilehe aadressi. Veebileht peab olema kättesaadav HTTPS-i kaudu."

#: showbits/includes/class-settings-page.php
msgid "Connecting did not work. Try again, or ask your ShowBits contact."
msgstr "Ühendamine ei õnnestunud. Proovi uuesti või küsi oma ShowBitsi kontaktisikult."
