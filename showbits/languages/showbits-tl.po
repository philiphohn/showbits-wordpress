# Tagalog translation of the ShowBits plugin.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: tl\n"
"Plural-Forms: nplurals=2; plural=n != 1;\n"

#. Description of the plugin
#: showbits/showbits.php
msgid "Released clips and quote cards from ShowBits in the media library: pick them in WordPress, or receive what your ShowBits admins send."
msgstr "Mga aprubadong clip at quote card mula sa ShowBits, diretso sa media library: piliin ang mga ito sa WordPress, o tanggapin ang ipinapadala ng iyong mga admin sa ShowBits."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer as expected."
msgstr "Hindi inaasahan ang sagot ng ShowBits."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer with a file."
msgstr "Hindi nagbalik ng file ang ShowBits."

#: showbits/includes/class-api-client.php showbits/includes/class-importer.php
msgid "ShowBits could not be reached."
msgstr "Hindi maabot ang ShowBits."

#. translators: 1: ShowBits' reason, 2: the HTTP status
#: showbits/includes/class-api-client.php
msgid "ShowBits refused (%1$s, HTTP %2$d)."
msgstr "Tumanggi ang ShowBits (%1$s, HTTP %2$d)."

#: showbits/includes/class-connection.php
msgid "You may not connect this site."
msgstr "Wala kang pahintulot na ikonekta ang site na ito."

#. translators: %s: the clip's title
#: showbits/includes/class-importer.php
msgid "%s (thumbnail)"
msgstr "%s (thumbnail)"

#. translators: %s: a quote (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%s”"
msgstr "“%s”"

#. translators: 1: a quote, 2: who said it (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%1$s” – %2$s"
msgstr "“%1$s” – %2$s"

#: showbits/includes/class-importer.php
msgid "This is not a clip or a format ShowBits offers."
msgstr "Hindi ito clip o format na iniaalok ng ShowBits."

#: showbits/includes/class-importer.php
msgid "The clip is no longer released in ShowBits."
msgstr "Hindi na aprubado ang clip sa ShowBits."

#: showbits/includes/class-importer.php
msgid "The embargo still holds: the file stays in ShowBits until it ends."
msgstr "May bisa pa ang embargo: mananatili ang file sa ShowBits hanggang matapos ito."

#: showbits/includes/class-importer.php
msgid "The file is not ready yet in ShowBits."
msgstr "Hindi pa handa ang file sa ShowBits."

#: showbits/includes/class-importer.php
msgid "The file could not be downloaded."
msgstr "Hindi ma-download ang file."

#: showbits/includes/class-importer.php
msgid "WordPress did not take the file into the media library."
msgstr "Hindi tinanggap ng WordPress ang file sa media library."

#: showbits/includes/class-importer.php
msgid "The delivery from ShowBits is no longer valid. Import the clip again."
msgstr "Wala nang bisa ang padala mula sa ShowBits. I-import muli ang clip."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer accepts this site’s connection: connect it again under Settings → ShowBits."
msgstr "Hindi na tinatanggap ng ShowBits ang koneksyon ng site na ito: ikonekta itong muli sa Mga Setting → ShowBits."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer delivers to this site: the workspace’s plan has ended."
msgstr "Hindi na nagpapadala ang ShowBits sa site na ito: natapos na ang plan ng workspace."

#: showbits/includes/class-importer.php
msgid "The site’s imports for today are used up. Try again tomorrow."
msgstr "Naubos na ang mga import ng site para sa araw na ito. Subukang muli bukas."

#: showbits/includes/class-importer.php
msgid "The import was interrupted."
msgstr "Naputol ang pag-import."

#: showbits/includes/class-importer.php
msgid "The import failed."
msgstr "Nabigo ang pag-import."

#: showbits/includes/class-library-endpoint.php
msgid "This site is not connected to ShowBits."
msgstr "Hindi nakakonekta ang site na ito sa ShowBits."

#: showbits/includes/class-library-page.php
msgid "All"
msgstr "Lahat"

#: showbits/includes/class-library-page.php
msgid "Clips"
msgstr "Mga clip"

#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Quote cards"
msgstr "Mga quote card"

#: showbits/includes/class-library-page.php
msgid "Search titles"
msgstr "Maghanap sa mga pamagat"

#: showbits/includes/class-library-page.php
msgid "Search the library"
msgstr "Maghanap sa library"

#: showbits/includes/class-library-page.php
msgid "Import selected"
msgstr "I-import ang napili"

#. translators: 1: which one, 2: how many in all
#: showbits/includes/class-library-page.php
msgid "Asking ShowBits for %1$d of %2$d …"
msgstr "Hinihiling sa ShowBits ang %1$d sa %2$d…"

#. translators: %d: how many clips are still on their way
#: showbits/includes/class-library-page.php
msgid "On the way from ShowBits: %d …"
msgstr "Parating mula sa ShowBits: %d…"

#. translators: %d: how many clips were imported
#: showbits/includes/class-library-page.php
msgid "Imported: %d"
msgstr "Na-import: %d"

#: showbits/includes/class-library-page.php
msgid "Not everything has arrived yet; it continues in the background. Settings → ShowBits lists the imports."
msgstr "Hindi pa dumarating ang lahat; nagpapatuloy ito sa background. Nakalista ang mga import sa Mga Setting → ShowBits."

#: showbits/includes/class-library-page.php
msgid "On the way"
msgstr "Parating na"

#: showbits/includes/class-library-page.php
msgid "Load more"
msgstr "Mag-load pa"

#: showbits/includes/class-library-page.php
msgid "Loading …"
msgstr "Naglo-load…"

#: showbits/includes/class-library-page.php
msgid "No released clips or quote cards yet."
msgstr "Wala pang aprubadong clip o quote card."

#. translators: %s: date and time the embargo ends
#: showbits/includes/class-library-page.php
msgid "Embargo until %s"
msgstr "Embargo hanggang %s"

#: showbits/includes/class-library-page.php
msgid "Not ready yet"
msgstr "Hindi pa handa"

#: showbits/includes/class-library-page.php
msgid "In the media library"
msgstr "Nasa media library na"

#: showbits/includes/class-library-page.php
msgid "An older version is in the media library"
msgstr "May mas lumang bersyon sa media library"

#: showbits/includes/class-library-page.php
msgid "Edit"
msgstr "I-edit"

#: showbits/includes/class-library-page.php
msgid "Format"
msgstr "Format"

#: showbits/includes/class-library-page.php
msgid "Video"
msgstr "Video"

#: showbits/includes/class-library-page.php
msgid "Quote card"
msgstr "Quote card"

#: showbits/includes/class-library-page.php
msgid "Meme"
msgstr "Meme"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "Failed: %s"
msgstr "Nabigo: %s"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "The library could not be loaded: %s"
msgstr "Hindi ma-load ang library: %s"

#: showbits/includes/class-library-page.php
msgid "This site is not connected to ShowBits yet."
msgstr "Hindi pa nakakonekta ang site na ito sa ShowBits."

#: showbits/includes/class-library-page.php
msgid "Connect it in the settings."
msgstr "Ikonekta ito sa mga setting."

#: showbits/includes/class-library-page.php
msgid "An administrator of this site connects it in the settings."
msgstr "Isang administrator ng site na ito ang dapat magkonekta nito sa mga setting."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-library-page.php
msgid "Released clips and quote cards from the ShowBits workspace “%s”. What you import lands in the media library, ready for posts and pages."
msgstr "Mga aprubadong clip at quote card mula sa ShowBits workspace na “%s”. Mapupunta sa media library ang anumang i-import mo, handa na para sa mga post at pahina."

#: showbits/includes/class-library-page.php
msgid "The library needs JavaScript."
msgstr "Kailangan ng library ang JavaScript."

#: showbits/includes/class-settings-page.php
msgid "Settings"
msgstr "Mga Setting"

#: showbits/includes/class-settings-page.php
msgid "You may not change these settings."
msgstr "Wala kang pahintulot na baguhin ang mga setting na ito."

#: showbits/includes/class-settings-page.php
msgid "Connection"
msgstr "Koneksyon"

#. translators: 1: the constant SHOWBITS_ENCRYPTION_KEY, 2: the file wp-config.php (both stay as they are)
#: showbits/includes/class-settings-page.php
msgid "Your site’s security keys are not in %2$s, so the key that protects the connection to ShowBits is stored in the database. Add %1$s with a long random value to %2$s; if the site is connected already, connect it again afterwards."
msgstr "Wala sa %2$s ang mga security key ng iyong site, kaya nakaimbak sa database ang key na nagpoprotekta sa koneksyon sa ShowBits. Idagdag ang %1$s na may mahabang random na value sa %2$s; kung nakakonekta na ang site, ikonekta itong muli pagkatapos."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-settings-page.php
msgid "Connected to the workspace “%s”."
msgstr "Nakakonekta sa workspace na “%s”."

#. translators: 1: imports today, 2: imports a day the plan allows
#: showbits/includes/class-settings-page.php
msgid "Imports today: %1$d of %2$d."
msgstr "Mga import ngayong araw: %1$d sa %2$d."

#. translators: 1: a person, 2: a date, 3: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "Connected by %1$s on %2$s, at %3$s."
msgstr "Ikinonekta ni %1$s noong %2$s, sa %3$s."

#: showbits/includes/class-settings-page.php
msgid "Connect again"
msgstr "Ikonekta muli"

#: showbits/includes/class-settings-page.php
msgid "With a new site key the site renews its connection, or moves to another workspace."
msgstr "Gamit ang bagong site key, mapapanibago ng site ang koneksyon nito, o makalilipat ito sa ibang workspace."

#. translators: %s: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "ShowBits (%s) cannot be reached right now. The connection stays; try again later."
msgstr "Hindi maabot ang ShowBits (%s) sa ngayon. Mananatili ang koneksyon; subukang muli mamaya."

#: showbits/includes/class-settings-page.php
msgid "ShowBits no longer accepts this site’s connection: it was disconnected in ShowBits, the plan ended, or this site’s keys changed. Connect it again with a new site key."
msgstr "Hindi na tinatanggap ng ShowBits ang koneksyon ng site na ito: idiniskonekta ito sa ShowBits, natapos na ang plan, o nagbago ang mga key ng site na ito. Ikonekta itong muli gamit ang bagong site key."

#: showbits/includes/class-settings-page.php
msgid "Connect this site to a ShowBits workspace: an admin or owner of the workspace makes a site key for this site in ShowBits (Integrations → WordPress). The site can then take released clips and quote cards into its media library, and receive what your ShowBits admins send."
msgstr "Ikonekta ang site na ito sa isang ShowBits workspace: gagawa ang isang admin o may-ari ng workspace ng site key para sa site na ito sa ShowBits (Integrations → WordPress). Pagkatapos, makakukuha ang site ng mga aprubadong clip at quote card para sa media library nito, at matatanggap nito ang ipinapadala ng iyong mga admin sa ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Imports"
msgstr "Mga import"

#: showbits/includes/class-settings-page.php
msgid "Format of quote cards"
msgstr "Format ng mga quote card"

#: showbits/includes/class-settings-page.php
msgid "4:5 (feeds, articles)"
msgstr "4:5 (mga feed, artikulo)"

#: showbits/includes/class-settings-page.php
msgid "1:1 (square)"
msgstr "1:1 (parisukat)"

#: showbits/includes/class-settings-page.php
msgid "9:16 (stories)"
msgstr "9:16 (mga story)"

#: showbits/includes/class-settings-page.php
msgid "The picture pushes bring; in the library you choose for each card."
msgstr "Ang format ng larawang dala ng mga ipinapadala rito; sa library, pipiliin mo ito para sa bawat card."

#: showbits/includes/class-settings-page.php
msgid "Videos"
msgstr "Mga video"

#: showbits/includes/class-settings-page.php
msgid "Import the thumbnail as the video’s poster image"
msgstr "I-import ang thumbnail bilang poster image ng video"

#: showbits/includes/class-settings-page.php
msgid "Save"
msgstr "I-save"

#: showbits/includes/class-settings-page.php
msgid "Site key"
msgstr "Site key"

#. translators: %s: this site's address
#: showbits/includes/class-settings-page.php
msgid "Made in ShowBits for %s, valid for 24 hours and only once. ShowBits then checks that it is talking to this site."
msgstr "Ginawa sa ShowBits para sa %s, may bisa nang 24 na oras at isang beses lang magagamit. Pagkatapos, titiyakin ng ShowBits na ang site na ito talaga ang kausap nito."

#: showbits/includes/class-settings-page.php
msgid "Connect"
msgstr "Ikonekta"

#: showbits/includes/class-settings-page.php
msgid "Are you an admin or owner of the workspace yourself? Then sign in to ShowBits and agree there, without a site key:"
msgstr "Ikaw mismo ba ay admin o may-ari ng workspace? Kung gayon, mag-sign in sa ShowBits at pumayag doon, nang walang site key:"

#: showbits/includes/class-settings-page.php
msgid "Connect through ShowBits"
msgstr "Ikonekta sa pamamagitan ng ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits address"
msgstr "Address ng ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits Cloud: https://app.showbits.ai. OnPremise: the address of your installation."
msgstr "ShowBits Cloud: https://app.showbits.ai. OnPremise: ang address ng iyong instalasyon."

#: showbits/includes/class-settings-page.php
msgid "Disconnect"
msgstr "Idiskonekta"

#: showbits/includes/class-settings-page.php
msgid "Disconnect this site from ShowBits? What is in the media library stays."
msgstr "Gusto mo bang idiskonekta ang site na ito mula sa ShowBits? Mananatili ang nasa media library."

#: showbits/includes/class-settings-page.php
msgid "asked for"
msgstr "Hiniling"

#: showbits/includes/class-settings-page.php
msgid "waiting"
msgstr "Naghihintay"

#: showbits/includes/class-settings-page.php
msgid "importing"
msgstr "Ini-import"

#: showbits/includes/class-settings-page.php
msgid "imported"
msgstr "Na-import"

#: showbits/includes/class-settings-page.php
msgid "failed"
msgstr "Nabigo"

#: showbits/includes/class-settings-page.php
msgid "Recent imports"
msgstr "Mga kamakailang import"

#: showbits/includes/class-settings-page.php
msgid "When"
msgstr "Kailan"

#: showbits/includes/class-settings-page.php
msgid "Clip"
msgstr "Clip"

#: showbits/includes/class-settings-page.php
msgid "How"
msgstr "Paano"

#: showbits/includes/class-settings-page.php
msgid "State"
msgstr "Katayuan"

#: showbits/includes/class-settings-page.php
msgid "sent from ShowBits"
msgstr "Ipinadala mula sa ShowBits"

#: showbits/includes/class-settings-page.php
msgid "picked here"
msgstr "Pinili rito"

#: showbits/includes/class-settings-page.php
msgid "Connected. The library is under Media → ShowBits."
msgstr "Nakakonekta na. Nasa Media → ShowBits ang library."

#: showbits/includes/class-settings-page.php
msgid "Disconnected. What is in the media library stays."
msgstr "Nadiskonekta na. Mananatili ang nasa media library."

#: showbits/includes/class-settings-page.php
msgid "Saved."
msgstr "Na-save."

#: showbits/includes/class-settings-page.php
msgid "Connecting was cancelled in ShowBits."
msgstr "Kinansela ang pagkonekta sa ShowBits."

#: showbits/includes/class-settings-page.php
msgid "That way back from ShowBits did not belong to this attempt. Start again."
msgstr "Hindi kabilang sa pagkonektang sinimulan dito ang pagbalik na ito mula sa ShowBits. Magsimulang muli."

#: showbits/includes/class-settings-page.php
msgid "The ShowBits address must start with https://."
msgstr "Dapat magsimula sa https:// ang address ng ShowBits."

#: showbits/includes/class-settings-page.php
msgid "That is not a site key. Copy it from ShowBits (Integrations → WordPress) again."
msgstr "Hindi iyan site key. Kopyahin itong muli mula sa ShowBits (Integrations → WordPress)."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not take the site key: it is unknown, used, withdrawn or expired (a site key lasts 24 hours, a consent ten minutes). Make a new one."
msgstr "Hindi tinanggap ng ShowBits ang site key: hindi ito kilala, nagamit na, binawi na, o nag-expire na (24 na oras ang bisa ng site key, at sampung minuto ang sa pahintulot). Gumawa ng bago."

#: showbits/includes/class-settings-page.php
msgid "The site key was made for another address. Make one for this site’s address."
msgstr "Ginawa ang site key para sa ibang address. Gumawa ng isa para sa address ng site na ito."

#: showbits/includes/class-settings-page.php
msgid "ShowBits could not reach this site at its REST API (/wp-json/showbits/v1/push), or ShowBits itself could not be reached. The site must be public over HTTPS; a firewall or security plugin must let ShowBits in."
msgstr "Hindi maabot ng ShowBits ang site na ito sa REST API nito (/wp-json/showbits/v1/push), o hindi maabot ang ShowBits mismo. Dapat pampubliko ang site sa HTTPS; dapat papasukin ng firewall o security plugin ang ShowBits."

#: showbits/includes/class-settings-page.php
msgid "This site did not answer ShowBits’ check as expected. Try again; if it fails again, a cache or security plugin may answer for WordPress."
msgstr "Hindi tama ang naging sagot ng site na ito sa pagsusuri ng ShowBits. Subukang muli; kung mabigo ulit, maaaring isang cache o security plugin ang sumasagot sa halip na WordPress."

#: showbits/includes/class-settings-page.php
msgid "The workspace’s plan has ended, or whoever made the site key may no longer connect sites."
msgstr "Natapos na ang plan ng workspace, o hindi na pinapayagang magkonekta ng mga site ang gumawa ng site key."

#: showbits/includes/class-settings-page.php
msgid "The workspace has as many sites as its plan allows."
msgstr "Naabot na ng workspace ang dami ng site na pinapayagan ng plan nito."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not accept this site’s address. It must be served over HTTPS."
msgstr "Hindi tinanggap ng ShowBits ang address ng site na ito. Dapat itong ihatid sa pamamagitan ng HTTPS."

#: showbits/includes/class-settings-page.php
msgid "Connecting did not work. Try again, or ask your ShowBits contact."
msgstr "Hindi gumana ang pagkonekta. Subukang muli, o magtanong sa iyong contact sa ShowBits."
