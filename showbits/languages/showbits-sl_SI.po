# Slovenian translation of the ShowBits plugin.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: sl_SI\n"
"Plural-Forms: nplurals=4; plural=(n % 100 == 1) ? 0 : ((n % 100 == 2) ? 1 : ((n % 100 == 3 || n % 100 == 4) ? 2 : 3));\n"

#. Description of the plugin
#: showbits/showbits.php
msgid "Released clips and quote cards from ShowBits in the media library: pick them in WordPress, or receive what your ShowBits admins send."
msgstr "Odobreni izrezki in slike s citati iz ShowBitsa v medijski knjižnici: izberite jih v WordPressu ali prejemajte, kar vam pošiljajo vaši administratorji v ShowBitsu."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer as expected."
msgstr "ShowBits ni odgovoril, kot je bilo pričakovano."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer with a file."
msgstr "ShowBits ni vrnil datoteke."

#: showbits/includes/class-api-client.php showbits/includes/class-importer.php
msgid "ShowBits could not be reached."
msgstr "ShowBits ni dosegljiv."

#. translators: 1: ShowBits' reason, 2: the HTTP status
#: showbits/includes/class-api-client.php
msgid "ShowBits refused (%1$s, HTTP %2$d)."
msgstr "ShowBits je zavrnil zahtevo (%1$s, HTTP %2$d)."

#: showbits/includes/class-connection.php
msgid "You may not connect this site."
msgstr "Nimate dovoljenja za povezovanje tega spletišča."

#. translators: %s: the clip's title
#: showbits/includes/class-importer.php
msgid "%s (thumbnail)"
msgstr "%s (predogledna sličica)"

#. translators: %s: a quote (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%s”"
msgstr "„%s“"

#. translators: 1: a quote, 2: who said it (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%1$s” – %2$s"
msgstr "„%1$s“ – %2$s"

#: showbits/includes/class-importer.php
msgid "This is not a clip or a format ShowBits offers."
msgstr "To ni izrezek niti format, ki ga ponuja ShowBits."

#: showbits/includes/class-importer.php
msgid "The clip is no longer released in ShowBits."
msgstr "Izrezek v ShowBitsu ni več odobren."

#: showbits/includes/class-importer.php
msgid "The embargo still holds: the file stays in ShowBits until it ends."
msgstr "Embargo še velja: do njegovega izteka datoteka ostane v ShowBitsu."

#: showbits/includes/class-importer.php
msgid "The file is not ready yet in ShowBits."
msgstr "Datoteka v ShowBitsu še ni pripravljena."

#: showbits/includes/class-importer.php
msgid "The file could not be downloaded."
msgstr "Datoteke ni bilo mogoče prenesti."

#: showbits/includes/class-importer.php
msgid "WordPress did not take the file into the media library."
msgstr "WordPress datoteke ni sprejel v medijsko knjižnico."

#: showbits/includes/class-importer.php
msgid "The delivery from ShowBits is no longer valid. Import the clip again."
msgstr "Dostava iz ShowBitsa ni več veljavna. Ponovno uvozite izrezek."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer accepts this site’s connection: connect it again under Settings → ShowBits."
msgstr "ShowBits ne sprejema več povezave tega spletišča: ponovno ga povežite v meniju Nastavitve → ShowBits."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer delivers to this site: the workspace’s plan has ended."
msgstr "ShowBits temu spletišču ne dostavlja več ničesar: paket delovnega prostora je potekel."

#: showbits/includes/class-importer.php
msgid "The site’s imports for today are used up. Try again tomorrow."
msgstr "Dnevna omejitev uvozov za to spletišče je dosežena. Poskusite znova jutri."

#: showbits/includes/class-importer.php
msgid "The import was interrupted."
msgstr "Uvoz je bil prekinjen."

#: showbits/includes/class-importer.php
msgid "The import failed."
msgstr "Uvoz ni uspel."

#: showbits/includes/class-library-endpoint.php
msgid "This site is not connected to ShowBits."
msgstr "To spletišče ni povezano s ShowBitsom."

#: showbits/includes/class-library-page.php
msgid "All"
msgstr "Vse"

#: showbits/includes/class-library-page.php
msgid "Clips"
msgstr "Izrezki"

#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Quote cards"
msgstr "Slike s citati"

#: showbits/includes/class-library-page.php
msgid "Search titles"
msgstr "Išči po naslovih"

#: showbits/includes/class-library-page.php
msgid "Search the library"
msgstr "Preišči knjižnico"

#: showbits/includes/class-library-page.php
msgid "Import selected"
msgstr "Uvozi izbrano"

#. translators: 1: which one, 2: how many in all
#: showbits/includes/class-library-page.php
msgid "Asking ShowBits for %1$d of %2$d …"
msgstr "Pošiljanje zahteve ShowBitsu: %1$d od %2$d…"

#. translators: %d: how many clips are still on their way
#: showbits/includes/class-library-page.php
msgid "On the way from ShowBits: %d …"
msgstr "Na poti iz ShowBitsa: %d…"

#. translators: %d: how many clips were imported
#: showbits/includes/class-library-page.php
msgid "Imported: %d"
msgstr "Uvoženo: %d"

#: showbits/includes/class-library-page.php
msgid "Not everything has arrived yet; it continues in the background. Settings → ShowBits lists the imports."
msgstr "Vse še ni prispelo; uvoz se nadaljuje v ozadju. Seznam uvozov je v meniju Nastavitve → ShowBits."

#: showbits/includes/class-library-page.php
msgid "On the way"
msgstr "Na poti"

#: showbits/includes/class-library-page.php
msgid "Load more"
msgstr "Naloži več"

#: showbits/includes/class-library-page.php
msgid "Loading …"
msgstr "Nalaganje…"

#: showbits/includes/class-library-page.php
msgid "No released clips or quote cards yet."
msgstr "Odobrenih izrezkov ali slik s citati še ni."

#. translators: %s: date and time the embargo ends
#: showbits/includes/class-library-page.php
msgid "Embargo until %s"
msgstr "Embargo do %s"

#: showbits/includes/class-library-page.php
msgid "Not ready yet"
msgstr "Še ni pripravljeno"

#: showbits/includes/class-library-page.php
msgid "In the media library"
msgstr "V medijski knjižnici"

#: showbits/includes/class-library-page.php
msgid "An older version is in the media library"
msgstr "Starejša različica je v medijski knjižnici"

#: showbits/includes/class-library-page.php
msgid "Edit"
msgstr "Uredi"

#: showbits/includes/class-library-page.php
msgid "Format"
msgstr "Format"

#: showbits/includes/class-library-page.php
msgid "Video"
msgstr "Video"

#: showbits/includes/class-library-page.php
msgid "Quote card"
msgstr "Slika s citatom"

#: showbits/includes/class-library-page.php
msgid "Meme"
msgstr "Mem"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "Failed: %s"
msgstr "Ni uspelo: %s"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "The library could not be loaded: %s"
msgstr "Knjižnice ni bilo mogoče naložiti: %s"

#: showbits/includes/class-library-page.php
msgid "This site is not connected to ShowBits yet."
msgstr "To spletišče še ni povezano s ShowBitsom."

#: showbits/includes/class-library-page.php
msgid "Connect it in the settings."
msgstr "Povežite ga v nastavitvah."

#: showbits/includes/class-library-page.php
msgid "An administrator of this site connects it in the settings."
msgstr "Administrator tega spletišča ga lahko poveže v nastavitvah."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-library-page.php
msgid "Released clips and quote cards from the ShowBits workspace “%s”. What you import lands in the media library, ready for posts and pages."
msgstr "Odobreni izrezki in slike s citati iz delovnega prostora „%s“ v ShowBitsu. Kar uvozite, pristane v medijski knjižnici, pripravljeno za prispevke in strani."

#: showbits/includes/class-library-page.php
msgid "The library needs JavaScript."
msgstr "Knjižnica potrebuje JavaScript."

#: showbits/includes/class-settings-page.php
msgid "Settings"
msgstr "Nastavitve"

#: showbits/includes/class-settings-page.php
msgid "You may not change these settings."
msgstr "Nimate dovoljenja za spreminjanje teh nastavitev."

#: showbits/includes/class-settings-page.php
msgid "Connection"
msgstr "Povezava"

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-settings-page.php
msgid "Connected to the workspace “%s”."
msgstr "Povezano z delovnim prostorom „%s“."

#. translators: 1: imports today, 2: imports a day the plan allows
#: showbits/includes/class-settings-page.php
msgid "Imports today: %1$d of %2$d."
msgstr "Današnji uvozi: %1$d od %2$d."

#. translators: 1: a person, 2: a date, 3: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "Connected by %1$s on %2$s, at %3$s."
msgstr "Povezavo z naslovom %3$s je vzpostavil uporabnik %1$s, %2$s."

#: showbits/includes/class-settings-page.php
msgid "Connect again"
msgstr "Ponovna povezava"

#: showbits/includes/class-settings-page.php
msgid "With a new site key the site renews its connection, or moves to another workspace."
msgstr "Nov ključ spletišča obnovi povezavo ali spletišče preseli v drug delovni prostor."

#. translators: %s: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "ShowBits (%s) cannot be reached right now. The connection stays; try again later."
msgstr "ShowBits (%s) trenutno ni dosegljiv. Povezava ostane; poskusite znova pozneje."

#: showbits/includes/class-settings-page.php
msgid "ShowBits no longer accepts this site’s connection: it was disconnected in ShowBits, the plan ended, or this site’s keys changed. Connect it again with a new site key."
msgstr "ShowBits ne sprejema več povezave tega spletišča: povezava je bila prekinjena v ShowBitsu, paket je potekel ali pa so se ključi tega spletišča spremenili. Ponovno ga povežite z novim ključem spletišča."

#: showbits/includes/class-settings-page.php
msgid "Connect this site to a ShowBits workspace: an admin or owner of the workspace makes a site key for this site in ShowBits (Integrations → WordPress). The site can then take released clips and quote cards into its media library, and receive what your ShowBits admins send."
msgstr "Povežite to spletišče z delovnim prostorom v ShowBitsu: administrator ali lastnik delovnega prostora v ShowBitsu ustvari ključ spletišča za to spletišče (Integrations → WordPress). Spletišče lahko nato prevzema odobrene izrezke in slike s citati v svojo medijsko knjižnico ter prejema, kar pošiljajo vaši administratorji v ShowBitsu."

#: showbits/includes/class-settings-page.php
msgid "Imports"
msgstr "Uvozi"

#: showbits/includes/class-settings-page.php
msgid "Format of quote cards"
msgstr "Format slik s citati"

#: showbits/includes/class-settings-page.php
msgid "4:5 (feeds, articles)"
msgstr "4:5 (viri novic, članki)"

#: showbits/includes/class-settings-page.php
msgid "1:1 (square)"
msgstr "1:1 (kvadrat)"

#: showbits/includes/class-settings-page.php
msgid "9:16 (stories)"
msgstr "9:16 (zgodbe)"

#: showbits/includes/class-settings-page.php
msgid "The picture pushes bring; in the library you choose for each card."
msgstr "Format, ki ga imajo poslane slike; v knjižnici ga izberete za vsako sliko posebej."

#: showbits/includes/class-settings-page.php
msgid "Videos"
msgstr "Videoposnetki"

#: showbits/includes/class-settings-page.php
msgid "Import the thumbnail as the video’s poster image"
msgstr "Uvozi predogledno sličico kot naslovno sliko videoposnetka"

#: showbits/includes/class-settings-page.php
msgid "Save"
msgstr "Shrani"

#: showbits/includes/class-settings-page.php
msgid "Site key"
msgstr "Ključ spletišča"

#. translators: %s: this site's address
#: showbits/includes/class-settings-page.php
msgid "Made in ShowBits for %s, valid for 24 hours and only once. ShowBits then checks that it is talking to this site."
msgstr "Ustvarjen v ShowBitsu za %s; velja 24 ur in ga je mogoče uporabiti le enkrat. ShowBits nato preveri, ali komunicira prav s tem spletiščem."

#: showbits/includes/class-settings-page.php
msgid "Connect"
msgstr "Poveži"

#: showbits/includes/class-settings-page.php
msgid "Are you an admin or owner of the workspace yourself? Then sign in to ShowBits and agree there, without a site key:"
msgstr "Ste sami administrator ali lastnik delovnega prostora? Potem se prijavite v ShowBits in tam podajte soglasje, brez ključa spletišča:"

#: showbits/includes/class-settings-page.php
msgid "Connect through ShowBits"
msgstr "Poveži prek ShowBitsa"

#: showbits/includes/class-settings-page.php
msgid "ShowBits address"
msgstr "Naslov ShowBitsa"

#: showbits/includes/class-settings-page.php
msgid "ShowBits Cloud: https://app.showbits.ai. OnPremise: the address of your installation."
msgstr "ShowBits Cloud: https://app.showbits.ai. OnPremise: naslov vaše namestitve."

#: showbits/includes/class-settings-page.php
msgid "Disconnect"
msgstr "Prekini povezavo"

#: showbits/includes/class-settings-page.php
msgid "Disconnect this site from ShowBits? What is in the media library stays."
msgstr "Želite prekiniti povezavo tega spletišča s ShowBitsom? Kar je v medijski knjižnici, ostane."

#: showbits/includes/class-settings-page.php
msgid "asked for"
msgstr "Zahtevano"

#: showbits/includes/class-settings-page.php
msgid "waiting"
msgstr "Čaka"

#: showbits/includes/class-settings-page.php
msgid "importing"
msgstr "Uvaža se"

#: showbits/includes/class-settings-page.php
msgid "imported"
msgstr "Uvoženo"

#: showbits/includes/class-settings-page.php
msgid "failed"
msgstr "Neuspešno"

#: showbits/includes/class-settings-page.php
msgid "Recent imports"
msgstr "Nedavni uvozi"

#: showbits/includes/class-settings-page.php
msgid "When"
msgstr "Datum"

#: showbits/includes/class-settings-page.php
msgid "Clip"
msgstr "Izrezek"

#: showbits/includes/class-settings-page.php
msgid "How"
msgstr "Način"

#: showbits/includes/class-settings-page.php
msgid "State"
msgstr "Stanje"

#: showbits/includes/class-settings-page.php
msgid "sent from ShowBits"
msgstr "Poslano iz ShowBitsa"

#: showbits/includes/class-settings-page.php
msgid "picked here"
msgstr "Izbrano tukaj"

#: showbits/includes/class-settings-page.php
msgid "Connected. The library is under Media → ShowBits."
msgstr "Povezano. Knjižnica je v meniju Mediji → ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Disconnected. What is in the media library stays."
msgstr "Povezava je prekinjena. Kar je v medijski knjižnici, ostane."

#: showbits/includes/class-settings-page.php
msgid "Saved."
msgstr "Shranjeno."

#: showbits/includes/class-settings-page.php
msgid "Connecting was cancelled in ShowBits."
msgstr "Povezovanje je bilo preklicano v ShowBitsu."

#: showbits/includes/class-settings-page.php
msgid "That way back from ShowBits did not belong to this attempt. Start again."
msgstr "Ta povratek iz ShowBitsa ne pripada temu poskusu povezovanja. Začnite znova."

#: showbits/includes/class-settings-page.php
msgid "The ShowBits address must start with https://."
msgstr "Naslov ShowBitsa se mora začeti s https://."

#: showbits/includes/class-settings-page.php
msgid "That is not a site key. Copy it from ShowBits (Integrations → WordPress) again."
msgstr "To ni ključ spletišča. Ponovno ga kopirajte iz ShowBitsa (Integrations → WordPress)."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not take the site key: it is unknown, used, withdrawn or expired (a site key lasts 24 hours, a consent ten minutes). Make a new one."
msgstr "ShowBits ni sprejel ključa spletišča: je neznan, že uporabljen, preklican ali potekel (ključ spletišča velja 24 ur, soglasje deset minut). Ustvarite novega."

#: showbits/includes/class-settings-page.php
msgid "The site key was made for another address. Make one for this site’s address."
msgstr "Ključ spletišča je bil ustvarjen za drug naslov. Ustvarite ključ za naslov tega spletišča."

#: showbits/includes/class-settings-page.php
msgid "ShowBits could not reach this site at its REST API (/wp-json/showbits/v1/push), or ShowBits itself could not be reached. The site must be public over HTTPS; a firewall or security plugin must let ShowBits in."
msgstr "ShowBits ni mogel doseči tega spletišča prek njegovega vmesnika REST API (/wp-json/showbits/v1/push) ali pa sam ShowBits ni bil dosegljiv. Spletišče mora biti javno dostopno prek protokola HTTPS; požarni zid ali varnostni vtičnik mora prepustiti ShowBits."

#: showbits/includes/class-settings-page.php
msgid "This site did not answer ShowBits’ check as expected. Try again; if it fails again, a cache or security plugin may answer for WordPress."
msgstr "To spletišče se na preverjanje ShowBitsa ni odzvalo, kot je bilo pričakovano. Poskusite znova; če spet ne uspe, morda namesto WordPressa odgovarja vtičnik za predpomnjenje ali varnostni vtičnik."

#: showbits/includes/class-settings-page.php
msgid "The workspace’s plan has ended, or whoever made the site key may no longer connect sites."
msgstr "Paket delovnega prostora je potekel ali pa tisti, ki je ustvaril ključ spletišča, ne sme več povezovati spletišč."

#: showbits/includes/class-settings-page.php
msgid "The workspace has as many sites as its plan allows."
msgstr "Delovni prostor ima že toliko spletišč, kot jih dovoljuje njegov paket."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not accept this site’s address. It must be served over HTTPS."
msgstr "ShowBits ni sprejel naslova tega spletišča. Spletišče mora delovati prek protokola HTTPS."

#: showbits/includes/class-settings-page.php
msgid "Connecting did not work. Try again, or ask your ShowBits contact."
msgstr "Povezovanje ni uspelo. Poskusite znova ali se obrnite na svojo kontaktno osebo v ShowBitsu."
