# French (France) translation of the ShowBits plugin.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: fr_FR\n"
"Plural-Forms: nplurals=2; plural=n > 1;\n"

#. Description of the plugin
#: showbits/showbits.php
msgid "Released clips and quote cards from ShowBits in the media library: pick them in WordPress, or receive what your ShowBits admins send."
msgstr "Clips et cartes citations validés de ShowBits dans la médiathèque : choisissez-les dans WordPress ou recevez ce qu’envoient vos admins ShowBits."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer as expected."
msgstr "ShowBits n’a pas répondu comme prévu."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer with a file."
msgstr "ShowBits n’a renvoyé aucun fichier."

#: showbits/includes/class-api-client.php showbits/includes/class-importer.php
msgid "ShowBits could not be reached."
msgstr "Impossible de joindre ShowBits."

#. translators: 1: ShowBits' reason, 2: the HTTP status
#: showbits/includes/class-api-client.php
msgid "ShowBits refused (%1$s, HTTP %2$d)."
msgstr "ShowBits a refusé la demande (%1$s, HTTP %2$d)."

#: showbits/includes/class-connection.php
msgid "You may not connect this site."
msgstr "Vous n’avez pas l’autorisation de connecter ce site."

#. translators: %s: the clip's title
#: showbits/includes/class-importer.php
msgid "%s (thumbnail)"
msgstr "%s (miniature)"

#. translators: %s: a quote (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%s”"
msgstr "« %s »"

#. translators: 1: a quote, 2: who said it (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%1$s” – %2$s"
msgstr "« %1$s » – %2$s"

#: showbits/includes/class-importer.php
msgid "This is not a clip or a format ShowBits offers."
msgstr "Ceci n’est ni un clip ni un format proposé par ShowBits."

#: showbits/includes/class-importer.php
msgid "The clip is no longer released in ShowBits."
msgstr "Le clip n’est plus validé dans ShowBits."

#: showbits/includes/class-importer.php
msgid "The embargo still holds: the file stays in ShowBits until it ends."
msgstr "L’embargo est toujours en vigueur : le fichier reste dans ShowBits jusqu’à sa levée."

#: showbits/includes/class-importer.php
msgid "The file is not ready yet in ShowBits."
msgstr "Le fichier n’est pas encore prêt dans ShowBits."

#: showbits/includes/class-importer.php
msgid "The file could not be downloaded."
msgstr "Le fichier n’a pas pu être téléchargé."

#: showbits/includes/class-importer.php
msgid "WordPress did not take the file into the media library."
msgstr "WordPress a refusé d’ajouter le fichier à la médiathèque."

#: showbits/includes/class-importer.php
msgid "The delivery from ShowBits is no longer valid. Import the clip again."
msgstr "L’envoi de ShowBits n’est plus valide. Importez à nouveau le clip."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer accepts this site’s connection: connect it again under Settings → ShowBits."
msgstr "ShowBits n’accepte plus la connexion de ce site : reconnectez-le dans Réglages → ShowBits."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer delivers to this site: the workspace’s plan has ended."
msgstr "ShowBits n’envoie plus rien à ce site : l’abonnement de l’espace de travail a pris fin."

#: showbits/includes/class-importer.php
msgid "The site’s imports for today are used up. Try again tomorrow."
msgstr "Le quota d’importations de ce site est épuisé pour aujourd’hui. Réessayez demain."

#: showbits/includes/class-importer.php
msgid "The import was interrupted."
msgstr "L’importation a été interrompue."

#: showbits/includes/class-importer.php
msgid "The import failed."
msgstr "L’importation a échoué."

#: showbits/includes/class-library-endpoint.php
msgid "This site is not connected to ShowBits."
msgstr "Ce site n’est pas connecté à ShowBits."

#: showbits/includes/class-library-page.php
msgid "All"
msgstr "Tous"

#: showbits/includes/class-library-page.php
msgid "Clips"
msgstr "Clips"

#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Quote cards"
msgstr "Cartes citations"

#: showbits/includes/class-library-page.php
msgid "Search titles"
msgstr "Rechercher dans les titres"

#: showbits/includes/class-library-page.php
msgid "Search the library"
msgstr "Rechercher dans la bibliothèque"

#: showbits/includes/class-library-page.php
msgid "Import selected"
msgstr "Importer la sélection"

#. translators: 1: which one, 2: how many in all
#: showbits/includes/class-library-page.php
msgid "Asking ShowBits for %1$d of %2$d …"
msgstr "Demande à ShowBits : %1$d sur %2$d…"

#. translators: %d: how many clips are still on their way
#: showbits/includes/class-library-page.php
msgid "On the way from ShowBits: %d …"
msgstr "En route depuis ShowBits : %d…"

#. translators: %d: how many clips were imported
#: showbits/includes/class-library-page.php
msgid "Imported: %d"
msgstr "Importés : %d"

#: showbits/includes/class-library-page.php
msgid "Not everything has arrived yet; it continues in the background. Settings → ShowBits lists the imports."
msgstr "Tout n’est pas encore arrivé ; l’importation se poursuit en arrière-plan. La liste des importations se trouve dans Réglages → ShowBits."

#: showbits/includes/class-library-page.php
msgid "On the way"
msgstr "En route"

#: showbits/includes/class-library-page.php
msgid "Load more"
msgstr "Charger plus"

#: showbits/includes/class-library-page.php
msgid "Loading …"
msgstr "Chargement…"

#: showbits/includes/class-library-page.php
msgid "No released clips or quote cards yet."
msgstr "Pas encore de clips ni de cartes citations validés."

#. translators: %s: date and time the embargo ends
#: showbits/includes/class-library-page.php
msgid "Embargo until %s"
msgstr "Embargo jusqu’au %s"

#: showbits/includes/class-library-page.php
msgid "Not ready yet"
msgstr "Pas encore prêt"

#: showbits/includes/class-library-page.php
msgid "In the media library"
msgstr "Dans la médiathèque"

#: showbits/includes/class-library-page.php
msgid "An older version is in the media library"
msgstr "Une version antérieure est dans la médiathèque"

#: showbits/includes/class-library-page.php
msgid "Edit"
msgstr "Modifier"

#: showbits/includes/class-library-page.php
msgid "Format"
msgstr "Format"

#: showbits/includes/class-library-page.php
msgid "Video"
msgstr "Vidéo"

#: showbits/includes/class-library-page.php
msgid "Quote card"
msgstr "Carte citation"

#: showbits/includes/class-library-page.php
msgid "Meme"
msgstr "Mème"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "Failed: %s"
msgstr "Échec : %s"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "The library could not be loaded: %s"
msgstr "Impossible de charger la bibliothèque : %s"

#: showbits/includes/class-library-page.php
msgid "This site is not connected to ShowBits yet."
msgstr "Ce site n’est pas encore connecté à ShowBits."

#: showbits/includes/class-library-page.php
msgid "Connect it in the settings."
msgstr "Connectez-le dans les réglages."

#: showbits/includes/class-library-page.php
msgid "An administrator of this site connects it in the settings."
msgstr "C’est à un administrateur de ce site de le connecter dans les réglages."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-library-page.php
msgid "Released clips and quote cards from the ShowBits workspace “%s”. What you import lands in the media library, ready for posts and pages."
msgstr "Clips et cartes citations validés de l’espace de travail ShowBits « %s ». Ce que vous importez arrive dans la médiathèque, prêt pour vos articles et vos pages."

#: showbits/includes/class-library-page.php
msgid "The library needs JavaScript."
msgstr "La bibliothèque nécessite JavaScript."

#: showbits/includes/class-settings-page.php
msgid "Settings"
msgstr "Réglages"

#: showbits/includes/class-settings-page.php
msgid "You may not change these settings."
msgstr "Vous n’avez pas l’autorisation de modifier ces réglages."

#: showbits/includes/class-settings-page.php
msgid "Connection"
msgstr "Connexion"

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-settings-page.php
msgid "Connected to the workspace “%s”."
msgstr "Connecté à l’espace de travail « %s »."

#. translators: 1: imports today, 2: imports a day the plan allows
#: showbits/includes/class-settings-page.php
msgid "Imports today: %1$d of %2$d."
msgstr "Importations du jour : %1$d sur %2$d."

#. translators: 1: a person, 2: a date, 3: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "Connected by %1$s on %2$s, at %3$s."
msgstr "Connecté par %1$s le %2$s, à l’adresse %3$s."

#: showbits/includes/class-settings-page.php
msgid "Connect again"
msgstr "Reconnecter"

#: showbits/includes/class-settings-page.php
msgid "With a new site key the site renews its connection, or moves to another workspace."
msgstr "Avec une nouvelle clé de site, le site renouvelle sa connexion ou passe à un autre espace de travail."

#. translators: %s: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "ShowBits (%s) cannot be reached right now. The connection stays; try again later."
msgstr "ShowBits (%s) est injoignable pour le moment. La connexion est conservée ; réessayez plus tard."

#: showbits/includes/class-settings-page.php
msgid "ShowBits no longer accepts this site’s connection: it was disconnected in ShowBits, the plan ended, or this site’s keys changed. Connect it again with a new site key."
msgstr "ShowBits n’accepte plus la connexion de ce site : il a été déconnecté dans ShowBits, l’abonnement a pris fin ou les clés de ce site ont changé. Reconnectez-le avec une nouvelle clé de site."

#: showbits/includes/class-settings-page.php
msgid "Connect this site to a ShowBits workspace: an admin or owner of the workspace makes a site key for this site in ShowBits (Integrations → WordPress). The site can then take released clips and quote cards into its media library, and receive what your ShowBits admins send."
msgstr "Connectez ce site à un espace de travail ShowBits : un admin ou un propriétaire de l’espace de travail crée une clé de site pour ce site dans ShowBits (Integrations → WordPress). Le site peut ensuite ajouter à sa médiathèque les clips et cartes citations validés, et recevoir ce qu’envoient vos admins ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Imports"
msgstr "Importations"

#: showbits/includes/class-settings-page.php
msgid "Format of quote cards"
msgstr "Format des cartes citations"

#: showbits/includes/class-settings-page.php
msgid "4:5 (feeds, articles)"
msgstr "4:5 (fils d’actualité, articles)"

#: showbits/includes/class-settings-page.php
msgid "1:1 (square)"
msgstr "1:1 (carré)"

#: showbits/includes/class-settings-page.php
msgid "9:16 (stories)"
msgstr "9:16 (stories)"

#: showbits/includes/class-settings-page.php
msgid "The picture pushes bring; in the library you choose for each card."
msgstr "Format des cartes envoyées à ce site ; dans la bibliothèque, vous le choisissez pour chaque carte."

#: showbits/includes/class-settings-page.php
msgid "Videos"
msgstr "Vidéos"

#: showbits/includes/class-settings-page.php
msgid "Import the thumbnail as the video’s poster image"
msgstr "Importer la miniature comme image d’affiche de la vidéo"

#: showbits/includes/class-settings-page.php
msgid "Save"
msgstr "Enregistrer"

#: showbits/includes/class-settings-page.php
msgid "Site key"
msgstr "Clé de site"

#. translators: %s: this site's address
#: showbits/includes/class-settings-page.php
msgid "Made in ShowBits for %s, valid for 24 hours and only once. ShowBits then checks that it is talking to this site."
msgstr "Créée dans ShowBits pour %s, valable 24 heures et une seule fois. ShowBits vérifie ensuite qu’il communique bien avec ce site."

#: showbits/includes/class-settings-page.php
msgid "Connect"
msgstr "Connecter"

#: showbits/includes/class-settings-page.php
msgid "Are you an admin or owner of the workspace yourself? Then sign in to ShowBits and agree there, without a site key:"
msgstr "Vous êtes vous-même admin ou propriétaire de l’espace de travail ? Connectez-vous alors à ShowBits et donnez-y votre accord, sans clé de site :"

#: showbits/includes/class-settings-page.php
msgid "Connect through ShowBits"
msgstr "Connecter via ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits address"
msgstr "Adresse de ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits Cloud: https://app.showbits.ai. OnPremise: the address of your installation."
msgstr "ShowBits Cloud : https://app.showbits.ai. OnPremise : l’adresse de votre installation."

#: showbits/includes/class-settings-page.php
msgid "Disconnect"
msgstr "Déconnecter"

#: showbits/includes/class-settings-page.php
msgid "Disconnect this site from ShowBits? What is in the media library stays."
msgstr "Déconnecter ce site de ShowBits ? Ce qui se trouve dans la médiathèque y reste."

#: showbits/includes/class-settings-page.php
msgid "asked for"
msgstr "Demandé"

#: showbits/includes/class-settings-page.php
msgid "waiting"
msgstr "En attente"

#: showbits/includes/class-settings-page.php
msgid "importing"
msgstr "Importation en cours"

#: showbits/includes/class-settings-page.php
msgid "imported"
msgstr "Importé"

#: showbits/includes/class-settings-page.php
msgid "failed"
msgstr "Échec"

#: showbits/includes/class-settings-page.php
msgid "Recent imports"
msgstr "Importations récentes"

#: showbits/includes/class-settings-page.php
msgid "When"
msgstr "Date"

#: showbits/includes/class-settings-page.php
msgid "Clip"
msgstr "Clip"

#: showbits/includes/class-settings-page.php
msgid "How"
msgstr "Origine"

#: showbits/includes/class-settings-page.php
msgid "State"
msgstr "État"

#: showbits/includes/class-settings-page.php
msgid "sent from ShowBits"
msgstr "Envoyé depuis ShowBits"

#: showbits/includes/class-settings-page.php
msgid "picked here"
msgstr "Choisi ici"

#: showbits/includes/class-settings-page.php
msgid "Connected. The library is under Media → ShowBits."
msgstr "Connecté. La bibliothèque se trouve dans Médias → ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Disconnected. What is in the media library stays."
msgstr "Déconnecté. Ce qui se trouve dans la médiathèque y reste."

#: showbits/includes/class-settings-page.php
msgid "Saved."
msgstr "Réglages enregistrés."

#: showbits/includes/class-settings-page.php
msgid "Connecting was cancelled in ShowBits."
msgstr "La connexion a été annulée dans ShowBits."

#: showbits/includes/class-settings-page.php
msgid "That way back from ShowBits did not belong to this attempt. Start again."
msgstr "Ce retour depuis ShowBits ne correspond pas à la tentative de connexion de ce site. Recommencez."

#: showbits/includes/class-settings-page.php
msgid "The ShowBits address must start with https://."
msgstr "L’adresse de ShowBits doit commencer par https://."

#: showbits/includes/class-settings-page.php
msgid "That is not a site key. Copy it from ShowBits (Integrations → WordPress) again."
msgstr "Ce n’est pas une clé de site. Copiez-la à nouveau depuis ShowBits (Integrations → WordPress)."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not take the site key: it is unknown, used, withdrawn or expired (a site key lasts 24 hours, a consent ten minutes). Make a new one."
msgstr "ShowBits n’a pas accepté la clé de site : elle est inconnue, déjà utilisée, révoquée ou expirée (une clé de site est valable 24 heures, un consentement dix minutes). Créez-en une nouvelle."

#: showbits/includes/class-settings-page.php
msgid "The site key was made for another address. Make one for this site’s address."
msgstr "La clé de site a été créée pour une autre adresse. Créez-en une pour l’adresse de ce site."

#: showbits/includes/class-settings-page.php
msgid "ShowBits could not reach this site at its REST API (/wp-json/showbits/v1/push), or ShowBits itself could not be reached. The site must be public over HTTPS; a firewall or security plugin must let ShowBits in."
msgstr "ShowBits n’a pas pu joindre ce site via son API REST (/wp-json/showbits/v1/push), ou ShowBits lui-même était injoignable. Le site doit être accessible publiquement en HTTPS ; un pare-feu ou une extension de sécurité doit laisser passer ShowBits."

#: showbits/includes/class-settings-page.php
msgid "This site did not answer ShowBits’ check as expected. Try again; if it fails again, a cache or security plugin may answer for WordPress."
msgstr "Ce site n’a pas répondu comme prévu à la vérification de ShowBits. Réessayez ; en cas de nouvel échec, une extension de cache ou de sécurité répond peut-être à la place de WordPress."

#: showbits/includes/class-settings-page.php
msgid "The workspace’s plan has ended, or whoever made the site key may no longer connect sites."
msgstr "L’abonnement de l’espace de travail a pris fin, ou la personne qui a créé la clé de site n’a plus le droit de connecter des sites."

#: showbits/includes/class-settings-page.php
msgid "The workspace has as many sites as its plan allows."
msgstr "L’espace de travail a déjà autant de sites que son abonnement le permet."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not accept this site’s address. It must be served over HTTPS."
msgstr "ShowBits n’a pas accepté l’adresse de ce site. Le site doit être servi en HTTPS."

#: showbits/includes/class-settings-page.php
msgid "Connecting did not work. Try again, or ask your ShowBits contact."
msgstr "La connexion a échoué. Réessayez ou contactez votre interlocuteur ShowBits."
