# Slovak translation of the ShowBits plugin.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: sk_SK\n"
"Plural-Forms: nplurals=3; plural=(n == 1) ? 0 : ((n >= 2 && n <= 4) ? 1 : 2);\n"

#. Description of the plugin
#: showbits/showbits.php
msgid "Released clips and quote cards from ShowBits in the media library: pick them in WordPress, or receive what your ShowBits admins send."
msgstr "Schválené klipy a obrázky s citátmi zo ShowBits priamo v knižnici médií: vyberajte ich vo WordPresse alebo prijímajte to, čo posielajú vaši administrátori ShowBits."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer as expected."
msgstr "ShowBits vrátil neočakávanú odpoveď."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer with a file."
msgstr "ShowBits nevrátil súbor."

#: showbits/includes/class-api-client.php showbits/includes/class-importer.php
msgid "ShowBits could not be reached."
msgstr "ShowBits je nedostupný."

#. translators: 1: ShowBits' reason, 2: the HTTP status
#: showbits/includes/class-api-client.php
msgid "ShowBits refused (%1$s, HTTP %2$d)."
msgstr "ShowBits odmietol požiadavku (%1$s, HTTP %2$d)."

#: showbits/includes/class-connection.php
msgid "You may not connect this site."
msgstr "Nemáte oprávnenie pripojiť tento web."

#. translators: %s: the clip's title
#: showbits/includes/class-importer.php
msgid "%s (thumbnail)"
msgstr "%s (miniatúra)"

#. translators: %s: a quote (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%s”"
msgstr "„%s“"

#. translators: 1: a quote, 2: who said it (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%1$s” – %2$s"
msgstr "„%1$s“ – %2$s"

#: showbits/includes/class-importer.php
msgid "This is not a clip or a format ShowBits offers."
msgstr "Nejde o klip ani o formát, ktorý ShowBits ponúka."

#: showbits/includes/class-importer.php
msgid "The clip is no longer released in ShowBits."
msgstr "Klip už nie je v ShowBits schválený."

#: showbits/includes/class-importer.php
msgid "The embargo still holds: the file stays in ShowBits until it ends."
msgstr "Embargo stále platí: až do jeho skončenia zostáva súbor v ShowBits."

#: showbits/includes/class-importer.php
msgid "The file is not ready yet in ShowBits."
msgstr "Súbor ešte nie je v ShowBits pripravený."

#: showbits/includes/class-importer.php
msgid "The file could not be downloaded."
msgstr "Súbor sa nepodarilo stiahnuť."

#: showbits/includes/class-importer.php
msgid "WordPress did not take the file into the media library."
msgstr "WordPress neprevzal súbor do knižnice médií."

#: showbits/includes/class-importer.php
msgid "The delivery from ShowBits is no longer valid. Import the clip again."
msgstr "Zásielka zo ShowBits už nie je platná. Importujte klip znova."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer accepts this site’s connection: connect it again under Settings → ShowBits."
msgstr "ShowBits už neprijíma pripojenie tohto webu: pripojte ho znova v časti Nastavenia → ShowBits."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer delivers to this site: the workspace’s plan has ended."
msgstr "ShowBits už tomuto webu nič nedoručuje: plán pracovného priestoru sa skončil."

#: showbits/includes/class-importer.php
msgid "The site’s imports for today are used up. Try again tomorrow."
msgstr "Dnešný limit importov tohto webu je vyčerpaný. Skúste to znova zajtra."

#: showbits/includes/class-importer.php
msgid "The import was interrupted."
msgstr "Import bol prerušený."

#: showbits/includes/class-importer.php
msgid "The import failed."
msgstr "Import zlyhal."

#: showbits/includes/class-library-endpoint.php
msgid "This site is not connected to ShowBits."
msgstr "Tento web nie je pripojený k ShowBits."

#: showbits/includes/class-library-page.php
msgid "All"
msgstr "Všetko"

#: showbits/includes/class-library-page.php
msgid "Clips"
msgstr "Klipy"

#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Quote cards"
msgstr "Obrázky s citátmi"

#: showbits/includes/class-library-page.php
msgid "Search titles"
msgstr "Hľadať v názvoch"

#: showbits/includes/class-library-page.php
msgid "Search the library"
msgstr "Prehľadať knižnicu"

#: showbits/includes/class-library-page.php
msgid "Import selected"
msgstr "Importovať vybrané"

#. translators: 1: which one, 2: how many in all
#: showbits/includes/class-library-page.php
msgid "Asking ShowBits for %1$d of %2$d …"
msgstr "Odosielanie požiadavky do ShowBits: %1$d z %2$d…"

#. translators: %d: how many clips are still on their way
#: showbits/includes/class-library-page.php
msgid "On the way from ShowBits: %d …"
msgstr "Na ceste zo ShowBits: %d…"

#. translators: %d: how many clips were imported
#: showbits/includes/class-library-page.php
msgid "Imported: %d"
msgstr "Importované: %d"

#: showbits/includes/class-library-page.php
msgid "Not everything has arrived yet; it continues in the background. Settings → ShowBits lists the imports."
msgstr "Ešte nedorazilo všetko; import pokračuje na pozadí. Prehľad importov nájdete v časti Nastavenia → ShowBits."

#: showbits/includes/class-library-page.php
msgid "On the way"
msgstr "Na ceste"

#: showbits/includes/class-library-page.php
msgid "Load more"
msgstr "Načítať ďalšie"

#: showbits/includes/class-library-page.php
msgid "Loading …"
msgstr "Načítava sa…"

#: showbits/includes/class-library-page.php
msgid "No released clips or quote cards yet."
msgstr "Zatiaľ žiadne schválené klipy ani obrázky s citátmi."

#. translators: %s: date and time the embargo ends
#: showbits/includes/class-library-page.php
msgid "Embargo until %s"
msgstr "Embargo do %s"

#: showbits/includes/class-library-page.php
msgid "Not ready yet"
msgstr "Ešte nie je pripravené"

#: showbits/includes/class-library-page.php
msgid "In the media library"
msgstr "V knižnici médií"

#: showbits/includes/class-library-page.php
msgid "An older version is in the media library"
msgstr "V knižnici médií je staršia verzia"

#: showbits/includes/class-library-page.php
msgid "Edit"
msgstr "Upraviť"

#: showbits/includes/class-library-page.php
msgid "Format"
msgstr "Formát"

#: showbits/includes/class-library-page.php
msgid "Video"
msgstr "Video"

#: showbits/includes/class-library-page.php
msgid "Quote card"
msgstr "Obrázok s citátom"

#: showbits/includes/class-library-page.php
msgid "Meme"
msgstr "Mém"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "Failed: %s"
msgstr "Zlyhalo: %s"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "The library could not be loaded: %s"
msgstr "Knižnicu sa nepodarilo načítať: %s"

#: showbits/includes/class-library-page.php
msgid "This site is not connected to ShowBits yet."
msgstr "Tento web ešte nie je pripojený k ShowBits."

#: showbits/includes/class-library-page.php
msgid "Connect it in the settings."
msgstr "Pripojte ho v nastaveniach."

#: showbits/includes/class-library-page.php
msgid "An administrator of this site connects it in the settings."
msgstr "Pripojiť ho môže administrátor tohto webu v nastaveniach."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-library-page.php
msgid "Released clips and quote cards from the ShowBits workspace “%s”. What you import lands in the media library, ready for posts and pages."
msgstr "Schválené klipy a obrázky s citátmi z pracovného priestoru ShowBits „%s“. Čo naimportujete, nájdete v knižnici médií, pripravené pre články a stránky."

#: showbits/includes/class-library-page.php
msgid "The library needs JavaScript."
msgstr "Knižnica vyžaduje JavaScript."

#: showbits/includes/class-settings-page.php
msgid "Settings"
msgstr "Nastavenia"

#: showbits/includes/class-settings-page.php
msgid "You may not change these settings."
msgstr "Nemáte oprávnenie meniť tieto nastavenia."

#: showbits/includes/class-settings-page.php
msgid "Connection"
msgstr "Pripojenie"

#. translators: 1: the constant SHOWBITS_ENCRYPTION_KEY, 2: the file wp-config.php (both stay as they are)
#: showbits/includes/class-settings-page.php
msgid "Your site’s security keys are not in %2$s, so the key that protects the connection to ShowBits is stored in the database. Add %1$s with a long random value to %2$s; if the site is connected already, connect it again afterwards."
msgstr "Bezpečnostné kľúče vášho webu nie sú v %2$s, preto je kľúč, ktorý chráni pripojenie k ShowBits, uložený v databáze. Pridajte do %2$s %1$s s dlhou náhodnou hodnotou; ak je web už pripojený, potom ho pripojte znova."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-settings-page.php
msgid "Connected to the workspace “%s”."
msgstr "Pripojené k pracovnému priestoru „%s“."

#. translators: 1: imports today, 2: imports a day the plan allows
#: showbits/includes/class-settings-page.php
msgid "Imports today: %1$d of %2$d."
msgstr "Dnešné importy: %1$d z %2$d."

#. translators: 1: a person, 2: a date, 3: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "Connected by %1$s on %2$s, at %3$s."
msgstr "Pripojené používateľom %1$s dňa %2$s k %3$s."

#: showbits/includes/class-settings-page.php
msgid "Connect again"
msgstr "Opätovné pripojenie"

#: showbits/includes/class-settings-page.php
msgid "With a new site key the site renews its connection, or moves to another workspace."
msgstr "Novým kľúčom webu obnovíte pripojenie alebo web presuniete do iného pracovného priestoru."

#. translators: %s: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "ShowBits (%s) cannot be reached right now. The connection stays; try again later."
msgstr "ShowBits (%s) je momentálne nedostupný. Pripojenie zostáva zachované; skúste to neskôr."

#: showbits/includes/class-settings-page.php
msgid "ShowBits no longer accepts this site’s connection: it was disconnected in ShowBits, the plan ended, or this site’s keys changed. Connect it again with a new site key."
msgstr "ShowBits už neprijíma pripojenie tohto webu: bolo odpojené v ShowBits, plán sa skončil alebo sa zmenili kľúče tohto webu. Pripojte web znova pomocou nového kľúča webu."

#: showbits/includes/class-settings-page.php
msgid "Connect this site to a ShowBits workspace: an admin or owner of the workspace makes a site key for this site in ShowBits (Integrations → WordPress). The site can then take released clips and quote cards into its media library, and receive what your ShowBits admins send."
msgstr "Pripojte tento web k pracovnému priestoru ShowBits: administrátor alebo vlastník pracovného priestoru vytvorí v ShowBits kľúč webu pre tento web (Integrations → WordPress). Web potom môže preberať schválené klipy a obrázky s citátmi do svojej knižnice médií a prijímať to, čo posielajú vaši administrátori ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Imports"
msgstr "Importy"

#: showbits/includes/class-settings-page.php
msgid "Format of quote cards"
msgstr "Formát obrázkov s citátmi"

#: showbits/includes/class-settings-page.php
msgid "4:5 (feeds, articles)"
msgstr "4:5 (feedy, články)"

#: showbits/includes/class-settings-page.php
msgid "1:1 (square)"
msgstr "1:1 (štvorec)"

#: showbits/includes/class-settings-page.php
msgid "9:16 (stories)"
msgstr "9:16 (príbehy)"

#: showbits/includes/class-settings-page.php
msgid "The picture pushes bring; in the library you choose for each card."
msgstr "Formát obrázkov odoslaných na web; v knižnici ho vyberáte pri každom obrázku zvlášť."

#: showbits/includes/class-settings-page.php
msgid "Videos"
msgstr "Videá"

#: showbits/includes/class-settings-page.php
msgid "Import the thumbnail as the video’s poster image"
msgstr "Importovať miniatúru ako plagátový obrázok videa"

#: showbits/includes/class-settings-page.php
msgid "Save"
msgstr "Uložiť"

#: showbits/includes/class-settings-page.php
msgid "Site key"
msgstr "Kľúč webu"

#. translators: %s: this site's address
#: showbits/includes/class-settings-page.php
msgid "Made in ShowBits for %s, valid for 24 hours and only once. ShowBits then checks that it is talking to this site."
msgstr "Vytvára sa v ShowBits pre %s; platí 24 hodín a dá sa použiť len raz. ShowBits potom overí, že komunikuje práve s týmto webom."

#: showbits/includes/class-settings-page.php
msgid "Connect"
msgstr "Pripojiť"

#: showbits/includes/class-settings-page.php
msgid "Are you an admin or owner of the workspace yourself? Then sign in to ShowBits and agree there, without a site key:"
msgstr "Ste sami administrátorom alebo vlastníkom pracovného priestoru? Potom sa prihláste do ShowBits a udeľte tam súhlas, bez kľúča webu:"

#: showbits/includes/class-settings-page.php
msgid "Connect through ShowBits"
msgstr "Pripojiť cez ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits address"
msgstr "Adresa ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits Cloud: https://app.showbits.ai. OnPremise: the address of your installation."
msgstr "ShowBits Cloud: https://app.showbits.ai. OnPremise: adresa vašej inštalácie."

#: showbits/includes/class-settings-page.php
msgid "Disconnect"
msgstr "Odpojiť"

#: showbits/includes/class-settings-page.php
msgid "Disconnect this site from ShowBits? What is in the media library stays."
msgstr "Odpojiť tento web od ShowBits? Čo je v knižnici médií, zostane."

#: showbits/includes/class-settings-page.php
msgid "asked for"
msgstr "Vyžiadané"

#: showbits/includes/class-settings-page.php
msgid "waiting"
msgstr "Čaká"

#: showbits/includes/class-settings-page.php
msgid "importing"
msgstr "Importuje sa"

#: showbits/includes/class-settings-page.php
msgid "imported"
msgstr "Importované"

#: showbits/includes/class-settings-page.php
msgid "failed"
msgstr "Zlyhalo"

#: showbits/includes/class-settings-page.php
msgid "Recent imports"
msgstr "Posledné importy"

#: showbits/includes/class-settings-page.php
msgid "When"
msgstr "Dátum"

#: showbits/includes/class-settings-page.php
msgid "Clip"
msgstr "Klip"

#: showbits/includes/class-settings-page.php
msgid "How"
msgstr "Spôsob"

#: showbits/includes/class-settings-page.php
msgid "State"
msgstr "Stav"

#: showbits/includes/class-settings-page.php
msgid "sent from ShowBits"
msgstr "Odoslané zo ShowBits"

#: showbits/includes/class-settings-page.php
msgid "picked here"
msgstr "Vybrané tu"

#: showbits/includes/class-settings-page.php
msgid "Connected. The library is under Media → ShowBits."
msgstr "Pripojené. Knižnicu nájdete v časti Multimédiá → ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Disconnected. What is in the media library stays."
msgstr "Odpojené. Čo je v knižnici médií, zostáva."

#: showbits/includes/class-settings-page.php
msgid "Saved."
msgstr "Uložené."

#: showbits/includes/class-settings-page.php
msgid "Connecting was cancelled in ShowBits."
msgstr "Pripájanie bolo v ShowBits zrušené."

#: showbits/includes/class-settings-page.php
msgid "That way back from ShowBits did not belong to this attempt. Start again."
msgstr "Tento návrat zo ShowBits nepatrí k tomuto pokusu o pripojenie. Začnite znova."

#: showbits/includes/class-settings-page.php
msgid "The ShowBits address must start with https://."
msgstr "Adresa ShowBits musí začínať na https://."

#: showbits/includes/class-settings-page.php
msgid "That is not a site key. Copy it from ShowBits (Integrations → WordPress) again."
msgstr "Toto nie je kľúč webu. Skopírujte ho znova zo ShowBits (Integrations → WordPress)."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not take the site key: it is unknown, used, withdrawn or expired (a site key lasts 24 hours, a consent ten minutes). Make a new one."
msgstr "ShowBits neprijal kľúč webu: je neznámy, použitý, odvolaný alebo mu vypršala platnosť (kľúč webu platí 24 hodín, súhlas desať minút). Vytvorte nový."

#: showbits/includes/class-settings-page.php
msgid "The site key was made for another address. Make one for this site’s address."
msgstr "Kľúč webu bol vytvorený pre inú adresu. Vytvorte kľúč pre adresu tohto webu."

#: showbits/includes/class-settings-page.php
msgid "ShowBits could not reach this site at its REST API (/wp-json/showbits/v1/push), or ShowBits itself could not be reached. The site must be public over HTTPS; a firewall or security plugin must let ShowBits in."
msgstr "ShowBits sa k tomuto webu nedostal cez jeho REST API (/wp-json/showbits/v1/push) alebo bol nedostupný samotný ShowBits. Web musí byť verejne dostupný cez HTTPS; firewall alebo bezpečnostný plugin musí ShowBits prepustiť."

#: showbits/includes/class-settings-page.php
msgid "This site did not answer ShowBits’ check as expected. Try again; if it fails again, a cache or security plugin may answer for WordPress."
msgstr "Tento web neodpovedal na kontrolu ShowBits podľa očakávania. Skúste to znova; ak to opäť zlyhá, možno namiesto WordPressu odpovedá plugin pre cache alebo bezpečnostný plugin."

#: showbits/includes/class-settings-page.php
msgid "The workspace’s plan has ended, or whoever made the site key may no longer connect sites."
msgstr "Plán pracovného priestoru sa skončil alebo ten, kto vytvoril kľúč webu, už nesmie pripájať weby."

#: showbits/includes/class-settings-page.php
msgid "The workspace has as many sites as its plan allows."
msgstr "Pracovný priestor už má toľko webov, koľko povoľuje jeho plán."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not accept this site’s address. It must be served over HTTPS."
msgstr "ShowBits neprijal adresu tohto webu. Web musí bežať cez HTTPS."

#: showbits/includes/class-settings-page.php
msgid "Connecting did not work. Try again, or ask your ShowBits contact."
msgstr "Pripojenie sa nepodarilo. Skúste to znova alebo sa obráťte na svoju kontaktnú osobu v ShowBits."
