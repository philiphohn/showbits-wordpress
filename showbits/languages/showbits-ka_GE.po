msgstr "თავად ხართ სამუშაო სივრცის ადმინისტრატორი ან მფლობელი? მაშინ შედით ShowBits-ში და იქვე დაეთანხმეთ, საიტის გასაღების გარეშე:"

#: showbits/includes/class-settings-page.php
msgid "Connect through ShowBits"
msgstr "ShowBits-ის გავლით დაკავშირება"

#: showbits/includes/class-settings-page.php
msgid "ShowBits address"
msgstr "ShowBits-ის მისამართი"

#: showbits/includes/class-settings-page.php
msgid "ShowBits Cloud: https://app.showbits.ai. OnPremise: the address of your installation."
msgstr "ShowBits Cloud: https://app.showbits.ai. OnPremise: თქვენი ინსტალაციის მისამართი."

#: showbits/includes/class-settings-page.php
msgid "Disconnect"
msgstr "კავშირის გაწყვეტა"

#: showbits/includes/class-settings-page.php
msgid "Disconnect this site from ShowBits? What is in the media library stays."
msgstr "გაწყდეს ამ საიტის კავშირი ShowBits-თან? მედიაბიბლიოთეკაში არსებული ყველაფერი დარჩება."

