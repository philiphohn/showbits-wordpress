# Lao translation of the ShowBits plugin.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: lo\n"
"Plural-Forms: nplurals=1; plural=0;\n"

#. Description of the plugin
#: showbits/showbits.php
msgid "Released clips and quote cards from ShowBits in the media library: pick them in WordPress, or receive what your ShowBits admins send."
msgstr "ຄລິບ ແລະ ບັດຄຳເວົ້າທີ່ອະນຸມັດເຜີຍແຜ່ແລ້ວຈາກ ShowBits ໃນຄັງສື່: ເລືອກເອົາໃນ WordPress ຫຼື ຮັບສິ່ງທີ່ຜູ້ເບິ່ງແຍງ ShowBits ຂອງທ່ານສົ່ງມາ."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer as expected."
msgstr "ShowBits ບໍ່ໄດ້ຕອບກັບຕາມທີ່ຄາດໄວ້."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer with a file."
msgstr "ShowBits ບໍ່ໄດ້ສົ່ງໄຟລ໌ກັບມາ."

#: showbits/includes/class-api-client.php showbits/includes/class-importer.php
msgid "ShowBits could not be reached."
msgstr "ບໍ່ສາມາດຕິດຕໍ່ ShowBits ໄດ້."

#. translators: 1: ShowBits' reason, 2: the HTTP status
#: showbits/includes/class-api-client.php
msgid "ShowBits refused (%1$s, HTTP %2$d)."
msgstr "ShowBits ປະຕິເສດຄຳຂໍ (%1$s, HTTP %2$d)."

#: showbits/includes/class-connection.php
msgid "You may not connect this site."
msgstr "ທ່ານບໍ່ມີສິດເຊື່ອມຕໍ່ເວັບໄຊນີ້."

#. translators: %s: the clip's title
#: showbits/includes/class-importer.php
msgid "%s (thumbnail)"
msgstr "%s (ຮູບຫຍໍ້)"

#. translators: %s: a quote (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%s”"
msgstr "“%s”"

#. translators: 1: a quote, 2: who said it (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%1$s” – %2$s"
msgstr "“%1$s” – %2$s"

#: showbits/includes/class-importer.php
msgid "This is not a clip or a format ShowBits offers."
msgstr "ນີ້ບໍ່ແມ່ນຄລິບ ຫຼື ບໍ່ແມ່ນອັດຕາສ່ວນຮູບທີ່ ShowBits ມີໃຫ້."

#: showbits/includes/class-importer.php
msgid "The clip is no longer released in ShowBits."
msgstr "ຄລິບນີ້ບໍ່ໄດ້ຮັບອະນຸມັດເຜີຍແຜ່ໃນ ShowBits ອີກຕໍ່ໄປ."

#: showbits/includes/class-importer.php
msgid "The embargo still holds: the file stays in ShowBits until it ends."
msgstr "ຍັງຢູ່ໃນໄລຍະຫ້າມເຜີຍແຜ່: ໄຟລ໌ຈະຢູ່ໃນ ShowBits ຈົນກວ່າໄລຍະນີ້ຈະສິ້ນສຸດ."

#: showbits/includes/class-importer.php
msgid "The file is not ready yet in ShowBits."
msgstr "ໄຟລ໌ຍັງບໍ່ພ້ອມໃນ ShowBits."

#: showbits/includes/class-importer.php
msgid "The file could not be downloaded."
msgstr "ບໍ່ສາມາດດາວໂຫຼດໄຟລ໌ໄດ້."

#: showbits/includes/class-importer.php
msgid "WordPress did not take the file into the media library."
msgstr "WordPress ບໍ່ໄດ້ຮັບໄຟລ໌ເຂົ້າໃນຄັງສື່."

#: showbits/includes/class-importer.php
msgid "The delivery from ShowBits is no longer valid. Import the clip again."
msgstr "ການຈັດສົ່ງຈາກ ShowBits ໃຊ້ບໍ່ໄດ້ອີກແລ້ວ. ກະລຸນານຳເຂົ້າຄລິບອີກຄັ້ງ."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer accepts this site’s connection: connect it again under Settings → ShowBits."
msgstr "ShowBits ບໍ່ຍອມຮັບການເຊື່ອມຕໍ່ຂອງເວັບໄຊນີ້ອີກຕໍ່ໄປ: ກະລຸນາເຊື່ອມຕໍ່ໃໝ່ທີ່ ການຕັ້ງຄ່າ → ShowBits."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer delivers to this site: the workspace’s plan has ended."
msgstr "ShowBits ບໍ່ຈັດສົ່ງໃຫ້ເວັບໄຊນີ້ອີກຕໍ່ໄປ: ແພັກເກັດຂອງພື້ນທີ່ເຮັດວຽກໄດ້ສິ້ນສຸດລົງແລ້ວ."

#: showbits/includes/class-importer.php
msgid "The site’s imports for today are used up. Try again tomorrow."
msgstr "ການນຳເຂົ້າຂອງເວັບໄຊນີ້ສຳລັບມື້ນີ້ໝົດແລ້ວ. ກະລຸນາລອງໃໝ່ມື້ອື່ນ."

#: showbits/includes/class-importer.php
msgid "The import was interrupted."
msgstr "ການນຳເຂົ້າຖືກຂັດຈັງຫວະ."

#: showbits/includes/class-importer.php
msgid "The import failed."
msgstr "ການນຳເຂົ້າລົ້ມເຫຼວ."

#: showbits/includes/class-library-endpoint.php
msgid "This site is not connected to ShowBits."
msgstr "ເວັບໄຊນີ້ບໍ່ໄດ້ເຊື່ອມຕໍ່ກັບ ShowBits."

#: showbits/includes/class-library-page.php
msgid "All"
msgstr "ທັງໝົດ"

#: showbits/includes/class-library-page.php
msgid "Clips"
msgstr "ຄລິບ"

#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Quote cards"
msgstr "ບັດຄຳເວົ້າ"

#: showbits/includes/class-library-page.php
msgid "Search titles"
msgstr "ຊອກຫາຫົວຂໍ້"

#: showbits/includes/class-library-page.php
msgid "Search the library"
msgstr "ຊອກຫາໃນຄັງເນື້ອຫາ"

#: showbits/includes/class-library-page.php
msgid "Import selected"
msgstr "ນຳເຂົ້າລາຍການທີ່ເລືອກ"

#. translators: 1: which one, 2: how many in all
#: showbits/includes/class-library-page.php
msgid "Asking ShowBits for %1$d of %2$d …"
msgstr "ກຳລັງຂໍຈາກ ShowBits: ລາຍການທີ %1$d ຈາກ %2$d…"

#. translators: %d: how many clips are still on their way
#: showbits/includes/class-library-page.php
msgid "On the way from ShowBits: %d …"
msgstr "ກຳລັງສົ່ງມາຈາກ ShowBits: %d ລາຍການ…"

#. translators: %d: how many clips were imported
#: showbits/includes/class-library-page.php
msgid "Imported: %d"
msgstr "ນຳເຂົ້າແລ້ວ: %d"

#: showbits/includes/class-library-page.php
msgid "Not everything has arrived yet; it continues in the background. Settings → ShowBits lists the imports."
msgstr "ຍັງມາບໍ່ຄົບ; ການນຳເຂົ້າຈະດຳເນີນຕໍ່ໃນເບື້ອງຫຼັງ. ເບິ່ງລາຍການນຳເຂົ້າໄດ້ທີ່ ການຕັ້ງຄ່າ → ShowBits."

#: showbits/includes/class-library-page.php
msgid "On the way"
msgstr "ກຳລັງສົ່ງມາ"

#: showbits/includes/class-library-page.php
msgid "Load more"
msgstr "ໂຫຼດເພີ່ມ"

#: showbits/includes/class-library-page.php
msgid "Loading …"
msgstr "ກຳລັງໂຫຼດ…"

#: showbits/includes/class-library-page.php
msgid "No released clips or quote cards yet."
msgstr "ຍັງບໍ່ມີຄລິບ ຫຼື ບັດຄຳເວົ້າທີ່ອະນຸມັດເຜີຍແຜ່ແລ້ວ."

#. translators: %s: date and time the embargo ends
#: showbits/includes/class-library-page.php
msgid "Embargo until %s"
msgstr "ຫ້າມເຜີຍແຜ່ຈົນຮອດ %s"

#: showbits/includes/class-library-page.php
msgid "Not ready yet"
msgstr "ຍັງບໍ່ພ້ອມ"

#: showbits/includes/class-library-page.php
msgid "In the media library"
msgstr "ຢູ່ໃນຄັງສື່ແລ້ວ"

#: showbits/includes/class-library-page.php
msgid "An older version is in the media library"
msgstr "ມີສະບັບເກົ່າຢູ່ໃນຄັງສື່"

#: showbits/includes/class-library-page.php
msgid "Edit"
msgstr "ແກ້ໄຂ"

#: showbits/includes/class-library-page.php
msgid "Format"
msgstr "ອັດຕາສ່ວນ"

#: showbits/includes/class-library-page.php
msgid "Video"
msgstr "ວິດີໂອ"

#: showbits/includes/class-library-page.php
msgid "Quote card"
msgstr "ບັດຄຳເວົ້າ"

#: showbits/includes/class-library-page.php
msgid "Meme"
msgstr "ມີມ"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "Failed: %s"
msgstr "ລົ້ມເຫຼວ: %s"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "The library could not be loaded: %s"
msgstr "ບໍ່ສາມາດໂຫຼດຄັງເນື້ອຫາໄດ້: %s"

#: showbits/includes/class-library-page.php
msgid "This site is not connected to ShowBits yet."
msgstr "ເວັບໄຊນີ້ຍັງບໍ່ໄດ້ເຊື່ອມຕໍ່ກັບ ShowBits."

#: showbits/includes/class-library-page.php
msgid "Connect it in the settings."
msgstr "ກະລຸນາເຊື່ອມຕໍ່ໃນການຕັ້ງຄ່າ."

#: showbits/includes/class-library-page.php
msgid "An administrator of this site connects it in the settings."
msgstr "ຜູ້ເບິ່ງແຍງລະບົບຂອງເວັບໄຊນີ້ຈະເປັນຜູ້ເຊື່ອມຕໍ່ໃນການຕັ້ງຄ່າ."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-library-page.php
msgid "Released clips and quote cards from the ShowBits workspace “%s”. What you import lands in the media library, ready for posts and pages."
msgstr "ຄລິບ ແລະ ບັດຄຳເວົ້າທີ່ອະນຸມັດເຜີຍແຜ່ແລ້ວຈາກພື້ນທີ່ເຮັດວຽກ ShowBits “%s”. ສິ່ງທີ່ທ່ານນຳເຂົ້າຈະຢູ່ໃນຄັງສື່ ພ້ອມໃຊ້ໃນບົດຄວາມ ແລະ ໜ້າ."

#: showbits/includes/class-library-page.php
msgid "The library needs JavaScript."
msgstr "ຄັງເນື້ອຫາຕ້ອງໃຊ້ JavaScript."

#: showbits/includes/class-settings-page.php
msgid "Settings"
msgstr "ການຕັ້ງຄ່າ"

#: showbits/includes/class-settings-page.php
msgid "You may not change these settings."
msgstr "ທ່ານບໍ່ມີສິດປ່ຽນການຕັ້ງຄ່າເຫຼົ່ານີ້."

#: showbits/includes/class-settings-page.php
msgid "Connection"
msgstr "ການເຊື່ອມຕໍ່"

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-settings-page.php
msgid "Connected to the workspace “%s”."
msgstr "ເຊື່ອມຕໍ່ກັບພື້ນທີ່ເຮັດວຽກ “%s” ແລ້ວ."

#. translators: 1: imports today, 2: imports a day the plan allows
#: showbits/includes/class-settings-page.php
msgid "Imports today: %1$d of %2$d."
msgstr "ການນຳເຂົ້າມື້ນີ້: %1$d ຈາກ %2$d."

#. translators: 1: a person, 2: a date, 3: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "Connected by %1$s on %2$s, at %3$s."
msgstr "ເຊື່ອມຕໍ່ໂດຍ %1$s ເມື່ອ %2$s ທີ່ %3$s."

#: showbits/includes/class-settings-page.php
msgid "Connect again"
msgstr "ເຊື່ອມຕໍ່ໃໝ່"

#: showbits/includes/class-settings-page.php
msgid "With a new site key the site renews its connection, or moves to another workspace."
msgstr "ດ້ວຍກະແຈເວັບໄຊໃໝ່ ເວັບໄຊຈະຕໍ່ອາຍຸການເຊື່ອມຕໍ່ ຫຼື ຍ້າຍໄປພື້ນທີ່ເຮັດວຽກອື່ນ."

#. translators: %s: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "ShowBits (%s) cannot be reached right now. The connection stays; try again later."
msgstr "ຕອນນີ້ບໍ່ສາມາດຕິດຕໍ່ ShowBits (%s) ໄດ້. ການເຊື່ອມຕໍ່ຍັງຄົງຢູ່; ກະລຸນາລອງໃໝ່ພາຍຫຼັງ."

#: showbits/includes/class-settings-page.php
msgid "ShowBits no longer accepts this site’s connection: it was disconnected in ShowBits, the plan ended, or this site’s keys changed. Connect it again with a new site key."
msgstr "ShowBits ບໍ່ຍອມຮັບການເຊື່ອມຕໍ່ຂອງເວັບໄຊນີ້ອີກຕໍ່ໄປ: ອາດຖືກຕັດການເຊື່ອມຕໍ່ໃນ ShowBits, ແພັກເກັດສິ້ນສຸດລົງ ຫຼື ກະແຈຂອງເວັບໄຊນີ້ປ່ຽນໄປ. ກະລຸນາເຊື່ອມຕໍ່ໃໝ່ດ້ວຍກະແຈເວັບໄຊໃໝ່."

#: showbits/includes/class-settings-page.php
msgid "Connect this site to a ShowBits workspace: an admin or owner of the workspace makes a site key for this site in ShowBits (Integrations → WordPress). The site can then take released clips and quote cards into its media library, and receive what your ShowBits admins send."
msgstr "ເຊື່ອມຕໍ່ເວັບໄຊນີ້ກັບພື້ນທີ່ເຮັດວຽກ ShowBits: ຜູ້ເບິ່ງແຍງ ຫຼື ເຈົ້າຂອງພື້ນທີ່ເຮັດວຽກສ້າງກະແຈເວັບໄຊສຳລັບເວັບໄຊນີ້ໃນ ShowBits (Integrations → WordPress). ຈາກນັ້ນ ເວັບໄຊຈະສາມາດນຳຄລິບ ແລະ ບັດຄຳເວົ້າທີ່ອະນຸມັດເຜີຍແຜ່ແລ້ວເຂົ້າສູ່ຄັງສື່ຂອງຕົນ ແລະ ຮັບສິ່ງທີ່ຜູ້ເບິ່ງແຍງ ShowBits ຂອງທ່ານສົ່ງມາ."

#: showbits/includes/class-settings-page.php
msgid "Imports"
msgstr "ການນຳເຂົ້າ"

#: showbits/includes/class-settings-page.php
msgid "Format of quote cards"
msgstr "ອັດຕາສ່ວນຂອງບັດຄຳເວົ້າ"

#: showbits/includes/class-settings-page.php
msgid "4:5 (feeds, articles)"
msgstr "4:5 (ຟີດ, ບົດຄວາມ)"

#: showbits/includes/class-settings-page.php
msgid "1:1 (square)"
msgstr "1:1 (ສີ່ຫຼ່ຽມຈະຕຸລັດ)"

#: showbits/includes/class-settings-page.php
msgid "9:16 (stories)"
msgstr "9:16 (ສະຕໍຣີ)"

#: showbits/includes/class-settings-page.php
msgid "The picture pushes bring; in the library you choose for each card."
msgstr "ອັດຕາສ່ວນຮູບຂອງບັດທີ່ຖືກສົ່ງມາ; ໃນຄັງເນື້ອຫາ ທ່ານເລືອກໄດ້ສຳລັບແຕ່ລະບັດ."

#: showbits/includes/class-settings-page.php
msgid "Videos"
msgstr "ວິດີໂອ"

#: showbits/includes/class-settings-page.php
msgid "Import the thumbnail as the video’s poster image"
msgstr "ນຳເຂົ້າຮູບຫຍໍ້ເປັນຮູບໂປສເຕີຂອງວິດີໂອ"

#: showbits/includes/class-settings-page.php
msgid "Save"
msgstr "ບັນທຶກ"

#: showbits/includes/class-settings-page.php
msgid "Site key"
msgstr "ກະແຈເວັບໄຊ"

#. translators: %s: this site's address
#: showbits/includes/class-settings-page.php
msgid "Made in ShowBits for %s, valid for 24 hours and only once. ShowBits then checks that it is talking to this site."
msgstr "ສ້າງໃນ ShowBits ສຳລັບ %s, ໃຊ້ໄດ້ 24 ຊົ່ວໂມງ ແລະ ໃຊ້ໄດ້ພຽງຄັ້ງດຽວ. ຈາກນັ້ນ ShowBits ຈະກວດສອບວ່າກຳລັງສື່ສານກັບເວັບໄຊນີ້ແທ້."

#: showbits/includes/class-settings-page.php
msgid "Connect"
msgstr "ເຊື່ອມຕໍ່"

#: showbits/includes/class-settings-page.php
msgid "Are you an admin or owner of the workspace yourself? Then sign in to ShowBits and agree there, without a site key:"
msgstr "ທ່ານເປັນຜູ້ເບິ່ງແຍງ ຫຼື ເຈົ້າຂອງພື້ນທີ່ເຮັດວຽກເອງບໍ? ຖ້າແມ່ນ ກະລຸນາເຂົ້າສູ່ລະບົບ ShowBits ແລະ ຍິນຍອມຢູ່ທີ່ນັ້ນ ໂດຍບໍ່ຕ້ອງໃຊ້ກະແຈເວັບໄຊ:"

#: showbits/includes/class-settings-page.php
msgid "Connect through ShowBits"
msgstr "ເຊື່ອມຕໍ່ຜ່ານ ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits address"
msgstr "ທີ່ຢູ່ ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits Cloud: https://app.showbits.ai. OnPremise: the address of your installation."
msgstr "ShowBits Cloud: https://app.showbits.ai. OnPremise: ທີ່ຢູ່ຂອງການຕິດຕັ້ງຂອງທ່ານ."

#: showbits/includes/class-settings-page.php
msgid "Disconnect"
msgstr "ຕັດການເຊື່ອມຕໍ່"

#: showbits/includes/class-settings-page.php
msgid "Disconnect this site from ShowBits? What is in the media library stays."
msgstr "ຕັດການເຊື່ອມຕໍ່ເວັບໄຊນີ້ຈາກ ShowBits ບໍ? ສິ່ງທີ່ຢູ່ໃນຄັງສື່ຈະຍັງຄົງຢູ່."

#: showbits/includes/class-settings-page.php
msgid "asked for"
msgstr "ຮ້ອງຂໍແລ້ວ"

#: showbits/includes/class-settings-page.php
msgid "waiting"
msgstr "ກຳລັງລໍຖ້າ"

#: showbits/includes/class-settings-page.php
msgid "importing"
msgstr "ກຳລັງນຳເຂົ້າ"

#: showbits/includes/class-settings-page.php
msgid "imported"
msgstr "ນຳເຂົ້າແລ້ວ"

#: showbits/includes/class-settings-page.php
msgid "failed"
msgstr "ລົ້ມເຫຼວ"

#: showbits/includes/class-settings-page.php
msgid "Recent imports"
msgstr "ການນຳເຂົ້າຫຼ້າສຸດ"

#: showbits/includes/class-settings-page.php
msgid "When"
msgstr "ເວລາ"

#: showbits/includes/class-settings-page.php
msgid "Clip"
msgstr "ຄລິບ"

#: showbits/includes/class-settings-page.php
msgid "How"
msgstr "ທີ່ມາ"

#: showbits/includes/class-settings-page.php
msgid "State"
msgstr "ສະຖານະ"

#: showbits/includes/class-settings-page.php
msgid "sent from ShowBits"
msgstr "ສົ່ງມາຈາກ ShowBits"

#: showbits/includes/class-settings-page.php
msgid "picked here"
msgstr "ເລືອກຢູ່ນີ້"

#: showbits/includes/class-settings-page.php
msgid "Connected. The library is under Media → ShowBits."
msgstr "ເຊື່ອມຕໍ່ແລ້ວ. ຄັງເນື້ອຫາຢູ່ທີ່ ສື່ → ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Disconnected. What is in the media library stays."
msgstr "ຕັດການເຊື່ອມຕໍ່ແລ້ວ. ສິ່ງທີ່ຢູ່ໃນຄັງສື່ຈະຍັງຄົງຢູ່."

#: showbits/includes/class-settings-page.php
msgid "Saved."
msgstr "ບັນທຶກແລ້ວ."

#: showbits/includes/class-settings-page.php
msgid "Connecting was cancelled in ShowBits."
msgstr "ການເຊື່ອມຕໍ່ຖືກຍົກເລີກໃນ ShowBits."

#: showbits/includes/class-settings-page.php
msgid "That way back from ShowBits did not belong to this attempt. Start again."
msgstr "ການກັບມາຈາກ ShowBits ບໍ່ກົງກັບການພະຍາຍາມເຊື່ອມຕໍ່ຄັ້ງນີ້. ກະລຸນາເລີ່ມໃໝ່."

#: showbits/includes/class-settings-page.php
msgid "The ShowBits address must start with https://."
msgstr "ທີ່ຢູ່ ShowBits ຕ້ອງຂຶ້ນຕົ້ນດ້ວຍ https://."

#: showbits/includes/class-settings-page.php
msgid "That is not a site key. Copy it from ShowBits (Integrations → WordPress) again."
msgstr "ນັ້ນບໍ່ແມ່ນກະແຈເວັບໄຊ. ກະລຸນາສຳເນົາຈາກ ShowBits (Integrations → WordPress) ອີກຄັ້ງ."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not take the site key: it is unknown, used, withdrawn or expired (a site key lasts 24 hours, a consent ten minutes). Make a new one."
msgstr "ShowBits ບໍ່ຍອມຮັບກະແຈເວັບໄຊ: ກະແຈບໍ່ຮູ້ຈັກ, ຖືກໃຊ້ແລ້ວ, ຖືກຖອນຄືນ ຫຼື ໝົດອາຍຸ (ກະແຈເວັບໄຊໃຊ້ໄດ້ 24 ຊົ່ວໂມງ, ການຍິນຍອມໃຊ້ໄດ້ສິບນາທີ). ກະລຸນາສ້າງອັນໃໝ່."

#: showbits/includes/class-settings-page.php
msgid "The site key was made for another address. Make one for this site’s address."
msgstr "ກະແຈເວັບໄຊນີ້ຖືກສ້າງສຳລັບທີ່ຢູ່ອື່ນ. ກະລຸນາສ້າງອັນໃໝ່ສຳລັບທີ່ຢູ່ຂອງເວັບໄຊນີ້."

#: showbits/includes/class-settings-page.php
msgid "ShowBits could not reach this site at its REST API (/wp-json/showbits/v1/push), or ShowBits itself could not be reached. The site must be public over HTTPS; a firewall or security plugin must let ShowBits in."
msgstr "ShowBits ບໍ່ສາມາດເຂົ້າເຖິງເວັບໄຊນີ້ຜ່ານ REST API ຂອງມັນ (/wp-json/showbits/v1/push) ໄດ້ ຫຼື ບໍ່ສາມາດຕິດຕໍ່ ShowBits ເອງໄດ້. ເວັບໄຊຕ້ອງເປີດສູ່ສາທາລະນະຜ່ານ HTTPS; ໄຟວໍ ຫຼື ປລັກອິນຄວາມປອດໄພຕ້ອງອະນຸຍາດໃຫ້ ShowBits ເຂົ້າມາໄດ້."

#: showbits/includes/class-settings-page.php
msgid "This site did not answer ShowBits’ check as expected. Try again; if it fails again, a cache or security plugin may answer for WordPress."
msgstr "ເວັບໄຊນີ້ບໍ່ໄດ້ຕອບການກວດສອບຂອງ ShowBits ຕາມທີ່ຄາດໄວ້. ກະລຸນາລອງໃໝ່; ຖ້າຍັງລົ້ມເຫຼວອີກ ອາດມີປລັກອິນແຄຊ ຫຼື ປລັກອິນຄວາມປອດໄພຕອບແທນ WordPress."

#: showbits/includes/class-settings-page.php
msgid "The workspace’s plan has ended, or whoever made the site key may no longer connect sites."
msgstr "ແພັກເກັດຂອງພື້ນທີ່ເຮັດວຽກໄດ້ສິ້ນສຸດລົງແລ້ວ ຫຼື ຜູ້ທີ່ສ້າງກະແຈເວັບໄຊບໍ່ມີສິດເຊື່ອມຕໍ່ເວັບໄຊອີກຕໍ່ໄປ."

#: showbits/includes/class-settings-page.php
msgid "The workspace has as many sites as its plan allows."
msgstr "ພື້ນທີ່ເຮັດວຽກມີເວັບໄຊຄົບຕາມຈຳນວນທີ່ແພັກເກັດອະນຸຍາດແລ້ວ."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not accept this site’s address. It must be served over HTTPS."
msgstr "ShowBits ບໍ່ຍອມຮັບທີ່ຢູ່ຂອງເວັບໄຊນີ້. ເວັບໄຊຕ້ອງໃຫ້ບໍລິການຜ່ານ HTTPS."

#: showbits/includes/class-settings-page.php
msgid "Connecting did not work. Try again, or ask your ShowBits contact."
msgstr "ການເຊື່ອມຕໍ່ບໍ່ສຳເລັດ. ກະລຸນາລອງໃໝ່ ຫຼື ສອບຖາມຜູ້ຕິດຕໍ່ຂອງທ່ານທີ່ ShowBits."
