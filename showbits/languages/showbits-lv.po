# Latvian translation of the ShowBits plugin.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: lv\n"
"Plural-Forms: nplurals=3; plural=(n % 10 == 0 || n % 100 >= 11 && n % 100 <= 19) ? 0 : ((n % 10 == 1 && n % 100 != 11) ? 1 : 2);\n"

#. Description of the plugin
#: showbits/showbits.php
msgid "Released clips and quote cards from ShowBits in the media library: pick them in WordPress, or receive what your ShowBits admins send."
msgstr "ShowBits publicēšanai apstiprinātie klipi un citātu kartītes datņu bibliotēkā: izvēlieties tos WordPress pusē vai saņemiet to, ko sūta jūsu ShowBits administratori."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer as expected."
msgstr "ShowBits neatbildēja, kā gaidīts."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer with a file."
msgstr "ShowBits neatsūtīja datni."

#: showbits/includes/class-api-client.php showbits/includes/class-importer.php
msgid "ShowBits could not be reached."
msgstr "Nevarēja sazināties ar ShowBits."

#. translators: 1: ShowBits' reason, 2: the HTTP status
#: showbits/includes/class-api-client.php
msgid "ShowBits refused (%1$s, HTTP %2$d)."
msgstr "ShowBits noraidīja pieprasījumu (%1$s, HTTP %2$d)."

#: showbits/includes/class-connection.php
msgid "You may not connect this site."
msgstr "Jums nav tiesību savienot šo vietni."

#. translators: %s: the clip's title
#: showbits/includes/class-importer.php
msgid "%s (thumbnail)"
msgstr "%s (sīktēls)"

#. translators: %s: a quote (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%s”"
msgstr "“%s”"

#. translators: 1: a quote, 2: who said it (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%1$s” – %2$s"
msgstr "“%1$s” – %2$s"

#: showbits/includes/class-importer.php
msgid "This is not a clip or a format ShowBits offers."
msgstr "Tas nav klips vai formāts, ko piedāvā ShowBits."

#: showbits/includes/class-importer.php
msgid "The clip is no longer released in ShowBits."
msgstr "Klips pakalpojumā ShowBits vairs nav apstiprināts publicēšanai."

#: showbits/includes/class-importer.php
msgid "The embargo still holds: the file stays in ShowBits until it ends."
msgstr "Embargo joprojām ir spēkā: datne paliek pakalpojumā ShowBits, līdz embargo beigsies."

#: showbits/includes/class-importer.php
msgid "The file is not ready yet in ShowBits."
msgstr "Datne pakalpojumā ShowBits vēl nav gatava."

#: showbits/includes/class-importer.php
msgid "The file could not be downloaded."
msgstr "Datni neizdevās lejupielādēt."

#: showbits/includes/class-importer.php
msgid "WordPress did not take the file into the media library."
msgstr "WordPress nepievienoja datni datņu bibliotēkai."

#: showbits/includes/class-importer.php
msgid "The delivery from ShowBits is no longer valid. Import the clip again."
msgstr "ShowBits piegāde vairs nav derīga. Importējiet klipu vēlreiz."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer accepts this site’s connection: connect it again under Settings → ShowBits."
msgstr "ShowBits vairs nepieņem šīs vietnes savienojumu: savienojiet to vēlreiz sadaļā Iestatījumi → ShowBits."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer delivers to this site: the workspace’s plan has ended."
msgstr "ShowBits vairs nepiegādā šai vietnei: darbvietas plāns ir beidzies."

#: showbits/includes/class-importer.php
msgid "The site’s imports for today are used up. Try again tomorrow."
msgstr "Vietnes šodienas importu limits ir izsmelts. Mēģiniet vēlreiz rīt."

#: showbits/includes/class-importer.php
msgid "The import was interrupted."
msgstr "Imports tika pārtraukts."

#: showbits/includes/class-importer.php
msgid "The import failed."
msgstr "Imports neizdevās."

#: showbits/includes/class-library-endpoint.php
msgid "This site is not connected to ShowBits."
msgstr "Šī vietne nav savienota ar ShowBits."

#: showbits/includes/class-library-page.php
msgid "All"
msgstr "Visi"

#: showbits/includes/class-library-page.php
msgid "Clips"
msgstr "Klipi"

#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Quote cards"
msgstr "Citātu kartītes"

#: showbits/includes/class-library-page.php
msgid "Search titles"
msgstr "Meklēt nosaukumos"

#: showbits/includes/class-library-page.php
msgid "Search the library"
msgstr "Meklēt bibliotēkā"

#: showbits/includes/class-library-page.php
msgid "Import selected"
msgstr "Importēt atlasītos"

#. translators: 1: which one, 2: how many in all
#: showbits/includes/class-library-page.php
msgid "Asking ShowBits for %1$d of %2$d …"
msgstr "Pieprasa no ShowBits: %1$d no %2$d…"

#. translators: %d: how many clips are still on their way
#: showbits/includes/class-library-page.php
msgid "On the way from ShowBits: %d …"
msgstr "Ceļā no ShowBits: %d…"

#. translators: %d: how many clips were imported
#: showbits/includes/class-library-page.php
msgid "Imported: %d"
msgstr "Importēti: %d"

#: showbits/includes/class-library-page.php
msgid "Not everything has arrived yet; it continues in the background. Settings → ShowBits lists the imports."
msgstr "Vēl nav pienācis viss; imports turpinās fonā. Importi ir redzami sadaļā Iestatījumi → ShowBits."

#: showbits/includes/class-library-page.php
msgid "On the way"
msgstr "Ceļā"

#: showbits/includes/class-library-page.php
msgid "Load more"
msgstr "Ielādēt vairāk"

#: showbits/includes/class-library-page.php
msgid "Loading …"
msgstr "Ielādē…"

#: showbits/includes/class-library-page.php
msgid "No released clips or quote cards yet."
msgstr "Vēl nav neviena publicēšanai apstiprināta klipa vai citāta kartītes."

#. translators: %s: date and time the embargo ends
#: showbits/includes/class-library-page.php
msgid "Embargo until %s"
msgstr "Embargo līdz %s"

#: showbits/includes/class-library-page.php
msgid "Not ready yet"
msgstr "Vēl nav gatavs"

#: showbits/includes/class-library-page.php
msgid "In the media library"
msgstr "Datņu bibliotēkā"

#: showbits/includes/class-library-page.php
msgid "An older version is in the media library"
msgstr "Datņu bibliotēkā ir vecāka versija"

#: showbits/includes/class-library-page.php
msgid "Edit"
msgstr "Labot"

#: showbits/includes/class-library-page.php
msgid "Format"
msgstr "Formāts"

#: showbits/includes/class-library-page.php
msgid "Video"
msgstr "Video"

#: showbits/includes/class-library-page.php
msgid "Quote card"
msgstr "Citāta kartīte"

#: showbits/includes/class-library-page.php
msgid "Meme"
msgstr "Mēms"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "Failed: %s"
msgstr "Neizdevās: %s"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "The library could not be loaded: %s"
msgstr "Bibliotēku neizdevās ielādēt: %s"

#: showbits/includes/class-library-page.php
msgid "This site is not connected to ShowBits yet."
msgstr "Šī vietne vēl nav savienota ar ShowBits."

#: showbits/includes/class-library-page.php
msgid "Connect it in the settings."
msgstr "Savienojiet to iestatījumos."

#: showbits/includes/class-library-page.php
msgid "An administrator of this site connects it in the settings."
msgstr "Vietni iestatījumos var savienot tās administrators."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-library-page.php
msgid "Released clips and quote cards from the ShowBits workspace “%s”. What you import lands in the media library, ready for posts and pages."
msgstr "Publicēšanai apstiprinātie klipi un citātu kartītes no ShowBits darbvietas “%s”. Tas, ko importējat, nonāk datņu bibliotēkā, gatavs izmantošanai rakstos un lapās."

#: showbits/includes/class-library-page.php
msgid "The library needs JavaScript."
msgstr "Bibliotēkai nepieciešams JavaScript."

#: showbits/includes/class-settings-page.php
msgid "Settings"
msgstr "Iestatījumi"

#: showbits/includes/class-settings-page.php
msgid "You may not change these settings."
msgstr "Jums nav tiesību mainīt šos iestatījumus."

#: showbits/includes/class-settings-page.php
msgid "Connection"
msgstr "Savienojums"

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-settings-page.php
msgid "Connected to the workspace “%s”."
msgstr "Savienots ar darbvietu “%s”."

#. translators: 1: imports today, 2: imports a day the plan allows
#: showbits/includes/class-settings-page.php
msgid "Imports today: %1$d of %2$d."
msgstr "Importi šodien: %1$d no %2$d."

#. translators: 1: a person, 2: a date, 3: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "Connected by %1$s on %2$s, at %3$s."
msgstr "Savienojumu izveidoja %1$s (%2$s), adrese: %3$s."

#: showbits/includes/class-settings-page.php
msgid "Connect again"
msgstr "Savienot vēlreiz"

#: showbits/includes/class-settings-page.php
msgid "With a new site key the site renews its connection, or moves to another workspace."
msgstr "Ar jaunu vietnes atslēgu vietne atjauno savienojumu vai pāriet uz citu darbvietu."

#. translators: %s: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "ShowBits (%s) cannot be reached right now. The connection stays; try again later."
msgstr "ShowBits (%s) pašlaik nav sasniedzams. Savienojums saglabājas; mēģiniet vēlāk vēlreiz."

#: showbits/includes/class-settings-page.php
msgid "ShowBits no longer accepts this site’s connection: it was disconnected in ShowBits, the plan ended, or this site’s keys changed. Connect it again with a new site key."
msgstr "ShowBits vairs nepieņem šīs vietnes savienojumu: tas tika atvienots pakalpojumā ShowBits, plāns beidzās vai mainījās šīs vietnes atslēgas. Savienojiet to vēlreiz ar jaunu vietnes atslēgu."

#: showbits/includes/class-settings-page.php
msgid "Connect this site to a ShowBits workspace: an admin or owner of the workspace makes a site key for this site in ShowBits (Integrations → WordPress). The site can then take released clips and quote cards into its media library, and receive what your ShowBits admins send."
msgstr "Savienojiet šo vietni ar ShowBits darbvietu: darbvietas administrators vai īpašnieks pakalpojumā ShowBits izveido šai vietnei vietnes atslēgu (Integrations → WordPress). Pēc tam vietne var pievienot publicēšanai apstiprinātos klipus un citātu kartītes savai datņu bibliotēkai un saņemt to, ko sūta jūsu ShowBits administratori."

#: showbits/includes/class-settings-page.php
msgid "Imports"
msgstr "Importi"

#: showbits/includes/class-settings-page.php
msgid "Format of quote cards"
msgstr "Citātu kartīšu formāts"

#: showbits/includes/class-settings-page.php
msgid "4:5 (feeds, articles)"
msgstr "4:5 (plūsmas, raksti)"

#: showbits/includes/class-settings-page.php
msgid "1:1 (square)"
msgstr "1:1 (kvadrāts)"

#: showbits/includes/class-settings-page.php
msgid "9:16 (stories)"
msgstr "9:16 (stāsti)"

#: showbits/includes/class-settings-page.php
msgid "The picture pushes bring; in the library you choose for each card."
msgstr "Formāts, kādā pienāk nosūtītās kartītes; bibliotēkā formātu izvēlaties katrai kartītei atsevišķi."

#: showbits/includes/class-settings-page.php
msgid "Videos"
msgstr "Video"

#: showbits/includes/class-settings-page.php
msgid "Import the thumbnail as the video’s poster image"
msgstr "Importēt sīktēlu kā video plakāta attēlu"

#: showbits/includes/class-settings-page.php
msgid "Save"
msgstr "Saglabāt"

#: showbits/includes/class-settings-page.php
msgid "Site key"
msgstr "Vietnes atslēga"

#. translators: %s: this site's address
#: showbits/includes/class-settings-page.php
msgid "Made in ShowBits for %s, valid for 24 hours and only once. ShowBits then checks that it is talking to this site."
msgstr "Izveidota pakalpojumā ShowBits adresei %s, derīga 24 stundas un tikai vienu reizi. Pēc tam ShowBits pārbauda, vai sazinās tieši ar šo vietni."

#: showbits/includes/class-settings-page.php
msgid "Connect"
msgstr "Savienot"

#: showbits/includes/class-settings-page.php
msgid "Are you an admin or owner of the workspace yourself? Then sign in to ShowBits and agree there, without a site key:"
msgstr "Ja jums ir darbvietas administratora vai īpašnieka loma, pierakstieties pakalpojumā ShowBits un piekrītiet tur, bez vietnes atslēgas:"

#: showbits/includes/class-settings-page.php
msgid "Connect through ShowBits"
msgstr "Savienot, izmantojot ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits address"
msgstr "ShowBits adrese"

#: showbits/includes/class-settings-page.php
msgid "ShowBits Cloud: https://app.showbits.ai. OnPremise: the address of your installation."
msgstr "ShowBits Cloud: https://app.showbits.ai. OnPremise: jūsu instalācijas adrese."

#: showbits/includes/class-settings-page.php
msgid "Disconnect"
msgstr "Atvienot"

#: showbits/includes/class-settings-page.php
msgid "Disconnect this site from ShowBits? What is in the media library stays."
msgstr "Atvienot šo vietni no ShowBits? Datņu bibliotēkas saturs paliek."

#: showbits/includes/class-settings-page.php
msgid "asked for"
msgstr "pieprasīts"

#: showbits/includes/class-settings-page.php
msgid "waiting"
msgstr "gaida"

#: showbits/includes/class-settings-page.php
msgid "importing"
msgstr "importē"

#: showbits/includes/class-settings-page.php
msgid "imported"
msgstr "importēts"

#: showbits/includes/class-settings-page.php
msgid "failed"
msgstr "neizdevās"

#: showbits/includes/class-settings-page.php
msgid "Recent imports"
msgstr "Pēdējie importi"

#: showbits/includes/class-settings-page.php
msgid "When"
msgstr "Kad"

#: showbits/includes/class-settings-page.php
msgid "Clip"
msgstr "Klips"

#: showbits/includes/class-settings-page.php
msgid "How"
msgstr "Veids"

#: showbits/includes/class-settings-page.php
msgid "State"
msgstr "Statuss"

#: showbits/includes/class-settings-page.php
msgid "sent from ShowBits"
msgstr "nosūtīts no ShowBits"

#: showbits/includes/class-settings-page.php
msgid "picked here"
msgstr "izvēlēts šeit"

#: showbits/includes/class-settings-page.php
msgid "Connected. The library is under Media → ShowBits."
msgstr "Savienots. Bibliotēka atrodas sadaļā Datnes → ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Disconnected. What is in the media library stays."
msgstr "Atvienots. Datņu bibliotēkas saturs paliek."

#: showbits/includes/class-settings-page.php
msgid "Saved."
msgstr "Saglabāts."

#: showbits/includes/class-settings-page.php
msgid "Connecting was cancelled in ShowBits."
msgstr "Savienošana tika atcelta pakalpojumā ShowBits."

#: showbits/includes/class-settings-page.php
msgid "That way back from ShowBits did not belong to this attempt. Start again."
msgstr "Šī atgriešanās no ShowBits neatbilda šim savienošanas mēģinājumam. Sāciet no jauna."

#: showbits/includes/class-settings-page.php
msgid "The ShowBits address must start with https://."
msgstr "ShowBits adresei jāsākas ar https://."

#: showbits/includes/class-settings-page.php
msgid "That is not a site key. Copy it from ShowBits (Integrations → WordPress) again."
msgstr "Tā nav vietnes atslēga. Nokopējiet to vēlreiz no ShowBits (Integrations → WordPress)."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not take the site key: it is unknown, used, withdrawn or expired (a site key lasts 24 hours, a consent ten minutes). Make a new one."
msgstr "ShowBits nepieņēma vietnes atslēgu: tā ir nezināma, jau izmantota, atsaukta vai beigusies (vietnes atslēga ir derīga 24 stundas, piekrišana – desmit minūtes). Izveidojiet jaunu."

#: showbits/includes/class-settings-page.php
msgid "The site key was made for another address. Make one for this site’s address."
msgstr "Vietnes atslēga tika izveidota citai adresei. Izveidojiet atslēgu šīs vietnes adresei."

#: showbits/includes/class-settings-page.php
msgid "ShowBits could not reach this site at its REST API (/wp-json/showbits/v1/push), or ShowBits itself could not be reached. The site must be public over HTTPS; a firewall or security plugin must let ShowBits in."
msgstr "ShowBits nevarēja sasniegt šo vietni caur tās REST API (/wp-json/showbits/v1/push), vai arī nevarēja sasniegt pašu ShowBits. Vietnei jābūt publiski pieejamai, izmantojot HTTPS; ugunsmūrim vai drošības spraudnim jāļauj ShowBits piekļūt."

#: showbits/includes/class-settings-page.php
msgid "This site did not answer ShowBits’ check as expected. Try again; if it fails again, a cache or security plugin may answer for WordPress."
msgstr "Šī vietne neatbildēja uz ShowBits pārbaudi, kā gaidīts. Mēģiniet vēlreiz; ja atkal neizdodas, iespējams, WordPress vietā atbild kešatmiņas vai drošības spraudnis."

#: showbits/includes/class-settings-page.php
msgid "The workspace’s plan has ended, or whoever made the site key may no longer connect sites."
msgstr "Darbvietas plāns ir beidzies, vai arī tam, kurš izveidoja vietnes atslēgu, vairs nav tiesību savienot vietnes."

#: showbits/includes/class-settings-page.php
msgid "The workspace has as many sites as its plan allows."
msgstr "Darbvietai jau ir tik daudz vietņu, cik atļauj tās plāns."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not accept this site’s address. It must be served over HTTPS."
msgstr "ShowBits nepieņēma šīs vietnes adresi. Vietnei jābūt pieejamai, izmantojot HTTPS."

#: showbits/includes/class-settings-page.php
msgid "Connecting did not work. Try again, or ask your ShowBits contact."
msgstr "Savienošana neizdevās. Mēģiniet vēlreiz vai sazinieties ar savu ShowBits kontaktpersonu."
