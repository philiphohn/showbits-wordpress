# Turkish translation of the ShowBits plugin.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: tr_TR\n"
"Plural-Forms: nplurals=2; plural=n > 1;\n"

#. Description of the plugin
#: showbits/showbits.php
msgid "Released clips and quote cards from ShowBits in the media library: pick them in WordPress, or receive what your ShowBits admins send."
msgstr "ShowBits’teki onaylı klipler ve alıntı kartları ortam kütüphanesinde: WordPress’te seçin ya da ShowBits yöneticilerinizin gönderdiklerini alın."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer as expected."
msgstr "ShowBits beklendiği gibi yanıt vermedi."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer with a file."
msgstr "ShowBits yanıt olarak bir dosya göndermedi."

#: showbits/includes/class-api-client.php showbits/includes/class-importer.php
msgid "ShowBits could not be reached."
msgstr "ShowBits’e ulaşılamadı."

#. translators: 1: ShowBits' reason, 2: the HTTP status
#: showbits/includes/class-api-client.php
msgid "ShowBits refused (%1$s, HTTP %2$d)."
msgstr "ShowBits isteği reddetti (%1$s, HTTP %2$d)."

#: showbits/includes/class-connection.php
msgid "You may not connect this site."
msgstr "Bu siteyi bağlama yetkiniz yok."

#. translators: %s: the clip's title
#: showbits/includes/class-importer.php
msgid "%s (thumbnail)"
msgstr "%s (küçük resim)"

#. translators: %s: a quote (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%s”"
msgstr "“%s”"

#. translators: 1: a quote, 2: who said it (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%1$s” – %2$s"
msgstr "“%1$s” – %2$s"

#: showbits/includes/class-importer.php
msgid "This is not a clip or a format ShowBits offers."
msgstr "Bu, ShowBits’in sunduğu bir klip ya da biçim değil."

#: showbits/includes/class-importer.php
msgid "The clip is no longer released in ShowBits."
msgstr "Klip ShowBits’te artık onaylı değil."

#: showbits/includes/class-importer.php
msgid "The embargo still holds: the file stays in ShowBits until it ends."
msgstr "Ambargo hâlâ sürüyor: dosya, ambargo bitene kadar ShowBits’te kalır."

#: showbits/includes/class-importer.php
msgid "The file is not ready yet in ShowBits."
msgstr "Dosya ShowBits’te henüz hazır değil."

#: showbits/includes/class-importer.php
msgid "The file could not be downloaded."
msgstr "Dosya indirilemedi."

#: showbits/includes/class-importer.php
msgid "WordPress did not take the file into the media library."
msgstr "WordPress dosyayı ortam kütüphanesine almadı."

#: showbits/includes/class-importer.php
msgid "The delivery from ShowBits is no longer valid. Import the clip again."
msgstr "ShowBits’ten gelen teslimat artık geçerli değil. Klibi yeniden içe aktarın."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer accepts this site’s connection: connect it again under Settings → ShowBits."
msgstr "ShowBits bu sitenin bağlantısını artık kabul etmiyor: siteyi Ayarlar → ShowBits sayfasından yeniden bağlayın."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer delivers to this site: the workspace’s plan has ended."
msgstr "ShowBits bu siteye artık teslimat yapmıyor: çalışma alanının planı sona erdi."

#: showbits/includes/class-importer.php
msgid "The site’s imports for today are used up. Try again tomorrow."
msgstr "Sitenin bugünkü içe aktarma hakkı doldu. Yarın yeniden deneyin."

#: showbits/includes/class-importer.php
msgid "The import was interrupted."
msgstr "İçe aktarma yarıda kesildi."

#: showbits/includes/class-importer.php
msgid "The import failed."
msgstr "İçe aktarma başarısız oldu."

#: showbits/includes/class-library-endpoint.php
msgid "This site is not connected to ShowBits."
msgstr "Bu site ShowBits’e bağlı değil."

#: showbits/includes/class-library-page.php
msgid "All"
msgstr "Tümü"

#: showbits/includes/class-library-page.php
msgid "Clips"
msgstr "Klipler"

#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Quote cards"
msgstr "Alıntı kartları"

#: showbits/includes/class-library-page.php
msgid "Search titles"
msgstr "Başlıklarda ara"

#: showbits/includes/class-library-page.php
msgid "Search the library"
msgstr "Kütüphanede ara"

#: showbits/includes/class-library-page.php
msgid "Import selected"
msgstr "Seçilenleri içe aktar"

#. translators: 1: which one, 2: how many in all
#: showbits/includes/class-library-page.php
msgid "Asking ShowBits for %1$d of %2$d …"
msgstr "ShowBits’ten isteniyor: %1$d / %2$d…"

#. translators: %d: how many clips are still on their way
#: showbits/includes/class-library-page.php
msgid "On the way from ShowBits: %d …"
msgstr "ShowBits’ten geliyor: %d…"

#. translators: %d: how many clips were imported
#: showbits/includes/class-library-page.php
msgid "Imported: %d"
msgstr "İçe aktarıldı: %d"

#: showbits/includes/class-library-page.php
msgid "Not everything has arrived yet; it continues in the background. Settings → ShowBits lists the imports."
msgstr "Henüz hepsi gelmedi; işlem arka planda sürüyor. İçe aktarmalar Ayarlar → ShowBits sayfasında listelenir."

#: showbits/includes/class-library-page.php
msgid "On the way"
msgstr "Yolda"

#: showbits/includes/class-library-page.php
msgid "Load more"
msgstr "Daha fazla yükle"

#: showbits/includes/class-library-page.php
msgid "Loading …"
msgstr "Yükleniyor…"

#: showbits/includes/class-library-page.php
msgid "No released clips or quote cards yet."
msgstr "Henüz onaylı klip ya da alıntı kartı yok."

#. translators: %s: date and time the embargo ends
#: showbits/includes/class-library-page.php
msgid "Embargo until %s"
msgstr "%s tarihine kadar ambargolu"

#: showbits/includes/class-library-page.php
msgid "Not ready yet"
msgstr "Henüz hazır değil"

#: showbits/includes/class-library-page.php
msgid "In the media library"
msgstr "Ortam kütüphanesinde"

#: showbits/includes/class-library-page.php
msgid "An older version is in the media library"
msgstr "Ortam kütüphanesinde eski bir sürümü var"

#: showbits/includes/class-library-page.php
msgid "Edit"
msgstr "Düzenle"

#: showbits/includes/class-library-page.php
msgid "Format"
msgstr "Biçim"

#: showbits/includes/class-library-page.php
msgid "Video"
msgstr "Video"

#: showbits/includes/class-library-page.php
msgid "Quote card"
msgstr "Alıntı kartı"

#: showbits/includes/class-library-page.php
msgid "Meme"
msgstr "Mim"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "Failed: %s"
msgstr "Başarısız: %s"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "The library could not be loaded: %s"
msgstr "Kütüphane yüklenemedi: %s"

#: showbits/includes/class-library-page.php
msgid "This site is not connected to ShowBits yet."
msgstr "Bu site henüz ShowBits’e bağlı değil."

#: showbits/includes/class-library-page.php
msgid "Connect it in the settings."
msgstr "Ayarlardan bağlayın."

#: showbits/includes/class-library-page.php
msgid "An administrator of this site connects it in the settings."
msgstr "Siteyi ayarlardan bu sitenin bir yöneticisi bağlayabilir."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-library-page.php
msgid "Released clips and quote cards from the ShowBits workspace “%s”. What you import lands in the media library, ready for posts and pages."
msgstr "“%s” ShowBits çalışma alanındaki onaylı klipler ve alıntı kartları. İçe aktardıklarınız ortam kütüphanesine gelir ve yazılarda ve sayfalarda kullanıma hazırdır."

#: showbits/includes/class-library-page.php
msgid "The library needs JavaScript."
msgstr "Kütüphane için JavaScript gerekir."

#: showbits/includes/class-settings-page.php
msgid "Settings"
msgstr "Ayarlar"

#: showbits/includes/class-settings-page.php
msgid "You may not change these settings."
msgstr "Bu ayarları değiştirme yetkiniz yok."

#: showbits/includes/class-settings-page.php
msgid "Connection"
msgstr "Bağlantı"

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-settings-page.php
msgid "Connected to the workspace “%s”."
msgstr "“%s” çalışma alanına bağlı."

#. translators: 1: imports today, 2: imports a day the plan allows
#: showbits/includes/class-settings-page.php
msgid "Imports today: %1$d of %2$d."
msgstr "Bugünkü içe aktarmalar: %1$d / %2$d."

#. translators: 1: a person, 2: a date, 3: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "Connected by %1$s on %2$s, at %3$s."
msgstr "%1$s tarafından %2$s tarihinde %3$s adresine bağlandı."

#: showbits/includes/class-settings-page.php
msgid "Connect again"
msgstr "Yeniden bağla"

#: showbits/includes/class-settings-page.php
msgid "With a new site key the site renews its connection, or moves to another workspace."
msgstr "Site, yeni bir site anahtarıyla bağlantısını yeniler ya da başka bir çalışma alanına geçer."

#. translators: %s: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "ShowBits (%s) cannot be reached right now. The connection stays; try again later."
msgstr "ShowBits’e (%s) şu anda ulaşılamıyor. Bağlantı korunuyor; daha sonra yeniden deneyin."

#: showbits/includes/class-settings-page.php
msgid "ShowBits no longer accepts this site’s connection: it was disconnected in ShowBits, the plan ended, or this site’s keys changed. Connect it again with a new site key."
msgstr "ShowBits bu sitenin bağlantısını artık kabul etmiyor: bağlantı ShowBits’te kesilmiş, plan sona ermiş ya da bu sitenin anahtarları değişmiş. Siteyi yeni bir site anahtarıyla yeniden bağlayın."

#: showbits/includes/class-settings-page.php
msgid "Connect this site to a ShowBits workspace: an admin or owner of the workspace makes a site key for this site in ShowBits (Integrations → WordPress). The site can then take released clips and quote cards into its media library, and receive what your ShowBits admins send."
msgstr "Bu siteyi bir ShowBits çalışma alanına bağlayın: çalışma alanının bir yöneticisi veya sahibi, ShowBits’te (Integrations → WordPress) bu site için bir site anahtarı oluşturur. Ardından site, onaylı klipleri ve alıntı kartlarını ortam kütüphanesine alabilir ve ShowBits yöneticilerinizin gönderdiklerini teslim alabilir."

#: showbits/includes/class-settings-page.php
msgid "Imports"
msgstr "İçe aktarmalar"

#: showbits/includes/class-settings-page.php
msgid "Format of quote cards"
msgstr "Alıntı kartlarının biçimi"

#: showbits/includes/class-settings-page.php
msgid "4:5 (feeds, articles)"
msgstr "4:5 (akışlar, makaleler)"

#: showbits/includes/class-settings-page.php
msgid "1:1 (square)"
msgstr "1:1 (kare)"

#: showbits/includes/class-settings-page.php
msgid "9:16 (stories)"
msgstr "9:16 (hikâyeler)"

#: showbits/includes/class-settings-page.php
msgid "The picture pushes bring; in the library you choose for each card."
msgstr "Gönderimlerle gelen görsel biçimi; kütüphanede ise biçimi her kart için ayrı seçersiniz."

#: showbits/includes/class-settings-page.php
msgid "Videos"
msgstr "Videolar"

#: showbits/includes/class-settings-page.php
msgid "Import the thumbnail as the video’s poster image"
msgstr "Küçük resmi videonun poster görseli olarak içe aktar"

#: showbits/includes/class-settings-page.php
msgid "Save"
msgstr "Kaydet"

#: showbits/includes/class-settings-page.php
msgid "Site key"
msgstr "Site anahtarı"

#. translators: %s: this site's address
#: showbits/includes/class-settings-page.php
msgid "Made in ShowBits for %s, valid for 24 hours and only once. ShowBits then checks that it is talking to this site."
msgstr "ShowBits’te %s için oluşturulur; 24 saat ve yalnızca bir kez geçerlidir. ShowBits ardından gerçekten bu siteyle iletişim kurduğunu doğrular."

#: showbits/includes/class-settings-page.php
msgid "Connect"
msgstr "Bağla"

#: showbits/includes/class-settings-page.php
msgid "Are you an admin or owner of the workspace yourself? Then sign in to ShowBits and agree there, without a site key:"
msgstr "Çalışma alanının yöneticisi veya sahibi siz misiniz? O hâlde ShowBits’e giriş yapın ve site anahtarı olmadan orada onay verin:"

#: showbits/includes/class-settings-page.php
msgid "Connect through ShowBits"
msgstr "ShowBits üzerinden bağla"

#: showbits/includes/class-settings-page.php
msgid "ShowBits address"
msgstr "ShowBits adresi"

#: showbits/includes/class-settings-page.php
msgid "ShowBits Cloud: https://app.showbits.ai. OnPremise: the address of your installation."
msgstr "ShowBits Cloud: https://app.showbits.ai. OnPremise: kendi kurulumunuzun adresi."

#: showbits/includes/class-settings-page.php
msgid "Disconnect"
msgstr "Bağlantıyı kes"

#: showbits/includes/class-settings-page.php
msgid "Disconnect this site from ShowBits? What is in the media library stays."
msgstr "Bu sitenin ShowBits bağlantısı kesilsin mi? Ortam kütüphanesindekiler yerinde kalır."

#: showbits/includes/class-settings-page.php
msgid "asked for"
msgstr "İstendi"

#: showbits/includes/class-settings-page.php
msgid "waiting"
msgstr "Bekliyor"

#: showbits/includes/class-settings-page.php
msgid "importing"
msgstr "İçe aktarılıyor"

#: showbits/includes/class-settings-page.php
msgid "imported"
msgstr "İçe aktarıldı"

#: showbits/includes/class-settings-page.php
msgid "failed"
msgstr "Başarısız"

#: showbits/includes/class-settings-page.php
msgid "Recent imports"
msgstr "Son içe aktarmalar"

#: showbits/includes/class-settings-page.php
msgid "When"
msgstr "Zaman"

#: showbits/includes/class-settings-page.php
msgid "Clip"
msgstr "Klip"

#: showbits/includes/class-settings-page.php
msgid "How"
msgstr "Geliş şekli"

#: showbits/includes/class-settings-page.php
msgid "State"
msgstr "Durum"

#: showbits/includes/class-settings-page.php
msgid "sent from ShowBits"
msgstr "ShowBits’ten gönderildi"

#: showbits/includes/class-settings-page.php
msgid "picked here"
msgstr "Burada seçildi"

#: showbits/includes/class-settings-page.php
msgid "Connected. The library is under Media → ShowBits."
msgstr "Bağlandı. Kütüphaneyi Ortam → ShowBits altında bulabilirsiniz."

#: showbits/includes/class-settings-page.php
msgid "Disconnected. What is in the media library stays."
msgstr "Bağlantı kesildi. Ortam kütüphanesindekiler yerinde kalır."

#: showbits/includes/class-settings-page.php
msgid "Saved."
msgstr "Kaydedildi."

#: showbits/includes/class-settings-page.php
msgid "Connecting was cancelled in ShowBits."
msgstr "Bağlama işlemi ShowBits’te iptal edildi."

#: showbits/includes/class-settings-page.php
msgid "That way back from ShowBits did not belong to this attempt. Start again."
msgstr "ShowBits’ten bu geri dönüş, bu sitenin başlattığı bağlanma denemesine ait değil. Yeniden başlayın."

#: showbits/includes/class-settings-page.php
msgid "The ShowBits address must start with https://."
msgstr "ShowBits adresi https:// ile başlamalıdır."

#: showbits/includes/class-settings-page.php
msgid "That is not a site key. Copy it from ShowBits (Integrations → WordPress) again."
msgstr "Bu bir site anahtarı değil. Anahtarı ShowBits’ten (Integrations → WordPress) yeniden kopyalayın."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not take the site key: it is unknown, used, withdrawn or expired (a site key lasts 24 hours, a consent ten minutes). Make a new one."
msgstr "ShowBits site anahtarını kabul etmedi: anahtar bilinmiyor, kullanılmış, geri çekilmiş ya da süresi dolmuş (site anahtarı 24 saat, onay on dakika geçerlidir). Yeni bir anahtar oluşturun."

#: showbits/includes/class-settings-page.php
msgid "The site key was made for another address. Make one for this site’s address."
msgstr "Site anahtarı başka bir adres için oluşturulmuş. Bu sitenin adresi için bir anahtar oluşturun."

#: showbits/includes/class-settings-page.php
msgid "ShowBits could not reach this site at its REST API (/wp-json/showbits/v1/push), or ShowBits itself could not be reached. The site must be public over HTTPS; a firewall or security plugin must let ShowBits in."
msgstr "ShowBits bu siteye REST API’si (/wp-json/showbits/v1/push) üzerinden ulaşamadı ya da ShowBits’in kendisine ulaşılamadı. Site HTTPS üzerinden herkese açık olmalıdır; güvenlik duvarı veya güvenlik eklentisi ShowBits’e izin vermelidir."

#: showbits/includes/class-settings-page.php
msgid "This site did not answer ShowBits’ check as expected. Try again; if it fails again, a cache or security plugin may answer for WordPress."
msgstr "Bu site, ShowBits’in denetimine beklendiği gibi yanıt vermedi. Yeniden deneyin; yine olmazsa WordPress yerine bir önbellek veya güvenlik eklentisi yanıt veriyor olabilir."

#: showbits/includes/class-settings-page.php
msgid "The workspace’s plan has ended, or whoever made the site key may no longer connect sites."
msgstr "Çalışma alanının planı sona erdi ya da site anahtarını oluşturan kişinin artık site bağlama yetkisi yok."

#: showbits/includes/class-settings-page.php
msgid "The workspace has as many sites as its plan allows."
msgstr "Çalışma alanında, planının izin verdiği sayıda site zaten var."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not accept this site’s address. It must be served over HTTPS."
msgstr "ShowBits bu sitenin adresini kabul etmedi. Site HTTPS üzerinden sunulmalıdır."

#: showbits/includes/class-settings-page.php
msgid "Connecting did not work. Try again, or ask your ShowBits contact."
msgstr "Bağlantı kurulamadı. Yeniden deneyin ya da ShowBits’teki irtibat kişinize danışın."
