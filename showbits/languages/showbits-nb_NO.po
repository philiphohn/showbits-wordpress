# Norwegian (Bokmål) translation of the ShowBits plugin.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: nb_NO\n"
"Plural-Forms: nplurals=2; plural=n != 1;\n"

#. Description of the plugin
#: showbits/showbits.php
msgid "Released clips and quote cards from ShowBits in the media library: pick them in WordPress, or receive what your ShowBits admins send."
msgstr "Frigitte klipp og sitatkort fra ShowBits i mediebiblioteket: velg dem i WordPress, eller motta det administratorene dine i ShowBits sender."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer as expected."
msgstr "ShowBits svarte ikke som forventet."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer with a file."
msgstr "ShowBits leverte ingen fil."

#: showbits/includes/class-api-client.php showbits/includes/class-importer.php
msgid "ShowBits could not be reached."
msgstr "ShowBits kunne ikke nås."

#. translators: 1: ShowBits' reason, 2: the HTTP status
#: showbits/includes/class-api-client.php
msgid "ShowBits refused (%1$s, HTTP %2$d)."
msgstr "ShowBits avviste (%1$s, HTTP %2$d)."

#: showbits/includes/class-connection.php
msgid "You may not connect this site."
msgstr "Du har ikke tillatelse til å koble til dette nettstedet."

#. translators: %s: the clip's title
#: showbits/includes/class-importer.php
msgid "%s (thumbnail)"
msgstr "%s (miniatyrbilde)"

#. translators: %s: a quote (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%s”"
msgstr "«%s»"

#. translators: 1: a quote, 2: who said it (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%1$s” – %2$s"
msgstr "«%1$s» – %2$s"

#: showbits/includes/class-importer.php
msgid "This is not a clip or a format ShowBits offers."
msgstr "Dette er ikke et klipp eller et format som ShowBits tilbyr."

#: showbits/includes/class-importer.php
msgid "The clip is no longer released in ShowBits."
msgstr "Klippet er ikke lenger frigitt i ShowBits."

#: showbits/includes/class-importer.php
msgid "The embargo still holds: the file stays in ShowBits until it ends."
msgstr "Embargoen gjelder fortsatt: filen blir værende i ShowBits til embargoen utløper."

#: showbits/includes/class-importer.php
msgid "The file is not ready yet in ShowBits."
msgstr "Filen er ikke klar ennå i ShowBits."

#: showbits/includes/class-importer.php
msgid "The file could not be downloaded."
msgstr "Filen kunne ikke lastes ned."

#: showbits/includes/class-importer.php
msgid "WordPress did not take the file into the media library."
msgstr "WordPress la ikke filen inn i mediebiblioteket."

#: showbits/includes/class-importer.php
msgid "The delivery from ShowBits is no longer valid. Import the clip again."
msgstr "Leveransen fra ShowBits er ikke lenger gyldig. Importer klippet på nytt."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer accepts this site’s connection: connect it again under Settings → ShowBits."
msgstr "ShowBits godtar ikke lenger tilkoblingen til dette nettstedet: koble det til på nytt under Innstillinger → ShowBits."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer delivers to this site: the workspace’s plan has ended."
msgstr "ShowBits leverer ikke lenger til dette nettstedet: abonnementet til arbeidsområdet er avsluttet."

#: showbits/includes/class-importer.php
msgid "The site’s imports for today are used up. Try again tomorrow."
msgstr "Nettstedet har brukt opp dagens importer. Prøv igjen i morgen."

#: showbits/includes/class-importer.php
msgid "The import was interrupted."
msgstr "Importen ble avbrutt."

#: showbits/includes/class-importer.php
msgid "The import failed."
msgstr "Importen mislyktes."

#: showbits/includes/class-library-endpoint.php
msgid "This site is not connected to ShowBits."
msgstr "Dette nettstedet er ikke koblet til ShowBits."

#: showbits/includes/class-library-page.php
msgid "All"
msgstr "Alle"

#: showbits/includes/class-library-page.php
msgid "Clips"
msgstr "Klipp"

#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Quote cards"
msgstr "Sitatkort"

#: showbits/includes/class-library-page.php
msgid "Search titles"
msgstr "Søk i titler"

#: showbits/includes/class-library-page.php
msgid "Search the library"
msgstr "Søk i biblioteket"

#: showbits/includes/class-library-page.php
msgid "Import selected"
msgstr "Importer valgte"

#. translators: 1: which one, 2: how many in all
#: showbits/includes/class-library-page.php
msgid "Asking ShowBits for %1$d of %2$d …"
msgstr "Ber ShowBits om %1$d av %2$d…"

#. translators: %d: how many clips are still on their way
#: showbits/includes/class-library-page.php
msgid "On the way from ShowBits: %d …"
msgstr "På vei fra ShowBits: %d…"

#. translators: %d: how many clips were imported
#: showbits/includes/class-library-page.php
msgid "Imported: %d"
msgstr "Importert: %d"

#: showbits/includes/class-library-page.php
msgid "Not everything has arrived yet; it continues in the background. Settings → ShowBits lists the imports."
msgstr "Ikke alt har kommet ennå; det fortsetter i bakgrunnen. Innstillinger → ShowBits viser importene."

#: showbits/includes/class-library-page.php
msgid "On the way"
msgstr "På vei"

#: showbits/includes/class-library-page.php
msgid "Load more"
msgstr "Last inn flere"

#: showbits/includes/class-library-page.php
msgid "Loading …"
msgstr "Laster inn…"

#: showbits/includes/class-library-page.php
msgid "No released clips or quote cards yet."
msgstr "Ingen frigitte klipp eller sitatkort ennå."

#. translators: %s: date and time the embargo ends
#: showbits/includes/class-library-page.php
msgid "Embargo until %s"
msgstr "Embargo til %s"

#: showbits/includes/class-library-page.php
msgid "Not ready yet"
msgstr "Ikke klar ennå"

#: showbits/includes/class-library-page.php
msgid "In the media library"
msgstr "I mediebiblioteket"

#: showbits/includes/class-library-page.php
msgid "An older version is in the media library"
msgstr "En eldre versjon ligger i mediebiblioteket"

#: showbits/includes/class-library-page.php
msgid "Edit"
msgstr "Rediger"

#: showbits/includes/class-library-page.php
msgid "Format"
msgstr "Format"

#: showbits/includes/class-library-page.php
msgid "Video"
msgstr "Video"

#: showbits/includes/class-library-page.php
msgid "Quote card"
msgstr "Sitatkort"

#: showbits/includes/class-library-page.php
msgid "Meme"
msgstr "Meme"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "Failed: %s"
msgstr "Mislyktes: %s"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "The library could not be loaded: %s"
msgstr "Biblioteket kunne ikke lastes inn: %s"

#: showbits/includes/class-library-page.php
msgid "This site is not connected to ShowBits yet."
msgstr "Dette nettstedet er ikke koblet til ShowBits ennå."

#: showbits/includes/class-library-page.php
msgid "Connect it in the settings."
msgstr "Koble det til i innstillingene."

#: showbits/includes/class-library-page.php
msgid "An administrator of this site connects it in the settings."
msgstr "En administrator for dette nettstedet må koble det til i innstillingene."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-library-page.php
msgid "Released clips and quote cards from the ShowBits workspace “%s”. What you import lands in the media library, ready for posts and pages."
msgstr "Frigitte klipp og sitatkort fra ShowBits-arbeidsområdet «%s». Det du importerer, havner i mediebiblioteket, klart for innlegg og sider."

#: showbits/includes/class-library-page.php
msgid "The library needs JavaScript."
msgstr "Biblioteket krever JavaScript."

#: showbits/includes/class-settings-page.php
msgid "Settings"
msgstr "Innstillinger"

#: showbits/includes/class-settings-page.php
msgid "You may not change these settings."
msgstr "Du har ikke tillatelse til å endre disse innstillingene."

#: showbits/includes/class-settings-page.php
msgid "Connection"
msgstr "Tilkobling"

#. translators: 1: the constant SHOWBITS_ENCRYPTION_KEY, 2: the file wp-config.php (both stay as they are)
#: showbits/includes/class-settings-page.php
msgid "Your site’s security keys are not in %2$s, so the key that protects the connection to ShowBits is stored in the database. Add %1$s with a long random value to %2$s; if the site is connected already, connect it again afterwards."
msgstr "Sikkerhetsnøklene til nettstedet ditt er ikke i %2$s, så nøkkelen som beskytter tilkoblingen til ShowBits, lagres i databasen. Legg til %1$s med en lang tilfeldig verdi i %2$s; hvis nettstedet allerede er tilkoblet, kobler du det til på nytt etterpå."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-settings-page.php
msgid "Connected to the workspace “%s”."
msgstr "Koblet til arbeidsområdet «%s»."

#. translators: 1: imports today, 2: imports a day the plan allows
#: showbits/includes/class-settings-page.php
msgid "Imports today: %1$d of %2$d."
msgstr "Importer i dag: %1$d av %2$d."

#. translators: 1: a person, 2: a date, 3: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "Connected by %1$s on %2$s, at %3$s."
msgstr "Koblet til %3$s av %1$s den %2$s."

#: showbits/includes/class-settings-page.php
msgid "Connect again"
msgstr "Koble til på nytt"

#: showbits/includes/class-settings-page.php
msgid "With a new site key the site renews its connection, or moves to another workspace."
msgstr "Med en ny nettstedsnøkkel fornyer nettstedet tilkoblingen sin eller flytter til et annet arbeidsområde."

#. translators: %s: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "ShowBits (%s) cannot be reached right now. The connection stays; try again later."
msgstr "ShowBits (%s) kan ikke nås akkurat nå. Tilkoblingen beholdes; prøv igjen senere."

#: showbits/includes/class-settings-page.php
msgid "ShowBits no longer accepts this site’s connection: it was disconnected in ShowBits, the plan ended, or this site’s keys changed. Connect it again with a new site key."
msgstr "ShowBits godtar ikke lenger tilkoblingen til dette nettstedet: den ble koblet fra i ShowBits, abonnementet er avsluttet, eller nøklene til nettstedet er endret. Koble det til på nytt med en ny nettstedsnøkkel."

#: showbits/includes/class-settings-page.php
msgid "Connect this site to a ShowBits workspace: an admin or owner of the workspace makes a site key for this site in ShowBits (Integrations → WordPress). The site can then take released clips and quote cards into its media library, and receive what your ShowBits admins send."
msgstr "Koble dette nettstedet til et ShowBits-arbeidsområde: en administrator eller eier av arbeidsområdet lager en nettstedsnøkkel for dette nettstedet i ShowBits (Integrations → WordPress). Deretter kan nettstedet hente frigitte klipp og sitatkort inn i mediebiblioteket sitt og motta det administratorene dine i ShowBits sender."

#: showbits/includes/class-settings-page.php
msgid "Imports"
msgstr "Import"

#: showbits/includes/class-settings-page.php
msgid "Format of quote cards"
msgstr "Format for sitatkort"

#: showbits/includes/class-settings-page.php
msgid "4:5 (feeds, articles)"
msgstr "4:5 (feeder, artikler)"

#: showbits/includes/class-settings-page.php
msgid "1:1 (square)"
msgstr "1:1 (kvadratisk)"

#: showbits/includes/class-settings-page.php
msgid "9:16 (stories)"
msgstr "9:16 (stories)"

#: showbits/includes/class-settings-page.php
msgid "The picture pushes bring; in the library you choose for each card."
msgstr "Formatet for kort som sendes hit; i biblioteket velger du det for hvert kort."

#: showbits/includes/class-settings-page.php
msgid "Videos"
msgstr "Videoer"

#: showbits/includes/class-settings-page.php
msgid "Import the thumbnail as the video’s poster image"
msgstr "Importer miniatyrbildet som videoens plakatbilde"

#: showbits/includes/class-settings-page.php
msgid "Save"
msgstr "Lagre"

#: showbits/includes/class-settings-page.php
msgid "Site key"
msgstr "Nettstedsnøkkel"

#. translators: %s: this site's address
#: showbits/includes/class-settings-page.php
msgid "Made in ShowBits for %s, valid for 24 hours and only once. ShowBits then checks that it is talking to this site."
msgstr "Laget i ShowBits for %s, gyldig i 24 timer og bare til engangsbruk. ShowBits kontrollerer deretter at det snakker med akkurat dette nettstedet."

#: showbits/includes/class-settings-page.php
msgid "Connect"
msgstr "Koble til"

#: showbits/includes/class-settings-page.php
msgid "Are you an admin or owner of the workspace yourself? Then sign in to ShowBits and agree there, without a site key:"
msgstr "Er du selv administrator eller eier av arbeidsområdet? Logg da inn på ShowBits og gi samtykke der, uten nettstedsnøkkel:"

#: showbits/includes/class-settings-page.php
msgid "Connect through ShowBits"
msgstr "Koble til via ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits address"
msgstr "ShowBits-adresse"

#: showbits/includes/class-settings-page.php
msgid "ShowBits Cloud: https://app.showbits.ai. OnPremise: the address of your installation."
msgstr "ShowBits Cloud: https://app.showbits.ai. OnPremise: adressen til installasjonen din."

#: showbits/includes/class-settings-page.php
msgid "Disconnect"
msgstr "Koble fra"

#: showbits/includes/class-settings-page.php
msgid "Disconnect this site from ShowBits? What is in the media library stays."
msgstr "Koble dette nettstedet fra ShowBits? Det som ligger i mediebiblioteket, blir liggende."

#: showbits/includes/class-settings-page.php
msgid "asked for"
msgstr "Forespurt"

#: showbits/includes/class-settings-page.php
msgid "waiting"
msgstr "I kø"

#: showbits/includes/class-settings-page.php
msgid "importing"
msgstr "Importeres"

#: showbits/includes/class-settings-page.php
msgid "imported"
msgstr "Importert"

#: showbits/includes/class-settings-page.php
msgid "failed"
msgstr "Mislyktes"

#: showbits/includes/class-settings-page.php
msgid "Recent imports"
msgstr "Nylige importer"

#: showbits/includes/class-settings-page.php
msgid "When"
msgstr "Når"

#: showbits/includes/class-settings-page.php
msgid "Clip"
msgstr "Klipp"

#: showbits/includes/class-settings-page.php
msgid "How"
msgstr "Kilde"

#: showbits/includes/class-settings-page.php
msgid "State"
msgstr "Status"

#: showbits/includes/class-settings-page.php
msgid "sent from ShowBits"
msgstr "Sendt fra ShowBits"

#: showbits/includes/class-settings-page.php
msgid "picked here"
msgstr "Valgt her"

#: showbits/includes/class-settings-page.php
msgid "Connected. The library is under Media → ShowBits."
msgstr "Tilkoblet. Biblioteket finner du under Media → ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Disconnected. What is in the media library stays."
msgstr "Frakoblet. Det som ligger i mediebiblioteket, blir liggende."

#: showbits/includes/class-settings-page.php
msgid "Saved."
msgstr "Lagret."

#: showbits/includes/class-settings-page.php
msgid "Connecting was cancelled in ShowBits."
msgstr "Tilkoblingen ble avbrutt i ShowBits."

#: showbits/includes/class-settings-page.php
msgid "That way back from ShowBits did not belong to this attempt. Start again."
msgstr "Omdirigeringen tilbake fra ShowBits hører ikke til tilkoblingsforsøket fra dette nettstedet. Start på nytt."

#: showbits/includes/class-settings-page.php
msgid "The ShowBits address must start with https://."
msgstr "ShowBits-adressen må begynne med https://."

#: showbits/includes/class-settings-page.php
msgid "That is not a site key. Copy it from ShowBits (Integrations → WordPress) again."
msgstr "Dette er ikke en nettstedsnøkkel. Kopier den på nytt fra ShowBits (Integrations → WordPress)."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not take the site key: it is unknown, used, withdrawn or expired (a site key lasts 24 hours, a consent ten minutes). Make a new one."
msgstr "ShowBits godtok ikke nettstedsnøkkelen: den er ukjent, brukt, trukket tilbake eller utløpt (en nettstedsnøkkel varer i 24 timer, et samtykke i ti minutter). Lag en ny."

#: showbits/includes/class-settings-page.php
msgid "The site key was made for another address. Make one for this site’s address."
msgstr "Nettstedsnøkkelen ble laget for en annen adresse. Lag en for adressen til dette nettstedet."

#: showbits/includes/class-settings-page.php
msgid "ShowBits could not reach this site at its REST API (/wp-json/showbits/v1/push), or ShowBits itself could not be reached. The site must be public over HTTPS; a firewall or security plugin must let ShowBits in."
msgstr "ShowBits kunne ikke nå dette nettstedet via REST-API-et (/wp-json/showbits/v1/push), eller ShowBits selv kunne ikke nås. Nettstedet må være offentlig tilgjengelig over HTTPS; en brannmur eller sikkerhetsutvidelse må slippe ShowBits inn."

#: showbits/includes/class-settings-page.php
msgid "This site did not answer ShowBits’ check as expected. Try again; if it fails again, a cache or security plugin may answer for WordPress."
msgstr "Dette nettstedet svarte ikke på kontrollen fra ShowBits som forventet. Prøv igjen; mislykkes det igjen, kan det være at en hurtigbuffer- eller sikkerhetsutvidelse svarer i stedet for WordPress."

#: showbits/includes/class-settings-page.php
msgid "The workspace’s plan has ended, or whoever made the site key may no longer connect sites."
msgstr "Abonnementet til arbeidsområdet er avsluttet, eller den som laget nettstedsnøkkelen, har ikke lenger lov til å koble til nettsteder."

#: showbits/includes/class-settings-page.php
msgid "The workspace has as many sites as its plan allows."
msgstr "Arbeidsområdet har allerede så mange nettsteder som abonnementet tillater."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not accept this site’s address. It must be served over HTTPS."
msgstr "ShowBits godtok ikke adressen til dette nettstedet. Nettstedet må leveres over HTTPS."

#: showbits/includes/class-settings-page.php
msgid "Connecting did not work. Try again, or ask your ShowBits contact."
msgstr "Tilkoblingen mislyktes. Prøv igjen, eller spør kontaktpersonen din hos ShowBits."
