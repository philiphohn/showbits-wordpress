# Yoruba translation of the ShowBits plugin.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: yor\n"
"Plural-Forms: nplurals=2; plural=n != 1;\n"

#. Description of the plugin
#: showbits/showbits.php
msgid "Released clips and quote cards from ShowBits in the media library: pick them in WordPress, or receive what your ShowBits admins send."
msgstr "Àwọn fọ́nrán àti káàdì àyọkà tí a ti yọ̀ǹda ní ShowBits, nínú ilé-ìkàwé mídíà: ẹ yàn wọ́n nínú WordPress, tàbí kí ẹ gba ohun tí àwọn alákòóso ShowBits yín bá fi ránṣẹ́."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer as expected."
msgstr "ShowBits kò dáhùn bí a ṣe retí."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer with a file."
msgstr "ShowBits kò fi fáìlì dáhùn."

#: showbits/includes/class-api-client.php showbits/includes/class-importer.php
msgid "ShowBits could not be reached."
msgstr "Kò ṣeé ṣe láti kàn sí ShowBits."

#. translators: 1: ShowBits' reason, 2: the HTTP status
#: showbits/includes/class-api-client.php
msgid "ShowBits refused (%1$s, HTTP %2$d)."
msgstr "ShowBits kọ̀ (%1$s, HTTP %2$d)."

#: showbits/includes/class-connection.php
msgid "You may not connect this site."
msgstr "Ẹ kò ní àṣẹ láti so ìkànnì yìí pọ̀."

#. translators: %s: the clip's title
#: showbits/includes/class-importer.php
msgid "%s (thumbnail)"
msgstr "%s (àwòrán kékeré)"

#. translators: %s: a quote (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%s”"
msgstr "“%s”"

#. translators: 1: a quote, 2: who said it (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%1$s” – %2$s"
msgstr "“%1$s” – %2$s"

#: showbits/includes/class-importer.php
msgid "This is not a clip or a format ShowBits offers."
msgstr "Èyí kì í ṣe fọ́nrán tàbí ìrísí tí ShowBits ń pèsè."

#: showbits/includes/class-importer.php
msgid "The clip is no longer released in ShowBits."
msgstr "A kò yọ̀ǹda fọ́nrán náà ní ShowBits mọ́."

#: showbits/includes/class-importer.php
msgid "The embargo still holds: the file stays in ShowBits until it ends."
msgstr "Ìfòfindè ìtẹ̀jáde ṣì wà lórí rẹ̀: fáìlì náà yóò wà ní ShowBits títí ìfòfindè náà yóò fi parí."

#: showbits/includes/class-importer.php
msgid "The file is not ready yet in ShowBits."
msgstr "Fáìlì náà kò tíì ṣetán ní ShowBits."

#: showbits/includes/class-importer.php
msgid "The file could not be downloaded."
msgstr "Kò ṣeé ṣe láti ṣe ìgbàsílẹ̀ fáìlì náà."

#: showbits/includes/class-importer.php
msgid "WordPress did not take the file into the media library."
msgstr "WordPress kò gba fáìlì náà sínú ilé-ìkàwé mídíà."

#: showbits/includes/class-importer.php
msgid "The delivery from ShowBits is no longer valid. Import the clip again."
msgstr "Ìfijíṣẹ́ láti ShowBits kò wúlò mọ́. Ẹ tún gbé fọ́nrán náà wọlé."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer accepts this site’s connection: connect it again under Settings → ShowBits."
msgstr "ShowBits kò gba ìsopọ̀ ìkànnì yìí mọ́: ẹ tún so ó pọ̀ ní Ètò → ShowBits."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer delivers to this site: the workspace’s plan has ended."
msgstr "ShowBits kò fi nǹkan ránṣẹ́ sí ìkànnì yìí mọ́: ètò ìsanwó àyè iṣẹ́ náà ti parí."

#: showbits/includes/class-importer.php
msgid "The site’s imports for today are used up. Try again tomorrow."
msgstr "Ìkànnì yìí ti lo gbogbo ìgbéwọlé rẹ̀ fún òní tán. Ẹ tún gbìyànjú lọ́la."

#: showbits/includes/class-importer.php
msgid "The import was interrupted."
msgstr "Ìgbéwọlé náà dúró ní àárín."

#: showbits/includes/class-importer.php
msgid "The import failed."
msgstr "Ìgbéwọlé náà kùnà."

#: showbits/includes/class-library-endpoint.php
msgid "This site is not connected to ShowBits."
msgstr "Ìkànnì yìí kò sopọ̀ mọ́ ShowBits."

#: showbits/includes/class-library-page.php
msgid "All"
msgstr "Gbogbo"

#: showbits/includes/class-library-page.php
msgid "Clips"
msgstr "Àwọn fọ́nrán"

#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Quote cards"
msgstr "Àwọn káàdì àyọkà"

#: showbits/includes/class-library-page.php
msgid "Search titles"
msgstr "Ṣàwárí àwọn àkọlé"

#: showbits/includes/class-library-page.php
msgid "Search the library"
msgstr "Ṣàwárí nínú ilé-ìkàwé"

#: showbits/includes/class-library-page.php
msgid "Import selected"
msgstr "Gbé àwọn tí a yàn wọlé"

#. translators: 1: which one, 2: how many in all
#: showbits/includes/class-library-page.php
msgid "Asking ShowBits for %1$d of %2$d …"
msgstr "À ń béèrè %1$d nínú %2$d lọ́wọ́ ShowBits…"

#. translators: %d: how many clips are still on their way
#: showbits/includes/class-library-page.php
msgid "On the way from ShowBits: %d …"
msgstr "Ó ń bọ̀ láti ShowBits: %d…"

#. translators: %d: how many clips were imported
#: showbits/includes/class-library-page.php
msgid "Imported: %d"
msgstr "A ti gbé %d wọlé"

#: showbits/includes/class-library-page.php
msgid "Not everything has arrived yet; it continues in the background. Settings → ShowBits lists the imports."
msgstr "Kì í ṣe gbogbo rẹ̀ ló ti dé; iṣẹ́ náà ń bá a lọ ní abẹ́lẹ̀. Ẹ wo àkọsílẹ̀ àwọn ìgbéwọlé ní Ètò → ShowBits."

#: showbits/includes/class-library-page.php
msgid "On the way"
msgstr "Ó ń bọ̀"

#: showbits/includes/class-library-page.php
msgid "Load more"
msgstr "Fi díẹ̀ sí i hàn"

#: showbits/includes/class-library-page.php
msgid "Loading …"
msgstr "Ẹ dúró díẹ̀…"

#: showbits/includes/class-library-page.php
msgid "No released clips or quote cards yet."
msgstr "Kò tíì sí fọ́nrán tàbí káàdì àyọkà tí a ti yọ̀ǹda."

#. translators: %s: date and time the embargo ends
#: showbits/includes/class-library-page.php
msgid "Embargo until %s"
msgstr "Ìfòfindè ìtẹ̀jáde títí di %s"

#: showbits/includes/class-library-page.php
msgid "Not ready yet"
msgstr "Kò tíì ṣetán"

#: showbits/includes/class-library-page.php
msgid "In the media library"
msgstr "Ó wà nínú ilé-ìkàwé mídíà"

#: showbits/includes/class-library-page.php
msgid "An older version is in the media library"
msgstr "Ẹ̀dà àtijọ́ kan wà nínú ilé-ìkàwé mídíà"

#: showbits/includes/class-library-page.php
msgid "Edit"
msgstr "Ṣàtúnṣe"

#: showbits/includes/class-library-page.php
msgid "Format"
msgstr "Ìrísí"

#: showbits/includes/class-library-page.php
msgid "Video"
msgstr "Fídíò"

#: showbits/includes/class-library-page.php
msgid "Quote card"
msgstr "Káàdì àyọkà"

#: showbits/includes/class-library-page.php
msgid "Meme"
msgstr "Meme"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "Failed: %s"
msgstr "Ó kùnà: %s"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "The library could not be loaded: %s"
msgstr "Kò ṣeé ṣe láti ṣí ilé-ìkàwé náà: %s"

#: showbits/includes/class-library-page.php
msgid "This site is not connected to ShowBits yet."
msgstr "Ìkànnì yìí kò tíì sopọ̀ mọ́ ShowBits."

#: showbits/includes/class-library-page.php
msgid "Connect it in the settings."
msgstr "Ẹ so ó pọ̀ nínú ètò."

#: showbits/includes/class-library-page.php
msgid "An administrator of this site connects it in the settings."
msgstr "Alákòóso ìkànnì yìí ni yóò so ó pọ̀ nínú ètò."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-library-page.php
msgid "Released clips and quote cards from the ShowBits workspace “%s”. What you import lands in the media library, ready for posts and pages."
msgstr "Àwọn fọ́nrán àti káàdì àyọkà tí a ti yọ̀ǹda láti inú àyè iṣẹ́ ShowBits “%s”. Ohun tí ẹ bá gbé wọlé yóò wọ ilé-ìkàwé mídíà, yóò sì ṣetán fún àwọn àròkọ àti ojú-ìwé."

#: showbits/includes/class-library-page.php
msgid "The library needs JavaScript."
msgstr "Ilé-ìkàwé náà nílò JavaScript."

#: showbits/includes/class-settings-page.php
msgid "Settings"
msgstr "Ètò"

#: showbits/includes/class-settings-page.php
msgid "You may not change these settings."
msgstr "Ẹ kò ní àṣẹ láti yí ètò wọ̀nyí padà."

#: showbits/includes/class-settings-page.php
msgid "Connection"
msgstr "Ìsopọ̀"

#. translators: 1: the constant SHOWBITS_ENCRYPTION_KEY, 2: the file wp-config.php (both stay as they are)
#: showbits/includes/class-settings-page.php
msgid "Your site’s security keys are not in %2$s, so the key that protects the connection to ShowBits is stored in the database. Add %1$s with a long random value to %2$s; if the site is connected already, connect it again afterwards."
msgstr "Àwọn kọ́kọ́rọ́ ààbò ìkànnì yín kò sí nínú %2$s, nítorí náà kọ́kọ́rọ́ tí ó ń dáàbò bo ìsopọ̀ sí ShowBits wà nínú ibi ìpamọ́ dátà. Ẹ fi %1$s pẹ̀lú iye àìròtẹ́lẹ̀ tó gùn kún %2$s; bí ìkànnì náà bá ti so pọ̀ tẹ́lẹ̀, ẹ tún so ó pọ̀ lẹ́yìn náà."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-settings-page.php
msgid "Connected to the workspace “%s”."
msgstr "Ó ti sopọ̀ mọ́ àyè iṣẹ́ “%s”."

#. translators: 1: imports today, 2: imports a day the plan allows
#: showbits/includes/class-settings-page.php
msgid "Imports today: %1$d of %2$d."
msgstr "Ìgbéwọlé lónìí: %1$d nínú %2$d."

#. translators: 1: a person, 2: a date, 3: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "Connected by %1$s on %2$s, at %3$s."
msgstr "%1$s ló so ó pọ̀ ní %2$s, sí %3$s."

#: showbits/includes/class-settings-page.php
msgid "Connect again"
msgstr "Tún sopọ̀"

#: showbits/includes/class-settings-page.php
msgid "With a new site key the site renews its connection, or moves to another workspace."
msgstr "Pẹ̀lú kọ́kọ́rọ́ ìkànnì tuntun, ìkànnì náà yóò sọ ìsopọ̀ rẹ̀ dọ̀tun, tàbí kí ó kó lọ sí àyè iṣẹ́ mìíràn."

#. translators: %s: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "ShowBits (%s) cannot be reached right now. The connection stays; try again later."
msgstr "Kò ṣeé ṣe láti kàn sí ShowBits (%s) báyìí. Ìsopọ̀ náà ṣì wà; ẹ tún gbìyànjú tó bá yá."

#: showbits/includes/class-settings-page.php
msgid "ShowBits no longer accepts this site’s connection: it was disconnected in ShowBits, the plan ended, or this site’s keys changed. Connect it again with a new site key."
msgstr "ShowBits kò gba ìsopọ̀ ìkànnì yìí mọ́: wọ́n gé ìsopọ̀ náà ní ShowBits, ètò ìsanwó ti parí, tàbí àwọn kọ́kọ́rọ́ ìkànnì yìí ti yí padà. Ẹ tún so ó pọ̀ pẹ̀lú kọ́kọ́rọ́ ìkànnì tuntun."

#: showbits/includes/class-settings-page.php
msgid "Connect this site to a ShowBits workspace: an admin or owner of the workspace makes a site key for this site in ShowBits (Integrations → WordPress). The site can then take released clips and quote cards into its media library, and receive what your ShowBits admins send."
msgstr "Ẹ so ìkànnì yìí pọ̀ mọ́ àyè iṣẹ́ ShowBits kan: alákòóso tàbí olùní àyè iṣẹ́ náà yóò ṣẹ̀dá kọ́kọ́rọ́ ìkànnì fún ìkànnì yìí ní ShowBits (Integrations → WordPress). Lẹ́yìn náà, ìkànnì náà lè gba àwọn fọ́nrán àti káàdì àyọkà tí a ti yọ̀ǹda sínú ilé-ìkàwé mídíà rẹ̀, kí ó sì gba ohun tí àwọn alákòóso ShowBits yín bá fi ránṣẹ́."

#: showbits/includes/class-settings-page.php
msgid "Imports"
msgstr "Àwọn ìgbéwọlé"

#: showbits/includes/class-settings-page.php
msgid "Format of quote cards"
msgstr "Ìrísí àwọn káàdì àyọkà"

#: showbits/includes/class-settings-page.php
msgid "4:5 (feeds, articles)"
msgstr "4:5 (ìkànnì àjọlò, àpilẹ̀kọ)"

#: showbits/includes/class-settings-page.php
msgid "1:1 (square)"
msgstr "1:1 (onígun mẹ́rin ọgbọọgba)"

#: showbits/includes/class-settings-page.php
msgid "9:16 (stories)"
msgstr "9:16 (àwọn ìtàn)"

#: showbits/includes/class-settings-page.php
msgid "The picture pushes bring; in the library you choose for each card."
msgstr "Ìrísí àwòrán tí àwọn nǹkan tí a fi ránṣẹ́ síbí máa ń mú wá; nínú ilé-ìkàwé, ẹ̀yin ni yóò yàn án fún káàdì kọ̀ọ̀kan."

#: showbits/includes/class-settings-page.php
msgid "Videos"
msgstr "Àwọn fídíò"

#: showbits/includes/class-settings-page.php
msgid "Import the thumbnail as the video’s poster image"
msgstr "Gbé àwòrán kékeré wọlé gẹ́gẹ́ bí àwòrán pósítà fídíò náà"

#: showbits/includes/class-settings-page.php
msgid "Save"
msgstr "Fi pamọ́"

#: showbits/includes/class-settings-page.php
msgid "Site key"
msgstr "Kọ́kọ́rọ́ ìkànnì"

#. translators: %s: this site's address
#: showbits/includes/class-settings-page.php
msgid "Made in ShowBits for %s, valid for 24 hours and only once. ShowBits then checks that it is talking to this site."
msgstr "A ṣẹ̀dá rẹ̀ ní ShowBits fún %s, ó wúlò fún wákàtí 24, ẹ̀ẹ̀kan ṣoṣo sì ni a lè lò ó. Lẹ́yìn náà, ShowBits yóò ṣàyẹ̀wò pé ìkànnì yìí gan-an ni òun ń bá sọ̀rọ̀."

#: showbits/includes/class-settings-page.php
msgid "Connect"
msgstr "Sopọ̀"

#: showbits/includes/class-settings-page.php
msgid "Are you an admin or owner of the workspace yourself? Then sign in to ShowBits and agree there, without a site key:"
msgstr "Ṣé ẹ̀yin fúnra yín jẹ́ alákòóso tàbí olùní àyè iṣẹ́ náà? Bí ó bá rí bẹ́ẹ̀, ẹ wọlé sí ShowBits kí ẹ sì fọwọ́ sí i níbẹ̀, láìsí kọ́kọ́rọ́ ìkànnì:"

#: showbits/includes/class-settings-page.php
msgid "Connect through ShowBits"
msgstr "Sopọ̀ nípasẹ̀ ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits address"
msgstr "Àdírẹ́sì ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits Cloud: https://app.showbits.ai. OnPremise: the address of your installation."
msgstr "ShowBits Cloud: https://app.showbits.ai. OnPremise: àdírẹ́sì ẹ̀dà tí ẹ fi sórí ẹ̀rọ yín."

#: showbits/includes/class-settings-page.php
msgid "Disconnect"
msgstr "Gé ìsopọ̀"

#: showbits/includes/class-settings-page.php
msgid "Disconnect this site from ShowBits? What is in the media library stays."
msgstr "Ṣé ẹ fẹ́ gé ìsopọ̀ ìkànnì yìí pẹ̀lú ShowBits? Ohun tó wà nínú ilé-ìkàwé mídíà kò ní kúrò."

#: showbits/includes/class-settings-page.php
msgid "asked for"
msgstr "A ti béèrè"

#: showbits/includes/class-settings-page.php
msgid "waiting"
msgstr "Ó ń dúró"

#: showbits/includes/class-settings-page.php
msgid "importing"
msgstr "Ó ń wọlé"

#: showbits/includes/class-settings-page.php
msgid "imported"
msgstr "Ó ti wọlé"

#: showbits/includes/class-settings-page.php
msgid "failed"
msgstr "Ó kùnà"

#: showbits/includes/class-settings-page.php
msgid "Recent imports"
msgstr "Àwọn ìgbéwọlé àìpẹ́ yìí"

#: showbits/includes/class-settings-page.php
msgid "When"
msgstr "Àkókò"

#: showbits/includes/class-settings-page.php
msgid "Clip"
msgstr "Fọ́nrán"

#: showbits/includes/class-settings-page.php
msgid "How"
msgstr "Bí ó ṣe dé"

#: showbits/includes/class-settings-page.php
msgid "State"
msgstr "Ipò"

#: showbits/includes/class-settings-page.php
msgid "sent from ShowBits"
msgstr "A fi ránṣẹ́ láti ShowBits"

#: showbits/includes/class-settings-page.php
msgid "picked here"
msgstr "A yàn án níbí"

#: showbits/includes/class-settings-page.php
msgid "Connected. The library is under Media → ShowBits."
msgstr "Ó ti sopọ̀. Ilé-ìkàwé náà wà ní Mídíà → ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Disconnected. What is in the media library stays."
msgstr "A ti gé ìsopọ̀ náà. Ohun tó wà nínú ilé-ìkàwé mídíà kò ní kúrò."

#: showbits/includes/class-settings-page.php
msgid "Saved."
msgstr "A ti fi pamọ́."

#: showbits/includes/class-settings-page.php
msgid "Connecting was cancelled in ShowBits."
msgstr "A fagilé ìsopọ̀ náà ní ShowBits."

#: showbits/includes/class-settings-page.php
msgid "That way back from ShowBits did not belong to this attempt. Start again."
msgstr "Ìpadàbọ̀ yìí láti ShowBits kò jẹ́ ti ìgbìyànjú ìsopọ̀ tí ìkànnì yìí bẹ̀rẹ̀. Ẹ tún bẹ̀rẹ̀."

#: showbits/includes/class-settings-page.php
msgid "The ShowBits address must start with https://."
msgstr "Àdírẹ́sì ShowBits gbọ́dọ̀ bẹ̀rẹ̀ pẹ̀lú https://."

#: showbits/includes/class-settings-page.php
msgid "That is not a site key. Copy it from ShowBits (Integrations → WordPress) again."
msgstr "Ìyẹn kì í ṣe kọ́kọ́rọ́ ìkànnì. Ẹ tún ṣe àdàkọ rẹ̀ láti ShowBits (Integrations → WordPress)."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not take the site key: it is unknown, used, withdrawn or expired (a site key lasts 24 hours, a consent ten minutes). Make a new one."
msgstr "ShowBits kò gba kọ́kọ́rọ́ ìkànnì náà: a kò mọ̀ ọ́n, a ti lò ó, a ti fà á sẹ́yìn, tàbí ó ti kọjá àkókò (kọ́kọ́rọ́ ìkànnì máa ń wúlò fún wákàtí 24, ìfọwọ́sí fún ìṣẹ́jú mẹ́wàá). Ẹ ṣẹ̀dá òmíràn."

#: showbits/includes/class-settings-page.php
msgid "The site key was made for another address. Make one for this site’s address."
msgstr "A ṣẹ̀dá kọ́kọ́rọ́ ìkànnì náà fún àdírẹ́sì mìíràn. Ẹ ṣẹ̀dá ọ̀kan fún àdírẹ́sì ìkànnì yìí."

#: showbits/includes/class-settings-page.php
msgid "ShowBits could not reach this site at its REST API (/wp-json/showbits/v1/push), or ShowBits itself could not be reached. The site must be public over HTTPS; a firewall or security plugin must let ShowBits in."
msgstr "ShowBits kò lè dé ọ̀dọ̀ ìkànnì yìí nípasẹ̀ REST API rẹ̀ (/wp-json/showbits/v1/push), tàbí kò ṣeé ṣe láti kàn sí ShowBits fúnra rẹ̀. Ìkànnì náà gbọ́dọ̀ wà ní gbangba lórí HTTPS; firewall tàbí àfikún ààbò gbọ́dọ̀ jẹ́ kí ShowBits wọlé."

#: showbits/includes/class-settings-page.php
msgid "This site did not answer ShowBits’ check as expected. Try again; if it fails again, a cache or security plugin may answer for WordPress."
msgstr "Ìkànnì yìí kò dáhùn àyẹ̀wò ShowBits bí a ṣe retí. Ẹ tún gbìyànjú; bí ó bá tún kùnà, ó ṣeé ṣe kí àfikún cache tàbí àfikún ààbò kan máa dáhùn dípò WordPress."

#: showbits/includes/class-settings-page.php
msgid "The workspace’s plan has ended, or whoever made the site key may no longer connect sites."
msgstr "Ètò ìsanwó àyè iṣẹ́ náà ti parí, tàbí ẹni tó ṣẹ̀dá kọ́kọ́rọ́ ìkànnì náà kò ní àṣẹ láti so àwọn ìkànnì pọ̀ mọ́."

#: showbits/includes/class-settings-page.php
msgid "The workspace has as many sites as its plan allows."
msgstr "Àyè iṣẹ́ náà ti dé òpin iye ìkànnì tí ètò ìsanwó rẹ̀ fàyè gbà."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not accept this site’s address. It must be served over HTTPS."
msgstr "ShowBits kò gba àdírẹ́sì ìkànnì yìí. Ó gbọ́dọ̀ máa ṣiṣẹ́ lórí HTTPS."

