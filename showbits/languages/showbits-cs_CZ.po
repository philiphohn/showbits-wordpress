# Czech translation of the ShowBits plugin.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: cs_CZ\n"
"Plural-Forms: nplurals=3; plural=(n == 1) ? 0 : ((n >= 2 && n <= 4) ? 1 : 2);\n"

#. Description of the plugin
#: showbits/showbits.php
msgid "Released clips and quote cards from ShowBits in the media library: pick them in WordPress, or receive what your ShowBits admins send."
msgstr "Schválené klipy a obrázky s citáty ze ShowBits přímo v knihovně médií: vybírejte je ve WordPressu nebo přijímejte to, co posílají vaši administrátoři ShowBits."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer as expected."
msgstr "ShowBits vrátil neočekávanou odpověď."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer with a file."
msgstr "ShowBits nevrátil soubor."

#: showbits/includes/class-api-client.php showbits/includes/class-importer.php
msgid "ShowBits could not be reached."
msgstr "ShowBits je nedostupný."

#. translators: 1: ShowBits' reason, 2: the HTTP status
#: showbits/includes/class-api-client.php
msgid "ShowBits refused (%1$s, HTTP %2$d)."
msgstr "ShowBits odmítl požadavek (%1$s, HTTP %2$d)."

#: showbits/includes/class-connection.php
msgid "You may not connect this site."
msgstr "Nemáte oprávnění připojit tento web."

#. translators: %s: the clip's title
#: showbits/includes/class-importer.php
msgid "%s (thumbnail)"
msgstr "%s (náhled)"

#. translators: %s: a quote (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%s”"
msgstr "„%s“"

#. translators: 1: a quote, 2: who said it (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%1$s” – %2$s"
msgstr "„%1$s“ – %2$s"

#: showbits/includes/class-importer.php
msgid "This is not a clip or a format ShowBits offers."
msgstr "Nejde o klip ani o formát, který ShowBits nabízí."

#: showbits/includes/class-importer.php
msgid "The clip is no longer released in ShowBits."
msgstr "Klip už není v ShowBits schválený."

#: showbits/includes/class-importer.php
msgid "The embargo still holds: the file stays in ShowBits until it ends."
msgstr "Embargo stále platí: do jeho skončení zůstává soubor v ShowBits."

#: showbits/includes/class-importer.php
msgid "The file is not ready yet in ShowBits."
msgstr "Soubor v ShowBits ještě není připravený."

#: showbits/includes/class-importer.php
msgid "The file could not be downloaded."
msgstr "Soubor se nepodařilo stáhnout."

#: showbits/includes/class-importer.php
msgid "WordPress did not take the file into the media library."
msgstr "WordPress nepřevzal soubor do knihovny médií."

#: showbits/includes/class-importer.php
msgid "The delivery from ShowBits is no longer valid. Import the clip again."
msgstr "Zásilka ze ShowBits už není platná. Importujte klip znovu."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer accepts this site’s connection: connect it again under Settings → ShowBits."
msgstr "ShowBits už nepřijímá připojení tohoto webu: připojte ho znovu v nabídce Nastavení → ShowBits."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer delivers to this site: the workspace’s plan has ended."
msgstr "ShowBits už tomuto webu nic nedoručuje: tarif pracovního prostoru skončil."

#: showbits/includes/class-importer.php
msgid "The site’s imports for today are used up. Try again tomorrow."
msgstr "Dnešní limit importů tohoto webu je vyčerpán. Zkuste to znovu zítra."

#: showbits/includes/class-importer.php
msgid "The import was interrupted."
msgstr "Import byl přerušen."

#: showbits/includes/class-importer.php
msgid "The import failed."
msgstr "Import se nezdařil."

#: showbits/includes/class-library-endpoint.php
msgid "This site is not connected to ShowBits."
msgstr "Tento web není připojen k ShowBits."

#: showbits/includes/class-library-page.php
msgid "All"
msgstr "Vše"

#: showbits/includes/class-library-page.php
msgid "Clips"
msgstr "Klipy"

#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Quote cards"
msgstr "Obrázky s citáty"

#: showbits/includes/class-library-page.php
msgid "Search titles"
msgstr "Hledat v názvech"

#: showbits/includes/class-library-page.php
msgid "Search the library"
msgstr "Prohledat knihovnu"

#: showbits/includes/class-library-page.php
msgid "Import selected"
msgstr "Importovat vybrané"

#. translators: 1: which one, 2: how many in all
#: showbits/includes/class-library-page.php
msgid "Asking ShowBits for %1$d of %2$d …"
msgstr "Odesílání požadavku do ShowBits: %1$d z %2$d…"

#. translators: %d: how many clips are still on their way
#: showbits/includes/class-library-page.php
msgid "On the way from ShowBits: %d …"
msgstr "Na cestě ze ShowBits: %d…"

#. translators: %d: how many clips were imported
#: showbits/includes/class-library-page.php
msgid "Imported: %d"
msgstr "Importováno: %d"

#: showbits/includes/class-library-page.php
msgid "Not everything has arrived yet; it continues in the background. Settings → ShowBits lists the imports."
msgstr "Ještě nedorazilo všechno; import pokračuje na pozadí. Přehled importů najdete v nabídce Nastavení → ShowBits."

#: showbits/includes/class-library-page.php
msgid "On the way"
msgstr "Na cestě"

#: showbits/includes/class-library-page.php
msgid "Load more"
msgstr "Načíst další"

#: showbits/includes/class-library-page.php
msgid "Loading …"
msgstr "Načítání…"

#: showbits/includes/class-library-page.php
msgid "No released clips or quote cards yet."
msgstr "Zatím žádné schválené klipy ani obrázky s citáty."

#. translators: %s: date and time the embargo ends
#: showbits/includes/class-library-page.php
msgid "Embargo until %s"
msgstr "Embargo do %s"

#: showbits/includes/class-library-page.php
msgid "Not ready yet"
msgstr "Ještě není připraveno"

#: showbits/includes/class-library-page.php
msgid "In the media library"
msgstr "V knihovně médií"

#: showbits/includes/class-library-page.php
msgid "An older version is in the media library"
msgstr "V knihovně médií je starší verze"

#: showbits/includes/class-library-page.php
msgid "Edit"
msgstr "Upravit"

#: showbits/includes/class-library-page.php
msgid "Format"
msgstr "Formát"

#: showbits/includes/class-library-page.php
msgid "Video"
msgstr "Video"

#: showbits/includes/class-library-page.php
msgid "Quote card"
msgstr "Obrázek s citátem"

#: showbits/includes/class-library-page.php
msgid "Meme"
msgstr "Mem"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "Failed: %s"
msgstr "Nezdařilo se: %s"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "The library could not be loaded: %s"
msgstr "Knihovnu se nepodařilo načíst: %s"

#: showbits/includes/class-library-page.php
msgid "This site is not connected to ShowBits yet."
msgstr "Tento web ještě není připojen k ShowBits."

#: showbits/includes/class-library-page.php
msgid "Connect it in the settings."
msgstr "Připojte ho v nastavení."

#: showbits/includes/class-library-page.php
msgid "An administrator of this site connects it in the settings."
msgstr "Připojit ho může administrátor tohoto webu v nastavení."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-library-page.php
msgid "Released clips and quote cards from the ShowBits workspace “%s”. What you import lands in the media library, ready for posts and pages."
msgstr "Schválené klipy a obrázky s citáty z pracovního prostoru ShowBits „%s“. Co naimportujete, najdete v knihovně médií, připravené pro příspěvky a stránky."

#: showbits/includes/class-library-page.php
msgid "The library needs JavaScript."
msgstr "Knihovna vyžaduje JavaScript."

#: showbits/includes/class-settings-page.php
msgid "Settings"
msgstr "Nastavení"

#: showbits/includes/class-settings-page.php
msgid "You may not change these settings."
msgstr "Nemáte oprávnění měnit tato nastavení."

#: showbits/includes/class-settings-page.php
msgid "Connection"
msgstr "Připojení"

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-settings-page.php
msgid "Connected to the workspace “%s”."
msgstr "Připojeno k pracovnímu prostoru „%s“."

#. translators: 1: imports today, 2: imports a day the plan allows
#: showbits/includes/class-settings-page.php
msgid "Imports today: %1$d of %2$d."
msgstr "Dnešní importy: %1$d z %2$d."

#. translators: 1: a person, 2: a date, 3: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "Connected by %1$s on %2$s, at %3$s."
msgstr "Připojeno uživatelem %1$s dne %2$s k %3$s."

#: showbits/includes/class-settings-page.php
msgid "Connect again"
msgstr "Opětovné připojení"

#: showbits/includes/class-settings-page.php
msgid "With a new site key the site renews its connection, or moves to another workspace."
msgstr "Novým klíčem webu obnovíte připojení nebo web přesunete do jiného pracovního prostoru."

#. translators: %s: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "ShowBits (%s) cannot be reached right now. The connection stays; try again later."
msgstr "ShowBits (%s) je momentálně nedostupný. Připojení zůstává zachováno; zkuste to později."

#: showbits/includes/class-settings-page.php
msgid "ShowBits no longer accepts this site’s connection: it was disconnected in ShowBits, the plan ended, or this site’s keys changed. Connect it again with a new site key."
msgstr "ShowBits už nepřijímá připojení tohoto webu: bylo odpojeno v ShowBits, tarif skončil nebo se změnily klíče tohoto webu. Připojte web znovu pomocí nového klíče webu."

#: showbits/includes/class-settings-page.php
msgid "Connect this site to a ShowBits workspace: an admin or owner of the workspace makes a site key for this site in ShowBits (Integrations → WordPress). The site can then take released clips and quote cards into its media library, and receive what your ShowBits admins send."
msgstr "Připojte tento web k pracovnímu prostoru ShowBits: administrátor nebo vlastník pracovního prostoru vytvoří v ShowBits klíč webu pro tento web (Integrations → WordPress). Web pak může přebírat schválené klipy a obrázky s citáty do své knihovny médií a přijímat to, co posílají vaši administrátoři ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Imports"
msgstr "Importy"

#: showbits/includes/class-settings-page.php
msgid "Format of quote cards"
msgstr "Formát obrázků s citáty"

#: showbits/includes/class-settings-page.php
msgid "4:5 (feeds, articles)"
msgstr "4:5 (feedy, články)"

#: showbits/includes/class-settings-page.php
msgid "1:1 (square)"
msgstr "1:1 (čtverec)"

#: showbits/includes/class-settings-page.php
msgid "9:16 (stories)"
msgstr "9:16 (příběhy)"

#: showbits/includes/class-settings-page.php
msgid "The picture pushes bring; in the library you choose for each card."
msgstr "Formát obrázků odeslaných na web; v knihovně ho vybíráte u každého obrázku zvlášť."

#: showbits/includes/class-settings-page.php
msgid "Videos"
msgstr "Videa"

#: showbits/includes/class-settings-page.php
msgid "Import the thumbnail as the video’s poster image"
msgstr "Importovat náhled jako plakátový obrázek videa"

#: showbits/includes/class-settings-page.php
msgid "Save"
msgstr "Uložit"

#: showbits/includes/class-settings-page.php
msgid "Site key"
msgstr "Klíč webu"

#. translators: %s: this site's address
#: showbits/includes/class-settings-page.php
msgid "Made in ShowBits for %s, valid for 24 hours and only once. ShowBits then checks that it is talking to this site."
msgstr "Vytváří se v ShowBits pro %s; platí 24 hodin a lze ho použít jen jednou. ShowBits pak ověří, že komunikuje právě s tímto webem."

#: showbits/includes/class-settings-page.php
msgid "Connect"
msgstr "Připojit"

#: showbits/includes/class-settings-page.php
msgid "Are you an admin or owner of the workspace yourself? Then sign in to ShowBits and agree there, without a site key:"
msgstr "Jste sami administrátorem nebo vlastníkem pracovního prostoru? Pak se přihlaste do ShowBits a udělte tam souhlas, bez klíče webu:"

#: showbits/includes/class-settings-page.php
msgid "Connect through ShowBits"
msgstr "Připojit přes ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits address"
msgstr "Adresa ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits Cloud: https://app.showbits.ai. OnPremise: the address of your installation."
msgstr "ShowBits Cloud: https://app.showbits.ai. OnPremise: adresa vaší instalace."

#: showbits/includes/class-settings-page.php
msgid "Disconnect"
msgstr "Odpojit"

#: showbits/includes/class-settings-page.php
msgid "Disconnect this site from ShowBits? What is in the media library stays."
msgstr "Odpojit tento web od ShowBits? Co je v knihovně médií, zůstane."

#: showbits/includes/class-settings-page.php
msgid "asked for"
msgstr "Vyžádáno"

#: showbits/includes/class-settings-page.php
msgid "waiting"
msgstr "Ve frontě"

#: showbits/includes/class-settings-page.php
msgid "importing"
msgstr "Importuje se"

#: showbits/includes/class-settings-page.php
msgid "imported"
msgstr "Importováno"

#: showbits/includes/class-settings-page.php
msgid "failed"
msgstr "Nezdařilo se"

#: showbits/includes/class-settings-page.php
msgid "Recent imports"
msgstr "Poslední importy"

#: showbits/includes/class-settings-page.php
msgid "When"
msgstr "Datum"

#: showbits/includes/class-settings-page.php
msgid "Clip"
msgstr "Klip"

#: showbits/includes/class-settings-page.php
msgid "How"
msgstr "Způsob"

#: showbits/includes/class-settings-page.php
msgid "State"
msgstr "Stav"

#: showbits/includes/class-settings-page.php
msgid "sent from ShowBits"
msgstr "Odesláno ze ShowBits"

#: showbits/includes/class-settings-page.php
msgid "picked here"
msgstr "Vybráno zde"

#: showbits/includes/class-settings-page.php
msgid "Connected. The library is under Media → ShowBits."
msgstr "Připojeno. Knihovnu najdete v nabídce Média → ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Disconnected. What is in the media library stays."
msgstr "Odpojeno. Co je v knihovně médií, zůstává."

#: showbits/includes/class-settings-page.php
msgid "Saved."
msgstr "Uloženo."

#: showbits/includes/class-settings-page.php
msgid "Connecting was cancelled in ShowBits."
msgstr "Připojování bylo v ShowBits zrušeno."

#: showbits/includes/class-settings-page.php
msgid "That way back from ShowBits did not belong to this attempt. Start again."
msgstr "Tento návrat ze ShowBits nepatří k tomuto pokusu o připojení. Začněte znovu."

#: showbits/includes/class-settings-page.php
msgid "The ShowBits address must start with https://."
msgstr "Adresa ShowBits musí začínat na https://."

#: showbits/includes/class-settings-page.php
msgid "That is not a site key. Copy it from ShowBits (Integrations → WordPress) again."
msgstr "To není klíč webu. Zkopírujte ho znovu ze ShowBits (Integrations → WordPress)."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not take the site key: it is unknown, used, withdrawn or expired (a site key lasts 24 hours, a consent ten minutes). Make a new one."
msgstr "ShowBits klíč webu nepřijal: je neznámý, použitý, odvolaný nebo mu vypršela platnost (klíč webu platí 24 hodin, souhlas deset minut). Vytvořte nový."

#: showbits/includes/class-settings-page.php
msgid "The site key was made for another address. Make one for this site’s address."
msgstr "Klíč webu byl vytvořen pro jinou adresu. Vytvořte klíč pro adresu tohoto webu."

#: showbits/includes/class-settings-page.php
msgid "ShowBits could not reach this site at its REST API (/wp-json/showbits/v1/push), or ShowBits itself could not be reached. The site must be public over HTTPS; a firewall or security plugin must let ShowBits in."
msgstr "ShowBits se k tomuto webu nedostal přes jeho REST API (/wp-json/showbits/v1/push) nebo byl nedostupný samotný ShowBits. Web musí být veřejně dostupný přes HTTPS; firewall nebo bezpečnostní plugin musí ShowBits propustit."

#: showbits/includes/class-settings-page.php
msgid "This site did not answer ShowBits’ check as expected. Try again; if it fails again, a cache or security plugin may answer for WordPress."
msgstr "Tento web neodpověděl na kontrolu ShowBits podle očekávání. Zkuste to znovu; pokud to opět selže, možná místo WordPressu odpovídá cachovací nebo bezpečnostní plugin."

#: showbits/includes/class-settings-page.php
msgid "The workspace’s plan has ended, or whoever made the site key may no longer connect sites."
msgstr "Tarif pracovního prostoru skončil nebo ten, kdo vytvořil klíč webu, už nesmí připojovat weby."

#: showbits/includes/class-settings-page.php
msgid "The workspace has as many sites as its plan allows."
msgstr "Pracovní prostor už má tolik webů, kolik jeho tarif dovoluje."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not accept this site’s address. It must be served over HTTPS."
msgstr "ShowBits nepřijal adresu tohoto webu. Web musí běžet přes HTTPS."

#: showbits/includes/class-settings-page.php
msgid "Connecting did not work. Try again, or ask your ShowBits contact."
msgstr "Připojení se nezdařilo. Zkuste to znovu nebo se obraťte na svou kontaktní osobu v ShowBits."
