# Esperanto translation of the ShowBits plugin.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: eo\n"
"Plural-Forms: nplurals=2; plural=n != 1;\n"

#. Description of the plugin
#: showbits/showbits.php
msgid "Released clips and quote cards from ShowBits in the media library: pick them in WordPress, or receive what your ShowBits admins send."
msgstr "Aprobitaj klipoj kaj citaĵkartoj el ShowBits en la aŭdovida biblioteko: elektu ilin en WordPress aŭ ricevu tion, kion sendas viaj ShowBits-administrantoj."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer as expected."
msgstr "ShowBits ne respondis kiel atendite."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer with a file."
msgstr "ShowBits ne liveris dosieron."

#: showbits/includes/class-api-client.php showbits/includes/class-importer.php
msgid "ShowBits could not be reached."
msgstr "Ne eblis atingi ShowBits."

#. translators: 1: ShowBits' reason, 2: the HTTP status
#: showbits/includes/class-api-client.php
msgid "ShowBits refused (%1$s, HTTP %2$d)."
msgstr "ShowBits rifuzis la peton (%1$s, HTTP %2$d)."

#: showbits/includes/class-connection.php
msgid "You may not connect this site."
msgstr "Vi ne rajtas konekti ĉi tiun retejon."

#. translators: %s: the clip's title
#: showbits/includes/class-importer.php
msgid "%s (thumbnail)"
msgstr "%s (bildeto)"

#. translators: %s: a quote (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%s”"
msgstr "“%s”"

#. translators: 1: a quote, 2: who said it (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%1$s” – %2$s"
msgstr "“%1$s” – %2$s"

#: showbits/includes/class-importer.php
msgid "This is not a clip or a format ShowBits offers."
msgstr "Tio estas nek klipo nek formato, kiun ShowBits proponas."

#: showbits/includes/class-importer.php
msgid "The clip is no longer released in ShowBits."
msgstr "La klipo ne plu estas aprobita en ShowBits."

#: showbits/includes/class-importer.php
msgid "The embargo still holds: the file stays in ShowBits until it ends."
msgstr "La embargo ankoraŭ validas: la dosiero restas en ShowBits, ĝis la embargo finiĝos."

#: showbits/includes/class-importer.php
msgid "The file is not ready yet in ShowBits."
msgstr "La dosiero ankoraŭ ne estas preta en ShowBits."

#: showbits/includes/class-importer.php
msgid "The file could not be downloaded."
msgstr "Ne eblis elŝuti la dosieron."

#: showbits/includes/class-importer.php
msgid "WordPress did not take the file into the media library."
msgstr "WordPress ne akceptis la dosieron en la aŭdovidan bibliotekon."

#: showbits/includes/class-importer.php
msgid "The delivery from ShowBits is no longer valid. Import the clip again."
msgstr "La livero el ShowBits ne plu validas. Importu la klipon denove."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer accepts this site’s connection: connect it again under Settings → ShowBits."
msgstr "ShowBits ne plu akceptas la konekton de ĉi tiu retejo: rekonektu ĝin en Agordoj → ShowBits."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer delivers to this site: the workspace’s plan has ended."
msgstr "ShowBits ne plu liveras al ĉi tiu retejo: la abono de la laborspaco finiĝis."

#: showbits/includes/class-importer.php
msgid "The site’s imports for today are used up. Try again tomorrow."
msgstr "La hodiaŭaj importoj de la retejo estas elĉerpitaj. Provu denove morgaŭ."

#: showbits/includes/class-importer.php
msgid "The import was interrupted."
msgstr "La importo estis interrompita."

#: showbits/includes/class-importer.php
msgid "The import failed."
msgstr "La importo malsukcesis."

#: showbits/includes/class-library-endpoint.php
msgid "This site is not connected to ShowBits."
msgstr "Ĉi tiu retejo ne estas konektita al ShowBits."

#: showbits/includes/class-library-page.php
msgid "All"
msgstr "Ĉiuj"

#: showbits/includes/class-library-page.php
msgid "Clips"
msgstr "Klipoj"

#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Quote cards"
msgstr "Citaĵkartoj"

#: showbits/includes/class-library-page.php
msgid "Search titles"
msgstr "Serĉi en titoloj"

#: showbits/includes/class-library-page.php
msgid "Search the library"
msgstr "Serĉi en la biblioteko"

#: showbits/includes/class-library-page.php
msgid "Import selected"
msgstr "Importi la elektitajn"

#. translators: 1: which one, 2: how many in all
#: showbits/includes/class-library-page.php
msgid "Asking ShowBits for %1$d of %2$d …"
msgstr "Petante de ShowBits: %1$d el %2$d…"

#. translators: %d: how many clips are still on their way
#: showbits/includes/class-library-page.php
msgid "On the way from ShowBits: %d …"
msgstr "Survoje el ShowBits: %d…"

#. translators: %d: how many clips were imported
#: showbits/includes/class-library-page.php
msgid "Imported: %d"
msgstr "Importitaj: %d"

#: showbits/includes/class-library-page.php
msgid "Not everything has arrived yet; it continues in the background. Settings → ShowBits lists the imports."
msgstr "Ankoraŭ ne ĉio alvenis; la importado daŭras fone. La importoj estas listigitaj en Agordoj → ShowBits."

#: showbits/includes/class-library-page.php
msgid "On the way"
msgstr "Survoje"

#: showbits/includes/class-library-page.php
msgid "Load more"
msgstr "Ŝargi pliajn"

#: showbits/includes/class-library-page.php
msgid "Loading …"
msgstr "Ŝargante…"

#: showbits/includes/class-library-page.php
msgid "No released clips or quote cards yet."
msgstr "Ankoraŭ neniuj aprobitaj klipoj aŭ citaĵkartoj."

#. translators: %s: date and time the embargo ends
#: showbits/includes/class-library-page.php
msgid "Embargo until %s"
msgstr "Embargo ĝis %s"

#: showbits/includes/class-library-page.php
msgid "Not ready yet"
msgstr "Ankoraŭ ne preta"

#: showbits/includes/class-library-page.php
msgid "In the media library"
msgstr "En la aŭdovida biblioteko"

#: showbits/includes/class-library-page.php
msgid "An older version is in the media library"
msgstr "Pli malnova versio estas en la aŭdovida biblioteko"

#: showbits/includes/class-library-page.php
msgid "Edit"
msgstr "Redakti"

#: showbits/includes/class-library-page.php
msgid "Format"
msgstr "Formato"

#: showbits/includes/class-library-page.php
msgid "Video"
msgstr "Video"

#: showbits/includes/class-library-page.php
msgid "Quote card"
msgstr "Citaĵkarto"

#: showbits/includes/class-library-page.php
msgid "Meme"
msgstr "Memeo"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "Failed: %s"
msgstr "Malsukcesis: %s"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "The library could not be loaded: %s"
msgstr "Ne eblis ŝargi la bibliotekon: %s"

#: showbits/includes/class-library-page.php
msgid "This site is not connected to ShowBits yet."
msgstr "Ĉi tiu retejo ankoraŭ ne estas konektita al ShowBits."

#: showbits/includes/class-library-page.php
msgid "Connect it in the settings."
msgstr "Konektu ĝin en la agordoj."

#: showbits/includes/class-library-page.php
msgid "An administrator of this site connects it in the settings."
msgstr "Administranto de ĉi tiu retejo povas konekti ĝin en la agordoj."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-library-page.php
msgid "Released clips and quote cards from the ShowBits workspace “%s”. What you import lands in the media library, ready for posts and pages."
msgstr "Aprobitaj klipoj kaj citaĵkartoj el la ShowBits-laborspaco “%s”. Kion vi importas, tio aperas en la aŭdovida biblioteko, preta por afiŝoj kaj paĝoj."

#: showbits/includes/class-library-page.php
msgid "The library needs JavaScript."
msgstr "La biblioteko bezonas JavaScript."

#: showbits/includes/class-settings-page.php
msgid "Settings"
msgstr "Agordoj"

#: showbits/includes/class-settings-page.php
msgid "You may not change these settings."
msgstr "Vi ne rajtas ŝanĝi ĉi tiujn agordojn."

#: showbits/includes/class-settings-page.php
msgid "Connection"
msgstr "Konekto"

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-settings-page.php
msgid "Connected to the workspace “%s”."
msgstr "Konektita al la laborspaco “%s”."

#. translators: 1: imports today, 2: imports a day the plan allows
#: showbits/includes/class-settings-page.php
msgid "Imports today: %1$d of %2$d."
msgstr "Importoj hodiaŭ: %1$d el %2$d."

#. translators: 1: a person, 2: a date, 3: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "Connected by %1$s on %2$s, at %3$s."
msgstr "Konektita de %1$s je %2$s, ĉe %3$s."

#: showbits/includes/class-settings-page.php
msgid "Connect again"
msgstr "Rekonekti"

#: showbits/includes/class-settings-page.php
msgid "With a new site key the site renews its connection, or moves to another workspace."
msgstr "Per nova reteja ŝlosilo la retejo renovigas sian konekton aŭ transiras al alia laborspaco."

#. translators: %s: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "ShowBits (%s) cannot be reached right now. The connection stays; try again later."
msgstr "ShowBits (%s) nun ne estas atingebla. La konekto restas; provu denove poste."

#: showbits/includes/class-settings-page.php
msgid "ShowBits no longer accepts this site’s connection: it was disconnected in ShowBits, the plan ended, or this site’s keys changed. Connect it again with a new site key."
msgstr "ShowBits ne plu akceptas la konekton de ĉi tiu retejo: ĝi estis malkonektita en ShowBits, la abono finiĝis aŭ la ŝlosiloj de ĉi tiu retejo ŝanĝiĝis. Rekonektu ĝin per nova reteja ŝlosilo."

#: showbits/includes/class-settings-page.php
msgid "Connect this site to a ShowBits workspace: an admin or owner of the workspace makes a site key for this site in ShowBits (Integrations → WordPress). The site can then take released clips and quote cards into its media library, and receive what your ShowBits admins send."
msgstr "Konektu ĉi tiun retejon al ShowBits-laborspaco: administranto aŭ posedanto de la laborspaco kreas en ShowBits retejan ŝlosilon por ĉi tiu retejo (Integrations → WordPress). Poste la retejo povas preni aprobitajn klipojn kaj citaĵkartojn en sian aŭdovidan bibliotekon kaj ricevi tion, kion sendas viaj ShowBits-administrantoj."

#: showbits/includes/class-settings-page.php
msgid "Imports"
msgstr "Importoj"

#: showbits/includes/class-settings-page.php
msgid "Format of quote cards"
msgstr "Formato de citaĵkartoj"

#: showbits/includes/class-settings-page.php
msgid "4:5 (feeds, articles)"
msgstr "4:5 (fluoj, artikoloj)"

#: showbits/includes/class-settings-page.php
msgid "1:1 (square)"
msgstr "1:1 (kvadrata)"

#: showbits/includes/class-settings-page.php
msgid "9:16 (stories)"
msgstr "9:16 (rakontoj)"

#: showbits/includes/class-settings-page.php
msgid "The picture pushes bring; in the library you choose for each card."
msgstr "La formato de kartoj senditaj al ĉi tiu retejo; en la biblioteko vi elektas ĝin por ĉiu karto."

#: showbits/includes/class-settings-page.php
msgid "Videos"
msgstr "Videoj"

#: showbits/includes/class-settings-page.php
msgid "Import the thumbnail as the video’s poster image"
msgstr "Importi la bildeton kiel afiŝbildon de la video"

#: showbits/includes/class-settings-page.php
msgid "Save"
msgstr "Konservi"

#: showbits/includes/class-settings-page.php
msgid "Site key"
msgstr "Reteja ŝlosilo"

#. translators: %s: this site's address
#: showbits/includes/class-settings-page.php
msgid "Made in ShowBits for %s, valid for 24 hours and only once. ShowBits then checks that it is talking to this site."
msgstr "Kreita en ShowBits por %s, valida dum 24 horoj kaj nur unufoje. Poste ShowBits kontrolas, ke ĝi komunikas ĝuste kun ĉi tiu retejo."

#: showbits/includes/class-settings-page.php
msgid "Connect"
msgstr "Konekti"

#: showbits/includes/class-settings-page.php
msgid "Are you an admin or owner of the workspace yourself? Then sign in to ShowBits and agree there, without a site key:"
msgstr "Ĉu vi mem estas administranto aŭ posedanto de la laborspaco? Tiam ensalutu al ShowBits kaj konsentu tie, sen reteja ŝlosilo:"

#: showbits/includes/class-settings-page.php
msgid "Connect through ShowBits"
msgstr "Konekti per ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits address"
msgstr "Adreso de ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits Cloud: https://app.showbits.ai. OnPremise: the address of your installation."
msgstr "ShowBits Cloud: https://app.showbits.ai. OnPremise: la adreso de via instalaĵo."

#: showbits/includes/class-settings-page.php
msgid "Disconnect"
msgstr "Malkonekti"

#: showbits/includes/class-settings-page.php
msgid "Disconnect this site from ShowBits? What is in the media library stays."
msgstr "Ĉu malkonekti ĉi tiun retejon de ShowBits? Kio estas en la aŭdovida biblioteko, tio restas."

#: showbits/includes/class-settings-page.php
msgid "asked for"
msgstr "Petita"

#: showbits/includes/class-settings-page.php
msgid "waiting"
msgstr "Atendanta"

#: showbits/includes/class-settings-page.php
msgid "importing"
msgstr "Importata"

#: showbits/includes/class-settings-page.php
msgid "imported"
msgstr "Importita"

#: showbits/includes/class-settings-page.php
msgid "failed"
msgstr "Malsukcesis"

#: showbits/includes/class-settings-page.php
msgid "Recent imports"
msgstr "Lastatempaj importoj"

#: showbits/includes/class-settings-page.php
msgid "When"
msgstr "Dato"

#: showbits/includes/class-settings-page.php
msgid "Clip"
msgstr "Klipo"

#: showbits/includes/class-settings-page.php
msgid "How"
msgstr "Deveno"

#: showbits/includes/class-settings-page.php
msgid "State"
msgstr "Stato"

#: showbits/includes/class-settings-page.php
msgid "sent from ShowBits"
msgstr "Sendita el ShowBits"

#: showbits/includes/class-settings-page.php
msgid "picked here"
msgstr "Elektita ĉi tie"

#: showbits/includes/class-settings-page.php
msgid "Connected. The library is under Media → ShowBits."
msgstr "Konektita. La biblioteko troviĝas en Aŭdovidaĵoj → ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Disconnected. What is in the media library stays."
msgstr "Malkonektita. Kio estas en la aŭdovida biblioteko, tio restas."

#: showbits/includes/class-settings-page.php
msgid "Saved."
msgstr "La agordoj estas konservitaj."

#: showbits/includes/class-settings-page.php
msgid "Connecting was cancelled in ShowBits."
msgstr "La konektado estis nuligita en ShowBits."

#: showbits/includes/class-settings-page.php
msgid "That way back from ShowBits did not belong to this attempt. Start again."
msgstr "Ĉi tiu reveno el ShowBits ne apartenas al la konekta provo, kiun komencis ĉi tiu retejo. Rekomencu."

#: showbits/includes/class-settings-page.php
msgid "The ShowBits address must start with https://."
msgstr "La adreso de ShowBits devas komenciĝi per https://."

#: showbits/includes/class-settings-page.php
msgid "That is not a site key. Copy it from ShowBits (Integrations → WordPress) again."
msgstr "Tio ne estas reteja ŝlosilo. Kopiu ĝin denove el ShowBits (Integrations → WordPress)."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not take the site key: it is unknown, used, withdrawn or expired (a site key lasts 24 hours, a consent ten minutes). Make a new one."
msgstr "ShowBits ne akceptis la retejan ŝlosilon: ĝi estas nekonata, jam uzita, revokita aŭ eksvalidiĝinta (reteja ŝlosilo validas 24 horojn, konsento dek minutojn). Kreu novan."

#: showbits/includes/class-settings-page.php
msgid "The site key was made for another address. Make one for this site’s address."
msgstr "La reteja ŝlosilo estis kreita por alia adreso. Kreu unu por la adreso de ĉi tiu retejo."

#: showbits/includes/class-settings-page.php
msgid "ShowBits could not reach this site at its REST API (/wp-json/showbits/v1/push), or ShowBits itself could not be reached. The site must be public over HTTPS; a firewall or security plugin must let ShowBits in."
msgstr "ShowBits ne povis atingi ĉi tiun retejon per ĝia REST-API (/wp-json/showbits/v1/push), aŭ ShowBits mem ne estis atingebla. La retejo devas esti publike alirebla per HTTPS; fajroŝirmilo aŭ sekureca kromprogramo devas enlasi ShowBits."

#: showbits/includes/class-settings-page.php
msgid "This site did not answer ShowBits’ check as expected. Try again; if it fails again, a cache or security plugin may answer for WordPress."
msgstr "Ĉi tiu retejo ne respondis kiel atendite al la kontrolo de ShowBits. Provu denove; se ĝi denove malsukcesos, eble kaŝmemora aŭ sekureca kromprogramo respondas anstataŭ WordPress."

#: showbits/includes/class-settings-page.php
msgid "The workspace’s plan has ended, or whoever made the site key may no longer connect sites."
msgstr "La abono de la laborspaco finiĝis, aŭ kiu kreis la retejan ŝlosilon, tiu ne plu rajtas konekti retejojn."

#: showbits/includes/class-settings-page.php
msgid "The workspace has as many sites as its plan allows."
msgstr "La laborspaco jam havas tiom da retejoj, kiom ĝia abono permesas."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not accept this site’s address. It must be served over HTTPS."
msgstr "ShowBits ne akceptis la adreson de ĉi tiu retejo. La retejo devas esti servata per HTTPS."

#: showbits/includes/class-settings-page.php
msgid "Connecting did not work. Try again, or ask your ShowBits contact."
msgstr "La konektado ne sukcesis. Provu denove aŭ demandu vian kontaktulon ĉe ShowBits."
