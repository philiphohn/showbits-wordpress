# Spanish (Spain) translation of the ShowBits plugin.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: es_ES\n"
"Plural-Forms: nplurals=2; plural=n != 1;\n"

#. Description of the plugin
#: showbits/showbits.php
msgid "Released clips and quote cards from ShowBits in the media library: pick them in WordPress, or receive what your ShowBits admins send."
msgstr "Clips y tarjetas con cita aprobados de ShowBits en la biblioteca de medios: elígelos en WordPress o recibe lo que envíen tus administradores de ShowBits."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer as expected."
msgstr "ShowBits no ha respondido como se esperaba."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer with a file."
msgstr "ShowBits no ha devuelto ningún archivo."

#: showbits/includes/class-api-client.php showbits/includes/class-importer.php
msgid "ShowBits could not be reached."
msgstr "No se ha podido acceder a ShowBits."

#. translators: 1: ShowBits' reason, 2: the HTTP status
#: showbits/includes/class-api-client.php
msgid "ShowBits refused (%1$s, HTTP %2$d)."
msgstr "ShowBits ha rechazado la solicitud (%1$s, HTTP %2$d)."

#: showbits/includes/class-connection.php
msgid "You may not connect this site."
msgstr "No tienes permiso para conectar este sitio."

#. translators: %s: the clip's title
#: showbits/includes/class-importer.php
msgid "%s (thumbnail)"
msgstr "%s (miniatura)"

#. translators: %s: a quote (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%s”"
msgstr "«%s»"

#. translators: 1: a quote, 2: who said it (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%1$s” – %2$s"
msgstr "«%1$s» – %2$s"

#: showbits/includes/class-importer.php
msgid "This is not a clip or a format ShowBits offers."
msgstr "Esto no es un clip ni un formato que ofrezca ShowBits."

#: showbits/includes/class-importer.php
msgid "The clip is no longer released in ShowBits."
msgstr "El clip ya no está aprobado en ShowBits."

#: showbits/includes/class-importer.php
msgid "The embargo still holds: the file stays in ShowBits until it ends."
msgstr "El embargo sigue vigente: hasta que termine, el archivo permanecerá en ShowBits."

#: showbits/includes/class-importer.php
msgid "The file is not ready yet in ShowBits."
msgstr "El archivo aún no está listo en ShowBits."

#: showbits/includes/class-importer.php
msgid "The file could not be downloaded."
msgstr "No se ha podido descargar el archivo."

#: showbits/includes/class-importer.php
msgid "WordPress did not take the file into the media library."
msgstr "WordPress no ha aceptado el archivo en la biblioteca de medios."

#: showbits/includes/class-importer.php
msgid "The delivery from ShowBits is no longer valid. Import the clip again."
msgstr "El envío de ShowBits ya no es válido. Vuelve a importar el clip."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer accepts this site’s connection: connect it again under Settings → ShowBits."
msgstr "ShowBits ya no acepta la conexión de este sitio: vuelve a conectarlo en Ajustes → ShowBits."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer delivers to this site: the workspace’s plan has ended."
msgstr "ShowBits ya no envía contenido a este sitio: el plan del espacio de trabajo ha terminado."

#: showbits/includes/class-importer.php
msgid "The site’s imports for today are used up. Try again tomorrow."
msgstr "Este sitio ha alcanzado el límite diario de importaciones. Inténtalo de nuevo mañana."

#: showbits/includes/class-importer.php
msgid "The import was interrupted."
msgstr "La importación se ha interrumpido."

#: showbits/includes/class-importer.php
msgid "The import failed."
msgstr "La importación ha fallado."

#: showbits/includes/class-library-endpoint.php
msgid "This site is not connected to ShowBits."
msgstr "Este sitio no está conectado a ShowBits."

#: showbits/includes/class-library-page.php
msgid "All"
msgstr "Todos"

#: showbits/includes/class-library-page.php
msgid "Clips"
msgstr "Clips"

#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Quote cards"
msgstr "Tarjetas con cita"

#: showbits/includes/class-library-page.php
msgid "Search titles"
msgstr "Buscar por título"

#: showbits/includes/class-library-page.php
msgid "Search the library"
msgstr "Buscar en la biblioteca"

#: showbits/includes/class-library-page.php
msgid "Import selected"
msgstr "Importar seleccionados"

#. translators: 1: which one, 2: how many in all
#: showbits/includes/class-library-page.php
msgid "Asking ShowBits for %1$d of %2$d …"
msgstr "Solicitando a ShowBits: %1$d de %2$d…"

#. translators: %d: how many clips are still on their way
#: showbits/includes/class-library-page.php
msgid "On the way from ShowBits: %d …"
msgstr "En camino desde ShowBits: %d…"

#. translators: %d: how many clips were imported
#: showbits/includes/class-library-page.php
msgid "Imported: %d"
msgstr "Importados: %d"

#: showbits/includes/class-library-page.php
msgid "Not everything has arrived yet; it continues in the background. Settings → ShowBits lists the imports."
msgstr "Aún no ha llegado todo; el proceso continúa en segundo plano. Puedes ver las importaciones en Ajustes → ShowBits."

#: showbits/includes/class-library-page.php
msgid "On the way"
msgstr "En camino"

#: showbits/includes/class-library-page.php
msgid "Load more"
msgstr "Cargar más"

#: showbits/includes/class-library-page.php
msgid "Loading …"
msgstr "Cargando…"

#: showbits/includes/class-library-page.php
msgid "No released clips or quote cards yet."
msgstr "Aún no hay clips ni tarjetas con cita aprobados."

#. translators: %s: date and time the embargo ends
#: showbits/includes/class-library-page.php
msgid "Embargo until %s"
msgstr "Embargo hasta el %s"

#: showbits/includes/class-library-page.php
msgid "Not ready yet"
msgstr "Aún no está listo"

#: showbits/includes/class-library-page.php
msgid "In the media library"
msgstr "En la biblioteca de medios"

#: showbits/includes/class-library-page.php
msgid "An older version is in the media library"
msgstr "Hay una versión anterior en la biblioteca de medios"

#: showbits/includes/class-library-page.php
msgid "Edit"
msgstr "Editar"

#: showbits/includes/class-library-page.php
msgid "Format"
msgstr "Formato"

#: showbits/includes/class-library-page.php
msgid "Video"
msgstr "Vídeo"

#: showbits/includes/class-library-page.php
msgid "Quote card"
msgstr "Tarjeta con cita"

#: showbits/includes/class-library-page.php
msgid "Meme"
msgstr "Meme"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "Failed: %s"
msgstr "Error: %s"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "The library could not be loaded: %s"
msgstr "No se ha podido cargar la biblioteca: %s"

#: showbits/includes/class-library-page.php
msgid "This site is not connected to ShowBits yet."
msgstr "Este sitio aún no está conectado a ShowBits."

#: showbits/includes/class-library-page.php
msgid "Connect it in the settings."
msgstr "Conéctalo en los ajustes."

#: showbits/includes/class-library-page.php
msgid "An administrator of this site connects it in the settings."
msgstr "Un administrador de este sitio debe conectarlo en los ajustes."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-library-page.php
msgid "Released clips and quote cards from the ShowBits workspace “%s”. What you import lands in the media library, ready for posts and pages."
msgstr "Clips y tarjetas con cita aprobados del espacio de trabajo de ShowBits «%s». Lo que importes llega a la biblioteca de medios, listo para usar en entradas y páginas."

#: showbits/includes/class-library-page.php
msgid "The library needs JavaScript."
msgstr "La biblioteca necesita JavaScript."

#: showbits/includes/class-settings-page.php
msgid "Settings"
msgstr "Ajustes"

#: showbits/includes/class-settings-page.php
msgid "You may not change these settings."
msgstr "No tienes permiso para cambiar estos ajustes."

#: showbits/includes/class-settings-page.php
msgid "Connection"
msgstr "Conexión"

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-settings-page.php
msgid "Connected to the workspace “%s”."
msgstr "Conectado al espacio de trabajo «%s»."

#. translators: 1: imports today, 2: imports a day the plan allows
#: showbits/includes/class-settings-page.php
msgid "Imports today: %1$d of %2$d."
msgstr "Importaciones de hoy: %1$d de %2$d."

#. translators: 1: a person, 2: a date, 3: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "Connected by %1$s on %2$s, at %3$s."
msgstr "Conectado a %3$s por %1$s el %2$s."

#: showbits/includes/class-settings-page.php
msgid "Connect again"
msgstr "Volver a conectar"

#: showbits/includes/class-settings-page.php
msgid "With a new site key the site renews its connection, or moves to another workspace."
msgstr "Con una nueva clave de sitio, el sitio renueva su conexión o pasa a otro espacio de trabajo."

#. translators: %s: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "ShowBits (%s) cannot be reached right now. The connection stays; try again later."
msgstr "No se puede acceder a ShowBits (%s) en este momento. La conexión se mantiene; inténtalo de nuevo más tarde."

#: showbits/includes/class-settings-page.php
msgid "ShowBits no longer accepts this site’s connection: it was disconnected in ShowBits, the plan ended, or this site’s keys changed. Connect it again with a new site key."
msgstr "ShowBits ya no acepta la conexión de este sitio: se ha desconectado en ShowBits, el plan ha terminado o las claves de este sitio han cambiado. Vuelve a conectarlo con una nueva clave de sitio."

#: showbits/includes/class-settings-page.php
msgid "Connect this site to a ShowBits workspace: an admin or owner of the workspace makes a site key for this site in ShowBits (Integrations → WordPress). The site can then take released clips and quote cards into its media library, and receive what your ShowBits admins send."
msgstr "Conecta este sitio a un espacio de trabajo de ShowBits: un administrador o propietario del espacio de trabajo genera en ShowBits una clave de sitio para este sitio (Integrations → WordPress). Después, el sitio podrá importar a su biblioteca de medios los clips y tarjetas con cita aprobados, además de recibir lo que envíen tus administradores de ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Imports"
msgstr "Importaciones"

#: showbits/includes/class-settings-page.php
msgid "Format of quote cards"
msgstr "Formato de las tarjetas con cita"

#: showbits/includes/class-settings-page.php
msgid "4:5 (feeds, articles)"
msgstr "4:5 (feeds, artículos)"

#: showbits/includes/class-settings-page.php
msgid "1:1 (square)"
msgstr "1:1 (cuadrado)"

#: showbits/includes/class-settings-page.php
msgid "9:16 (stories)"
msgstr "9:16 (historias)"

#: showbits/includes/class-settings-page.php
msgid "The picture pushes bring; in the library you choose for each card."
msgstr "Es el formato de imagen de las tarjetas enviadas a este sitio; en la biblioteca puedes elegirlo para cada tarjeta."

#: showbits/includes/class-settings-page.php
msgid "Videos"
msgstr "Vídeos"

#: showbits/includes/class-settings-page.php
msgid "Import the thumbnail as the video’s poster image"
msgstr "Importar la miniatura como imagen de póster del vídeo"

#: showbits/includes/class-settings-page.php
msgid "Save"
msgstr "Guardar"

#: showbits/includes/class-settings-page.php
msgid "Site key"
msgstr "Clave de sitio"

#. translators: %s: this site's address
#: showbits/includes/class-settings-page.php
msgid "Made in ShowBits for %s, valid for 24 hours and only once. ShowBits then checks that it is talking to this site."
msgstr "Generada en ShowBits para %s, válida durante 24 horas y de un solo uso. Después, ShowBits comprueba que se está comunicando con este sitio."

#: showbits/includes/class-settings-page.php
msgid "Connect"
msgstr "Conectar"

#: showbits/includes/class-settings-page.php
msgid "Are you an admin or owner of the workspace yourself? Then sign in to ShowBits and agree there, without a site key:"
msgstr "¿Eres administrador o propietario del espacio de trabajo? Entonces inicia sesión en ShowBits y da allí tu consentimiento, sin clave de sitio:"

#: showbits/includes/class-settings-page.php
msgid "Connect through ShowBits"
msgstr "Conectar a través de ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits address"
msgstr "Dirección de ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits Cloud: https://app.showbits.ai. OnPremise: the address of your installation."
msgstr "ShowBits Cloud: https://app.showbits.ai. OnPremise: la dirección de tu instalación."

#: showbits/includes/class-settings-page.php
msgid "Disconnect"
msgstr "Desconectar"

#: showbits/includes/class-settings-page.php
msgid "Disconnect this site from ShowBits? What is in the media library stays."
msgstr "¿Desconectar este sitio de ShowBits? Lo que ya está en la biblioteca de medios se conserva."

#: showbits/includes/class-settings-page.php
msgid "asked for"
msgstr "Solicitado"

#: showbits/includes/class-settings-page.php
msgid "waiting"
msgstr "En espera"

#: showbits/includes/class-settings-page.php
msgid "importing"
msgstr "Importando"

#: showbits/includes/class-settings-page.php
msgid "imported"
msgstr "Importado"

#: showbits/includes/class-settings-page.php
msgid "failed"
msgstr "Error"

#: showbits/includes/class-settings-page.php
msgid "Recent imports"
msgstr "Importaciones recientes"

#: showbits/includes/class-settings-page.php
msgid "When"
msgstr "Fecha"

#: showbits/includes/class-settings-page.php
msgid "Clip"
msgstr "Clip"

#: showbits/includes/class-settings-page.php
msgid "How"
msgstr "Origen"

#: showbits/includes/class-settings-page.php
msgid "State"
msgstr "Estado"

#: showbits/includes/class-settings-page.php
msgid "sent from ShowBits"
msgstr "Enviado desde ShowBits"

#: showbits/includes/class-settings-page.php
msgid "picked here"
msgstr "Elegido aquí"

#: showbits/includes/class-settings-page.php
msgid "Connected. The library is under Media → ShowBits."
msgstr "Conectado. La biblioteca está en Medios → ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Disconnected. What is in the media library stays."
msgstr "Desconectado. Lo que ya está en la biblioteca de medios se conserva."

#: showbits/includes/class-settings-page.php
msgid "Saved."
msgstr "Ajustes guardados."

#: showbits/includes/class-settings-page.php
msgid "Connecting was cancelled in ShowBits."
msgstr "Se ha cancelado la conexión en ShowBits."

#: showbits/includes/class-settings-page.php
msgid "That way back from ShowBits did not belong to this attempt. Start again."
msgstr "La redirección desde ShowBits no corresponde a este intento de conexión. Empieza de nuevo."

#: showbits/includes/class-settings-page.php
msgid "The ShowBits address must start with https://."
msgstr "La dirección de ShowBits debe empezar por https://."

#: showbits/includes/class-settings-page.php
msgid "That is not a site key. Copy it from ShowBits (Integrations → WordPress) again."
msgstr "El texto pegado no es una clave de sitio. Vuelve a copiarla desde ShowBits (Integrations → WordPress)."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not take the site key: it is unknown, used, withdrawn or expired (a site key lasts 24 hours, a consent ten minutes). Make a new one."
msgstr "ShowBits no ha aceptado la clave de sitio: es desconocida, ya se ha usado, se ha revocado o ha caducado (una clave de sitio dura 24 horas; un consentimiento, diez minutos). Genera una nueva."

#: showbits/includes/class-settings-page.php
msgid "The site key was made for another address. Make one for this site’s address."
msgstr "La clave de sitio se generó para otra dirección. Genera una para la dirección de este sitio."

#: showbits/includes/class-settings-page.php
msgid "ShowBits could not reach this site at its REST API (/wp-json/showbits/v1/push), or ShowBits itself could not be reached. The site must be public over HTTPS; a firewall or security plugin must let ShowBits in."
msgstr "ShowBits no ha podido acceder a este sitio a través de su API REST (/wp-json/showbits/v1/push), o no se ha podido acceder al propio ShowBits. El sitio debe ser accesible públicamente por HTTPS; si hay un cortafuegos o un plugin de seguridad, debe permitir el acceso de ShowBits."

#: showbits/includes/class-settings-page.php
msgid "This site did not answer ShowBits’ check as expected. Try again; if it fails again, a cache or security plugin may answer for WordPress."
msgstr "Este sitio no ha respondido a la comprobación de ShowBits como se esperaba. Inténtalo de nuevo; si vuelve a fallar, puede que un plugin de caché o de seguridad esté respondiendo en lugar de WordPress."

#: showbits/includes/class-settings-page.php
msgid "The workspace’s plan has ended, or whoever made the site key may no longer connect sites."
msgstr "El plan del espacio de trabajo ha terminado o quien generó la clave de sitio ya no puede conectar sitios."

#: showbits/includes/class-settings-page.php
msgid "The workspace has as many sites as its plan allows."
msgstr "El espacio de trabajo ya tiene tantos sitios como permite su plan."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not accept this site’s address. It must be served over HTTPS."
msgstr "ShowBits no ha aceptado la dirección de este sitio. El sitio debe servirse por HTTPS."

#: showbits/includes/class-settings-page.php
msgid "Connecting did not work. Try again, or ask your ShowBits contact."
msgstr "No se ha podido conectar. Inténtalo de nuevo o consulta a tu contacto de ShowBits."
