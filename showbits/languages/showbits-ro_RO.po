# Romanian translation of the ShowBits plugin.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: ro_RO\n"
"Plural-Forms: nplurals=3; plural=(n == 1) ? 0 : ((n == 0 || n % 100 >= 2 && n % 100 <= 19) ? 1 : 2);\n"

#. Description of the plugin
#: showbits/showbits.php
msgid "Released clips and quote cards from ShowBits in the media library: pick them in WordPress, or receive what your ShowBits admins send."
msgstr "Clipuri și carduri cu citate aprobate din ShowBits, în biblioteca media: alege-le în WordPress sau primește ce trimit administratorii tăi din ShowBits."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer as expected."
msgstr "ShowBits nu a răspuns conform așteptărilor."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer with a file."
msgstr "ShowBits nu a trimis niciun fișier."

#: showbits/includes/class-api-client.php showbits/includes/class-importer.php
msgid "ShowBits could not be reached."
msgstr "ShowBits nu a putut fi contactat."

#. translators: 1: ShowBits' reason, 2: the HTTP status
#: showbits/includes/class-api-client.php
msgid "ShowBits refused (%1$s, HTTP %2$d)."
msgstr "ShowBits a refuzat cererea (%1$s, HTTP %2$d)."

#: showbits/includes/class-connection.php
msgid "You may not connect this site."
msgstr "Nu ai permisiunea să conectezi acest site."

#. translators: %s: the clip's title
#: showbits/includes/class-importer.php
msgid "%s (thumbnail)"
msgstr "%s (miniatură)"

#. translators: %s: a quote (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%s”"
msgstr "„%s”"

#. translators: 1: a quote, 2: who said it (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%1$s” – %2$s"
msgstr "„%1$s” – %2$s"

#: showbits/includes/class-importer.php
msgid "This is not a clip or a format ShowBits offers."
msgstr "Acesta nu este nici un clip, nici un format oferit de ShowBits."

#: showbits/includes/class-importer.php
msgid "The clip is no longer released in ShowBits."
msgstr "Clipul nu mai este aprobat în ShowBits."

#: showbits/includes/class-importer.php
msgid "The embargo still holds: the file stays in ShowBits until it ends."
msgstr "Embargoul este încă în vigoare: fișierul rămâne în ShowBits până la încheierea lui."

#: showbits/includes/class-importer.php
msgid "The file is not ready yet in ShowBits."
msgstr "Fișierul nu este încă gata în ShowBits."

#: showbits/includes/class-importer.php
msgid "The file could not be downloaded."
msgstr "Fișierul nu a putut fi descărcat."

#: showbits/includes/class-importer.php
msgid "WordPress did not take the file into the media library."
msgstr "WordPress nu a acceptat fișierul în biblioteca media."

#: showbits/includes/class-importer.php
msgid "The delivery from ShowBits is no longer valid. Import the clip again."
msgstr "Livrarea din ShowBits nu mai este validă. Importă din nou clipul."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer accepts this site’s connection: connect it again under Settings → ShowBits."
msgstr "ShowBits nu mai acceptă conexiunea acestui site: conectează-l din nou în Setări → ShowBits."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer delivers to this site: the workspace’s plan has ended."
msgstr "ShowBits nu mai livrează nimic acestui site: planul spațiului de lucru s-a încheiat."

#: showbits/includes/class-importer.php
msgid "The site’s imports for today are used up. Try again tomorrow."
msgstr "Importurile de azi ale acestui site s-au epuizat. Încearcă din nou mâine."

#: showbits/includes/class-importer.php
msgid "The import was interrupted."
msgstr "Importul a fost întrerupt."

#: showbits/includes/class-importer.php
msgid "The import failed."
msgstr "Importul a eșuat."

#: showbits/includes/class-library-endpoint.php
msgid "This site is not connected to ShowBits."
msgstr "Acest site nu este conectat la ShowBits."

#: showbits/includes/class-library-page.php
msgid "All"
msgstr "Toate"

#: showbits/includes/class-library-page.php
msgid "Clips"
msgstr "Clipuri"

#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Quote cards"
msgstr "Carduri cu citate"

#: showbits/includes/class-library-page.php
msgid "Search titles"
msgstr "Caută în titluri"

#: showbits/includes/class-library-page.php
msgid "Search the library"
msgstr "Caută în bibliotecă"

#: showbits/includes/class-library-page.php
msgid "Import selected"
msgstr "Importă selecția"

#. translators: 1: which one, 2: how many in all
#: showbits/includes/class-library-page.php
msgid "Asking ShowBits for %1$d of %2$d …"
msgstr "Se solicită de la ShowBits: %1$d din %2$d…"

#. translators: %d: how many clips are still on their way
#: showbits/includes/class-library-page.php
msgid "On the way from ShowBits: %d …"
msgstr "Pe drum din ShowBits: %d…"

#. translators: %d: how many clips were imported
#: showbits/includes/class-library-page.php
msgid "Imported: %d"
msgstr "Importate: %d"

#: showbits/includes/class-library-page.php
msgid "Not everything has arrived yet; it continues in the background. Settings → ShowBits lists the imports."
msgstr "Nu a sosit încă tot; importul continuă în fundal. Lista importurilor se află în Setări → ShowBits."

#: showbits/includes/class-library-page.php
msgid "On the way"
msgstr "Pe drum"

#: showbits/includes/class-library-page.php
msgid "Load more"
msgstr "Încarcă mai multe"

#: showbits/includes/class-library-page.php
msgid "Loading …"
msgstr "Se încarcă…"

#: showbits/includes/class-library-page.php
msgid "No released clips or quote cards yet."
msgstr "Nu există încă clipuri sau carduri cu citate aprobate."

#. translators: %s: date and time the embargo ends
#: showbits/includes/class-library-page.php
msgid "Embargo until %s"
msgstr "Embargo până la %s"

#: showbits/includes/class-library-page.php
msgid "Not ready yet"
msgstr "Nu este încă gata"

#: showbits/includes/class-library-page.php
msgid "In the media library"
msgstr "În biblioteca media"

#: showbits/includes/class-library-page.php
msgid "An older version is in the media library"
msgstr "O versiune mai veche este în biblioteca media"

#: showbits/includes/class-library-page.php
msgid "Edit"
msgstr "Editează"

#: showbits/includes/class-library-page.php
msgid "Format"
msgstr "Format"

#: showbits/includes/class-library-page.php
msgid "Video"
msgstr "Video"

#: showbits/includes/class-library-page.php
msgid "Quote card"
msgstr "Card cu citat"

#: showbits/includes/class-library-page.php
msgid "Meme"
msgstr "Meme"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "Failed: %s"
msgstr "Eșuat: %s"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "The library could not be loaded: %s"
msgstr "Biblioteca nu a putut fi încărcată: %s"

#: showbits/includes/class-library-page.php
msgid "This site is not connected to ShowBits yet."
msgstr "Acest site nu este încă conectat la ShowBits."

#: showbits/includes/class-library-page.php
msgid "Connect it in the settings."
msgstr "Conectează-l din setări."

#: showbits/includes/class-library-page.php
msgid "An administrator of this site connects it in the settings."
msgstr "Un administrator al acestui site trebuie să-l conecteze din setări."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-library-page.php
msgid "Released clips and quote cards from the ShowBits workspace “%s”. What you import lands in the media library, ready for posts and pages."
msgstr "Clipuri și carduri cu citate aprobate din spațiul de lucru ShowBits „%s”. Ce imporți ajunge în biblioteca media, gata pentru articole și pagini."

#: showbits/includes/class-library-page.php
msgid "The library needs JavaScript."
msgstr "Biblioteca are nevoie de JavaScript."

#: showbits/includes/class-settings-page.php
msgid "Settings"
msgstr "Setări"

#: showbits/includes/class-settings-page.php
msgid "You may not change these settings."
msgstr "Nu ai permisiunea să modifici aceste setări."

#: showbits/includes/class-settings-page.php
msgid "Connection"
msgstr "Conexiune"

#. translators: 1: the constant SHOWBITS_ENCRYPTION_KEY, 2: the file wp-config.php (both stay as they are)
#: showbits/includes/class-settings-page.php
msgid "Your site’s security keys are not in %2$s, so the key that protects the connection to ShowBits is stored in the database. Add %1$s with a long random value to %2$s; if the site is connected already, connect it again afterwards."
msgstr "Cheile de securitate ale site-ului tău nu sunt în %2$s, așa că cheia care protejează conexiunea cu ShowBits este stocată în baza de date. Adaugă %1$s cu o valoare aleatorie lungă în %2$s; dacă site-ul este deja conectat, conectează-l din nou după aceea."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-settings-page.php
msgid "Connected to the workspace “%s”."
msgstr "Conectat la spațiul de lucru „%s”."

#. translators: 1: imports today, 2: imports a day the plan allows
#: showbits/includes/class-settings-page.php
msgid "Imports today: %1$d of %2$d."
msgstr "Importuri azi: %1$d din %2$d."

#. translators: 1: a person, 2: a date, 3: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "Connected by %1$s on %2$s, at %3$s."
msgstr "Conectat de %1$s pe %2$s, la adresa %3$s."

#: showbits/includes/class-settings-page.php
msgid "Connect again"
msgstr "Reconectare"

#: showbits/includes/class-settings-page.php
msgid "With a new site key the site renews its connection, or moves to another workspace."
msgstr "Cu o cheie de site nouă, site-ul își reînnoiește conexiunea sau trece într-un alt spațiu de lucru."

#. translators: %s: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "ShowBits (%s) cannot be reached right now. The connection stays; try again later."
msgstr "ShowBits (%s) nu poate fi contactat acum. Conexiunea rămâne; încearcă din nou mai târziu."

#: showbits/includes/class-settings-page.php
msgid "ShowBits no longer accepts this site’s connection: it was disconnected in ShowBits, the plan ended, or this site’s keys changed. Connect it again with a new site key."
msgstr "ShowBits nu mai acceptă conexiunea acestui site: a fost deconectat în ShowBits, planul s-a încheiat sau cheile acestui site s-au schimbat. Conectează-l din nou cu o cheie de site nouă."

#: showbits/includes/class-settings-page.php
msgid "Connect this site to a ShowBits workspace: an admin or owner of the workspace makes a site key for this site in ShowBits (Integrations → WordPress). The site can then take released clips and quote cards into its media library, and receive what your ShowBits admins send."
msgstr "Conectează acest site la un spațiu de lucru ShowBits: un administrator sau proprietar al spațiului de lucru creează în ShowBits o cheie de site pentru acest site (Integrations → WordPress). Apoi site-ul poate prelua în biblioteca media clipuri și carduri cu citate aprobate și poate primi ce trimit administratorii tăi din ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Imports"
msgstr "Importuri"

#: showbits/includes/class-settings-page.php
msgid "Format of quote cards"
msgstr "Formatul cardurilor cu citate"

#: showbits/includes/class-settings-page.php
msgid "4:5 (feeds, articles)"
msgstr "4:5 (feeduri, articole)"

#: showbits/includes/class-settings-page.php
msgid "1:1 (square)"
msgstr "1:1 (pătrat)"

#: showbits/includes/class-settings-page.php
msgid "9:16 (stories)"
msgstr "9:16 (povești)"

#: showbits/includes/class-settings-page.php
msgid "The picture pushes bring; in the library you choose for each card."
msgstr "Formatul cardurilor trimise către acest site; în bibliotecă îl alegi pentru fiecare card."

#: showbits/includes/class-settings-page.php
msgid "Videos"
msgstr "Videoclipuri"

#: showbits/includes/class-settings-page.php
msgid "Import the thumbnail as the video’s poster image"
msgstr "Importă miniatura ca imagine poster a videoclipului"

#: showbits/includes/class-settings-page.php
msgid "Save"
msgstr "Salvează"

#: showbits/includes/class-settings-page.php
msgid "Site key"
msgstr "Cheie de site"

#. translators: %s: this site's address
#: showbits/includes/class-settings-page.php
msgid "Made in ShowBits for %s, valid for 24 hours and only once. ShowBits then checks that it is talking to this site."
msgstr "Creată în ShowBits pentru %s, valabilă 24 de ore și o singură dată. Apoi ShowBits verifică dacă vorbește chiar cu acest site."

#: showbits/includes/class-settings-page.php
msgid "Connect"
msgstr "Conectează"

#: showbits/includes/class-settings-page.php
msgid "Are you an admin or owner of the workspace yourself? Then sign in to ShowBits and agree there, without a site key:"
msgstr "Ești chiar tu administrator sau proprietar al spațiului de lucru? Atunci autentifică-te în ShowBits și dă-ți acordul acolo, fără cheie de site:"

#: showbits/includes/class-settings-page.php
msgid "Connect through ShowBits"
msgstr "Conectează prin ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits address"
msgstr "Adresa ShowBits"

#: showbits/includes/class-settings-page.php
msgid "ShowBits Cloud: https://app.showbits.ai. OnPremise: the address of your installation."
msgstr "ShowBits Cloud: https://app.showbits.ai. OnPremise: adresa instalării tale."

#: showbits/includes/class-settings-page.php
msgid "Disconnect"
msgstr "Deconectează"

#: showbits/includes/class-settings-page.php
msgid "Disconnect this site from ShowBits? What is in the media library stays."
msgstr "Vrei să deconectezi acest site de la ShowBits? Ce se află în biblioteca media rămâne acolo."

#: showbits/includes/class-settings-page.php
msgid "asked for"
msgstr "Solicitat"

#: showbits/includes/class-settings-page.php
msgid "waiting"
msgstr "În așteptare"

#: showbits/includes/class-settings-page.php
msgid "importing"
msgstr "Se importă"

#: showbits/includes/class-settings-page.php
msgid "imported"
msgstr "Importat"

#: showbits/includes/class-settings-page.php
msgid "failed"
msgstr "Eșuat"

#: showbits/includes/class-settings-page.php
msgid "Recent imports"
msgstr "Importuri recente"

#: showbits/includes/class-settings-page.php
msgid "When"
msgstr "Data"

#: showbits/includes/class-settings-page.php
msgid "Clip"
msgstr "Clip"

#: showbits/includes/class-settings-page.php
msgid "How"
msgstr "Sursă"

#: showbits/includes/class-settings-page.php
msgid "State"
msgstr "Stare"

#: showbits/includes/class-settings-page.php
msgid "sent from ShowBits"
msgstr "Trimis din ShowBits"

#: showbits/includes/class-settings-page.php
msgid "picked here"
msgstr "Ales aici"

#: showbits/includes/class-settings-page.php
msgid "Connected. The library is under Media → ShowBits."
msgstr "Conectat. Biblioteca se află în Media → ShowBits."

#: showbits/includes/class-settings-page.php
msgid "Disconnected. What is in the media library stays."
msgstr "Deconectat. Ce se află în biblioteca media rămâne acolo."

#: showbits/includes/class-settings-page.php
msgid "Saved."
msgstr "Setările au fost salvate."

#: showbits/includes/class-settings-page.php
msgid "Connecting was cancelled in ShowBits."
msgstr "Conectarea a fost anulată în ShowBits."

#: showbits/includes/class-settings-page.php
msgid "That way back from ShowBits did not belong to this attempt. Start again."
msgstr "Această revenire din ShowBits nu corespunde încercării de conectare pornite de acest site. Începe din nou."

#: showbits/includes/class-settings-page.php
msgid "The ShowBits address must start with https://."
msgstr "Adresa ShowBits trebuie să înceapă cu https://."

#: showbits/includes/class-settings-page.php
msgid "That is not a site key. Copy it from ShowBits (Integrations → WordPress) again."
msgstr "Aceasta nu este o cheie de site. Copiaz-o din nou din ShowBits (Integrations → WordPress)."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not take the site key: it is unknown, used, withdrawn or expired (a site key lasts 24 hours, a consent ten minutes). Make a new one."
msgstr "ShowBits nu a acceptat cheia de site: este necunoscută, deja folosită, retrasă sau expirată (o cheie de site este valabilă 24 de ore, un consimțământ zece minute). Creează una nouă."

#: showbits/includes/class-settings-page.php
msgid "The site key was made for another address. Make one for this site’s address."
msgstr "Cheia de site a fost creată pentru o altă adresă. Creează una pentru adresa acestui site."

#: showbits/includes/class-settings-page.php
msgid "ShowBits could not reach this site at its REST API (/wp-json/showbits/v1/push), or ShowBits itself could not be reached. The site must be public over HTTPS; a firewall or security plugin must let ShowBits in."
msgstr "ShowBits nu a putut accesa acest site prin API-ul REST (/wp-json/showbits/v1/push) sau ShowBits însuși nu a putut fi contactat. Site-ul trebuie să fie accesibil public prin HTTPS; un firewall sau un modul de securitate trebuie să lase ShowBits să treacă."

#: showbits/includes/class-settings-page.php
msgid "This site did not answer ShowBits’ check as expected. Try again; if it fails again, a cache or security plugin may answer for WordPress."
msgstr "Acest site nu a răspuns conform așteptărilor la verificarea făcută de ShowBits. Încearcă din nou; dacă eșuează iar, este posibil ca un modul de cache sau de securitate să răspundă în locul lui WordPress."

#: showbits/includes/class-settings-page.php
msgid "The workspace’s plan has ended, or whoever made the site key may no longer connect sites."
msgstr "Planul spațiului de lucru s-a încheiat sau persoana care a creat cheia de site nu mai are voie să conecteze site-uri."

#: showbits/includes/class-settings-page.php
msgid "The workspace has as many sites as its plan allows."
msgstr "Spațiul de lucru are deja atâtea site-uri câte permite planul său."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not accept this site’s address. It must be served over HTTPS."
msgstr "ShowBits nu a acceptat adresa acestui site. Site-ul trebuie servit prin HTTPS."

#: showbits/includes/class-settings-page.php
msgid "Connecting did not work. Try again, or ask your ShowBits contact."
msgstr "Conectarea nu a reușit. Încearcă din nou sau întreabă persoana ta de contact de la ShowBits."
