# Marathi translation of the ShowBits plugin.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: mr\n"
"Plural-Forms: nplurals=2; plural=n != 1;\n"

#. Description of the plugin
#: showbits/showbits.php
msgid "Released clips and quote cards from ShowBits in the media library: pick them in WordPress, or receive what your ShowBits admins send."
msgstr "ShowBits मधील मंजूर क्लिप्स आणि अवतरण कार्ड्स मीडिया लायब्ररीमध्ये: त्या WordPress मध्ये निवडा, किंवा तुमचे ShowBits ॲडमिन जे पाठवतात ते स्वीकारा."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer as expected."
msgstr "ShowBits ने अपेक्षेप्रमाणे उत्तर दिले नाही."

#: showbits/includes/class-api-client.php
msgid "ShowBits did not answer with a file."
msgstr "ShowBits ने फाइलसह उत्तर दिले नाही."

#: showbits/includes/class-api-client.php showbits/includes/class-importer.php
msgid "ShowBits could not be reached."
msgstr "ShowBits पर्यंत पोहोचता आले नाही."

#. translators: 1: ShowBits' reason, 2: the HTTP status
#: showbits/includes/class-api-client.php
msgid "ShowBits refused (%1$s, HTTP %2$d)."
msgstr "ShowBits ने नकार दिला (%1$s, HTTP %2$d)."

#: showbits/includes/class-connection.php
msgid "You may not connect this site."
msgstr "तुम्ही ही साइट कनेक्ट करू शकत नाही."

#. translators: %s: the clip's title
#: showbits/includes/class-importer.php
msgid "%s (thumbnail)"
msgstr "%s (थंबनेल)"

#. translators: %s: a quote (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%s”"
msgstr "“%s”"

#. translators: 1: a quote, 2: who said it (the alternative text of a quote card's picture)
#: showbits/includes/class-importer.php
msgid "“%1$s” – %2$s"
msgstr "“%1$s” – %2$s"

#: showbits/includes/class-importer.php
msgid "This is not a clip or a format ShowBits offers."
msgstr "ही क्लिप नाही किंवा ShowBits देत असलेला फॉरमॅट नाही."

#: showbits/includes/class-importer.php
msgid "The clip is no longer released in ShowBits."
msgstr "ही क्लिप आता ShowBits मध्ये मंजूर नाही."

#: showbits/includes/class-importer.php
msgid "The embargo still holds: the file stays in ShowBits until it ends."
msgstr "प्रकाशनबंदी अजूनही लागू आहे: ती संपेपर्यंत फाइल ShowBits मध्येच राहील."

#: showbits/includes/class-importer.php
msgid "The file is not ready yet in ShowBits."
msgstr "फाइल अद्याप ShowBits मध्ये तयार नाही."

#: showbits/includes/class-importer.php
msgid "The file could not be downloaded."
msgstr "फाइल डाउनलोड करता आली नाही."

#: showbits/includes/class-importer.php
msgid "WordPress did not take the file into the media library."
msgstr "WordPress ने फाइल मीडिया लायब्ररीमध्ये घेतली नाही."

#: showbits/includes/class-importer.php
msgid "The delivery from ShowBits is no longer valid. Import the clip again."
msgstr "ShowBits कडून आलेली डिलिव्हरी आता वैध नाही. क्लिप पुन्हा आयात करा."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer accepts this site’s connection: connect it again under Settings → ShowBits."
msgstr "ShowBits आता या साइटचे कनेक्शन स्वीकारत नाही: सेटिंग्ज → ShowBits येथे ती पुन्हा कनेक्ट करा."

#: showbits/includes/class-importer.php
msgid "ShowBits no longer delivers to this site: the workspace’s plan has ended."
msgstr "ShowBits आता या साइटला काहीही पाठवत नाही: वर्कस्पेसचा प्लॅन संपला आहे."

#: showbits/includes/class-importer.php
msgid "The site’s imports for today are used up. Try again tomorrow."
msgstr "आजसाठी या साइटच्या आयाती संपल्या आहेत. उद्या पुन्हा प्रयत्न करा."

#: showbits/includes/class-importer.php
msgid "The import was interrupted."
msgstr "आयात अर्धवट थांबली."

#: showbits/includes/class-importer.php
msgid "The import failed."
msgstr "आयात अयशस्वी झाली."

#: showbits/includes/class-library-endpoint.php
msgid "This site is not connected to ShowBits."
msgstr "ही साइट ShowBits शी कनेक्ट केलेली नाही."

#: showbits/includes/class-library-page.php
msgid "All"
msgstr "सर्व"

#: showbits/includes/class-library-page.php
msgid "Clips"
msgstr "क्लिप्स"

#: showbits/includes/class-library-page.php showbits/includes/class-settings-page.php
msgid "Quote cards"
msgstr "अवतरण कार्ड्स"

#: showbits/includes/class-library-page.php
msgid "Search titles"
msgstr "शीर्षके शोधा"

#: showbits/includes/class-library-page.php
msgid "Search the library"
msgstr "लायब्ररीमध्ये शोधा"

#: showbits/includes/class-library-page.php
msgid "Import selected"
msgstr "निवडलेले आयात करा"

#. translators: 1: which one, 2: how many in all
#: showbits/includes/class-library-page.php
msgid "Asking ShowBits for %1$d of %2$d …"
msgstr "ShowBits कडे %2$d पैकी %1$d मागवत आहोत …"

#. translators: %d: how many clips are still on their way
#: showbits/includes/class-library-page.php
msgid "On the way from ShowBits: %d …"
msgstr "ShowBits कडून येत आहेत: %d …"

#. translators: %d: how many clips were imported
#: showbits/includes/class-library-page.php
msgid "Imported: %d"
msgstr "आयात झाले: %d"

#: showbits/includes/class-library-page.php
msgid "Not everything has arrived yet; it continues in the background. Settings → ShowBits lists the imports."
msgstr "अद्याप सर्व काही आलेले नाही; आयात पार्श्वभूमीत सुरू राहील. सेटिंग्ज → ShowBits येथे आयातींची यादी आहे."

#: showbits/includes/class-library-page.php
msgid "On the way"
msgstr "येत आहे"

#: showbits/includes/class-library-page.php
msgid "Load more"
msgstr "आणखी लोड करा"

#: showbits/includes/class-library-page.php
msgid "Loading …"
msgstr "लोड होत आहे …"

#: showbits/includes/class-library-page.php
msgid "No released clips or quote cards yet."
msgstr "अद्याप कोणत्याही मंजूर क्लिप्स किंवा अवतरण कार्ड्स नाहीत."

#. translators: %s: date and time the embargo ends
#: showbits/includes/class-library-page.php
msgid "Embargo until %s"
msgstr "%s पर्यंत प्रकाशनबंदी"

#: showbits/includes/class-library-page.php
msgid "Not ready yet"
msgstr "अद्याप तयार नाही"

#: showbits/includes/class-library-page.php
msgid "In the media library"
msgstr "मीडिया लायब्ररीमध्ये आहे"

#: showbits/includes/class-library-page.php
msgid "An older version is in the media library"
msgstr "जुनी आवृत्ती मीडिया लायब्ररीमध्ये आहे"

#: showbits/includes/class-library-page.php
msgid "Edit"
msgstr "संपादित करा"

#: showbits/includes/class-library-page.php
msgid "Format"
msgstr "फॉरमॅट"

#: showbits/includes/class-library-page.php
msgid "Video"
msgstr "व्हिडिओ"

#: showbits/includes/class-library-page.php
msgid "Quote card"
msgstr "अवतरण कार्ड"

#: showbits/includes/class-library-page.php
msgid "Meme"
msgstr "मीम"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "Failed: %s"
msgstr "अयशस्वी: %s"

#. translators: %s: why it failed
#: showbits/includes/class-library-page.php
msgid "The library could not be loaded: %s"
msgstr "लायब्ररी लोड करता आली नाही: %s"

#: showbits/includes/class-library-page.php
msgid "This site is not connected to ShowBits yet."
msgstr "ही साइट अद्याप ShowBits शी कनेक्ट केलेली नाही."

#: showbits/includes/class-library-page.php
msgid "Connect it in the settings."
msgstr "सेटिंग्जमध्ये ती कनेक्ट करा."

#: showbits/includes/class-library-page.php
msgid "An administrator of this site connects it in the settings."
msgstr "या साइटचा प्रशासक सेटिंग्जमध्ये ती कनेक्ट करतो."

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-library-page.php
msgid "Released clips and quote cards from the ShowBits workspace “%s”. What you import lands in the media library, ready for posts and pages."
msgstr "ShowBits वर्कस्पेस “%s” मधील मंजूर क्लिप्स आणि अवतरण कार्ड्स. तुम्ही जे आयात करता ते मीडिया लायब्ररीमध्ये येते, पोस्ट्स आणि पृष्ठांसाठी तयार."

#: showbits/includes/class-library-page.php
msgid "The library needs JavaScript."
msgstr "लायब्ररीसाठी JavaScript आवश्यक आहे."

#: showbits/includes/class-settings-page.php
msgid "Settings"
msgstr "सेटिंग्ज"

#: showbits/includes/class-settings-page.php
msgid "You may not change these settings."
msgstr "तुम्ही ही सेटिंग्ज बदलू शकत नाही."

#: showbits/includes/class-settings-page.php
msgid "Connection"
msgstr "कनेक्शन"

#. translators: %s: the ShowBits workspace's name
#: showbits/includes/class-settings-page.php
msgid "Connected to the workspace “%s”."
msgstr "“%s” वर्कस्पेसशी कनेक्ट केले आहे."

#. translators: 1: imports today, 2: imports a day the plan allows
#: showbits/includes/class-settings-page.php
msgid "Imports today: %1$d of %2$d."
msgstr "आजच्या आयाती: %2$d पैकी %1$d."

#. translators: 1: a person, 2: a date, 3: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "Connected by %1$s on %2$s, at %3$s."
msgstr "%1$s यांनी %2$s रोजी %3$s शी कनेक्ट केले."

#: showbits/includes/class-settings-page.php
msgid "Connect again"
msgstr "पुन्हा कनेक्ट करा"

#: showbits/includes/class-settings-page.php
msgid "With a new site key the site renews its connection, or moves to another workspace."
msgstr "नवीन साइट की वापरून साइट तिचे कनेक्शन नूतनीकरण करते, किंवा दुसऱ्या वर्कस्पेसमध्ये जाते."

#. translators: %s: ShowBits' address
#: showbits/includes/class-settings-page.php
msgid "ShowBits (%s) cannot be reached right now. The connection stays; try again later."
msgstr "ShowBits (%s) पर्यंत सध्या पोहोचता येत नाही. कनेक्शन कायम राहील; नंतर पुन्हा प्रयत्न करा."

#: showbits/includes/class-settings-page.php
msgid "ShowBits no longer accepts this site’s connection: it was disconnected in ShowBits, the plan ended, or this site’s keys changed. Connect it again with a new site key."
msgstr "ShowBits आता या साइटचे कनेक्शन स्वीकारत नाही: ते ShowBits मध्ये डिस्कनेक्ट केले गेले, प्लॅन संपला, किंवा या साइटच्या की बदलल्या. नवीन साइट की वापरून ती पुन्हा कनेक्ट करा."

#: showbits/includes/class-settings-page.php
msgid "Connect this site to a ShowBits workspace: an admin or owner of the workspace makes a site key for this site in ShowBits (Integrations → WordPress). The site can then take released clips and quote cards into its media library, and receive what your ShowBits admins send."
msgstr "ही साइट ShowBits वर्कस्पेसशी कनेक्ट करा: वर्कस्पेसचा ॲडमिन किंवा मालक ShowBits मध्ये (Integrations → WordPress) या साइटसाठी साइट की तयार करतो. त्यानंतर साइट मंजूर क्लिप्स आणि अवतरण कार्ड्स तिच्या मीडिया लायब्ररीमध्ये घेऊ शकते, आणि तुमचे ShowBits ॲडमिन जे पाठवतात ते स्वीकारू शकते."

#: showbits/includes/class-settings-page.php
msgid "Imports"
msgstr "आयात"

#: showbits/includes/class-settings-page.php
msgid "Format of quote cards"
msgstr "अवतरण कार्ड्सचा फॉरमॅट"

#: showbits/includes/class-settings-page.php
msgid "4:5 (feeds, articles)"
msgstr "4:5 (फीड्स, लेख)"

#: showbits/includes/class-settings-page.php
msgid "1:1 (square)"
msgstr "1:1 (चौरस)"

#: showbits/includes/class-settings-page.php
msgid "9:16 (stories)"
msgstr "9:16 (स्टोरीज)"

#: showbits/includes/class-settings-page.php
msgid "The picture pushes bring; in the library you choose for each card."
msgstr "पाठवलेली कार्ड्स या फॉरमॅटमध्ये येतात; लायब्ररीमध्ये तुम्ही प्रत्येक कार्डसाठी स्वतंत्रपणे निवडता."

#: showbits/includes/class-settings-page.php
msgid "Videos"
msgstr "व्हिडिओ"

#: showbits/includes/class-settings-page.php
msgid "Import the thumbnail as the video’s poster image"
msgstr "थंबनेल व्हिडिओची पोस्टर प्रतिमा म्हणून आयात करा"

#: showbits/includes/class-settings-page.php
msgid "Save"
msgstr "जतन करा"

#: showbits/includes/class-settings-page.php
msgid "Site key"
msgstr "साइट की"

#. translators: %s: this site's address
#: showbits/includes/class-settings-page.php
msgid "Made in ShowBits for %s, valid for 24 hours and only once. ShowBits then checks that it is talking to this site."
msgstr "ShowBits मध्ये %s साठी तयार केलेली, 24 तासांसाठी आणि फक्त एकदाच वैध. त्यानंतर ShowBits तपासते की ते याच साइटशी बोलत आहे."

#: showbits/includes/class-settings-page.php
msgid "Connect"
msgstr "कनेक्ट करा"

#: showbits/includes/class-settings-page.php
msgid "Are you an admin or owner of the workspace yourself? Then sign in to ShowBits and agree there, without a site key:"
msgstr "तुम्ही स्वतः वर्कस्पेसचे ॲडमिन किंवा मालक आहात का? तर ShowBits मध्ये साइन इन करा आणि तिथे संमती द्या, साइट की शिवाय:"

#: showbits/includes/class-settings-page.php
msgid "Connect through ShowBits"
msgstr "ShowBits द्वारे कनेक्ट करा"

#: showbits/includes/class-settings-page.php
msgid "ShowBits address"
msgstr "ShowBits पत्ता"

#: showbits/includes/class-settings-page.php
msgid "ShowBits Cloud: https://app.showbits.ai. OnPremise: the address of your installation."
msgstr "ShowBits Cloud: https://app.showbits.ai. OnPremise: तुमच्या इन्स्टॉलेशनचा पत्ता."

#: showbits/includes/class-settings-page.php
msgid "Disconnect"
msgstr "डिस्कनेक्ट करा"

#: showbits/includes/class-settings-page.php
msgid "Disconnect this site from ShowBits? What is in the media library stays."
msgstr "ही साइट ShowBits पासून डिस्कनेक्ट करायची? मीडिया लायब्ररीमध्ये जे आहे ते तसेच राहील."

#: showbits/includes/class-settings-page.php
msgid "asked for"
msgstr "मागवले"

#: showbits/includes/class-settings-page.php
msgid "waiting"
msgstr "प्रतीक्षेत"

#: showbits/includes/class-settings-page.php
msgid "importing"
msgstr "आयात होत आहे"

#: showbits/includes/class-settings-page.php
msgid "imported"
msgstr "आयात झाले"

#: showbits/includes/class-settings-page.php
msgid "failed"
msgstr "अयशस्वी"

#: showbits/includes/class-settings-page.php
msgid "Recent imports"
msgstr "अलीकडील आयाती"

#: showbits/includes/class-settings-page.php
msgid "When"
msgstr "केव्हा"

#: showbits/includes/class-settings-page.php
msgid "Clip"
msgstr "क्लिप"

#: showbits/includes/class-settings-page.php
msgid "How"
msgstr "कसे"

#: showbits/includes/class-settings-page.php
msgid "State"
msgstr "स्थिती"

#: showbits/includes/class-settings-page.php
msgid "sent from ShowBits"
msgstr "ShowBits कडून पाठवले"

#: showbits/includes/class-settings-page.php
msgid "picked here"
msgstr "येथे निवडले"

#: showbits/includes/class-settings-page.php
msgid "Connected. The library is under Media → ShowBits."
msgstr "कनेक्ट झाले. लायब्ररी मीडिया → ShowBits येथे आहे."

#: showbits/includes/class-settings-page.php
msgid "Disconnected. What is in the media library stays."
msgstr "डिस्कनेक्ट झाले. मीडिया लायब्ररीमध्ये जे आहे ते तसेच राहील."

#: showbits/includes/class-settings-page.php
msgid "Saved."
msgstr "जतन केले."

#: showbits/includes/class-settings-page.php
msgid "Connecting was cancelled in ShowBits."
msgstr "ShowBits मध्ये कनेक्ट करणे रद्द केले गेले."

#: showbits/includes/class-settings-page.php
msgid "That way back from ShowBits did not belong to this attempt. Start again."
msgstr "ShowBits कडून परत येण्याचा हा मार्ग या प्रयत्नाचा भाग नव्हता. पुन्हा सुरू करा."

#: showbits/includes/class-settings-page.php
msgid "The ShowBits address must start with https://."
msgstr "ShowBits पत्ता https:// ने सुरू व्हायला हवा."

#: showbits/includes/class-settings-page.php
msgid "That is not a site key. Copy it from ShowBits (Integrations → WordPress) again."
msgstr "ही साइट की नाही. ती ShowBits (Integrations → WordPress) मधून पुन्हा कॉपी करा."

#: showbits/includes/class-settings-page.php
msgid "ShowBits did not take the site key: it is unknown, used, withdrawn or expired (a site key lasts 24 hours, a consent ten minutes). Make a new one."
msgstr "ShowBits ने साइट की स्वीकारली नाही: ती अज्ञात, वापरलेली, मागे घेतलेली किंवा कालबाह्य आहे (साइट की 24 तास टिकते, संमती दहा मिनिटे). नवीन तयार करा."

#: showbits/includes/class-settings-page.php
msgid "The site key was made for another address. Make one for this site’s address."
msgstr "साइट की दुसऱ्या पत्त्यासाठी तयार केली होती. या साइटच्या पत्त्यासाठी एक तयार करा."

#: showbits/includes/class-settings-page.php
msgid "ShowBits could not reach this site at its REST API (/wp-json/showbits/v1/push), or ShowBits itself could not be reached. The site must be public over HTTPS; a firewall or security plugin must let ShowBits in."
msgstr "ShowBits या साइटपर्यंत तिच्या REST API (/wp-json/showbits/v1/push) द्वारे पोहोचू शकले नाही, किंवा ShowBits पर्यंतच पोहोचता आले नाही. साइट HTTPS वरून सार्वजनिक असणे आवश्यक आहे; फायरवॉल किंवा सुरक्षा प्लगइनने ShowBits ला आत येऊ द्यायला हवे."

#: showbits/includes/class-settings-page.php
msgid "This site did not answer ShowBits’ check as expected. Try again; if it fails again, a cache or security plugin may answer for WordPress."
msgstr "या साइटने ShowBits च्या तपासणीला अपेक्षेप्रमाणे उत्तर दिले नाही. पुन्हा प्रयत्न करा; पुन्हा अयशस्वी झाल्यास, कदाचित WordPress ऐवजी एखादे कॅशे किंवा सुरक्षा प्लगइन उत्तर देत आहे."

#: showbits/includes/class-settings-page.php
msgid "The workspace’s plan has ended, or whoever made the site key may no longer connect sites."
msgstr "वर्कस्पेसचा प्लॅन संपला आहे, किंवा ज्यांनी साइट की तयार केली त्यांना आता साइट्स कनेक्ट करण्याची परवानगी नाही."

#: showbits/includes/class-settings-page.php
msgid "The workspace has as many sites as its plan allows."
